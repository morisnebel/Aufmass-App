elagert`);\n        }\n      } catch (e) {\n        console.error('[migrateChecklistImages] Error:', e);\n      }\n    })();\n    return chkMigrationRunning;\n  };\n  const ChecklistService = {\n    getAll: async () => {\n      return getItems(KEYS.CHECKLISTS);\n    },\n    getById: async id => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const found = checklists.find(c => c.id === id);\n      return found ? chkRestoreImages(found) : null;\n    },\n    getByProjectId: async projectId => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      return Promise.all(checklists.filter(c => c.project_id === projectId).map(c => chkRestoreImages(c)));\n    },\n    create: async data => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const ops = [];\n      const newChecklist = Object.assign({}, chkExtractImages(data, ops), {\n        id: generateId(),\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      });\n      checklists.push(newChecklist);\n      await Promise.all([setItems(KEYS.CHECKLISTS, checklists), ...ops]);\n      return newChecklist;\n    },\n    update: async (id, data) => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const index = checklists.findIndex(c => c.id === id);\n      if (index === -1) return null;\n      const ops = [];\n      const oldRefs = [];\n      chkCollectRefs(checklists[index], oldRefs);\n      const merged = Object.assign({}, checklists[index], chkExtractImages(data, ops), {\n        updated_at: new Date().toISOString()\n      });\n      // Nicht mehr referenzierte Bild-Keys aufräumen\n      const newRefs = [];\n      chkCollectRefs(merged, newRefs);\n      const still = new Set(newRefs);\n      oldRefs.filter(k => !still.has(k)).forEach(k => AsyncStorage.default.removeItem(k).catch(() => {}));\n      checklists[index] = merged;\n      await Promise.all([setItems(KEYS.CHECKLISTS, checklists), ...ops]);\n      return checklists[index];\n    },\n    delete: async id => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const toDelete = checklists.find(c => c.id === id);\n      if (toDelete) chkDeleteImages(toDelete);\n      const filtered = checklists.filter(c => c.id !== id);\n      await setItems(KEYS.CHECKLISTS, filtered);\n      return true;\n    }\n  };\n\n  // ============ CHECKLIST TEMPLATES ============\n\n  const ChecklistTemplateService = {\n    getAll: async () => {\n      const templates = await getItems(KEYS.CHECKLIST_TEMPLATES);\n      // Nur die (kleinen) Vorlagen-Logos auflösen – Item-Bilder bleiben als Referenz (Performance)\n      const logoRefs = templates.map(t => t.templateLogo).filter(v => typeof v === 'string' && v.startsWith(CHK_IMG_PREFIX)).map(v => v.slice(CHK_IMG_PREFIX.length));\n      if (logoRefs.length > 0) {\n        const pairs = await AsyncStorage.default.multiGet(Array.from(new Set(logoRefs)));\n        const map = new Map(pairs);\n        return templates.map(t => typeof t.templateLogo === 'string' && t.templateLogo.startsWith(CHK_IMG_PREFIX) ? Object.assign({}, t, {\n          templateLogo: map.get(t.templateLogo.slice(CHK_IMG_PREFIX.length)) || undefined\n        }) : t);\n      }\n      return templates;\n    },\n    // Einmalig Standard-Vorlagen erstellen (nur beim ersten App-Start)\n    initializeDefaults: async () => {\n      const existingKey = await AsyncStorage.default.getItem(KEYS.CHECKLIST_TEMPLATES);\n      // Nur wenn noch nie Vorlagen existiert haben (key ist null, nicht leeres Array)\n      if (existingKey === null) {\n        const defaultTemplates = [{\n          id: 'default-1',\n          name: 'Dachinspektion',\n          items: [{\n            text: 'Dachziegel prüfen',\n            subItems: []\n          }, {\n            text: 'Dachrinne prüfen',\n            subItems: []\n          }, {\n            text: 'Schornstein prüfen',\n            subItems: []\n          }, {\n            text: 'Dachfenster prüfen',