olor: #4caf50;\n            font-weight: 600;\n          }\n          .pdf-category-note {\n            background: #fff8e1;\n            padding: 2px 4px;\n            border-radius: 2px;\n            font-size: 7px;\n            color: #f57c00;\n            font-style: italic;\n            margin-bottom: 3px;\n          }\n          .pdf-category-measurements {\n            background: #e3f2fd;\n            padding: 2px 4px;\n            border-radius: 2px;\n            margin-bottom: 3px;\n          }\n          .pdf-measurement-line {\n            font-size: 7px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-bottom: 1px;\n          }\n          .pdf-measurement-sum {\n            margin-top: 2px;\n            padding-top: 2px;\n            border-top: 1px solid #90caf9;\n            font-size: 7px;\n            color: #1565c0;\n          }\n          .pdf-sum-badge {\n            background: #bbdefb;\n            padding: 1px 4px;\n            border-radius: 6px;\n            font-weight: 600;\n            margin-left: 3px;\n          }\n          .pdf-level1-grid {\n            display: grid;\n            grid-template-columns: repeat(${checklistColumns}, 1fr);\n            gap: 3px;\n          }\n          .pdf-level1-container {\n            background: #fff;\n            border: 1px solid #e0e0e0;\n            border-left: 2px solid ${accentColor};\n            border-radius: 2px;\n            padding: 3px 4px;\n            box-sizing: border-box;\n          }\n          .pdf-level1-header {\n            display: flex;\n            align-items: center;\n            gap: 3px;\n            padding-bottom: 2px;\n            border-bottom: 1px solid #eee;\n            margin-bottom: 2px;\n          }\n          .pdf-level1-prefix {\n            background: ${accentColor};\n            color: ${pdfColor.textColor};\n            font-size: 7px;\n            font-weight: 700;\n            padding: 1px 3px;\n            border-radius: 2px;\n          }\n          .pdf-checkmark-circle {\n            color: #4caf50;\n            font-size: 8px;\n          }\n          .pdf-level1-title {\n            font-size: 8px;\n            font-weight: 600;\n            color: #333;\n            flex: 1;\n          }\n          .pdf-level1-content {\n            padding-left: 1px;\n          }\n          .pdf-deep-sub {\n            display: flex;\n            align-items: center;\n            gap: 2px;\n            padding: 0;\n          }\n          .pdf-deep-prefix {\n            font-size: 7px;\n            color: #666;\n            font-weight: 600;\n            min-width: 18px;\n          }\n          .pdf-checkmark {\n            color: #4caf50;\n            font-size: 7px;\n          }\n          .pdf-deep-text {\n            font-size: 7px;\n            color: #444;\n            flex: 1;\n          }\n          .pdf-note {\n            background: #fff8e1;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #f57c00;\n            font-style: italic;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .pdf-note-icon {\n            margin-right: 1px;\n          }\n          .pdf-measurement {\n            background: #e3f2fd;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .photos-grid, .sketches-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n          }\n          /* Flexible photo/sketch containers */\n          .photos-container, .sketches-container {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 15px;\n            align-items: flex-start;\n          }\n          .photos-container::after, .sketches-container::after {\n  