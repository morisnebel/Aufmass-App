            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 4px;\n            padding: 6px 8px;\n            margin-top: 5px;\n            font-size: 8px;\n          }\n          .footer {\n            margin-top: 5px;\n            padding: 3px 0;\n            border-top: 1px solid ${accentColor};\n            font-size: 6px;\n            color: #999;\n            text-align: center;\n            font-weight: 400;\n            page-break-inside: avoid;\n            page-break-before: avoid;\n            break-before: avoid;\n            break-inside: avoid;\n          }\n          /* Wrapper um den letzten Inhalt und Footer, um sie zusammenzuhalten */\n          .footer-container {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          /* Footer im Druck nur anzeigen wenn genug Platz - sonst verstecken */\n          @media print {\n            .footer {\n              /* Footer wird nur gedruckt wenn er auf die Seite passt */\n              orphans: 3;\n              widows: 3;\n            }\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2px;\n            margin-top: 4px;\n          }\n          .measure-item {\n            font-size: 8px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 10px;\n            color: ${accentColor};\n            margin-bottom: 3px;\n          }\n          .roof-notes {\n            margin-top: 4px;\n            padding-top: 4px;\n            border-top: 1px dashed #e0e0e0;\n            font-size: 8px;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n          }\n          .company-logo {\n            max-width: 120px;\n            max-height: 80px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>${t('pdf.phone')}: ${companyPhone}` : ''}\n                ${companyMobilePhone ? `<br/>${t('pdf.mobile')}: ${companyMobilePhone}` : ''}\n                ${companyFax ? `<br/>${t('pdf.fax')}: ${companyFax}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <h2>${t('pdf.projectOverview')}</h2>\n        <div class=\"info-grid\">\n          <div class=\"info-box\">\n            <h3>${t('pdf.project')}</h3>\n            ${project?.project_number ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">${t('projects.projectNumber')}:</span>\n                <span class=\"info-value\" style=\"color: #4caf50; font-weight: 600;\">${project.project_number}</spa