        if (!isNaN(num)) {\n          existingNumbers.push(num);\n        }\n      }\n    }\n\n    // Find the next available number (not just max + 1, but first gap or max + 1)\n    const maxNum = existingNumbers.length > 0 ? Math.max(...existingNumbers) : 0;\n    const nextNum = maxNum + 1;\n    console.log(`[generateCustomerNumber] Existing numbers: ${existingNumbers.join(', ')}, Next: ${nextNum}`);\n    return `${prefix}${String(nextNum).padStart(3, '0')}`;\n  };\n\n  // Helper function to generate next project number\n  const generateProjectNumber = async () => {\n    const yearPrefix = new Date().getFullYear().toString().slice(-2); // e.g., \"26\" for 2026\n    const prefix = `PR-${yearPrefix}`;\n    const projects = await getItems(KEYS.PROJECTS);\n    const existingNumbers = projects.filter(p => p.project_number?.startsWith(prefix)).map(p => {\n      const numPart = p.project_number?.substring(prefix.length) || '0';\n      return parseInt(numPart, 10) || 0;\n    });\n    const maxNum = existingNumbers.length > 0 ? Math.max(...existingNumbers) : 0;\n    return `${prefix}${String(maxNum + 1).padStart(3, '0')}`;\n  };\n\n  // Helper function to generate next object number\n  const generateObjectNumber = async () => {\n    const yearPrefix = new Date().getFullYear().toString().slice(-2); // e.g., \"26\" for 2026\n    const prefix = `OBJ-${yearPrefix}`;\n    const customers = await getItems(KEYS.CUSTOMERS);\n    const existingNumbers = [];\n\n    // Collect all object numbers from all customers' project addresses\n    for (const customer of customers) {\n      const addresses = customer.projectAddresses || [];\n      for (const addr of addresses) {\n        if (addr.object_number?.startsWith(prefix)) {\n          const numPart = addr.object_number.substring(prefix.length);\n          const num = parseInt(numPart, 10);\n          if (!isNaN(num)) {\n            existingNumbers.push(num);\n          }\n        }\n      }\n    }\n    const maxNum = existingNumbers.length > 0 ? Math.max(...existingNumbers) : 0;\n    return `${prefix}${String(maxNum + 1).padStart(3, '0')}`;\n  };\n\n  // Generate object number for a specific customer (sequential per customer)\n  // Jeder Kunde startet bei OBJ-26001, OBJ-26002, etc.\n  const generateObjectNumberForCustomer = async customerId => {\n    const yearPrefix = new Date().getFullYear().toString().slice(-2);\n    const prefix = `OBJ-${yearPrefix}`;\n    const customer = await getItems(KEYS.CUSTOMERS).then(customers => customers.find(c => c.id === customerId));\n    if (!customer) {\n      // Neuer Kunde ohne Adressen - starte bei 001\n      return `${prefix}001`;\n    }\n    const addresses = customer.projectAddresses || [];\n\n    // Wenn Kunde keine Adressen hat, starte bei 001\n    if (addresses.length === 0) {\n      return `${prefix}001`;\n    }\n    const existingNumbers = addresses.filter(addr => addr.object_number?.startsWith(prefix)).map(addr => {\n      const numPart = addr.object_number?.substring(prefix.length) || '0';\n      return parseInt(numPart, 10) || 0;\n    }).filter(num => num > 0);\n\n    // Wenn keine gültigen Nummern gefunden, starte bei 001\n    if (existingNumbers.length === 0) {\n      return `${prefix}001`;\n    }\n    const maxNum = Math.max(...existingNumbers);\n    console.log(`[generateObjectNumberForCustomer] Customer: ${customerId}, existing: ${existingNumbers.join(',')}, next: ${maxNum + 1}`);\n    return `${prefix}${String(maxNum + 1).padStart(3, '0')}`;\n  };\n\n  // ============ NUMBER VALIDATION FUNCTIONS ============\n  // Check if customer number already exists\n  const isCustomerNumberDuplicate = async (number, excludeId) => {\n    const customers = await getItems(KEYS.CUSTOMERS);\n    console.log('[DEBUG] isCustomerNumberDuplicate - checking:', number, 'exclude:', excludeId);\n    console.log('[DEBUG] All customer numbers:', customers.map(c => ({\n      id: c.id,\n      num: c.customer_number\n    })));\n    const result = customers.some(c => c.customer_number === number && c.id !== excludeId);\n    console.log('[DEBUG] isCustomerNumberDuplicate - result:', result);\n    return result;\n  };\n\n  // Check if project number already exists\n  const isProjectNumberDuplicate = async (number, excludeId) => {\n    const projects = await getItems(KEYS.PROJECTS);\n    return projects.some(p => p.project_number === number && p.id !== excludeId);\n  };\n\n  // Check if object number already exists WITHIN A CUSTOMER (not globally)\n  // Each customer can have their own sequence: OBJ-26001, OBJ-26002, etc.\n  const isObjectNumberDuplicate = async (number, customerId, excludeAddressId) => {\n    const customers = await getItems(KEYS.CUSTOMERS);\n    const customer = customers.find(c => c.id === customerId);\n    if (!customer) return false;\n    const addresses = customer.projectAddresses || [];\n    for (const addr of addresses) {\n      if (addr.object_number === number) {\n        // If we're updating, exclude the current address\n        if (excludeAddressId && addr.id === excludeAddressId) {\n          continue;\n        }\n        return true;\n      }\n    }\n    return false;\n  };\n\n  // Check if object number exists in ANY customer (for project objekt_number field)\n  const isObjectNumberDuplicateInProject = async (number, customerId, currentProjectId) => {\n    // First check if it exists in the customer's addresses\n    const customers = await getItems(KEYS.CUSTOMERS);\n    const customer = customers.find(c => c.id === customerId);\n    if (customer) {\n      const addresses = customer.projectAddresses || [];\n      const existsInAddresses = addresses.some(addr => addr.object_number === number);\n      if (existsInAddresses) {\n        // It's fine if it exists in customer's addresses - that's where it should come from\n        return false;\n      }\n    }\n\n    // Check if another project (not this customer) uses this number\n    const projects = await getItems(KEYS.PROJECTS);\n    for (const proj of projects) {\n      if (proj.id === currentProjectId) continue;\n      if (proj.customer_id === customerId) continue; // Same customer is OK\n      if (proj.objekt_number === number) {\n        return true; // Different customer uses this number\n      }\n    }\n    return false;\n  };\n\n  // Get next available customer number (avoiding duplicates)\n  const getNextAvailableCustomerNumber = async () => {\n    return generateCustomerNumber();\n  };\n\n  // Get next available project number (avoiding duplicates)\n  const getNextAvailableProjectNumber = async () => {\n    return generateProjectNumber();\n  };\n\n  // Get next available object number for customer (avoiding duplicates)\n  const getNextAvailableObjectNumber = async customerId => {\n    if (customerId) {\n      return generateObjectNumberForCustomer(customerId);\n    }\n    return generateObjectNumber();\n  };\n\n  // ============ LAST USED PROJECT TYPE ============\n  const LAST_PROJECT_TYPE_KEY = 'aufmass_last_project_type';\n  const setLastUsedProjectType = async projectType => {\n    try {\n      await AsyncStorage.default.setItem(LAST_PROJECT_TYPE_KEY, projectType);\n    } catch (error) {\n      console.error('Error saving last project type:', error);\n    }\n  };\n  const getLastUsedProjectType = async () => {\n    try {\n      return await AsyncStorage.default.getItem(LAST_PROJECT_TYPE_KEY);\n    } catch (error) {\n      console.error('Error loading last project type:', error);\n      return null;\n    }\n  };\n  const CustomerService = {\n    getAll: async () => {\n      return getItems(KEYS.CUSTOMERS);\n    },\n    getById: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      return customers.find(c => c.id === id) || null;\n    },\n    create: async data => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      // Auto-generate customer number if not provided\n      const customerNumber = data.customer_number || (await generateCustomerNumber());\n      const newCustomer = {\n        ...data,\n        id: generateId(),\n        customer_number: customerNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      customers.push(newCustomer);\n      await setItems(KEYS.CUSTOMERS, customers);\n      return newCustomer;\n    },\n    update: async (id, data) => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const index = customers.findIndex(c => c.id === id);\n      if (index === -1) return null;\n      customers[index] = {\n        ...customers[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.CUSTOMERS, customers);\n      return customers[index];\n    },\n    delete: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const filtered = customers.filter(c => c.id !== id);\n      await setItems(KEYS.CUSTOMERS, filtered);\n      return true;\n    }\n  };\n\n  // ============ PROJECTS ============\n\n  const ProjectService = {\n    // Aktive Projekte (ohne Papierkorb)\n    getAll: async () => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => !p.deleted_at);\n    },\n    getById: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.find(p => p.id === id) || null;\n    },\n    getByCustomerId: async customerId => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => p.customer_id === customerId && !p.deleted_at);\n    },\n    // Felder setzen OHNE updated_at anzufassen (für Export-Verlauf & Papierkorb,\n    // damit der Sync-Zeitvergleich beim Import nicht verfälscht wird)\n    setFieldsRaw: async (id, fields) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const index = projects.findIndex(p => p.id === id);\n      if (index === -1) return;\n      projects[index] = {\n        ...projects[index],\n        ...fields\n      };\n      await setItems(KEYS.PROJECTS, projects);\n    },\n    // Export-Zeitpunkt für mehrere Projekte in EINEM Schreibvorgang merken\n    setLastExported: async (ids, iso) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      let changed = false;\n      for (const id of ids) {\n        const index = projects.findIndex(p => p.id === id);\n        if (index !== -1) {\n          projects[index] = {\n            ...projects[index],\n            last_exported_at: iso\n          };\n          changed = true;\n        }\n      }\n      if (changed) await setItems(KEYS.PROJECTS, projects);\n    },\n    // ---- Papierkorb ----\n    getTrashed: async () => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => !!p.deleted_at).sort((a, b) => (b.deleted_at || '').localeCompare(a.deleted_at || ''));\n    },\n    moveToTrash: async id => {\n      await ProjectService.setFieldsRaw(id, {\n        deleted_at: new Date().toISOString()\n      });\n    },\n    restoreFromTrash: async id => {\n      await ProjectService.setFieldsRaw(id, {\n        deleted_at: undefined\n      });\n    },\n    // Endgültig löschen, was länger als `days` Tage im Papierkorb liegt\n    purgeExpiredTrash: async (days = 30) => {\n      const trashed = await ProjectService.getTrashed();\n      let purged = 0;\n      for (const p of trashed) {\n        const age = Date.now() - new Date(p.deleted_at).getTime();\n        if (age > days * 24 * 60 * 60 * 1000) {\n          try {\n            await ProjectService.delete(p.id);\n            purged++;\n          } catch (e) {\n            console.warn('[Papierkorb] Endgültiges Löschen fehlgeschlagen:', p.id, e);\n          }\n        }\n      }\n      return purged;\n    },\n    create: async data => {\n      const projects = await getItems(KEYS.PROJECTS);\n      // Auto-generate project number if not provided\n      const projectNumber = data.project_number || (await generateProjectNumber());\n      const newProject = {\n        ...data,\n        id: generateId(),\n        project_number: projectNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      projects.push(newProject);\n      await setItems(KEYS.PROJECTS, projects);\n      return newProject;\n    },\n    update: async (id, data) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const index = projects.findIndex(p => p.id === id);\n      if (index === -1) return null;\n      projects[index] = {\n        ...projects[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.PROJECTS, projects);\n      return projects[index];\n    },\n    delete: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const filtered = projects.filter(p => p.id !== id);\n      await setItems(KEYS.PROJECTS, filtered);\n      // Also delete related data\n      const sketches = await getItems(KEYS.SKETCHES);\n      const sketchesToDelete = sketches.filter(s => s.project_id === id);\n      await setItems(KEYS.SKETCHES, sketches.filter(s => s.project_id !== id));\n      // Clean up separate sketch data keys\n      const cleanupOps = [];\n      for (const sketch of sketchesToDelete) {\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_meta_${sketch.id}`));\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_bg_${sketch.id}`));\n        // Clean up separately stored image elements\n        try {\n          const metaStr = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (metaStr) {\n            const meta = JSON.parse(metaStr);\n            if (meta?.elements) {\n              for (const el of meta.elements) {\n                if (el.data?.imageStorageKey) {\n                  cleanupOps.push(AsyncStorage.default.removeItem(el.data.imageStorageKey));\n                }\n              }\n            }\n          }\n        } catch (e) {\n          // Ignore parse errors during cleanup\n        }\n      }\n      if (cleanupOps.length > 0) {\n        await Promise.all(cleanupOps);\n      }\n      const photos = await getItems(KEYS.PHOTOS);\n      // Separat gespeicherte Bilddaten der Projekt-Fotos mitlöschen (sonst bleibt\n      // der Speicher mit verwaisten photo_img_-Blobs gefüllt -> SQLITE_FULL)\n      const photosToDelete = photos.filter(p => p.project_id === id);\n      if (photosToDelete.length > 0) {\n        await AsyncStorage.default.multiRemove(photosToDelete.map(p => `photo_img_${p.id}`)).catch(() => {});\n      }\n      await setItems(KEYS.PHOTOS, photos.filter(p => p.project_id !== id));\n      const roofs = await getItems(KEYS.ROOFS);\n      await setItems(KEYS.ROOFS, roofs.filter(r => r.project_id !== id));\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      await setItems(KEYS.CHECKLISTS, checklists.filter(c => c.project_id !== id));\n      // Berichte des Projekts mitlöschen (sonst bleiben verwaiste Berichte zurück)\n      const reports = await getItems(KEYS.REPORTS);\n      await setItems(KEYS.REPORTS, reports.filter(r => r.project_id !== id));\n      return true;\n    }\n  };\n\n  // ============ SKETCHES ============\n\n  // Lagert große eingebettete Bilder (base64-URIs) aus Skizzen-Elementen in eigene\n  // sketch_img_-Keys aus, BEVOR die Metadaten per JSON.stringify serialisiert werden.\n  // Verhindert riesige String-Allokationen (std::bad_alloc-Crash auf iOS beim Import).\n  const externalizeSketchImages = (meta, sketchId, saveOps) => {\n    const out = {\n      ...meta\n    };\n    delete out.backgroundImage;\n    if (Array.isArray(out.elements)) {\n      out.elements = out.elements.map(el => {\n        const uri = el?.data?.uri;\n        if (el?.type === 'image' && typeof uri === 'string' && uri.length > 50000) {\n          const imageKey = `sketch_img_${sketchId}_${el.id}`;\n          saveOps.push(AsyncStorage.default.setItem(imageKey, uri).catch(() => {}));\n          return {\n            ...el,\n            data: {\n              ...el.data,\n              uri: '__stored__',\n              imageStorageKey: imageKey\n            }\n          };\n        }\n        return el;\n      });\n    }\n    return out;\n  };\n  const SketchService = {\n    getAll: async () => {\n      return getItems(KEYS.SKETCHES);\n    },\n    getById: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      return sketches.find(s => s.id === id) || null;\n    },\n    getByProjectId: async projectId => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      return sketches.filter(s => s.project_id === projectId);\n    },\n    // Für Projekt-Export: Skizzen inkl. eingebetteter Bearbeitungsdaten\n    // (metadata + backgroundImage aus den optimierten Keys). Beim Import\n    // splittet create() die Daten automatisch wieder auf.\n    getByProjectIdWithData: async projectId => {\n      const sketches = await SketchService.getByProjectId(projectId);\n      return Promise.all(sketches.map(async s => {\n        try {\n          const {\n            metadata,\n            backgroundImage\n          } = await SketchService.loadSketchData(s.id);\n          if (metadata) {\n            const full = {\n              ...metadata\n            };\n            if (backgroundImage) full.backgroundImage = backgroundImage;\n            return {\n              ...s,\n              metadata: JSON.stringify(full)\n            };\n          }\n        } catch (e) {\n          console.warn('[SketchService] Export: Skizzen-Daten fehlen für', s.id, e);\n        }\n        return s;\n      }));\n    },\n    // ---- OPTIMIZED: Load heavy sketch data from separate storage keys ----\n    // This avoids parsing all sketches just to load one sketch's elements/background\n    loadSketchData: async id => {\n      try {\n        // Try loading from separate optimized keys first\n        const [metaStr, bgImage] = await Promise.all([AsyncStorage.default.getItem(`sketch_meta_${id}`), AsyncStorage.default.getItem(`sketch_bg_${id}`)]);\n        if (metaStr) {\n          // Found in optimized storage - parse with error handling\n          let metadata;\n          try {\n            metadata = JSON.parse(metaStr);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: bgImage\n            };\n          }\n\n          // Restore image URIs from separate storage if they were extracted\n          if (metadata.elements && Array.isArray(metadata.elements)) {\n            const imageElements = metadata.elements.filter(el => el.type === 'image' && el.data?.imageStorageKey);\n            if (imageElements.length > 0) {\n              const imageKeys = imageElements.map(el => el.data.imageStorageKey);\n              const imagePromises = imageKeys.map(key => AsyncStorage.default.getItem(key).catch(() => null));\n              const imageData = await Promise.all(imagePromises);\n              metadata.elements = metadata.elements.map(el => {\n                if (el.type === 'image' && el.data?.imageStorageKey) {\n                  const idx = imageKeys.indexOf(el.data.imageStorageKey);\n                  if (idx !== -1 && imageData[idx]) {\n                    return {\n                      ...el,\n                      data: {\n                        ...el.data,\n                        uri: imageData[idx]\n                      }\n                    };\n                  }\n                }\n                return el;\n              });\n            }\n          }\n          return {\n            metadata,\n            backgroundImage: bgImage\n          };\n        }\n\n        // Fallback: migrate from old format (metadata embedded in main array)\n        console.log(`[SketchService] Migrating sketch ${id} to optimized storage...`);\n        const sketch = await SketchService.getById(id);\n        if (sketch?.metadata) {\n          let metadata;\n          try {\n            metadata = JSON.parse(sketch.metadata);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse legacy metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: null\n            };\n          }\n          const bg = metadata.backgroundImage || null;\n\n          // Save to optimized keys (migration)\n          const metaWithoutBg = {\n            ...metadata\n          };\n          delete metaWithoutBg.backgroundImage;\n          await AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg));\n          if (bg) {\n            await AsyncStorage.default.setItem(`sketch_bg_${id}`, bg);\n          }\n\n          // Clean heavy data from main array to speed up future loads\n          const sketches = await getItems(KEYS.SKETCHES);\n          const index = sketches.findIndex(s => s.id === id);\n          if (index !== -1) {\n            // Keep only lightweight data + sketch_data (small preview) in the main array\n            delete sketches[index].metadata;\n            await setItems(KEYS.SKETCHES, sketches);\n          }\n          return {\n            metadata: metaWithoutBg,\n            backgroundImage: bg\n          };\n        }\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      } catch (error) {\n        console.error(`[SketchService] Error loading sketch data for ${id}:`, error);\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      }\n    },\n    // ---- OPTIMIZED: Save heavy data to separate keys ----\n    saveSketchData: async (id, metadata, backgroundImage) => {\n      try {\n        // Save metadata (without background image) to separate key\n        const metaWithoutBg = {\n          ...metadata\n        };\n        delete metaWithoutBg.backgroundImage;\n        const saveOps = [AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg))];\n\n        // Save background image to its own key\n        if (backgroundImage) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, backgroundImage));\n        } else {\n          // Remove old background if cleared\n          saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n        }\n        await Promise.all(saveOps);\n      } catch (error) {\n        console.error(`[SketchService] Error saving sketch data for ${id}:`, error);\n      }\n    },\n    create: async data => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const id = generateId();\n\n      // Extract heavy data before storing in main array\n      const heavyMetadata = data.metadata;\n      const lightSketch = {\n        ...data,\n        id,\n        metadata: undefined,\n        // Don't store metadata in main array\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      sketches.push(lightSketch);\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = externalizeSketchImages(meta, id, saveOps);\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          }\n        } catch (e) {\n          // If metadata isn't valid JSON, store as-is in separate key\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return {\n        ...lightSketch,\n        metadata: heavyMetadata\n      };\n    },\n    update: async (id, data) => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const index = sketches.findIndex(s => s.id === id);\n      if (index === -1) return null;\n\n      // Extract heavy data\n      const heavyMetadata = data.metadata;\n      const lightData = {\n        ...data\n      };\n      delete lightData.metadata; // Don't store metadata in main array\n\n      sketches[index] = {\n        ...sketches[index],\n        ...lightData,\n        updated_at: new Date().toISOString()\n      };\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = externalizeSketchImages(meta, id, saveOps);\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          } else {\n            saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n          }\n        } catch (e) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return sketches[index];\n    },\n    delete: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const filtered = sketches.filter(s => s.id !== id);\n\n      // Delete main array entry + separate heavy data keys in parallel\n      await Promise.all([setItems(KEYS.SKETCHES, filtered), AsyncStorage.default.removeItem(`sketch_meta_${id}`), AsyncStorage.default.removeItem(`sketch_bg_${id}`)]);\n      return true;\n    },\n    // ---- BATCH MIGRATION: Move all embedded metadata to separate keys ----\n    // This should be called once on app startup to ensure the main sketches array is lightweight.\n    // After migration, loading the sketch list is fast because the heavy data is stored separately.\n    migrateAllSketches: async () => {\n      const MIGRATION_KEY = 'aufmassprofi_sketch_migration_done';\n      try {\n        // Check if migration already completed\n        const migrationDone = await AsyncStorage.default.getItem(MIGRATION_KEY);\n        if (migrationDone === 'true') {\n          console.log('[SketchService] Migration already completed, skipping.');\n          return;\n        }\n        console.log('[SketchService] Starting batch migration of sketches...');\n        const startTime = Date.now();\n        const sketches = await getItems(KEYS.SKETCHES);\n        let migratedCount = 0;\n        let needsSave = false;\n        for (const sketch of sketches) {\n          if (sketch.metadata) {\n            try {\n              const meta = JSON.parse(sketch.metadata);\n              const bg = meta.backgroundImage || null;\n              const metaWithoutBg = {\n                ...meta\n              };\n              delete metaWithoutBg.backgroundImage;\n\n              // Save heavy data to separate keys\n              await AsyncStorage.default.setItem(`sketch_meta_${sketch.id}`, JSON.stringify(metaWithoutBg));\n              if (bg) {\n                await AsyncStorage.default.setItem(`sketch_bg_${sketch.id}`, bg);\n              }\n\n              // Strip metadata from main array entry\n              delete sketch.metadata;\n              needsSave = true;\n              migratedCount++;\n            } catch (e) {\n              console.error(`[SketchService] Error migrating sketch ${sketch.id}:`, e);\n            }\n          }\n        }\n        if (needsSave) {\n          await setItems(KEYS.SKETCHES, sketches);\n        }\n\n        // Mark migration as done\n        await AsyncStorage.default.setItem(MIGRATION_KEY, 'true');\n        console.log(`[SketchService] Batch migration completed in ${Date.now() - startTime}ms. Migrated ${migratedCount} sketches.`);\n      } catch (error) {\n        console.error('[SketchService] Batch migration error:', error);\n      }\n    }\n  };\n\n  // ============ PHOTOS ============\n\n  // Migration: Foto-Bilddaten aus dem Array in separate Schlüssel verschieben\n  // Verhindert Hermes OOM bei JSON.stringify des gesamten Foto-Arrays\n  const migratePhotoStorage = async () => {\n    try {\n      const migrationKey = 'aufmassprofi_photo_migration_done';\n      const done = await AsyncStorage.default.getItem(migrationKey);\n      if (done === 'true') return; // Bereits migriert\n\n      const photos = await getItems(KEYS.PHOTOS);\n      let migrated = 0;\n      let needsSave = false;\n      for (const photo of photos) {\n        const inlineData = photo.image_data || photo.uri || '';\n        if (inlineData.length > 200) {\n          // Bilddaten separat speichern\n          try {\n            await AsyncStorage.default.setItem(`photo_img_${photo.id}`, inlineData);\n            photo.image_data = '';\n            photo.uri = '';\n            migrated++;\n            needsSave = true;\n          } catch (e) {\n            console.error(`Migration error for photo ${photo.id}:`, e);\n          }\n        }\n      }\n      if (needsSave) {\n        await setItems(KEYS.PHOTOS, photos);\n        console.log(`[migratePhotoStorage] ${migrated} photos migrated to separate storage`);\n      }\n      await AsyncStorage.default.setItem(migrationKey, 'true');\n    } catch (e) {\n      console.error('[migratePhotoStorage] Error:', e);\n    }\n  };\n\n  // Entfernt \"Geister-Fotos\": Einträge ohne Bilddaten. Diese entstehen, wenn beim\n  // Import/Speichern das Bild wegen vollem Speicher (SQLITE_FULL) nicht mehr\n  // gespeichert werden konnte, der Metadaten-Eintrag aber angelegt wurde.\n  const cleanupGhostPhotos = async () => {\n    try {\n      const photos = await getItems(KEYS.PHOTOS);\n      const keep = [];\n      let removed = 0;\n      for (const photo of photos) {\n        const inline = photo.image_data || photo.uri || '';\n        if (inline.length > 100) {\n          keep.push(photo);\n          continue;\n        }\n        const stored = await storage.getItem(`photo_img_${photo.id}`);\n        if (stored && stored.length > 100) {\n          keep.push(photo);\n        } else {\n          removed++;\n        }\n      }\n      if (removed > 0) {\n        await setItems(KEYS.PHOTOS, keep);\n        console.log(`[cleanupGhostPhotos] ${removed} Foto-Einträge ohne Bilddaten entfernt`);\n      }\n      return removed;\n    } catch (e) {\n      console.error('[cleanupGhostPhotos] Error:', e);\n      return 0;\n    }\n  };\n\n  // Entfernt verwaiste Speicher-Blobs (photo_img_/sketch_meta_/sketch_bg_/sketch_img_),\n  // deren Foto/Skizze nicht mehr existiert. Wichtig: Gelöschte Projekte haben früher\n  // ihre Bilddaten zurückgelassen -> Speicher blieb voll (SQLITE_FULL bei 6-MB-Limit).\n  const cleanupOrphanedStorage = async () => {\n    try {\n      const [photos, sketches] = await Promise.all([getItems(KEYS.PHOTOS), getItems(KEYS.SKETCHES)]);\n      const validPhotoIds = new Set(photos.map(p => p.id));\n      const validSketchIds = new Set(sketches.map(s => s.id));\n      const allKeys = await AsyncStorage.default.getAllKeys();\n      const toRemove = [];\n      for (const key of allKeys) {\n        if (key.startsWith('photo_img_')) {\n          if (!validPhotoIds.has(key.slice(10))) toRemove.push(key);\n        } else if (key.startsWith('sketch_meta_')) {\n          if (!validSketchIds.has(key.slice(12))) toRemove.push(key);\n        } else if (key.startsWith('sketch_bg_')) {\n          if (!validSketchIds.has(key.slice(10))) toRemove.push(key);\n        } else if (key.startsWith('sketch_img_')) {\n          // Format: sketch_img_<sketchId>_<elementId>; \"new\"-Keys nicht anfassen\n          const sketchId = key.slice(11).split('_')[0];\n          if (sketchId !== 'new' && !validSketchIds.has(sketchId)) toRemove.push(key);\n        }\n      }\n      if (toRemove.length > 0) {\n        await AsyncStorage.default.multiRemove(toRemove);\n        console.log(`[cleanupOrphanedStorage] ${toRemove.length} verwaiste Speicher-Einträge entfernt`);\n      }\n      return toRemove.length;\n    } catch (e) {\n      console.error('[cleanupOrphanedStorage] Error:', e);\n      return 0;\n    }\n  };\n  const PhotoService = {\n    getAll: async () => {\n      return getItems(KEYS.PHOTOS);\n    },\n    getById: async id => {\n      const photos = await getItems(KEYS.PHOTOS);\n      const photo = photos.find(p => p.id === id) || null;\n      if (photo) {\n        // Bilddaten separat laden (OOM-Schutz)\n        const imageData = await storage.getItem(`photo_img_${id}`);\n        if (imageData) {\n          photo.image_data = imageData;\n          photo.uri = imageData;\n        } else if (!photo.image_data && !photo.uri) {\n          // Kein separates Bild und kein Inline-Bild → kein Bild verfügbar\n        }\n        // Migration: Wenn Bild noch im Array steckt, separat speichern und Array bereinigen\n        if ((photo.image_data || photo.uri) && !imageData) {\n          const inlineImg = photo.image_data || photo.uri || '';\n          if (inlineImg.length > 100) {\n            // Nur echte base64-Daten migrieren\n            await storage.setItem(`photo_img_${id}`, inlineImg);\n          }\n        }\n      }\n      return photo;\n    },\n    getByProjectId: async projectId => {\n      const photos = await getItems(KEYS.PHOTOS);\n      const projectPhotos = photos.filter(p => p.project_id === projectId);\n      // Bilddaten separat laden für jedes Foto (einzeln, nicht alle auf einmal!)\n      for (const photo of projectPhotos) {\n        try {\n          const imageData = await storage.getItem(`photo_img_${photo.id}`);\n          if (imageData) {\n            photo.image_data = imageData;\n            photo.uri = imageData;\n          } else if (photo.image_data && photo.image_data.length > 100) {\n            // Migration: Altes Foto hat Bilddaten noch im Array\n            // Separat speichern für zukünftige Nutzung\n            await storage.setItem(`photo_img_${photo.id}`, photo.image_data);\n          } else if (photo.uri && photo.uri.length > 100) {\n            photo.image_data = photo.uri;\n            await storage.setItem(`photo_img_${photo.id}`, photo.uri);\n          }\n        } catch (e) {\n          console.error(`Error loading image for photo ${photo.id}:`, e);\n        }\n      }\n      return projectPhotos;\n    },\n    create: async data => {\n      const photos = await getItems(KEYS.PHOTOS);\n      const newId = generateId();\n\n      // Bilddaten SEPARAT speichern (verhindert OOM bei JSON.stringify des Arrays)\n      const imageData = data.image_data || data.uri || '';\n      if (imageData) {\n        await storage.setItem(`photo_img_${newId}`, imageData);\n      }\n\n      // MIGRATION: Alte Fotos mit Inline-Bilddaten ebenfalls migrieren\n      // Damit das Array klein bleibt und JSON.stringify nicht crasht\n      for (const existingPhoto of photos) {\n        const inlineData = existingPhoto.image_data || existingPhoto.uri || '';\n        if (inlineData.length > 200) {\n          // Bilddaten separat speichern (falls noch nicht geschehen)\n          try {\n            const alreadyMigrated = await storage.getItem(`photo_img_${existingPhoto.id}`);\n            if (!alreadyMigrated) {\n              await storage.setItem(`photo_img_${existingPhoto.id}`, inlineData);\n            }\n          } catch (e) {\n            console.error(`Migration error for photo ${existingPhoto.id}:`, e);\n          }\n          // Inline-Daten entfernen\n          existingPhoto.image_data = '';\n          existingPhoto.uri = '';\n        }\n      }\n\n      // Nur Metadaten im Array speichern (OHNE base64-Bilddaten!)\n      const newPhoto = {\n        ...data,\n        id: newId,\n        image_data: '',\n        // Nicht im Array speichern!\n        uri: '',\n        // Nicht im Array speichern!\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      photos.push(newPhoto);\n      await setItems(KEYS.PHOTOS, photos);\n\n      // Für Rückgabe: Bilddaten wieder anhängen\n      newPhoto.image_data = imageData;\n      newPhoto.uri = imageData;\n      return newPhoto;\n    },\n    update: async (id, data) => {\n      const photos = await getItems(KEYS.PHOTOS);\n      const index = photos.findIndex(p => p.id === id);\n      if (index === -1) return null;\n\n      // Falls Bilddaten aktualisiert werden, separat speichern\n      if (data.image_data || data.uri) {\n        const imageData = data.image_data || data.uri || '';\n        if (imageData) {\n          await storage.setItem(`photo_img_${id}`, imageData);\n        }\n        // Bilddaten aus dem Update entfernen\n        data = {\n          ...data,\n          image_data: '',\n          uri: ''\n        };\n      }\n      photos[index] = {\n        ...photos[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.PHOTOS, photos);\n      return photos[index];\n    },\n    delete: async id => {\n      const photos = await getItems(KEYS.PHOTOS);\n      const filtered = photos.filter(p => p.id !== id);\n      await setItems(KEYS.PHOTOS, filtered);\n      // Auch die separat gespeicherten Bilddaten löschen\n      try {\n        await AsyncStorage.default.removeItem(`photo_img_${id}`);\n      } catch (e) {\n        console.log(`Error removing photo image ${id}:`, e);\n      }\n      return true;\n    }\n  };\n\n  // ============ ROOFS ============\n\n  const RoofService = {\n    getAll: async () => {\n      return getItems(KEYS.ROOFS);\n    },\n    getById: async id => {\n      const roofs = await getItems(KEYS.ROOFS);\n      return roofs.find(r => r.id === id) || null;\n    },\n    getByProjectId: async projectId => {\n      const roofs = await getItems(KEYS.ROOFS);\n      return roofs.filter(r => r.project_id === projectId);\n    },\n    create: async data => {\n      const roofs = await getItems(KEYS.ROOFS);\n      const newRoof = {\n        ...data,\n        id: generateId(),\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      roofs.push(newRoof);\n      await setItems(KEYS.ROOFS, roofs);\n      return newRoof;\n    },\n    update: async (id, data) => {\n      const roofs = await getItems(KEYS.ROOFS);\n      const index = roofs.findIndex(r => r.id === id);\n      if (index === -1) return null;\n      roofs[index] = {\n        ...roofs[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.ROOFS, roofs);\n      return roofs[index];\n    },\n    delete: async id => {\n      const roofs = await getItems(KEYS.ROOFS);\n      const filtered = roofs.filter(r => r.id !== id);\n      await setItems(KEYS.ROOFS, filtered);\n      return true;\n    }\n  };\n\n  // ============ CHECKLISTS ============\n\n  // ============ Checklisten-Bilder: separate Speicherung (OOM-Schutz) ============\n  // Base64-Bilder werden NICHT mehr inline im Haupt-Array gespeichert, sondern\n  // unter eigenen Keys (chk_img_<id>) mit Referenz-Markern im Array.\n  const CHK_IMG_PREFIX = '@chkimg:';\n  const chkStoreInline = (val, ops) => {\n    if (val && typeof val === 'string' && val.startsWith('data:')) {\n      const key = `chk_img_${generateId()}`;\n      ops.push(AsyncStorage.default.setItem(key, val));\n      return CHK_IMG_PREFIX + key;\n    }\n    return val;\n  };\n  const chkExtractItems = (items, ops) => items.map(it => {\n    // String-Items (z.B. Vorlagen-Punkte) unverändert lassen – {...string} würde sie zerstören!\n    if (!it || typeof it !== 'object') return it;\n    return {\n      ...it,\n      printImage: chkStoreInline(it.printImage, ops),\n      categoryLogo: chkStoreInline(it.categoryLogo, ops),\n      previewImages: Array.isArray(it.previewImages) ? it.previewImages.map(v => chkStoreInline(v, ops)) : it.previewImages,\n      subItems: Array.isArray(it.subItems) ? chkExtractItems(it.subItems, ops) : it.subItems\n    };\n  });\n\n  // Repariert durch {...string} zerstörte String-Items (Zeichen-Map {0:'T',1:'e',...} -> String)\n  const chkRepairItem = it => {\n    if (it && typeof it === 'object' && it.text === undefined && typeof it['0'] === 'string') {\n      let s = '';\n      let i = 0;\n      while (typeof it[i] === 'string') {\n        s += it[i];\n        i++;\n      }\n      if (s.length > 0) return s;\n    }\n    return it;\n  };\n  const chkRepairItems = items => items.map(raw => {\n    const it = chkRepairItem(raw);\n    if (!it || typeof it !== 'object') return it;\n    return {\n      ...it,\n      subItems: Array.isArray(it.subItems) ? chkRepairItems(it.subItems) : it.subItems\n    };\n  });\n  const chkExtractImages = (obj, ops) => {\n    const out = {\n      ...obj\n    };\n    if ('templateLogo' in out) out.templateLogo = chkStoreInline(out.templateLogo, ops);\n    if (Array.isArray(out.items)) out.items = chkExtractItems(out.items, ops);\n    return out;\n  };\n  const chkCollectRefs = (obj, out) => {\n    const check = v => {\n      if (typeof v === 'string' && v.startsWith(CHK_IMG_PREFIX)) out.push(v.slice(CHK_IMG_PREFIX.length));\n    };\n    check(obj?.templateLogo);\n    const walk = items => (items || []).forEach(it => {\n      check(it?.printImage);\n      check(it?.categoryLogo);\n      (Array.isArray(it?.previewImages) ? it.previewImages : []).forEach(check);\n      if (Array.isArray(it?.subItems)) walk(it.subItems);\n    });\n    walk(obj?.items);\n  };\n  const chkRestoreImages = async obj => {\n    // Zuerst evtl. zerstörte String-Items reparieren (Bug: {...string} in alten Versionen)\n    let base = obj;\n    if (Array.isArray(base?.items)) {\n      base = {\n        ...base,\n        items: chkRepairItems(base.items)\n      };\n    }\n    const refs = [];\n    chkCollectRefs(base, refs);\n    if (refs.length === 0) return base;\n    const unique = Array.from(new Set(refs));\n    const pairs = await AsyncStorage.default.multiGet(unique);\n    const map = new Map(pairs);\n    const resolve = v => typeof v === 'string' && v.startsWith(CHK_IMG_PREFIX) ? map.get(v.slice(CHK_IMG_PREFIX.length)) || undefined : v;\n    const walk = items => items.map(it => {\n      if (!it || typeof it !== 'object') return it; // String-Items unverändert lassen\n      return {\n        ...it,\n        printImage: resolve(it.printImage),\n        categoryLogo: resolve(it.categoryLogo),\n        previewImages: Array.isArray(it.previewImages) ? it.previewImages.map(resolve).filter(Boolean) : it.previewImages,\n        subItems: Array.isArray(it.subItems) ? walk(it.subItems) : it.subItems\n      };\n    });\n    const out = {\n      ...base\n    };\n    if ('templateLogo' in out) out.templateLogo = resolve(out.templateLogo);\n    if (Array.isArray(out.items)) out.items = walk(out.items);\n    return out;\n  };\n  const chkDeleteImages = obj => {\n    const refs = [];\n    chkCollectRefs(obj, refs);\n    refs.forEach(k => AsyncStorage.default.removeItem(k).catch(() => {}));\n  };\n\n  // Einmalige Migration: Inline-Base64-Bilder aus Checklisten/Vorlagen auslagern\n  let chkMigrationRunning = null;\n  const migrateChecklistImages = async () => {\n    if (chkMigrationRunning) return chkMigrationRunning;\n    chkMigrationRunning = (async () => {\n      try {\n        for (const storageKey of [KEYS.CHECKLISTS, KEYS.CHECKLIST_TEMPLATES]) {\n          const raw = await AsyncStorage.default.getItem(storageKey);\n          if (!raw || raw.indexOf('data:image') === -1) continue; // nichts zu migrieren\n          const arr = JSON.parse(raw);\n          if (!Array.isArray(arr)) continue;\n          const ops = [];\n          const migrated = arr.map(entry => chkExtractImages(entry, ops));\n          await Promise.all(ops);\n          await AsyncStorage.default.setItem(storageKey, JSON.stringify(migrated));\n          console.log(`[migrateChecklistImages] ${ops.length} Bilder aus ${storageKey} ausgelagert`);\n        }\n      } catch (e) {\n        console.error('[migrateChecklistImages] Error:', e);\n      }\n    })();\n    return chkMigrationRunning;\n  };\n  const ChecklistService = {\n    getAll: async () => {\n      return getItems(KEYS.CHECKLISTS);\n    },\n    getById: async id => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const found = checklists.find(c => c.id === id);\n      return found ? chkRestoreImages(found) : null;\n    },\n    getByProjectId: async projectId => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      return Promise.all(checklists.filter(c => c.project_id === projectId).map(c => chkRestoreImages(c)));\n    },\n    create: async data => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const ops = [];\n      const newChecklist = {\n        ...chkExtractImages(data, ops),\n        id: generateId(),\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      checklists.push(newChecklist);\n      await Promise.all([setItems(KEYS.CHECKLISTS, checklists), ...ops]);\n      return newChecklist;\n    },\n    update: async (id, data) => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const index = checklists.findIndex(c => c.id === id);\n      if (index === -1) return null;\n      const ops = [];\n      const oldRefs = [];\n      chkCollectRefs(checklists[index], oldRefs);\n      const merged = {\n        ...checklists[index],\n        ...chkExtractImages(data, ops),\n        updated_at: new Date().toISOString()\n      };\n      // Nicht mehr referenzierte Bild-Keys aufräumen\n      const newRefs = [];\n      chkCollectRefs(merged, newRefs);\n      const still = new Set(newRefs);\n      oldRefs.filter(k => !still.has(k)).forEach(k => AsyncStorage.default.removeItem(k).catch(() => {}));\n      checklists[index] = merged;\n      await Promise.all([setItems(KEYS.CHECKLISTS, checklists), ...ops]);\n      return checklists[index];\n    },\n    delete: async id => {\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      const toDelete = checklists.find(c => c.id === id);\n      if (toDelete) chkDeleteImages(toDelete);\n      const filtered = checklists.filter(c => c.id !== id);\n      await setItems(KEYS.CHECKLISTS, filtered);\n      return true;\n    }\n  };\n\n  // ============ CHECKLIST TEMPLATES ============\n\n  const ChecklistTemplateService = {\n    getAll: async () => {\n      const raw = await getItems(KEYS.CHECKLIST_TEMPLATES);\n      // Zerstörte String-Items reparieren (Bug: {...string} in alten Versionen)\n      const templates = raw.map(t => Array.isArray(t?.items) ? {\n        ...t,\n        items: chkRepairItems(t.items)\n      } : t);\n      // Nur die (kleinen) Vorlagen-Logos auflösen – Item-Bilder bleiben als Referenz (Performance)\n      const logoRefs = templates.map(t => t.templateLogo).filter(v => typeof v === 'string' && v.startsWith(CHK_IMG_PREFIX)).map(v => v.slice(CHK_IMG_PREFIX.length));\n      if (logoRefs.length > 0) {\n        const pairs = await AsyncStorage.default.multiGet(Array.from(new Set(logoRefs)));\n        const map = new Map(pairs);\n        return templates.map(t => typeof t.templateLogo === 'string' && t.templateLogo.startsWith(CHK_IMG_PREFIX) ? {\n          ...t,\n          templateLogo: map.get(t.templateLogo.slice(CHK_IMG_PREFIX.length)) || undefined\n        } : t);\n      }\n      return templates;\n    },\n    // Einmalig Standard-Vorlagen erstellen (nur beim ersten App-Start)\n    initializeDefaults: async () => {\n      const existingKey = await AsyncStorage.default.getItem(KEYS.CHECKLIST_TEMPLATES);\n      // Nur wenn noch nie Vorlagen existiert haben (key ist null, nicht leeres Array)\n      if (existingKey === null) {\n        const defaultTemplates = [{\n          id: 'default-1',\n          name: 'Dachinspektion',\n          items: [{\n            text: 'Dachziegel prüfen',\n            subItems: []\n          }, {\n            text: 'Dachrinne prüfen',\n            subItems: []\n          }, {\n            text: 'Schornstein prüfen',\n            subItems: []\n          }, {\n            text: 'Dachfenster prüfen',\n            subItems: []\n          }],\n          created_at: new Date().toISOString(),\n          updated_at: new Date().toISOString()\n        }, {\n          id: 'default-2',\n          name: 'Aufmaß Standard',\n          items: [{\n            text: 'Dachfläche vermessen',\n            subItems: []\n          }, {\n            text: 'Traufhöhe messen',\n            subItems: []\n          }, {\n            text: 'Firsthöhe messen',\n            subItems: []\n          }, {\n            text: 'Dachneigung bestimmen',\n            subItems: []\n          }],\n          created_at: new Date().toISOString(),\n          updated_at: new Date().toISOString()\n        }];\n        await setItems(KEYS.CHECKLIST_TEMPLATES, defaultTemplates);\n      }\n    },\n    getById: async id => {\n      const templates = await getItems(KEYS.CHECKLIST_TEMPLATES);\n      const found = templates.find(t => t.id === id);\n      return found ? chkRestoreImages(found) : null;\n    },\n    create: async data => {\n      const templates = await getItems(KEYS.CHECKLIST_TEMPLATES);\n      const ops = [];\n      const newTemplate = {\n        ...chkExtractImages(data, ops),\n        id: generateId(),\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      templates.push(newTemplate);\n      await Promise.all([setItems(KEYS.CHECKLIST_TEMPLATES, templates), ...ops]);\n      return newTemplate;\n    },\n    update: async (id, data) => {\n      const templates = await getItems(KEYS.CHECKLIST_TEMPLATES);\n      const index = templates.findIndex(t => t.id === id);\n      if (index === -1) return null;\n      const ops = [];\n      const oldRef