e.length > 0) {\n            sketchesBySize.large.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html.replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>').replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:450px!important;object-fit:contain!important;\"').replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item sketch-large\" style=\"width:100%!important;\"');\n              sketchListHtml += `\n              <div style=\"display:block;width:100%;padding:5px;box-sizing:border-box;margin-bottom:10px;page-break-before:always;break-before:always;page-break-inside:avoid;break-inside:avoid;\">\n                <div style=\"width:100%;border:1px solid #ddd;padding:8px;box-sizing:border-box;overflow:hidden;max-height:500px;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n          }\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchListHtml}</div>`;\n        } else {\n          // iOS/Web: Standard-Layout\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchItems.join('')}</div>`;\n        }\n      }\n\n      // Helper function to calculate polygon area\n      const calculatePolygonArea = (points, scale = 100) => {\n        if (points.length < 3) return 0;\n        let area = 0;\n        for (let i = 0; i < points.length; i++) {\n          const j = (i + 1) % points.length;\n          area += points[i].x * points[j].y;\n          area -= points[j].x * points[i].y;\n        }\n        return Math.abs(area / 2) / (scale * scale);\n      };\n\n      // Helper function to calculate line length\n      const calculateLineLength = (p1, p2, scale = 100) => {\n        return Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2)) / scale;\n      };\n\n      // Category colors\n      const getCategoryColor = category => {\n        // First try to find color from loaded line categories\n        const loadedCat = pdfLineCategories.find(c => c.name === category);\n        if (loadedCat) {\n          return loadedCat.color;\n        }\n        // Fallback to hardcoded colors\n        const colors = {\n          'Ortgang': '#4CAF50',\n          'Traufe': '#2196F3',\n          'First': '#9C27B0',\n          'Kehle': '#673AB7',\n          'Grat': '#FF9800',\n          'Fensterbank': '#795548',\n          'Sturz': '#607D8B',\n          'Laibung': '#E91E63',\n          'Rinne': '#00BCD4',\n          'Fensterumfang': '#FF5722',\n          'Sockelleiste': '#795548',\n          'Ortgang rechts': '#4CAF50',\n          'Ortgang links': '#4CAF50'\n        };\n        return colors[category] || '#607D8B';\n      };\n\n      // Generate FULL SVG drawing for a calculation (large, with all details)\n      const generateFullCalcSvg = calc => {\n        const polygons = calc.polygons || [];\n        const calcLines = calc.lines || [];\n        const calcScale = calc.scale || 100;\n        const calcBackgroundImage = calc.backgroundImage || null;\n        if (polygons.length === 0) return '';\n\n        // Find bounding box\n        let minX = Infinity,\n          minY = Infinity,\n          maxX = -Infinity,\n          maxY = -Infinity;\n        polygons.forEach(p => {\n          p.points.forEach(pt => {\n            minX = Math.min(minX, pt.x);\n            minY = Math.min(minY, pt.y);\n            maxX = Math.max(maxX, pt.x);\n            maxY = Math.max(maxY, pt.y);\n          });\n        });\n        const padding = 50;\n        const width = maxX - minX + padding * 2;\n        const height = maxY - minY + padding * 2;\n\n        // Scale to fit on page - FULL WIDTH for printing (A4 minus margins ~700px)\n        const maxWidth = 700;\n        const scaleRatio = Math.min(maxWidth / width, 550 / height);\n        const svgWidth 