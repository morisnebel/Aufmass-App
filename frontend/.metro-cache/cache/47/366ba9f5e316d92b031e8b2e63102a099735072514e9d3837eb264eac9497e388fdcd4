 const chkStoreInline = (val, ops) => {\n    if (val && typeof val === 'string' && val.startsWith('data:')) {\n      const key = `chk_img_${generateId()}`;\n      ops.push(AsyncStorage.default.setItem(key, val));\n      return CHK_IMG_PREFIX + key;\n    }\n    return val;\n  };\n  const chkExtractItems = (items, ops) => items.map(it => {\n    // String-Items (z.B. Vorlagen-Punkte) unverändert lassen – {...string} würde sie zerstören!\n    if (!it || typeof it !== 'object') return it;\n    return {\n      ...it,\n      printImage: chkStoreInline(it.printImage, ops),\n      categoryLogo: chkStoreInline(it.categoryLogo, ops),\n      previewImages: Array.isArray(it.previewImages) ? it.previewImages.map(v => chkStoreInline(v, ops)) : it.previewImages,\n      subItems: Array.isArray(it.subItems) ? chkExtractItems(it.subItems, ops) : it.subItems\n    };\n  });\n\n  // Repariert durch {...string} zerstörte String-Items (Zeichen-Map {0:'T',1:'e',...} -> String)\n  const chkRepairItem = it => {\n    if (it && typeof it === 'object' && it.text === undefined && typeof it['0'] === 'string') {\n      let s = '';\n      let i = 0;\n      while (typeof it[i] === 'string') {\n        s += it[i];\n        i++;\n      }\n      if (s.length > 0) return s;\n    }\n    return it;\n  };\n  const chkRepairItems = items => items.map(raw => {\n    const it = chkRepairItem(raw);\n    if (!it || typeof it !== 'object') return it;\n    return {\n      ...it,\n      subItems: Array.isArray(it.subItems) ? chkRepairItems(it.subItems) : it.subItems\n    };\n  });\n  const chkExtractImages = (obj, ops) => {\n    const out = {\n      ...obj\n    };\n    if ('templateLogo' in out) out.templateLogo = chkStoreInline(out.templateLogo, ops);\n    if (Array.isArray(out.items)) out.items = chkExtractItems(out.items, ops);\n    return out;\n  };\n  const chkCollectRefs = (obj, out) => {\n    const check = v => {\n      if (typeof v === 'string' && v.startsWith(CHK_IMG_PREFIX)) out.push(v.slice(CHK_IMG_PREFIX