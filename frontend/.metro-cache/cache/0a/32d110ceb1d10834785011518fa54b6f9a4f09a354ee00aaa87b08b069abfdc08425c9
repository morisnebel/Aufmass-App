allback to individual reads\n      const result = new Map();\n      for (const key of keys) {\n        if (key === KEYS.SETTINGS) {\n          try {\n            const data = await storage.getItem(key);\n            result.set(key, data ? JSON.parse(data) : null);\n          } catch (e) {\n            result.set(key, null);\n          }\n        } else {\n          result.set(key, await getItemsSafe(key));\n        }\n      }\n      return result;\n    }\n  };\n\n  // Fast project data loader - reads ALL needed data in one native call\n  const loadAllProjectDataFast = async projectId => {\n    const startTime = Date.now();\n\n    // Read ALL keys in ONE native call\n    const allData = await getMultipleItems([KEYS.PROJECTS, KEYS.CUSTOMERS, KEYS.ROOFS, KEYS.PHOTOS, KEYS.SKETCHES, KEYS.CHECKLISTS, KEYS.DOCUMENTS, KEYS.AREA_CALCULATIONS, KEYS.SETTINGS, 'aufmassprofi_imagemeter_photos']);\n    const t1 = Date.now();\n\n    // Filter data for this project\n    const projects = allData.get(KEYS.PROJECTS) || [];\n    const project = projects.find(p => p.id === projectId) || null;\n    let customer = null;\n    if (project?.customer_id) {\n      const customers = allData.get(KEYS.CUSTOMERS) || [];\n      customer = customers.find(c => c.id === project.customer_id) || null;\n    }\n    const roofs = (allData.get(KEYS.ROOFS) || []).filter(r => r.project_id === projectId);\n    const photos = (allData.get(KEYS.PHOTOS) || []).filter(p => p.project_id === projectId);\n\n    // Bilddaten separat laden (neue Speicherstruktur: Datei statt AsyncStorage)\n    // FIX: Lade Fotos einzeln aus Datei (umgeht AsyncStorage-Limits auf Samsung/Android)\n    if (photos.length > 0) {\n      const migrationOps = [];\n      for (let i = 0; i < photos.length; i++) {\n        const photoId = photos[i].id;\n        try {\n          // Primär: Aus Datei laden\n          const imageData = await loadImageFromFile(`photo_img_${photoId}`);\n          if (imageData && imageData.length > 100) {\n          