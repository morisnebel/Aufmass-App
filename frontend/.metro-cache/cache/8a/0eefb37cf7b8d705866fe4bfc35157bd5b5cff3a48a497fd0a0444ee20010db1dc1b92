rEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html.replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>').replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:450px!important;object-fit:contain!important;\"').replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item sketch-large\" style=\"width:100%!important;\"');\n              sketchListHtml += `\n              <div style=\"display:block;width:100%;padding:5px;box-sizing:border-box;margin-bottom:10px;page-break-before:always;break-before:always;page-break-inside:avoid;break-inside:avoid;\">\n                <div style=\"width:100%;border:1px solid #ddd;padding:8px;box-sizing:border-box;overflow:hidden;max-height:500px;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n          }\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchListHtml}</div>`;\n        } else {\n          // iOS/Web: Standard-Layout\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchItems.join('')}</div>`;\n        }\n      }\n\n      // Helper function to calculate polygon area\n      const calculatePolygonArea = (points, scale = 100) => {\n        if (points.length < 3) return 0;\n        let area = 0;\n        for (let i = 0; i < points.length; i++) {\n          const j = (i + 1) % points.length;\n          area += points[i].x * points[j].y;\n          area -= points[j].x * points[i].y;\n        }\n        return Math.abs(area / 2) / (scale * scale);\n      };\n\n      // Helper function to calculate line length\n      const calculateLineLength = (p1, p2, scale = 100) => {\n        return Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2)) / scale;\n      };\n\n      // Category colors\n      const getCategoryC