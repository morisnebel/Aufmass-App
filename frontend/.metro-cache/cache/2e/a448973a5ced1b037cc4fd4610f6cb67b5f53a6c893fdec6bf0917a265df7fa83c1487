  const originalRotation = originalElement.rotation || 0;\n          newEl.rotation = originalRotation + rotationDelta;\n        } else if (dragMode === 'resize' && resizeHandle) {\n          // Resize element\n          if (el.type === 'circle' && resizeHandle === 'radius') {\n            const newRadius = Math.sqrt(Math.pow(locationX - originalElement.data.cx, 2) + Math.pow(locationY - originalElement.data.cy, 2));\n            newEl.data = Object.assign({}, el.data, {\n              r: Math.max(10, newRadius)\n            });\n          } else if (el.type === 'line' || el.type === 'arrow' || el.type === 'pointer' || el.type === 'memo') {\n            if (resizeHandle === 'start') {\n              newEl.data = Object.assign({}, el.data, {\n                x1: locationX,\n                y1: locationY\n              });\n              // Lupe-Position aktualisieren\n              if (showMagnifier) {\n                setMagnifierTargetPosition({\n                  x: locationX,\n                  y: locationY\n                });\n                setMagnifierPosition({\n                  x: locationX + (canvasLayout?.x || 0),\n                  y: locationY + (canvasLayout?.y || 0)\n                });\n              }\n            } else if (resizeHandle === 'end') {\n              newEl.data = Object.assign({}, el.data, {\n                x2: locationX,\n                y2: locationY\n              });\n              // Lupe-Position aktualisieren\n              if (showMagnifier) {\n                setMagnifierTargetPosition({\n                  x: locationX,\n                  y: locationY\n                });\n                setMagnifierPosition({\n                  x: locationX + (canvasLayout?.x || 0),\n                  y: locationY + (canvasLayout?.y || 0)\n                });\n              }\n            }\n          } else if (el.type === 'rect') {\n            let newData = Object.assign({}, el.data);\n            const origData = originalElement.data