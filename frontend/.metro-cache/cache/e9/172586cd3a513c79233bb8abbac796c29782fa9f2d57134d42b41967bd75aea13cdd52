ne = id => {\n      const source = guideLines.find(g => g.id === id);\n      if (!source) return;\n      saveStateForUndo();\n      // Offset by 20 pixels\n      const newGuideLine = {\n        id: Date.now().toString(),\n        start: {\n          x: source.start.x + 20,\n          y: source.start.y + 20\n        },\n        end: {\n          x: source.end.x + 20,\n          y: source.end.y + 20\n        }\n      };\n      setGuideLines([...guideLines, newGuideLine]);\n    };\n\n    // Extend guide line to canvas edges\n    const extendGuideLineToEdges = id => {\n      const guide = guideLines.find(g => g.id === id);\n      if (!guide) return;\n      const dx = guide.end.x - guide.start.x;\n      const dy = guide.end.y - guide.start.y;\n      if (dx === 0 && dy === 0) return;\n      saveStateForUndo();\n\n      // Calculate line equation: y = mx + b or x = constant for vertical\n      let newStart;\n      let newEnd;\n      if (Math.abs(dx) < 0.001) {\n        // Vertical line\n        newStart = {\n          x: guide.start.x,\n          y: 0\n        };\n        newEnd = {\n          x: guide.start.x,\n          y: canvasHeight\n        };\n      } else if (Math.abs(dy) < 0.001) {\n        // Horizontal line\n        newStart = {\n          x: 0,\n          y: guide.start.y\n        };\n        newEnd = {\n          x: canvasWidth,\n          y: guide.start.y\n        };\n      } else {\n        // Diagonal line\n        const m = dy / dx;\n        const b = guide.start.y - m * guide.start.x;\n\n        // Find intersections with canvas edges\n        const intersections = [];\n\n        // Left edge (x = 0)\n        const yLeft = b;\n        if (yLeft >= 0 && yLeft <= canvasHeight) {\n          intersections.push({\n            x: 0,\n            y: yLeft\n          });\n        }\n\n        // Right edge (x = canvasWidth)\n        const yRight = m * canvasWidth + b;\n        if (yRight >= 0 && yRight <= canvasHeight) {\n          intersections.push({\n         