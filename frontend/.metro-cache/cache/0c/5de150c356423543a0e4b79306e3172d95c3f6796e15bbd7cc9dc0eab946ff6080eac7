tle {\n            font-size: 8px;\n            font-weight: 600;\n            color: #333;\n            flex: 1;\n          }\n          .pdf-level1-content {\n            padding-left: 1px;\n          }\n          .pdf-deep-sub {\n            display: flex;\n            align-items: center;\n            gap: 2px;\n            padding: 0;\n          }\n          .pdf-deep-prefix {\n            font-size: 7px;\n            color: #666;\n            font-weight: 600;\n            min-width: 18px;\n          }\n          .pdf-checkmark {\n            color: #4caf50;\n            font-size: 7px;\n          }\n          .pdf-deep-text {\n            font-size: 7px;\n            color: #444;\n            flex: 1;\n          }\n          .pdf-note {\n            background: #fff8e1;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #f57c00;\n            font-style: italic;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .pdf-note-icon {\n            margin-right: 1px;\n          }\n          .pdf-measurement {\n            background: #e3f2fd;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .photos-grid, .sketches-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n          }\n          /* Flexible photo/sketch containers */\n          .photos-container, .sketches-container {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 15px;\n            align-items: flex-start;\n          }\n          .photos-container::after, .sketches-container::after {\n            content: \"\";\n            display: table;\n            clear: both;\n          }\n          /* Photo page groups - jede Gruppe auf eigener Seite */\n          .photos-page-group {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .photos-page-group .photos-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n          }\n          .photos-page-group .photo-item {\n            max-height: 320px;\n            overflow: hidden;\n          }\n          .photos-page-group .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* Neue Foto-Seiten Layouts */\n          .photos-section {\n            margin-bottom: 15px;\n          }\n          /* Klein: 3 Spalten Grid */\n          .photos-section-small {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 8px;\n          }\n          .photos-section-small .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-small .photo-item img {\n            max-height: 180px;\n            object-fit: contain;\n          }\n          .photo-grid-small {\n            width: 100%;\n          }\n          /* Mittel: 2 Spalten Grid */\n          .photos-section-medium {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 12px;\n          }\n          .photos-section-medium .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-medium .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          .photo-grid-medium {\n            width: 100%;\n          }\n          /* Groß: 1 Spalte (übereinander) */\n          .photos-section-large {\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n          }\n          .photos-section-large .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-large .photo-item img {\n            max-height: 340px;\n            object-fit: contain;\n          }\n          .photo-grid-large {\n            width: 100%;\n          }\n          /* iPhone-spezifischer Skizzen-Container */\n          .sketches-container-iphone {\n            display: block !important;\n            font-size: 0 !important;\n          }\n          .sketches-container-iphone .sketch-item {\n            display: inline-block !important;\n            vertical-align: top !important;\n            font-size: 14px !important;\n            margin-bottom: 10px !important;\n            margin-right: 1% !important;\n            max-height: 500px !important;\n            overflow: hidden !important;\n          }\n          .sketches-container-iphone .sketch-small {\n            width: 32% !important;\n            max-width: 32% !important;\n          }\n          .sketches-container-iphone .sketch-medium {\n            width: 48% !important;\n            max-width: 48% !important;\n          }\n          .sketches-container-iphone .sketch-large {\n            width: 100% !important;\n            max-width: 100% !important;\n          }\n          .sketches-container-iphone .sketch-full {\n            width: 100% !important;\n            max-width: 100% !important;\n          }\n          .sketches-container-iphone .sketch-item img {\n            max-height: 420px !important;\n            max-width: 100% !important;\n            width: 100% !important;\n            height: auto !important;\n            object-fit: contain !important;\n          }\n          .sketch-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .sketch-iphone img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* iPhone-spezifischer Fotos-Container: Grid mit 2 Spalten */\n          .photos-container-iphone {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n            margin-bottom: 20px;\n            align-items: start;\n          }\n          .photos-container-iphone.photos-new-page {\n            page-break-before: always !important;\n            break-before: page !important;\n          }\n          .photo-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .photo-iphone .photo-wrapper {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            border-radius: 4px;\n            overflow: hidden;\n          }\n          .photo-iphone img {\n            width: 100%;\n            height: auto;\n            max-height: 200px;\n            object-fit: contain;\n          }\n          /* Photo sizes - iPad mit Flexbox */\n          .photo-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 400px;\n            object-fit: contain;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes - mit Flexbox */\n          .sketch-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-item img {\n            max-height: 500px;\n            object-fit: contain;\n          }\n          .photo-item, .sketch-item {\n            border: 1px solid #e0e0e0;\n            border-radius: 6px;\n            overflow: hidden;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            display: block;\n            max-height: 350px;\n          }\n          /* Photo/Sketch im Grid nicht umbrechen */\n          .photo-iphone, .sketch-iphone {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            max-height: 280px;\n            overflow: hidden;\n          }\n          .photo-small, .photo-medium, .photo-large, .photo-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .sketch-small, .sketch-medium, .sketch-large, .sketch-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 300px;\n            object-fit: contain;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-title {\n            margin: 0;\n            padding: 8px 10px;\n            font-size: 11px;\n            font-weight: 600;\n            color: ${accentColor};\n            background: #f0f4f8;\n            border-bottom: 1px solid ${accentColor};\n          }\n          .sketch-notes {\n            padding: 8px 10px;\n            background: #fafafa;\n            border-top: 1px solid #e0e0e0;\n          }\n          .sketch-notes-filled {\n            background: #fff8e1;\n            border-top: 1px solid #ffe082;\n          }\n          .sketch-notes-label {\n            font-size: 9px;\n            font-weight: 600;\n            color: #666;\n          }\n          .sketch-notes-text {\n            font-size: 9px;\n            color: #333;\n            line-height: 1.4;\n          }\n          .sketch-notes-lines {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n          }\n          .sketch-note-line {\n            height: 1px;\n            background: #ccc;\n            width: 100%;\n          }\n          .sketch-placeholder {\n            height: 150px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            color: #999;\n          }\n          .empty {\n            color: #999;\n            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 4px;\n            padding: 6px 8px;\n            margin-top: 5px;\n            font-size: 8px;\n          }\n          .footer {\n            margin-top: 5px;\n            padding: 3px 0;\n            border-top: 1px solid ${accentColor};\n            font-size: 6px;\n            color: #999;\n            text-align: center;\n            font-weight: 400;\n            page-break-inside: avoid;\n            page-break-before: avoid;\n            break-before: avoid;\n            break-inside: avoid;\n          }\n          /* Wrapper um den letzten Inhalt und Footer, um sie zusammenzuhalten */\n          .footer-container {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          /* Footer im Druck nur anzeigen wenn genug Platz - sonst verstecken */\n          @media print {\n            .footer {\n              /* Footer wird nur gedruckt wenn er auf die Seite passt */\n              orphans: 3;\n              widows: 3;\n            }\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2px;\n            margin-top: 4px;\n          }\n          .measure-item {\n            font-size: 8px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 10px;\n            color: ${accentColor};\n            margin-bottom: 3px;\n          }\n          .roof-notes {\n            margin-top: 4px;\n            padding-top: 4px;\n            border-top: 1px dashed #e0e0e0;\n            font-size: 8px;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n          }\n          .company-logo {\n            max-width: 120px;\n            max-height: 80px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>${t('pdf.phone')}: ${companyPhone}` : ''}\n                ${companyMobilePhone ? `<br/>${t('pdf.mobile')}: ${companyMobilePhone}` : ''}\n                ${companyFax ? `<br/>${t('pdf.fax')}: ${companyFax}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <h2>${t('pdf.projectOverview')}</h2>\n        <div class=\"info-grid\">\n          <div class=\"info-box\">\n            <h3>${t('pdf.project')}</h3>\n            ${project?.project_number ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">${t('projects.projectNumber')}:</span>\n                <span class=\"info-value\" style=\"color: #4caf50; font-weight: 600;\">${project.project_number}</span>\n              </div>\n            ` : ''}\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${project?.name || '-'}</span>\n            </div>\n            ${project?.description ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">${t('projects.description')}:</span>\n                <span class=\"info-value\">${project.description}</span>\n              </div>\n            ` : ''}\n            <div class=\"info-row\">\n              <span class=\"info-label\">${t('projects.status')}:</span>\n              <span class=\"info-value\">${project?.status === 'aktiv' ? t('projects.statusActive') : project?.status === 'abgeschlossen' ? t('projects.statusCompleted') : t('projects.statusCancelled')}</span>\n            </div>\n            ${objektStreet || objektPlz || objektCity || objektName || objektAddressName || objektContactPerson || objektPhone || objektEmail || objektNumber ? `\n              <div style=\"margin-top: 6px; padding-top: 4px; border-top: 1px solid #e0e0e0;\">\n                <h4 style=\"color: #1976d2; margin: 0 0 3px 0; font-size: 8px; border-bottom: 1px solid #e0e0e0; padding-bottom: 2px;\">\n                  ${t('projects.objectAddress')}${objektAddressName ? ` (${objektAddressName})` : ''}\n                </h4>\n                ${objektNumber ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">${t('projects.objectNumber')}:</span>\n                    <span class=\"info-value\" style=\"color: #ff9800; font-weight: 600;\">${objektNumber}</span>\n                  </div>\n                ` : ''}\n                ${objektName ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">Name:</span>\n                    <span class=\"info-value\">${objektName}</span>\n                  </div>\n                ` : ''}\n                ${objektStreet ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">${t('common.street')}:</span>\n                    <span class=\"info-value\">${objektStreet}</span>\n                  </div>\n                ` : ''}\n                ${objektPlz || objektCity ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">${t('common.zip')}/${t('common.city')}:</span>\n                    <span class=\"info-value\">${objektPlz || ''} ${objektCity || ''}</span>\n                  </div>\n                ` : ''}\n                ${objektContactPerson ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">Ansprechpartner:</span>\n                    <span class=\"info-value\">${objektContactPerson}</span>\n                  </div>\n                ` : ''}\n                ${objektPhone ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">Tel:</span>\n                    <span class=\"info-value\">${objektPhone}</span>\n                  </div>\n                ` : ''}\n                ${objektEmail ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">E-Mail:</span>\n                    <span class=\"info-value\">${objektEmail}</span>\n                  </div>\n                ` : ''}\n              </div>\n            ` : ''}\n          </div>\n          \n          <div class=\"info-box\">\n            <h3>${t('projects.bauherr')}</h3>\n            ${customer?.customer_number ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">${t('customers.customerNumber')}:</span>\n                <span class=\"info-value\" style=\"color: #1976d2; font-weight: 600;\">${customer.customer_number}</span>\n              </div>\n            ` : ''}\n            ${bauherrName ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Name:</span>\n                <span class=\"info-value\