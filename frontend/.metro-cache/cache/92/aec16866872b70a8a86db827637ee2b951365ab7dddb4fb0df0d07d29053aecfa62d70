arks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                  </div>\n                </div>\n              ` : ''}\n              <div class=\"footer\">\n                ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n              </div>\n            </div>\n          </div>\n        ` : ''}\n        \n        ${photos.length === 0 && sketches.length === 0 && areaCalculations.length === 0 && !imagemeterHtml ? `\n          <div class=\"footer-container\">\n            ${remarks || project?.remarks ? `\n              <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                <h2>Bemerkungen</h2>\n                <div class=\"remarks-box\">\n                  ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                </div>\n              </div>\n            ` : ''}\n            <div class=\"footer\">\n              ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n            </div>\n          </div>\n        ` : ''}\n      </body>\n      </html>\n    `;\n      return html;\n    };\n\n    // Wrapper: appends Rapport-Sections to the existing project PDF HTML\n    const appendReportsToHtml = (html, reportsList) => {\n      if (!reportsList || reportsList.length === 0) return html;\n      try {\n        // eslint-disable-next-line @typescript-eslint/no-var-requires\n        const {\n          generateReportSectionHtml,\n          REPORT_CSS\n        } = require(_dependencyMap[35], \"../../services/ReportPdfService\");\n        // Jeden Rapport in einen eigenen .page-Container packen, damit er die volle Seitenbreite\n        // (210mm) bekommt - sonst sind Rapporte im iPhone-PDF-Preview zu schmal.\n        const rapportePages = reportsList.map((r, idx) => `\n        <div class=\"page\" style=\"page-break-before: always;\">\n          ${idx === 0 ? `<h1 style=\"color:#0d9488;border-bottom:2px solid #0d9488;padding-bottom:6px;margin-top:0;\">📝 Rappo