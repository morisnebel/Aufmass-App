orm.default.OS === 'ios' && CloudKitStorage) {\n          await CloudKitStorage.setItem(key, value);\n        }\n      } catch (error) {\n        console.log(`Error saving ${key} to CloudKit:`, error);\n        // Data is already in AsyncStorage, so we're safe\n      }\n    },\n    removeItem: async key => {\n      try {\n        await AsyncStorage.default.removeItem(key);\n        if (Platform.default.OS === 'ios' && CloudKitStorage) {\n          await CloudKitStorage.removeItem(key);\n        }\n      } catch (error) {\n        console.log(`Error removing ${key}:`, error);\n      }\n    }\n  };\n\n  // ============ SYNC EVENT LISTENERS ============\n  // These will be called when data changes on another device\n\n  const syncListeners = [];\n  const addSyncListener = callback => {\n    syncListeners.push(callback);\n\n    // Set up CloudKit listeners on iOS\n    if (Platform.default.OS === 'ios' && CloudKitStorage) {\n      CloudKitStorage.addListener('change', ({\n        key,\n        value\n      }) => {\n        console.log('CloudKit change received for:', key);\n        // Update local AsyncStorage\n        AsyncStorage.default.setItem(key, value);\n        // Notify listeners\n        try {\n          const parsed = JSON.parse(value);\n          syncListeners.forEach(cb => cb(key, parsed));\n        } catch (e) {\n          syncListeners.forEach(cb => cb(key, value));\n        }\n      });\n      CloudKitStorage.addListener('delete', ({\n        key\n      }) => {\n        console.log('CloudKit delete received for:', key);\n        AsyncStorage.default.removeItem(key);\n        syncListeners.forEach(cb => cb(key, null));\n      });\n    }\n  };\n  const removeSyncListener = callback => {\n    const index = syncListeners.indexOf(callback);\n    if (index > -1) {\n      syncListeners.splice(index, 1);\n    }\n  };\n\n  // ============ SYNC STATUS ============\n  const SyncService = {\n    isCloudKitAvailable: () => {\n      return Platform.default.OS === 'ios' && CloudKitStorage !== null;\n    },\n    getLastSyncTime: async () => {\n      return await AsyncStorage.default.getItem(KEYS.SYNC_TIMESTAMP);\n    },\n    updateSyncTime: async () => {\n      await AsyncStorage.default.setItem(KEYS.SYNC_TIMESTAMP, new Date().toISOString());\n    },\n    // Force sync all data to CloudKit\n    forceSyncAll: async () => {\n      if (!SyncService.isCloudKitAvailable()) return;\n      const allKeys = Object.values(KEYS);\n      for (const key of allKeys) {\n        try {\n          const localData = await AsyncStorage.default.getItem(key);\n          if (localData && CloudKitStorage) {\n            await CloudKitStorage.setItem(key, localData);\n          }\n        } catch (error) {\n          console.log(`Error syncing ${key}:`, error);\n        }\n      }\n      await SyncService.updateSyncTime();\n    },\n    // Pull all data from CloudKit\n    pullFromCloud: async () => {\n      if (!SyncService.isCloudKitAvailable()) return;\n      const allKeys = Object.values(KEYS);\n      for (const key of allKeys) {\n        try {\n          if (CloudKitStorage) {\n            const cloudData = await CloudKitStorage.getItem(key);\n            if (cloudData) {\n              await AsyncStorage.default.setItem(key, cloudData);\n            }\n          }\n        } catch (error) {\n          console.log(`Error pulling ${key} from cloud:`, error);\n        }\n      }\n      await SyncService.updateSyncTime();\n    }\n  };\n\n  // Generic CRUD operations using unified storage\n  const getItems = async key => {\n    try {\n      const data = await storage.getItem(key);\n      return data ? JSON.parse(data) : [];\n    } catch (error) {\n      console.error(`Error getting ${key}:`, error);\n      return [];\n    }\n  };\n\n  // Batch-read multiple keys in ONE native call (much faster than individual reads)\n  const getMultipleItems = async keys => {\n    try {\n      const startTime = Date.now();\n      const pairs = await AsyncStorage.default.multiGet(keys);\n      const result = new Map();\n      for (const [key, value] of pairs) {\n        try {\n          result.set(key, value ? JSON.parse(value) : []);\n        } catch (e) {\n          result.set(key, []);\n        }\n      }\n      console.log('[multiGet] Read', keys.length, 'keys in', Date.now() - startTime, 'ms');\n      return result;\n    } catch (error) {\n      console.error('Error in multiGet:', error);\n      // Fallback to individual reads\n      const result = new Map();\n      for (const key of keys) {\n        result.set(key, await getItems(key));\n      }\n      return result;\n    }\n  };\n\n  // Fast project data loader - reads ALL needed data in one native call\n  const loadAllProjectDataFast = async projectId => {\n    const startTime = Date.now();\n\n    // Read ALL keys in ONE native call\n    const allData = await getMultipleItems([KEYS.PROJECTS, KEYS.CUSTOMERS, KEYS.ROOFS, KEYS.PHOTOS, KEYS.SKETCHES, KEYS.CHECKLISTS, KEYS.DOCUMENTS, KEYS.AREA_CALCULATIONS, KEYS.SETTINGS, 'aufmassprofi_imagemeter_photos']);\n    const t1 = Date.now();\n\n    // Filter data for this project\n    const projects = allData.get(KEYS.PROJECTS) || [];\n    const project = projects.find(p => p.id === projectId) || null;\n    let customer = null;\n    if (project?.customer_id) {\n      const customers = allData.get(KEYS.CUSTOMERS) || [];\n      customer = customers.find(c => c.id === project.customer_id) || null;\n    }\n    const roofs = (allData.get(KEYS.ROOFS) || []).filter(r => r.project_id === projectId);\n    const photos = (allData.get(KEYS.PHOTOS) || []).filter(p => p.project_id === projectId);\n\n    // Bilddaten separat laden (neue Speicherstruktur: photo_img_${id})\n    if (photos.length > 0) {\n      const photoImageKeys = photos.map(p => `photo_img_${p.id}`);\n      try {\n        const photoImages = await AsyncStorage.default.multiGet(photoImageKeys);\n        for (let i = 0; i < photos.length; i++) {\n          const [, value] = photoImages[i]