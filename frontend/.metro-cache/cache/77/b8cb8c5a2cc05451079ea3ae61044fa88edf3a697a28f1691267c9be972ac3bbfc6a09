wait Promise.all([AsyncStorage.default.getItem(`sketch_meta_${id}`), AsyncStorage.default.getItem(`sketch_bg_${id}`)]);\n        if (metaStr) {\n          // Found in optimized storage - parse with error handling\n          let metadata;\n          try {\n            metadata = JSON.parse(metaStr);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: bgImage\n            };\n          }\n\n          // Restore image URIs from separate storage if they were extracted\n          if (metadata.elements && Array.isArray(metadata.elements)) {\n            const imageElements = metadata.elements.filter(el => el.type === 'image' && el.data?.imageStorageKey);\n            if (imageElements.length > 0) {\n              const imageKeys = imageElements.map(el => el.data.imageStorageKey);\n              const imagePromises = imageKeys.map(key => AsyncStorage.default.getItem(key).catch(() => null));\n              const imageData = await Promise.all(imagePromises);\n              metadata.elements = metadata.elements.map(el => {\n                if (el.type === 'image' && el.data?.imageStorageKey) {\n                  const idx = imageKeys.indexOf(el.data.imageStorageKey);\n                  if (idx !== -1 && imageData[idx]) {\n                    return {\n                      ...el,\n                      data: {\n                        ...el.data,\n                        uri: imageData[idx]\n                      }\n                    };\n                  }\n                }\n                return el;\n              });\n            }\n          }\n          return {\n            metadata,\n            backgroundImage: bgImage\n          };\n        }\n\n        // Fallback: migrate from old format (metadata embedded in main array)\n        console.log(`[SketchService] Migrating sketch ${id} to optimized storage...`);\n        const sketch = await SketchService.getById(id);\n        if (sketch?.metadata) {\n          let metadata;\n          try {\n            metadata = JSON.parse(sketch.metadata);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse legacy metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: null\n            };\n          }\n          const bg = metadata.backgroundImage || null;\n\n          // Save to optimized keys (migration)\n          const metaWithoutBg = {\n            ...metadata\n          };\n          delete metaWithoutBg.backgroundImage;\n          await AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg));\n          if (bg) {\n            await AsyncStorage.default.setItem(`sketch_bg_${id}`, bg);\n          }\n\n          // Clean heavy data from main array to speed up future loads\n          const sketches = await getItems(KEYS.SKETCHES);\n          const index = sketches.findIndex(s => s.id === id);\n          if (index !== -1) {\n            // Keep only lightweight data + sketch_data (small preview) in the main array\n            delete sketches[index].metadata;\n            await setItems(KEYS.SKETCHES, sketches);\n          }\n          return {\n            metadata: metaWithoutBg,\n            backgroundImage: bg\n          };\n        }\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      } catch (error) {\n        console.error(`[SketchService] Error loading sketch data for ${id}:`, error);\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      }\n    },\n    // ---- OPTIMIZED: Save heavy data to separate keys ----\n    saveSketchData: async (id, metadata, backgroundImage) => {\n      try {\n        // Save metadata (without background image) to separate key\n        const metaWithoutBg = {\n          ...metadata\n        };\n        delete metaWithoutBg.backgroundImage;\n        const saveOps = [AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg))];\n\n        // Save background image to its own key\n        if (backgroundImage) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, backgroundImage));\n        } else {\n          // Remove old background if cleared\n          saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n        }\n        await Promise.all(saveOps);\n      } catch (error) {\n        console.error(`[SketchService] Error saving sketch data for ${id}:`, error);\n      }\n    },\n    create: async data => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const id = generateId();\n\n      // Extract heavy data before storing in main array\n      const heavyMetadata = data.metadata;\n      const lightSketch = {\n        ...data,\n        id,\n        metadata: undefined,\n        // Don't store metadata in main array\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      sketches.push(lightSketch);\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = {\n            ...meta\n          };\n          delete metaWithoutBg.backgroundImage;\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          }\n        } catch (e) {\n          // If metadata isn't valid JSON, store as-is in separate key\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return {\n        ...lightSketch,\n        metadata: heavyMetadata\n      };\n    },\n    update: async (id, data) => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const index = sketches.findIndex(s => s.id === id);\n      if (index === -1) return null;\n\n      // Extract heavy data\n      const heavyMetadata = data.metadata;\n      const lightData = {\n        ...data\n      };\n      delete lightData.metadata; // Don't store metadata in main array\n\n      sketches[index] = {\n        ...sketches[index],\n        ...lightData,\n        updated_at: new Date().toISOString()\n      };\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = {\n            ...meta\n          };\n          delete metaWithoutBg.backgroundImage;\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          } else {\n            saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n          }\n        } catch (e) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return sketches[index];\n    },\n    delete: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const filtered = sketches.filter(s => s.id !== id);\n\n      // Delete main array entry + separate heavy data keys in parallel\n      await Promise.all([setItems(KEYS.SKETCHES, filtered), AsyncStorage.default.removeItem(`sketch_meta_${id}`), AsyncStorage.default.removeItem(`sketch_bg_${id}`)]);\n      return true;\n    },\n    // ---- BATCH MIGRATION: Move all embedded 