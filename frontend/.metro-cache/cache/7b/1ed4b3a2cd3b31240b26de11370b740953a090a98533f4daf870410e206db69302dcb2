ix = new Date().getFullYear().toString().slice(-2); // e.g., \"26\" for 2026\n    const prefix = `KD-${yearPrefix}`;\n    const customers = await getItems(KEYS.CUSTOMERS);\n\n    // Collect all existing numbers\n    const existingNumbers = [];\n    for (const c of customers) {\n      if (c.customer_number?.startsWith(prefix)) {\n        const numPart = c.customer_number.substring(prefix.length);\n        const num = parseInt(numPart, 10);\n        if (!isNaN(num)) {\n          existingNumbers.push(num);\n        }\n      }\n    }\n\n    // Find the next available number (not just max + 1, but first gap or max + 1)\n    const maxNum = existingNumbers.length > 0 ? Math.max(...existingNumbers) : 0;\n    const nextNum = maxNum + 1;\n    console.log(`[generateCustomerNumber] Existing numbers: ${existingNumbers.join(', ')}, Next: ${nextNum}`);\n    return `${prefix}${String(nextNum).padStart(3, '0')}`;\n  };\n\n  // Helper function to generate next project number\n  const generateProjectNumber = async () => {\n    const yearPrefix = new Date().getFullYear().toString().slice(-2); // e.g., \"26\" for 2026\n    const prefix = `PR-${yearPrefix}`;\n    const projects = await getItems(KEYS.PROJECTS);\n    const existingNumbers = projects.filter(p => p.project_number?.startsWith(prefix)).map(p => {\n      const numPart = p.project_number?.substring(prefix.length) || '0';\n      return parseInt(numPart, 10) || 0;\n    });\n    const maxNum = existingNumbers.length > 0 ? Math.max(...existingNumbers) : 0;\n    return `${prefix}${String(maxNum + 1).padStart(3, '0')}`;\n  };\n\n  // Helper function to generate next object number\n  const generateObjectNumber = async () => {\n    const yearPrefix = new Date().getFullYear().toString().slice(-2); // e.g., \"26\" for 2026\n    const prefix = `OBJ-${yearPrefix}`;\n    const customers = await getItems(KEYS.CUSTOMERS);\n    const existingNumbers = [];\n\n    // Collect all object numbers from all customers' project addresses\n    for (const customer of customers) {\n      const addresses = customer.projectAddresses || [];\n      for (const addr of addresses) {\n        if (addr.object_number?.startsWith(prefix)) {\n          const numPart = addr.object_number.substring(prefix.length);\n          const num = parseInt(numPart, 10);\n          if (!isNaN(num)) {\n            existingNumbers.push(num);\n          }\n        }\n      }\n    }\n    const maxNum = existingNumbers.length > 0 ? Math.max(...existingNumbers) : 0;\n    return `${prefix}${String(maxNum + 1).padStart(3, '0')}`;\n  };\n\n  // Generate object number for a specific customer (sequential per customer)\n  // Jeder Kunde startet bei OBJ-26001, OBJ-26002, etc.\n  const generateObjectNumberForCustomer = async customerId => {\n    const yearPrefix = new Date().getFullYear().toString().slice(-2);\n    const prefix = `OBJ-${yearPrefix}`;\n    const customer = await getItems(KEYS.CUSTOMERS).then(customers => customers.find(c => c.id === customerId));\n    if (!customer) {\n      // Neuer Kunde ohne Adressen - starte bei 001\n      return `${prefix}001`;\n    }\n    const addresses = customer.projectAddresses || [];\n\n    // Wenn Kunde keine Adressen hat, starte bei 001\n    if (addresses.length === 0) {\n      return `${prefix}001`;\n    }\n    const existingNumbers = addresses.filter(addr => addr.object_number?.startsWith(prefix)).map(addr => {\n      const numPart = addr.object_number?.substring(prefix.length) || '0';\n      return parseInt(numPart, 10) || 0;\n    }).filter(num => num > 0);\n\n    // Wenn keine gültigen Nummern gefunden, starte bei 001\n    if (existingNumbers.length === 0) {\n      return `${prefix}001`;\n    }\n    const maxNum = Math.max(...existingNumbers);\n    console.log(`[generateObjectNumberForCustomer] Customer: ${customerId}, existing: ${existingNumbers.join(',')}, next: ${maxNum + 1}`);\n    return `${prefix}${String(maxNum + 1).padStart(3, '0')}`;\n  };\n\n  // ============ NUMBER VALIDATION FUNCTIONS ============\n  // Check if customer number already exists\n  const isCustomerNumberDuplicate = async (number, excludeId) => {\n    const customers = await getItems(KEYS.CUSTOMERS);\n    console.log('[DEBUG] isCustomerNumberDuplicate - checking:', number, 'exclude:', excludeId);\n    console.log('[DEBUG] All customer numbers:', customers.map(c => ({\n      id: c.id,\n      num: c.customer_number\n    })));\n    const result = customers.some(c => c.customer_number === number && c.id !== excludeId);\n    console.log('[DEBUG] isCustomerNumberDuplicate - result:', result);\n    return result;\n  };\n\n  // Check if project number already exists\n  const isProjectNumberDuplicate = async (number, excludeId) => {\n    const projects = await getItems(KEYS.PROJECTS);\n    return projects.some(p => p.project_number === number && p.id !== excludeId);\n  };\n\n  // Check if object number already exists WITHIN A CUSTOMER (not globally)\n  // Each customer can have their own sequence: OBJ-26001, OBJ-26002, etc.\n  const isObjectNumberDuplicate = async (number, customerId, excludeAddressId) => {\n    const customers = await getItems(KEYS.CUSTOMERS);\n    const customer = customers.find(c => c.id === customerId);\n    if (!customer) return false;\n    const addresses = customer.projectAddresses || [];\n    for (const addr of addresses) {\n      if (addr.object_number === number) {\n        // If we're updating, exclude the current address\n        if (excludeAddressId && addr.id === excludeAddressId) {\n          continue;\n        }\n        return true;\n      }\n    }\n    return false;\n  };\n\n  // Check if object number exists in ANY customer (for project objekt_number field)\n  const isObjectNumberDuplicateInProject = async (number, customerId, currentProjectId) => {\n    // First check if it exists in the customer's addresses\n    const customers = await getItems(KEYS.CUSTOMERS);\n    const customer = customers.find(c => c.id === customerId);\n    if (customer) {\n      const addresses = customer.projectAddresses || [];\n      const existsInAddresses = addresses.some(addr => addr.object_number === number);\n      if (existsInAddresses) {\n        // It's fine if it exists in customer's addresses - that's where it should come from\n        return false;\n      }\n    }\n\n    // Check if another project (not this customer) uses this number\n    const projects = await getItems(KEYS.PROJECTS);\n    for (const proj of projects) {\n      if (proj.id === currentProjectId) continue;\n      if (proj.customer_id === customerId) continue; // Same customer is OK\n      if (proj.objekt_number === number) {\n        return true; // Different customer uses this number\n      }\n    }\n    return false;\n  };\n\n  // Get next available customer number (avoiding duplicates)\n  const getNextAvailableCustomerNumber = async () => {\n    return generateCustomerNumber();\n  };\n\n  // Get next available project number (avoiding duplicates)\n  const getNextAvailableProjectNumber = async () => {\n    return generateProjectNumber();\n  };\n\n  // Get next available object number for customer (avoiding duplicates)\n  const getNextAvailableObjectNumber = async customerId => {\n    if (customerId) {\n      return generateObjectNumberForCustomer(customerId);\n    }\n    return generateObjectNumber();\n  };\n\n  // ============ LAST USED PROJECT TYPE ============\n  const LAST_PROJECT_TYPE_KEY = 'aufmass_last_project_type';\n  const setLastUsedProjectType = async projectType => {\n    try {\n      await AsyncStorage.default.setItem(LAST_PROJECT_TYPE_KEY, projectType);\n    } catch (error) {\n      console.error('Error saving last project type:', error);\n    }\n  };\n  const getLastUsedProjectType = async () => {\n    try {\n      return await AsyncStorage.default.getItem(LAST_PROJECT_TYPE_KEY);\n    } catch (error) {\n      console.error('Error loading last project type:', error);\n      return null;\n    }\n  };\n  const CustomerService = {\n    getAll: async () => {\n      return getItems(KEYS.CUSTOMERS);\n    },\n    getById: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      return customers.find(c => c.id === id) || null;\n    },\n    create: async data => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      // Auto-generate customer number if not provided\n      const customerNumber = data.customer_number || (await generateCustomerNumber());\n      const newCustomer = {\n        ...data,\n        id: generateId(),\n        customer_number: customerNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      customers.push(newCustomer);\n      await setItems(KEYS.CUSTOMERS, customers);\n      return newCustomer;\n    },\n    update: async (id, data) => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const index = customers.findIndex(c => c.id === id);\n      if (index === -1) return null;\n      customers[index] = {\n        ...customers[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.CUSTOMERS, customers);\n      return customers[index];\n    },\n    delete: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const filtered = customers.filter(c => c.id !== id);\n      await setItems(KEYS.CUSTOMERS, filtered);\n      return true;\n    }\n  };\n\n  // ============ PROJECTS ============\n\n  const ProjectService = {\n    // Aktive Projekte (ohne Papierkorb)\n    getAll: async () => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => !p.deleted_at);\n    },\n    getById: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.find(p => p.id === id) || null;\n    },\n    getByCustomerId: async customerId => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => p.customer_id === customerId && !p.deleted_at);\n    },\n    // Felder setzen OHNE updated_at anzufassen (für Export-Verlauf & Papierkorb,\n    // damit der Sync-Zeitvergleich beim Import nicht verfälscht wird)\n    setFieldsRaw: async (id, fields) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const index = projects.findIndex(p => p.id === id);\n      if (index === -1) return;\n      projects[index] = {\n        ...projects[index],\n        ...fields\n      };\n      await setItems(KEYS.PROJECTS, projects);\n    },\n    // Export-Zeitpunkt für mehrere Projekte in EINEM Schreibvorgang merken\n    setLastExported: async (ids, iso) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      let changed = false;\n      for (const id of ids) {\n        const index = projects.findIndex(p => p.id === id);\n        if (index !== -1) {\n          projects[index] = {\n            ...projects[index],\n            last_exported_at: iso\n          };\n          changed = true;\n        }\n      }\n      if (changed) await setItems(KEYS.PROJECTS, projects);\n    },\n    // ---- Papierkorb ----\n    getTrashed: async () => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => !!p.deleted_at).sort((a, b) => (b.deleted_at || '').localeCompare(a.deleted_at || ''));\n    },\n    moveToTrash: async id => {\n      await ProjectService.setFieldsRaw(id, {\n        deleted_at: new Date().toISOString()\n      });\n    },\n    restoreFromTrash: async id => {\n      await ProjectService.setFieldsRaw(id, {\n        deleted_at: undefined\n      });\n    },\n    // Endgültig löschen, was länger als `days` Tage im Papierkorb liegt\n    purgeExpiredTrash: async (days = 30) => {\n      const trashed = await ProjectService.getTrashed();\n      let purged = 0;\n      for (const p of trashed) {\n        const age = Date.now() - new Date(p.deleted_at).getTime();\n        if (age > days * 24 * 60 * 60 * 1000) {\n          try {\n            await ProjectService.delete(p.id);\n            purged++;\n          } catch (e) {\n            console.warn('[Papierkorb] Endgültiges Löschen fehlgeschlagen:', p.id, e);\n          }\n        }\n      }\n      return purged;\n    },\n    create: async data => {\n      const projects = await getItems(KEYS.PROJECTS);\n      // Auto-generate project number if not provided\n      const projectNumber = data.project_number || (await generateProjectNumber());\n      const newProject = {\n        ...data,\n        id: generateId(),\n        project_number: projectNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      projects.push(newProject);\n      await setItems(KEYS.PROJECTS, projects);\n      return newProject;\n    },\n    update: async (id, data) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const index = projects.findIndex(p => p.id === id);\n      if (index === -1) return null;\n      projects[index] = {\n        ...projects[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.PROJECTS, projects);\n      return projects[index];\n    },\n    delete: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const filtered = projects.filter(p => p.id !== id);\n      await setItems(KEYS.PROJECTS, filtered);\n      // Also delete related data\n      const sketches = await getItems(KEYS.SKETCHES);\n      const sketchesToDelete = sketches.filter(s => s.project_id === id);\n      await setItems(KEYS.SKETCHES, sketches.filter(s => s.project_id !== id));\n      // Clean up separate sketch data keys\n      const cleanupOps = [];\n      for (const sketch of sketchesToDelete) {\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_meta_${sketch.id}`));\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_bg_${sketch.id}`));\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_prev_${sketch.id}`));\n        // Clean up separately stored image elements\n        try {\n          const metaStr = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (metaStr) {\n            const meta = JSON.parse(metaStr);\n            if (meta?.elements) {\n              for (const el of meta.elements) {\n                if (el.data?.imageStorageKey) {\n                  cleanupOps.push(AsyncStorage.default.removeItem(el.data.imageStorageKey));\n                }\n              }\n            }\n          }\n        } catch (e) {\n          // Ignore parse errors during cleanup\n        }\n      }\n      if (cleanupOps.length > 0) {\n        await Promise.all(cleanupOps);\n      }\n      const photos = await getItems(KEYS.PHOTOS);\n      // Separat gespeicherte Bilddaten der Projekt-Fotos mitlöschen (sonst bleibt\n      // der Speicher mit verwaisten photo_img_-Blobs gefüllt -> SQLITE_FULL)\n      const photosToDelete = photos.filter(p => p.project_id === id);\n      if (photosToDelete.length > 0) {\n        await AsyncStorage.default.multiRemove(photosToDelete.map(p => `photo_img_${p.id}`)).catch(() => {});\n      }\n      await setItems(KEYS.PHOTOS, photos.filter(p => p.project_id !== id));\n      const roofs = await getItems(KEYS.ROOFS);\n      await setItems(KEYS.ROOFS, roofs.filter(r => r.project_id !== id));\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      await setItems(KEYS.CHECKLISTS, checklists.filter(c => c.project_id !== id));\n      // Berichte des Projekts mitlöschen (sonst bleiben verwaiste Berichte zurück)\n      const reports = await getItems(KEYS.REPORTS);\n      await setItems(KEYS.REPORTS, reports.filter(r => r.project_id !== id));\n      return true;\n    }\n  };\n\n  // ============ SKETCHES ============\n\n  // Lagert große eingebettete Bilder (base64-URIs) aus Skizzen-Elementen in eigene\n  // sketch_img_-Keys aus, BEVOR die Metadaten per JSON.stringify serialisiert werden.\n  // Verhindert riesige String-Allokationen (std::bad_alloc-Crash auf iOS beim Import).\n  const externalizeSketchImages = (meta, sketchId, saveOps) => {\n    const out = {\n      ...meta\n    };\n    delete out.backgroundImage;\n    if (Array.isArray(out.elements)) {\n      out.elements = out.elements.map(el => {\n        const uri = el?.data?.uri;\n        if (el?.type === 'image' && typeof uri === 'string' && uri.length > 50000) {\n          const imageKey = `sketch_img_${sketchId}_${el.id}`;\n          saveOps.push(AsyncStorage.default.setItem(imageKey, uri).catch(() => {}));\n          return {\n            ...el,\n            data: {\n              ...el.data,\n              uri: '__stored__',\n              imageStorageKey: imageKey\n            }\n          };\n        }\n        return el;\n      });\n    }\n    return out;\n  };\n\n  // Vorschauen (sketch_data) über dieser Größe werden in eigene Keys ausgelagert,\n  // damit das Haupt-Array klein bleibt (sonst schlagen Schreibvorgänge bei vielen\n  // Skizzen fehl und Skizzen gehen verloren - siehe Import-Bug Build 128).\n  const SKETCH_PREVIEW_THRESHOLD = 50000;\n\n  // Ausgelagerte Vorschauen für eine Skizzen-Liste wiederherstellen (eine multiGet-Abfrage)\n  const restoreSketchPreviews = async sketches => {\n    const stored = sketches.filter(s => s.sketch_data === '__stored__');\n    if (stored.length === 0) return sketches;\n    try {\n      const pairs = await AsyncStorage.default.multiGet(stored.map(s => `sketch_prev_${s.id}`));\n      const map = new Map(pairs);\n      return sketches.map(s => s.sketch_data === '__stored__' ? {\n        ...s,\n        sketch_data: map.get(`sketch_prev_${s.id}`) || undefined\n      } : s);\n    } catch {\n      return sketches;\n    }\n  };\n\n  // Einmalige Migration: große Inline-Vorschauen aus dem Haupt-Array auslagern.\n  // Läuft bei jedem App-Start (billig, wenn nichts zu tun ist).\n  const migrateSketchPreviews = async () => {\n    try {\n      const sketches = await getItems(KEYS.SKETCHES);\n      let migrated = 0;\n      for (const s of sketches) {\n        if (typeof s.sketch_data === 'string' && s.sketch_data !== '__stored__' && s.sketch_data.length > SKETCH_PREVIEW_THRESHOLD) {\n          try {\n            await AsyncStorage.default.setItem(`sketch_prev_${s.id}`, s.sketch_data);\n            s.sketch_data = '__stored__';\n            migrated++;\n          } catch (e) {\n            console.warn('[migrateSketchPreviews] Auslagern fehlgeschlagen:', s.id, e);\n          }\n        }\n      }\n      if (migrated > 0) {\n        await setItems(KEYS.SKETCHES, sketches);\n        console.log(`[migrateSketchPreviews] ${migrated} Skizzen-Vorschauen ausgelagert`);\n      }\n      return migrated;\n    } catch (e) {\n      console.error('[migrateSketchPreviews] Fehler:', e);\n      return 0;\n    }\n  };\n  const SketchService = {\n    getAll: async () => {\n      return getItems(KEYS.SKETCHES);\n    },\n    getById: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const sketch = sketches.find(s => s.id === id) || null;\n      if (sketch && sketch.sketch_data === '__stored__') {\n        const prev = await AsyncStorage.default.getItem(`sketch_prev_${id}`).catch(() => null);\n        return {\n          ...sketch,\n          sketch_data: prev || undefined\n        };\n      }\n      return sketch;\n    },\n    getByProjectId: async projectId => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      return sketches.filter(s => s.project_id === projectId);\n    },\n    // Für Projekt-Export: Skizzen inkl. eingebetteter Bearbeitungsdaten\n    // (metadata + backgroundImage aus den optimierten Keys). Beim Import\n    // splittet create() die Daten automatisch wieder auf.\n    getByProjectIdWithData: async projectId => {\n      const sketches = await restoreSketchPreviews(await SketchService.getByProjectId(projectId));\n      return Promise.all(sketches.map(async s => {\n        try {\n          const {\n            metadata,\n            backgroundImage\n          } = await SketchService.loadSketchData(s.id);\n          if (metadata) {\n            const full = {\n              ...metadata\n            };\n            if (backgroundImage) full.backgroundImage = backgroundImage;\n            return {\n              ...s,\n              metadata: JSON.stringify(full)\n            };\n          }\n        } catch (e) {\n          console.warn('[SketchService] Export: Skizzen-Daten fehlen für', s.id, e);\n        }\n        return s;\n      }));\n    },\n    // ---- OPTIMIZED: Load heavy sketch data from separate storage keys ----\n    // This avoids parsing all sketches just to load one sketch's elements/background\n    loadSketchData: async id => {\n      try {\n        // Try loading from separate optimized keys first\n        const [metaStr, bgImage] = await Promise.all([AsyncStorage.default.getItem(`sketch_meta_${id}`), AsyncStorage.default.getItem(`sketch_bg_${id}`)]);\n        if (metaStr) {\n          // Found in optimized storage - parse with error handling\n          let metadata;\n          try {\n            metadata = JSON.parse(metaStr);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: bgImage\n            };\n          }\n\n          // Restore image URIs from separate storage if they were extracted\n          if (metadata.elements && Array.isArray(metadata.elements)) {\n            const imageElements = metadata.elements.filter(el => el.type === 'image' && el.data?.imageStorageKey);\n            if (imageElements.length > 0) {\n              const imageKeys = imageElements.map(el => el.data.imageStorageKey);\n              const imagePromises = imageKeys.map(key => AsyncStorage.default.getItem(key).catch(() => null));\n              const imageData = await Promise.all(imagePromises);\n              metadata.elements = metadata.elements.map(el => {\n                if (el.type === 'image' && el.data?.imageStorageKey) {\n                  const idx = imageKeys.indexOf(el.data.imageStorageKey);\n                  if (idx !== -1 && imageData[idx]) {\n                    return {\n                      ...el,\n                      data: {\n                        ...el.data,\n                        uri: imageData[idx]\n                      }\n                    };\n                  }\n                }\n                return el;\n              });\n            }\n          }\n          return {\n            metadata,\n            backgroundImage: bgImage\n          };\n        }\n\n        // Fallback: migrate from old format (metadata embedded in main array)\n        console.log(`[SketchService] Migrating sketch ${id} to optimized storage...`);\n        const sketch = await SketchService.getById(id);\n        if (sketch?.metadata) {\n          let metadata;\n          try {\n            metadata = JSON.parse(sketch.metadata);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse legacy metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: null\n            };\n          }\n          const bg = metadata.backgroundImage || null;\n\n          // Save to optimized keys (migration)\n          const metaWithoutBg = {\n            ...metadata\n          };\n          delete metaWithoutBg.backgroundImage;\n          await AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg));\n          if (bg) {\n            await AsyncStorage.default.setItem(`sketch_bg_${id}`, bg);\n          }\n\n          // Clean heavy data from main array to speed up future loads\n          const sketches = await getItems(KEYS.SKETCHES);\n          const index = sketches.findIndex(s => s.id === id);\n          if (index !== -1) {\n            // Keep only lightweight data + sketch_data (small preview) in the main array\n            delete sketches[index].metadata;\n            await setItems(KEYS.SKETCHES, sketches);\n          }\n          return {\n            metadata: metaWithoutBg,\n            backgroundImage: bg\n          };\n        }\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      } catch (error) {\n        console.error(`[SketchService] Error loading sketch data for ${id}:`, error);\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      }\n    },\n    // ---- OPTIMIZED: Save heavy data to separate keys ----\n    saveSketchData: async (id, metadata, backgroundImage) => {\n      try {\n        // Save metadata (without background image) to separate key\n        const metaWithoutBg = {\n          ...metadata\n        };\n        delete metaWithoutBg.backgroundImage;\n        const saveOps = [AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg))];\n\n        // Save background image to its own key\n        if (backgroundImage) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, backgroundImage));\n        } else {\n          // Remove old background if cleared\n          saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n        }\n        await Promise.all(saveOps);\n      } catch (error) {\n        console.error(`[SketchService] Error saving sketch data for ${id}:`, error);\n      }\n    },\n    create: async data => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const id = generateId();\n\n      // Extract heavy data before storing in main array\n      const heavyMetadata = data.metadata;\n      const lightSketch = {\n        ...data,\n        id,\n        metadata: undefined,\n        // Don't store metadata in main array\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [