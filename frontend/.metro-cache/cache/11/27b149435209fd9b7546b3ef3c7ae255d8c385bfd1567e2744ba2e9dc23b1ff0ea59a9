ingPdf(true);\n            const html = await generatePdfHtml();\n            setPdfHtmlContent(html);\n            setShowPdfPreviewModal(true);\n          } catch (error) {\n            console.error('Error generating preview:', error);\n            Alert.default.alert('Fehler', 'Vorschau konnte nicht erstellt werden.');\n          } finally {\n            setIsGeneratingPdf(false);\n          }\n        }\n      }, {\n        text: 'PDF teilen',\n        onPress: () => generateAndSharePdf()\n      }, {\n        text: 'In Dateien speichern',\n        onPress: () => generateAndSavePdf()\n      }, {\n        text: 'Abbrechen',\n        style: 'cancel'\n      }]);\n    };\n\n    // Generate and share PDF\n    const generateAndSharePdf = async () => {\n      try {\n        setIsGeneratingPdf(true);\n        const html = await generatePdfHtml();\n        const {\n          uri\n        } = await Print.printToFileAsync({\n          html,\n          base64: false\n        });\n\n        // Hide loader BEFORE opening share dialog to prevent stuck overlay\n        // Share dialog may not always resolve properly when user interacts with sub-dialogs (like Print)\n        setIsGeneratingPdf(false);\n        const canShare = await Sharing.isAvailableAsync();\n        if (canShare) {\n          await Sharing.shareAsync(uri, {\n            mimeType: 'application/pdf',\n            dialogTitle: `Aufmaß ${project?.name} teilen`,\n            UTI: 'com.adobe.pdf'\n          });\n        } else {\n          Alert.default.alert('Fehler', 'Teilen ist auf diesem Gerät nicht verfügbar.');\n        }\n      } catch (error) {\n        console.error('Error sharing PDF:', error);\n        Alert.default.alert('Fehler', 'PDF konnte nicht erstellt werden.');\n        setIsGeneratingPdf(false);\n      }\n    };\n\n    // Generate and save PDF to Files app\n    const generateAndSavePdf = async () => {\n      try {\n        setIsGeneratingPdf(true);\n        const html = await generatePdfHtml();\