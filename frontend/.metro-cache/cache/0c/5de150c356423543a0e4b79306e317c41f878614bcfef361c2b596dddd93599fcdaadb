ht}\" preserveAspectRatio=\"xMidYMid slice\">${svgPaths}</svg>`;\n            }\n          } catch (e) {\n            console.error('Error parsing photo annotations:', e);\n          }\n        }\n\n        // Erstes Foto bekommt \"Fotos\" als Hauptüberschrift\n        const photoHeading = index === 0 ? '<h2 class=\"photo-inline-heading\">Fotos</h2>' : '';\n        return `\n        <div class=\"photo-block\">\n          ${photoHeading}\n          <div class=\"photo-item ${sizeClass}\">\n            <div class=\"photo-wrapper\">\n              <img src=\"${photo.image_data}\" alt=\"Foto\" />\n              ${annotationSvg}\n            </div>\n            ${photo.description ? `<p>${photo.description}</p>` : ''}\n          </div>\n        </div>\n      `;\n      });\n\n      // Alle Fotos zusammen\n      const allPhotosHtml = photoItems.join('');\n      const photosHtml = photos.length > 0 ? `\n      <div class=\"photos-container\">\n        ${photoItems.join('')}\n      </div>\n    ` : '<p class=\"empty\">Keine Fotos erfasst</p>';\n\n      // Generate sketches HTML (embedded as base64/SVG) with size options\n      // Jede Skizze als eigener Block mit integrierter Überschrift (verhindert Trennung auf iPhone)\n      const sketchItems = sketches.map((sketch, index) => {\n        // Read pdf_size from sketch object or metadata\n        let size = sketch.pdf_size || 'large';\n        if (!size || size === 'large') {\n          // Try to read from metadata\n          try {\n            const metadata = sketch.metadata ? JSON.parse(sketch.metadata) : {};\n            if (metadata.pdf_size) {\n              size = metadata.pdf_size;\n            }\n          } catch (e) {}\n        }\n        let sizeClass = 'sketch-large';\n        if (size === 'small') sizeClass = 'sketch-small';\n        if (size === 'medium') sizeClass = 'sketch-medium';\n        if (size === 'full') sizeClass = 'sketch-full';\n\n        // Erste Skizze bekommt \"Skizzen\" als Hauptüberschrift, weitere