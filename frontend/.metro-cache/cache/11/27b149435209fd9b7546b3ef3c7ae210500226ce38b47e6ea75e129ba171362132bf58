ction\" style=\"margin-top: 30px;\">\n                  <h2>Bemerkungen</h2>\n                  <div class=\"remarks-box\">\n                    ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                  </div>\n                </div>\n              ` : ''}\n              <div class=\"footer\">\n                Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n              </div>\n            ` : ''}\n          </div>\n        ` : ''}\n        \n        ${sketches.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"sketches-section\">\n              <h2>Skizzen</h2>\n              ${sketchesHtml}\n            </div>\n            ${areaCalculations.length === 0 ? `\n              ${remarks || project?.remarks ? `\n                <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                  <h2>Bemerkungen</h2>\n                  <div class=\"remarks-box\">\n                    ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                  </div>\n                </div>\n              ` : ''}\n              <div class=\"footer\">\n                Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n              </div>\n            ` : ''}\n          </div>\n        ` : ''}\n        \n        ${areaCalculations.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"area-calcs-section\">\n              <h2>Flächenberechnungen</h2>\n              ${areaCalcsHtml}\n            </div>\n            ${remarks || project?.remarks ? `\n              <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                <h2>Bemerkungen</h2>\n                <div class=\"remarks-box\">\n                  ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                </div>\n              </div>\n            ` : ''}\n            <div class=\"footer\">\n              Erstellt mit AUFMASSPROFI DACH • ${fo