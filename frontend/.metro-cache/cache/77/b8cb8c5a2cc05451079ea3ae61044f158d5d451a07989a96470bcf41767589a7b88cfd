urn projects.filter(p => p.customer_id === customerId);\n    },\n    create: async data => {\n      const projects = await getItems(KEYS.PROJECTS);\n      // Auto-generate project number if not provided\n      const projectNumber = data.project_number || (await generateProjectNumber());\n      const newProject = {\n        ...data,\n        id: generateId(),\n        project_number: projectNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      projects.push(newProject);\n      await setItems(KEYS.PROJECTS, projects);\n      return newProject;\n    },\n    update: async (id, data) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const index = projects.findIndex(p => p.id === id);\n      if (index === -1) return null;\n      projects[index] = {\n        ...projects[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.PROJECTS, projects);\n      return projects[index];\n    },\n    delete: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const filtered = projects.filter(p => p.id !== id);\n      await setItems(KEYS.PROJECTS, filtered);\n      // Also delete related data\n      const sketches = await getItems(KEYS.SKETCHES);\n      const sketchesToDelete = sketches.filter(s => s.project_id === id);\n      await setItems(KEYS.SKETCHES, sketches.filter(s => s.project_id !== id));\n      // Clean up separate sketch data keys\n      const cleanupOps = [];\n      for (const sketch of sketchesToDelete) {\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_meta_${sketch.id}`));\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_bg_${sketch.id}`));\n        // Clean up separately stored image elements\n        try {\n          const metaStr = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (metaStr) {\n            const meta = JSON.parse(metaStr);\n            