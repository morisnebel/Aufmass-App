ectRatio > maxWidth / maxHeight) {\n          finalWidth = maxWidth;\n          finalHeight = maxWidth / aspectRatio;\n        } else {\n          finalHeight = maxHeight;\n          finalWidth = maxHeight * aspectRatio;\n        }\n        const newElement = {\n          id: generateId(),\n          type: 'image',\n          data: {\n            uri: base64Image\n          },\n          color: '#000000',\n          strokeWidth: 0,\n          x: 100,\n          y: 100,\n          width: finalWidth,\n          height: finalHeight,\n          rotation: 0\n        };\n        const newElements = [...elements, newElement];\n        addToHistory(newElements);\n        setSelectedElementId(newElement.id);\n        setPhotoEditMode(true);\n        selectDrawMode('select');\n        showAlert(t('common.success'), t('sketches.imageInserted'));\n      } catch (error) {\n        console.error('Error inserting image from URI:', error);\n        showAlert(t('common.error'), t('sketches.imageInsertError'));\n      }\n    };\n\n    // Take photo and insert on canvas\n    const takePhotoAndInsert = async () => {\n      try {\n        if (Platform.default.OS !== 'web') {\n          const {\n            status\n          } = await ImagePicker.requestCameraPermissionsAsync();\n          if (status !== 'granted') {\n            showAlert(t('sketches.cameraPermission'), t('sketches.cameraPermissionMessage'));\n            return;\n          }\n        }\n        const result = await ImagePicker.launchCameraAsync({\n          allowsEditing: false,\n          quality: 0.7\n        });\n        if (!result.canceled && result.assets[0]) {\n          const asset = result.assets[0];\n\n          // Bild auf max. 1200px Breite reduzieren (verhindert OOM auf iPad)\n          const manipResult = await ImageManipulator.manipulateAsync(asset.uri, [{\n            resize: {\n              width: Math.min(asset.width || 1200, 1200)\n            }\n          }], {\n            compress: 0.7,\n            format: ImageManipulator.SaveFormat.JPEG,\n            base64: true\n          });\n          if (!manipResult.base64) {\n            throw new Error('Could not generate base64');\n          }\n          const base64Image = `data:image/jpeg;base64,${manipResult.base64}`;\n\n          // Berechne korrektes Seitenverhältnis des Bildes\n          const imgWidth = manipResult.width || 250;\n          const imgHeight = manipResult.height || 250;\n          const maxWidth = 400;\n          const maxHeight = 300;\n          const aspectRatio = imgWidth / imgHeight;\n          let finalWidth, finalHeight;\n          if (aspectRatio > maxWidth / maxHeight) {\n            // Bild ist breiter - begrenzen durch Breite\n            finalWidth = maxWidth;\n            finalHeight = maxWidth / aspectRatio;\n          } else {\n            // Bild ist höher - begrenzen durch Höhe\n            finalHeight = maxHeight;\n            finalWidth = maxHeight * aspectRatio;\n          }\n          const newElement = {\n            id: generateId(),\n            type: 'image',\n            data: {\n              uri: base64Image\n            },\n            color: '#000000',\n            strokeWidth: 0,\n            x: 100,\n            y: 100,\n            width: finalWidth,\n            height: finalHeight,\n            rotation: 0\n          };\n          const newElements = [...elements, newElement];\n          addToHistory(newElements);\n          // Automatisch Foto-Bearbeiten Modus aktivieren\n          setSelectedElementId(newElement.id);\n          setPhotoEditMode(true);\n          selectDrawMode('select');\n        }\n      } catch (error) {\n        console.error('Error taking photo:', error);\n        showAlert(t('common.error'), t('sketches.photoTakeError'));\n      }\n    };\n\n    // Touch handlers\n    // Hilfsfunktion: Berechnet die Canvas-Koordinaten aus Touch-Event\n    // locationX/Y sind relativ zum inneren View (dem Canvas-Container)\n    // Bei einem gezoomten S