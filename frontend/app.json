{
  "expo": {
    "name": "Aufmassprofi",
    "slug": "frontend",
    "version": "1.1.22",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aufmassprofi.dach",
      "buildNumber": "132",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotos für Aufmaße und Skizzen aufnehmen",
        "NSContactsUsageDescription": "Kunden als Kontakte speichern",
        "NSPhotoLibraryUsageDescription": "Fotos in der Galerie speichern",
        "NSPhotoLibraryAddUsageDescription": "Aufmaß-Fotos in der Galerie speichern"
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.aufmassprofi.dach"
        ],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)com.aufmassprofi.dach"
      },
      "usesIcloudStorage": true
    },
    "android": {
      "package": "com.aufmassprofi.dach",
      "versionCode": 132,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "permissions": [
        "CAMERA",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "./plugins/withICloudConfig",
      "./plugins/withExcludeCloudKitAndroid",
      "./plugins/withExcludePdfThumbnailAndroid",
      "./plugins/withAndroidFullScreen",
      "./plugins/withAsyncStorageDbSize",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
