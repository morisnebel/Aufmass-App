italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 6px;\n            padding: 12px;\n            margin-top: 10px;\n          }\n          .footer {\n            margin-top: 30px;\n            padding-top: 15px;\n            border-top: 2px solid #1976d2;\n            font-size: 11px;\n            color: #666;\n            text-align: center;\n            font-weight: 500;\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 5px;\n            margin-top: 8px;\n          }\n          .measure-item {\n            font-size: 11px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 14px;\n            color: #1976d2;\n            margin-bottom: 5px;\n          }\n          .roof-notes {\n            margin-top: 8px;\n            padding-top: 8px;\n            border-top: 1px dashed #e0e0e0;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 15px;\n          }\n          .company-logo {\n            max-width: 180px;\n            max-height: 130px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${