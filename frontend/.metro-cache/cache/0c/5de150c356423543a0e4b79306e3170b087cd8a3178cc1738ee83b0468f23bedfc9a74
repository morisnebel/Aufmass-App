ore: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2px;\n            margin-top: 4px;\n          }\n          .measure-item {\n            font-size: 8px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 10px;\n            color: ${accentColor};\n            margin-bottom: 3px;\n          }\n          .roof-notes {\n            margin-top: 4px;\n            padding-top: 4px;\n            border-top: 1px dashed #e0e0e0;\n            font-size: 8px;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n          }\n          .company-logo {\n            max-width: 120px;\n            max-height: 80px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>Tel: ${companyPhone}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` :