    // Generate FULL SVG drawing for a calculation (large, with all details)\n      const generateFullCalcSvg = calc => {\n        const polygons = calc.polygons || [];\n        const calcLines = calc.lines || [];\n        const calcScale = calc.scale || 100;\n        const calcBackgroundImage = calc.backgroundImage || null;\n        if (polygons.length === 0) return '';\n\n        // Find bounding box\n        let minX = Infinity,\n          minY = Infinity,\n          maxX = -Infinity,\n          maxY = -Infinity;\n        polygons.forEach(p => {\n          p.points.forEach(pt => {\n            minX = Math.min(minX, pt.x);\n            minY = Math.min(minY, pt.y);\n            maxX = Math.max(maxX, pt.x);\n            maxY = Math.max(maxY, pt.y);\n          });\n        });\n        const padding = 50;\n        const width = maxX - minX + padding * 2;\n        const height = maxY - minY + padding * 2;\n\n        // Scale to fit on page - FULL WIDTH for printing (A4 minus margins ~700px)\n        const maxWidth = 700;\n        const scaleRatio = Math.min(maxWidth / width, 550 / height);\n        const svgWidth = width * scaleRatio;\n        const svgHeight = height * scaleRatio;\n        const transformPoint = pt => ({\n          x: (pt.x - minX + padding) * scaleRatio,\n          y: (pt.y - minY + padding) * scaleRatio\n        });\n\n        // Calculate areas for overlay\n        const mainAreas = polygons.filter(p => p.type === 'main');\n        const deductionAreas = polygons.filter(p => p.type === 'deduction');\n        const grossArea = mainAreas.reduce((sum, p) => sum + calculatePolygonArea(p.points, calcScale), 0);\n        const deductionsTotal = deductionAreas.reduce((sum, p) => sum + calculatePolygonArea(p.points, calcScale), 0);\n        const netArea = grossArea - deductionsTotal;\n        let svgContent = `<svg width=\"${svgWidth}\" height=\"${svgHeight}\" viewBox=\"0 0 ${svgWidth} ${svgHeight}\" style=\"background: #fff; border: 1px solid #ddd; bord