lder = sketches.some(s => sketchFolderOf(s));\n    const sortedSketches = anySketchFolder ? [...sketches].sort((a, b) => sketchFolderOf(a).localeCompare(sketchFolderOf(b))) : sketches;\n    const sketchItems = await Promise.all(sortedSketches.map(async (sketch, index) => {\n      // Read pdf_size and notes from sketch object or metadata\n      let size = sketch.pdf_size || 'large';\n      let sketchNotes = sketch.notes || '';\n      let pointerTexts = [];\n      let memoTexts = [];\n\n      // Metadata aus separatem Storage laden (zuverlässiger als sketch.metadata)\n      try {\n        let metadata = {};\n        const storedMeta = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n        if (storedMeta) {\n          metadata = JSON.parse(storedMeta);\n        } else if (sketch.metadata) {\n          metadata = typeof sketch.metadata === 'string' ? JSON.parse(sketch.metadata) : sketch.metadata;\n        }\n        if (!size || size === 'large') {\n          if (metadata.pdf_size) {\n            size = metadata.pdf_size;\n          }\n        }\n        // Notes aus metadata als Fallback\n        if (!sketchNotes && metadata.notes) {\n          sketchNotes = metadata.notes;\n        }\n        // Memo- und Pointer-Texte IMMER separat extrahieren (werden ZUSÄTZLICH zur Hauptnotiz angezeigt)\n        if (metadata.elements && Array.isArray(metadata.elements)) {\n          pointerTexts = metadata.elements.filter(el => el.type === 'pointer' && el.data?.text).map(el => el.data.text.trim()).filter(t => t.length > 0);\n          memoTexts = metadata.elements.filter(el => el.type === 'memo' && el.data?.text).map(el => el.data.text.trim()).filter(t => t.length > 0);\n        }\n      } catch (e) {\n        console.log('Error parsing sketch metadata:', e);\n      }\n\n      // Größenklasse basierend auf pdf_size - für alle Geräte gleich\n      let sizeClass = 'sketch-large'; // Default\n      if (size === 'small') sizeClass = 'sketch-small';else if (size === 'medium') sizeClass = 'sketch-medium';else if (size === 'full') sizeClass = 'sketch-full';else sizeClass = 'sketch-large';\n\n      // Titel für Skizze\n      const sketchTitle = sketch.title || `Skizze ${index + 1}`;\n\n      // Notizen gruppiert anzeigen: Hauptnotiz + Memo-Pfeil-Texte + Notiz-Texte (alle zusammen)\n      const noteParts = [];\n      if (sketchNotes.trim()) {\n        noteParts.push(`<span class=\"sketch-notes-label\">Notizen: </span><span class=\"sketch-notes-text\">${sketchNotes.replace(/\\n/g, '<br>')}</span>`);\n      }\n      if (pointerTexts.length > 0) {\n        noteParts.push(`<span class=\"sketch-notes-label\">${sketchLbl.pointerName}: </span><span class=\"sketch-notes-text\">${pointerTexts.join(' | ')}</span>`);\n      }\n      if (memoTexts.length > 0) {\n        noteParts.push(`<span class=\"sketch-notes-label\">${sketchLbl.memoName}: </span><span class=\"sketch-notes-text\">${memoTexts.join(' | ')}</span>`);\n      }\n      const notesHtml = noteParts.length > 0 ? `<div class=\"sketch-notes sketch-notes-filled\">${noteParts.join('<br>')}</div>` : '';\n\n      // Ordner-Überschrift einfügen, wenn ein neuer Ordner beginnt.\n      // WICHTIG: Überschrift wird INS Item eingebettet (page-break-inside: avoid),\n      // sonst trennt iOS die Überschrift von der Skizze auf verschiedene Seiten\n      // (page-break-after: avoid wird von iOS WebKit ignoriert).\n      const sketchFolder = sketchFolderOf(sketch);\n      const prevSketchFolder = index > 0 ? sketchFolderOf(sortedSketches[index - 1]) : null;\n      const folderHeading = anySketchFolder && sketchFolder !== prevSketchFolder ? `<div style=\"width: 100%; margin: 8px 0 4px 0; padding: 5px 10px; background: #f0f4f8; border-left: 4px solid #1976d2; border-radius: 4px; font-size: 11pt; font-weight: 700; color: #333; box-sizing: border-box;\">${sketchFolder || 'Ohne Ordner'}</div>` : '';\n      return `\n        <div class=\"sketch-item ${sizeClass}\">\n          ${index === 0 ? `<h2 class=\"sk