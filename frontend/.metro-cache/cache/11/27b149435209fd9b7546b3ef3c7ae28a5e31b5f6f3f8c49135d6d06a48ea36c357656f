th=\"1\"/>`;\n            svgContent += `<text x=\"${label.x + 2}\" y=\"${label.y + 2}\" font-size=\"9\" fill=\"${color}\">${memoText}</text>`;\n          });\n        }\n        svgContent += '</svg>';\n\n        // If there's a background image, show it ABOVE the drawing (not overlapping)\n        if (calcBackgroundImage) {\n          return `\n          <div>\n            <div style=\"display: flex; justify-content: flex-end; margin-bottom: 6px;\">\n              <div style=\"text-align: center;\">\n                <div style=\"font-size: 7px; color: #666; margin-bottom: 2px;\">Referenzbild</div>\n                <img src=\"${calcBackgroundImage}\" style=\"width: 80px; max-height: 60px; object-fit: contain; border-radius: 4px; border: 1px solid #ddd; background: #fff;\" />\n              </div>\n            </div>\n            <div>${svgContent}</div>\n          </div>\n        `;\n        }\n        return svgContent;\n      };\n\n      // Generate Area Calculations HTML - Compact details with two-column positions\n      const areaCalcsHtml = areaCalculations.length > 0 ? areaCalculations.map((calc, index) => {\n        const polygons = calc.polygons || [];\n        const calcLines = calc.lines || [];\n        const calcScale = calc.scale || 100;\n        const mainAreas = polygons.filter(p => p.type === 'main');\n        const deductionAreas = polygons.filter(p => p.type === 'deduction');\n        const grossArea = mainAreas.reduce((sum, p) => sum + calculatePolygonArea(p.points, calcScale), 0);\n        const deductionsTotal = deductionAreas.reduce((sum, p) => sum + calculatePolygonArea(p.points, calcScale), 0);\n        const netArea = grossArea - deductionsTotal;\n\n        // Group lines by category\n        const linesByCategory = {};\n        calcLines.forEach(line => {\n          const polygon = polygons.find(p => p.id === line.polygonId);\n          if (polygon && polygon.points && polygon.points.length > line.pointIndex) {\n            const point = polygon.points[line.pointIndex];\n            const nextPoint = polygon.points[(line.pointIndex + 1) % polygon.points.length];\n            const length = calculateLineLength(point, nextPoint, calcScale);\n            if (!linesByCategory[line.category]) linesByCategory[line.category] = 0;\n            linesByCategory[line.category] += length;\n          }\n        });\n        return `\n        <div style=\"margin-bottom: 12px; page-break-inside: avoid;\">\n          <!-- Header with name and result - more compact -->\n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 2px solid #4CAF50;\">\n            <span style=\"font-size: 12px; font-weight: bold;\">${calc.name || `Berechnung ${index + 1}`}</span>\n            <span style=\"font-size: 16px; font-weight: bold; color: #4CAF50;\">${netArea.toFixed(2)} m²</span>\n          </div>\n          \n          <!-- Drawing - Full width -->\n          <div style=\"text-align: center; margin-bottom: 8px;\">\n            ${generateFullCalcSvg(calc)}\n          </div>\n          \n          <!-- Compact calculation summary with frames -->\n          <div style=\"display: flex; gap: 8px; font-size: 9px; line-height: 1.3;\">\n            <!-- Rechenweg - framed -->\n            <div style=\"background: #f8f8f8; padding: 4px 6px; border-radius: 4px; border: 1px solid #e0e0e0; font-family: monospace; min-width: 100px;\">\n              <div style=\"font-size: 8px; color: #666; margin-bottom: 2px; font-weight: 600;\">Rechenweg:</div>\n              <div>Brutto: ${grossArea.toFixed(2)} m²</div>\n              ${deductionsTotal > 0 ? `<div>− Abzüge: ${deductionsTotal.toFixed(2)} m²</div>` : ''}\n              <div style=\"border-top: 1px solid #333; margin-top: 2px; padding-top: 2px; font-weight: bold;\">= ${netArea.toFixed(2)} m²</div>\n            </div>\n            \n            <!-- Flächen - framed -->\n            <div style=\"flex: 1; background: #f8f8f8; padding: 4px 6px; border-radius: 4px; border: 1px solid #e0e0e0;\">\n              ${mainAreas.length > 0 ? `\n                <div style=\"margin-bottom: 3px;\">\n                  <span style=\"font-weight: 600; color: #4CAF50; font-size: 8px;\">Grundflächen: </span>\n                  ${mainAreas.map(p => `<span style=\"margin-right: 6px;\">${p.name} +${calculatePolygonArea(p.points, calcScale).toFixed(2)}m²</span>`).join('')}\n                </div>\n              ` : ''}\n              ${deductionAreas.length > 0 ? `\n                <div>\n                  <span style=\"font-weight: 600; color: #f44336; font-size: 8px;\">Abzüge: </span>\n                  ${deductionAreas.map(p => `<span style=\"margin-right: 6px;\">${p.name} -${calculatePolygonArea(p.points, calcScale).toFixed(2)}m²</span>`).join('')}\n                </div>\n              ` : ''}\n            </div>\n            \n            <!-- Linien - framed, two columns -->\n            ${Object.keys(linesByCategory).length > 0 ? `\n              <div style=\"background: #f8f8f8; padding: 4px 6px; border-radius: 4px; border: 1px solid #e0e0e0; min-width: 180px;\">\n                <div style=\"font-weight: 600; color: #1976d2; font-size: 8px; margin-bottom: 2px;\">Linien:</div>\n                <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 2px 12px;\">\n                  ${Object.entries(linesByCategory).map(([cat, length]) => `\n                    <div style=\"display: flex; justify-content: space-between; font-size: 8px;\">\n                      <span style=\"display: flex; align-items: center;\">\n                        <span style=\"width: 5px; height: 5px; border-radius: 50%; background: ${getCategoryColor(cat)}; margin-right: 3px; display: inline-block;\"></span>\n                        ${cat}\n                      </span>\n                      <span style=\"margin-left: 4px;\">${length.toFixed(2)}m</span>\n                    </div>\n            