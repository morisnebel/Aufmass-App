ms: center;\n            justify-content: center;\n            background: #f5f5f5;\n            border-radius: 4px;\n            overflow: hidden;\n          }\n          .photo-iphone img {\n            width: 100%;\n            height: auto;\n            max-height: 200px;\n            object-fit: contain;\n          }\n          /* Photo sizes - iPad mit Flexbox */\n          .photo-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 400px;\n            object-fit: contain;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes - mit Flexbox */\n          .sketch-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n         