SON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = {\n            ...meta\n          };\n          delete metaWithoutBg.backgroundImage;\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          } else {\n            saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n          }\n        } catch (e) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return sketches[index];\n    },\n    delete: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const filtered = sketches.filter(s => s.id !== id);\n\n      // Delete main array entry + separate heavy data keys in parallel\n      await Promise.all([setItems(KEYS.SKETCHES, filtered), AsyncStorage.default.removeItem(`sketch_meta_${id}`), AsyncStorage.default.removeItem(`sketch_bg_${id}`)]);\n      return true;\n    },\n    // ---- BATCH MIGRATION: Move all embedded metadata to separate keys ----\n    // This should be called once on app startup to ensure the main sketches array is lightweight.\n    // After migration, loading the sketch list is fast because the heavy data is stored separately.\n    migrateAllSketches: async () => {\n      const MIGRATION_KEY = 'aufmassprofi_sketch_migration_done';\n      try {\n        // Check if migration already completed\n        const migrationDone = await AsyncStorage.default.getItem(MIGRATION_KEY);\n        if (migrationDone === 'true') {\n          console.log('[SketchService] Migration already completed, skipping.');\n          return;\n        }\n        console.log('[SketchService] Starting batch migration of sketches...');\n        const startTime = Date.now();\n        const sketches = await getItems(KEYS.SKETCHES);\n