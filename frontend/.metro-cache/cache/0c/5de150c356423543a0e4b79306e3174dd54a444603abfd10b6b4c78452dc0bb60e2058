       if (sketchesBySize.small.length > 0) {\n            sketchListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            sketchesBySize.small.forEach((html, idx) => {\n              // Bilder sollen Container füllen\n              const modifiedHtml = html.replace(/max-height:\\s*\\d+px;?/g, '').replace(/<img([^>]*)style=\"([^\"]*)\"/g, '<img$1style=\"width: 100%; height: auto; max-height: 280px; display: block; $2\"').replace(/<img(?![^>]*style)/g, '<img style=\"width: 100%; height: auto; max-height: 280px; display: block;\"');\n              sketchListHtml += `\n              <div style=\"display: inline-block; width: 32%; vertical-align: top; padding: 3px; box-sizing: border-box; font-size: 12px;\">\n                <div style=\"width: 100%;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n            sketchListHtml += `</div>`;\n          }\n\n          // Mittlere Skizzen: 2 nebeneinander (wie mittlere Fotos - 49% Breite)\n          if (sketchesBySize.medium.length > 0) {\n            sketchListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            sketchesBySize.medium.forEach((html, idx) => {\n              const modifiedHtml = html.replace(/max-height:\\s*\\d+px;?/g, '').replace(/<img([^>]*)style=\"([^\"]*)\"/g, '<img$1style=\"width: 100%; height: auto; max-height: 400px; display: block; $2\"').replace(/<img(?![^>]*style)/g, '<img style=\"width: 100%; height: auto; max-height: 400px; display: block;\"');\n              sketchListHtml += `\n              <div style=\"display: inline-block; width: 49%; vertical-align: top; padding: 3px; box-sizing: border-box; font-size: 12px;\">\n                <div style=\"width: 100%;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n            sketchListHtml += `</div>`;\n          }\n\n          // Große Skizzen: 1 pro Seite (volle Breite, pag