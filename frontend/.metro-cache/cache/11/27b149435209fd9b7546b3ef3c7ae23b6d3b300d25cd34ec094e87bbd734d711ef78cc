        ${objektContactPerson ? `<div style=\"margin-top: 6px;\"><strong>Ansprechpartner:</strong> ${objektContactPerson}</div>` : ''}\n                ${objektPhone ? `<div><strong>Tel:</strong> ${objektPhone}</div>` : ''}\n                ${objektEmail ? `<div><strong>E-Mail:</strong> ${objektEmail}</div>` : ''}\n              </div>\n            ` : ''}\n          </div>\n          \n          <div class=\"info-box\">\n            <h3>Bauherr</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${bauherrName}</span>\n            </div>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Adresse:</span>\n              <span class=\"info-value\">${bauherrStreet}<br/>${bauherrPlz} ${bauherrCity}</span>\n            </div>\n            ${bauherrPhone ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Telefon:</span>\n                <span class=\"info-value\">${bauherrPhone}</span>\n              </div>\n            ` : ''}\n            ${bauherrMobile ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Mobil:</span>\n                <span class=\"info-value\">${bauherrMobile}</span>\n              </div>\n            ` : ''}\n            ${bauherrEmail ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">E-Mail:</span>\n                <span class=\"info-value\">${bauherrEmail}</span>\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <div class=\"stats-grid\">\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${roofs.length}</div>\n            <div class=\"stat-label\">Dachflächen</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${pdfTotalArea.toFixed(2)} m²</div>\n            <div class=\"stat-label\">Gesamtfläche</div>\n      