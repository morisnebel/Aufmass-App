   }\n          .photo-small, .photo-medium, .photo-large, .photo-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .sketch-small, .sketch-medium, .sketch-large, .sketch-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 300px;\n            object-fit: contain;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-title {\n            margin: 0;\n            padding: 8px 10px;\n            font-size: 11px;\n            font-weight: 600;\n            color: ${accentColor};\n            background: #f0f4f8;\n            border-bottom: 1px solid ${accentColor};\n          }\n          .sketch-notes {\n            padding: 8px 10px;\n            background: #fafafa;\n            border-top: 1px solid #e0e0e0;\n          }\n          .sketch-notes-filled {\n            background: #fff8e1;\n            border-top: 1px solid #ffe082;\n          }\n          .sketch-notes-label {\n            font-size: 9px;\n            font-weight: 600;\n            color: #666;\n          }\n          .sketch-notes-text {\n            font-size: 9px;\n            color: #333;\n            line-height: 1.4;\n          }\n          .sketch-notes-lines {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n          }\n          .sketch-note-line {\n            height: 1px;\n            background: #ccc;\n            width: 100%;\n          }\n          .sketch-placeholder {\n            height: 150px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            color: #999;\n          }\n          .empty {\n            color: #999;\n            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 4px;\n            padding: 6px 8px;\n            margin-top: 5px;\n            font-size: 8px;\n          }\n          .footer {\n            margin-top: 5px;\n            padding: 3px 0;\n            border-top: 1px solid ${accentColor};\n            font-size: 6px;\n            color: #999;\n            text-align: center;\n            font-weight: 400;\n            page-break-inside: avoid;\n            page-break-before: avoid;\n            break-before: avoid;\n            break-inside: avoid;\n          }\n          /* Wrapper um den letzten Inhalt und Footer, um sie zusammenzuhalten */\n          .footer-container {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          /* Footer im Druck nur anzeigen wenn genug Platz - sonst verstecken */\n          @media print {\n            .footer {\n              /* Footer wird nur gedruckt wenn er auf die Seite passt */\n              orphans: 3;\n              widows: 3;\n            }\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2px;\n            margin-top: 4px;\n          }\n          .measure-item {\n            font-size: 8px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 10px;\n            color: ${accentColor};\n            margin-bottom: 3px;\n          }\n          .roof-notes {\n            margin-top: 4px;\n            padding-top: 4px;\n            border-top: 1px dashed #e0e0e0;\n            font-size: 8px;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n          }\n          .company-logo {\n            max-width: 120px;\n            max-height: 80px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>${t('pdf.phone')}: ${companyPhone}` : ''}\n                ${companyMobilePhone ? `<br/>${t('pdf.mobile')}: ${companyMobilePhone}` : ''}\n                ${companyFax ? `<br/>${t('pdf.fax')}: ${companyFax}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <h2>${t('pdf.projectOverview')}</h2>\n        <div class=\"info-grid\" style=\"display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 10px !important; width: 100% !important; max-width: none !important;\">\n          <div class=\"info-box\" style=\"width: 100% !important; box-sizing: border-box !important;\">\n            <h3>${t('pdf.project')}</h3>\n            ${project?.project_number ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">${t('projects.projectNumber')}:</span>\n                <span class=\"info-value\" style=\"color: #4caf50; font-weight: 600;\">${project.project_number}</span>\n              </div>\n            ` : ''}\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${project?.name || '-'}</span>\n            </div>\n            ${project?.description ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">${t('projects.description')}:</span>\n                <span class=\"info-value\">${project.description}</span>\n              </div>\n            ` : ''}\n            <div class=\"info-row\">\n              <span class=\"info-label\">${t('projects.status')}:</span>\n              <span class=\"info-value\">${project?.status === 'aktiv' ? t('projects.statusActive') : project?.status === 'abgeschlossen' ? t('projects.statusCompleted') : t('projects.statusCancelled')}</span>\n            </div>\n            ${objektStreet || objektPlz || objektCity || objektName || objektAddressName || objektContactPerson || objektPhone || objektEmail || objektNumber ? `\n              <div style=\"margin-top: 6px; padding-top: 4px; border-top: 1px solid #e0e0e0;\">\n                <h4 style=\"color: #1976d2; margin: 0 0 3px 0; font-size: 8px; border-bottom: 1px solid #e0e0e0; padding-bottom: 2px;\">\n                  ${t('projects.objectAddress')}${objektAddressName ? ` (${objektAddressName})