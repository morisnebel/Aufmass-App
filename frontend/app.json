{
  "expo": {
    "name": "Aufmassprofi Basic",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aufmassprofi.dach",
      "buildNumber": "38",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotos für Aufmaße und Skizzen aufnehmen",
        "NSContactsUsageDescription": "Kunden als Kontakte speichern",
        "NSPhotoLibraryUsageDescription": "Fotos in der Galerie speichern",
        "NSPhotoLibraryAddUsageDescription": "Aufmaß-Fotos in der Galerie speichern"
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.aufmassprofi.dach"
        ],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)com.aufmassprofi.dach"
      },
      "usesIcloudStorage": true
    },
    "android": {
      "package": "com.aufmassprofi.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "./plugins/withICloudConfig",
      "./plugins/withExcludeCloudKitAndroid",
      "./plugins/withAndroidFullScreen",
      "@react-native-community/datetimepicker",
      "expo-localization",
      ["expo-build-properties", {
        "android": {
          "AsyncStorage_db_size_in_MB": "500"
        }
      }],
      ["expo-image-picker", {
        "blockedPermissions": [
          "android.permission.READ_MEDIA_IMAGES",
          "android.permission.READ_MEDIA_VIDEO"
        ]
      }],
      ["expo-media-library", {
        "blockedPermissions": [
          "android.permission.READ_MEDIA_IMAGES",
          "android.permission.READ_MEDIA_VIDEO"
        ]
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "159413b4-c5be-4afa-9038-b6ba91a4ea1c"
      }
    },
    "owner": "morisnebel"
  }
}
