          padding-top: 4px;\n            border-top: 1px solid #90caf9;\n            font-size: 9px;\n            color: #1565c0;\n          }\n          .pdf-sum-badge {\n            background: #bbdefb;\n            padding: 2px 6px;\n            border-radius: 8px;\n            font-weight: 600;\n            margin-left: 4px;\n          }\n          .pdf-level1-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 6px;\n          }\n          .pdf-level1-container {\n            background: #fff;\n            border: 1px solid #e0e0e0;\n            border-left: 3px solid #1976d2;\n            border-radius: 4px;\n            padding: 6px;\n            box-sizing: border-box;\n          }\n          .pdf-level1-header {\n            display: flex;\n            align-items: center;\n            gap: 4px;\n            padding-bottom: 4px;\n            border-bottom: 1px solid #eee;\n            margin-bottom: 4px;\n          }\n          .pdf-level1-prefix {\n            background: #1976d2;\n            color: #fff;\n            font-size: 9px;\n            font-weight: 700;\n            padding: 1px 4px;\n            border-radius: 3px;\n          }\n          .pdf-checkmark-circle {\n            color: #4caf50;\n            font-size: 10px;\n          }\n          .pdf-level1-title {\n            font-size: 10px;\n            font-weight: 600;\n            color: #333;\n            flex: 1;\n          }\n          .pdf-level1-content {\n            padding-left: 2px;\n          }\n          .pdf-deep-sub {\n            display: flex;\n            align-items: center;\n            gap: 3px;\n            padding: 1px 0;\n          }\n          .pdf-deep-prefix {\n            font-size: 9px;\n            color: #666;\n            font-weight: 600;\n            min-width: 24px;\n          }\n          .pdf-checkmark {\n            color: #4caf50;\n            font-size: 9px;\n          }\n          .pdf-deep-text {\n            font-size: 9px;\n            color: #444;\n            flex: 1;\n          }\n          .pdf-note {\n            background: #fff8e1;\n            padding: 3px 5px;\n            border-radius: 3px;\n            font-size: 8px;\n            color: #f57c00;\n            font-style: italic;\n            margin-top: 2px;\n            margin-bottom: 2px;\n          }\n          .pdf-note-icon {\n            margin-right: 2px;\n          }\n          .pdf-measurement {\n            background: #e3f2fd;\n            padding: 3px 5px;\n            border-radius: 3px;\n            font-size: 8px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-top: 2px;\n            margin-bottom: 2px;\n          }\n          .photos-grid, .sketches-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n          }\n          /* Flexible photo/sketch containers */\n          .photos-container, .sketches-container {\n            display: block;\n          }\n          .photos-container::after, .sketches-container::after {\n            content: \"\";\n            display: table;\n            clear: both;\n          }\n          /* Photo sizes */\n          .photo-small {\n            width: calc(33.33% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .photo-medium {\n            width: calc(50% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .photo-large {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-full {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            displ