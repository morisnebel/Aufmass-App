console.error('[migrateDocumentImages] Error:', e);\n      }\n    })();\n    return docMigrationRunning;\n  };\n  const DocumentService = {\n    getAll: async () => {\n      return getItems(KEYS.DOCUMENTS);\n    },\n    getByProjectId: async projectId => {\n      const documents = await getItems(KEYS.DOCUMENTS);\n      return Promise.all(documents.filter(doc => doc.project_id === projectId).map(d => docRestoreImages(d)));\n    },\n    getById: async id => {\n      const documents = await getItems(KEYS.DOCUMENTS);\n      const found = documents.find(doc => doc.id === id);\n      return found ? docRestoreImages(found) : null;\n    },\n    create: async data => {\n      const documents = await getItems(KEYS.DOCUMENTS);\n      const ops = [];\n      const newDocument = {\n        ...docExtractImages(data, ops),\n        id: generateId(),\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      documents.push(newDocument);\n      await Promise.all([setItems(KEYS.DOCUMENTS, documents), ...ops]);\n      return newDocument;\n    },\n    update: async (id, data) => {\n      const documents = await getItems(KEYS.DOCUMENTS);\n      const index = documents.findIndex(doc => doc.id === id);\n      if (index !== -1) {\n        const ops = [];\n        const oldRefs = [];\n        docCollectRefs(documents[index], oldRefs);\n        documents[index] = {\n          ...documents[index],\n          ...docExtractImages(data, ops),\n          updated_at: new Date().toISOString()\n        };\n        const newRefs = [];\n        docCollectRefs(documents[index], newRefs);\n        const still = new Set(newRefs);\n        oldRefs.filter(k => !still.has(k)).forEach(k => AsyncStorage.default.removeItem(k).catch(() => {}));\n        await Promise.all([setItems(KEYS.DOCUMENTS, documents), ...ops]);\n        return documents[index];\n      }\n      return null;\n    },\n    updatePage: async (documentId, pageNumber, pageData) => {\n      const