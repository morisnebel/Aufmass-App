          tableHtml += '</table>';\n          }\n\n          // Große Fotos: 1 pro Reihe (volle Breite)\n          if (photosBySize.large.length > 0) {\n            tableHtml += `<table class=\"android-photo-table\" cellpadding=\"5\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; margin-bottom: 10px;\">`;\n            photosBySize.large.forEach(photo => {\n              tableHtml += `<tr><td style=\"width: 100%; vertical-align: top; padding: 5px;\">${generatePhotoHtml(photo)}</td></tr>`;\n            });\n            tableHtml += '</table>';\n          }\n          photosHtml = `<div class=\"${photosContainerClass}\">${tableHtml}</div>`;\n        } else {\n          // iOS/Web: Standard inline-block Layout\n          const firstPhotoHtml = generatePhotoHtml(photos[0]);\n          const restPhotoItems = photos.slice(1).map(photo => generatePhotoHtml(photo)).join('');\n          photosHtml = `<div class=\"${photosContainerClass}\" style=\"font-size: 0;\">${headingHtml}${firstPhotoHtml}${restPhotoItems}</div>`;\n        }\n      }\n\n      // Generate sketches HTML (embedded as base64/SVG) with size options\n      // iPhone: kleinere Skizzen (2 pro Seite) für bessere Kompatibilität\n      // iPad: normale Größe\n\n      const sketchItems = await Promise.all(sketches.map(async (sketch, index) => {\n        // Read pdf_size and notes from sketch object or metadata\n        let size = sketch.pdf_size || 'large';\n        let sketchNotes = sketch.notes || '';\n\n        // Metadata aus separatem Storage laden (zuverlässiger als sketch.metadata)\n        try {\n          let metadata = {};\n          const storedMeta = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (storedMeta) {\n            metadata = JSON.parse(storedMeta);\n          } else if (sketch.metadata) {\n            metadata = typeof sketch.metadata === 'string' ? JSON.parse(sketch.metadata) : sketch.metadata;\n          }\n          if (!size || size === 'large') {\n            if (metadata.pdf_size) {\n              size = metadata.pdf_size;\n            }\n          }\n          // Notes aus metadata als Fallback\n          if (!sketchNotes && metadata.notes) {\n            sketchNotes = metadata.notes;\n          }\n          // Memo-Elemente UND Pointer-Elemente: Text extrahieren (visuelle Notizen auf der Zeichenfläche)\n          if (!sketchNotes && metadata.elements && Array.isArray(metadata.elements)) {\n            const noteTexts = metadata.elements.filter(el => (el.type === 'memo' || el.type === 'pointer') && el.data?.text).map(el => el.data.text.trim()).filter(t => t.length > 0);\n            if (noteTexts.length > 0) {\n              sketchNotes = noteTexts.join(' | ');\n            }\n          }\n        } catch (e) {\n          console.log('Error parsing sketch metadata:', e);\n        }\n\n        // Größenklasse basierend auf pdf_size - für alle Geräte gleich\n        let sizeClass = 'sketch-large'; // Default\n        if (size === 'small') sizeClass = 'sketch-small';else if (size === 'medium') sizeClass = 'sketch-medium';else if (size === 'full') sizeClass = 'sketch-full';else sizeClass = 'sketch-large';\n\n        // Titel für Skizze\n        const sketchTitle = sketch.title || `Skizze ${index + 1}`;\n\n        // Notizen nur anzeigen wenn vorhanden - kompakt inline\n        const notesHtml = sketchNotes.trim() ? `<div class=\"sketch-notes sketch-notes-filled\">\n            <span class=\"sketch-notes-label\">Notizen: </span><span class=\"sketch-notes-text\">${sketchNotes.replace(/\\n/g, '<br>')}</span>\n          </div>` : '';\n        return `\n        <div class=\"sketch-item ${sizeClass}\">\n          ${index === 0 ? `<h2 class=\"sketch-inline-heading\">${t('sketches.title')}</h2>` : ''}\n          <p class=\"sketch-title\">${sketchTitle}</p>\n          ${sketch.sketch_data ? `<img src=\"${sketch.sketch_data}\" alt=\"Skizze\" />` : '<div class=\"sketch-placeholder\">Skizze</div>'}\n          ${note