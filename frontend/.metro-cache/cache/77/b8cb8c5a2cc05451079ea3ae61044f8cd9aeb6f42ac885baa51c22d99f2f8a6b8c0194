dateSyncTime();\n    }\n  };\n\n  // Generic CRUD operations using unified storage\n  const getItems = async key => {\n    try {\n      const data = await storage.getItem(key);\n      return data ? JSON.parse(data) : [];\n    } catch (error) {\n      console.error(`Error getting ${key}:`, error);\n      return [];\n    }\n  };\n\n  // Batch-read multiple keys in ONE native call (much faster than individual reads)\n  const getMultipleItems = async keys => {\n    try {\n      const startTime = Date.now();\n      const pairs = await AsyncStorage.default.multiGet(keys);\n      const result = new Map();\n      for (const [key, value] of pairs) {\n        try {\n          result.set(key, value ? JSON.parse(value) : []);\n        } catch (e) {\n          result.set(key, []);\n        }\n      }\n      console.log('[multiGet] Read', keys.length, 'keys in', Date.now() - startTime, 'ms');\n      return result;\n    } catch (error) {\n      console.error('Error in multiGet:', error);\n      // Fallback to individual reads\n      const result = new Map();\n      for (const key of keys) {\n        result.set(key, await getItems(key));\n      }\n      return result;\n    }\n  };\n\n  // Fast project data loader - reads ALL needed data in one native call\n  const loadAllProjectDataFast = async projectId => {\n    const startTime = Date.now();\n\n    // Read ALL keys in ONE native call\n    const allData = await getMultipleItems([KEYS.PROJECTS, KEYS.CUSTOMERS, KEYS.ROOFS, KEYS.PHOTOS, KEYS.SKETCHES, KEYS.CHECKLISTS, KEYS.DOCUMENTS, KEYS.AREA_CALCULATIONS, KEYS.SETTINGS, 'aufmassprofi_imagemeter_photos']);\n    const t1 = Date.now();\n\n    // Filter data for this project\n    const projects = allData.get(KEYS.PROJECTS) || [];\n    const project = projects.find(p => p.id === projectId) || null;\n    let customer = null;\n    if (project?.customer_id) {\n      const customers = allData.get(KEYS.CUSTOMERS) || [];\n      customer = customers.find(c => c.id === project.customer_id) || null;\n    }\n    const roofs = (allData.get(KEYS.ROOFS) || []).filter(r => r.project_id === projectId);\n    const photos = (allData.get(KEYS.PHOTOS) || []).filter(p => p.project_id === projectId);\n\n    // Bilddaten separat laden (neue Speicherstruktur: photo_img_${id})\n    if (photos.length > 0) {\n      const photoImageKeys = photos.map(p => `photo_img_${p.id}`);\n      try {\n        const photoImages = await AsyncStorage.default.multiGet(photoImageKeys);\n        for (let i = 0; i < photos.length; i++) {\n          const [, value] = photoImages[i];\n          if (value) {\n            photos[i].image_data = value;\n            photos[i].uri = value;\n          }\n          // Fallback: Wenn kein separates Bild, aber Inline-Daten vorhanden → OK (alte Fotos)\n        }\n      } catch (e) {\n        console.error('[loadAllProjectDataFast] Error loading photo images:', e);\n      }\n    }\n    const sketches = (allData.get(KEYS.SKETCHES) || []).filter(s => s.project_id === projectId);\n\n    // Skizzen-Notizen und pdf_size aus separatem Storage laden (sketch_meta_${id})\n    // Notizen werden dort gespeichert und sind möglicherweise nicht im Hauptobjekt vorhanden\n    if (sketches.length > 0) {\n      const sketchMetaKeys = sketches.map(s => `sketch_meta_${s.id}`);\n      try {\n        const sketchMetas = await AsyncStorage.default.multiGet(sketchMetaKeys);\n        for (let i = 0; i < sketches.length; i++) {\n          const [, metaStr] = sketchMetas[i];\n          if (metaStr) {\n            try {\n              const meta = JSON.parse(metaStr);\n              // Notizen aus metadata.notes übernehmen\n              if (meta.notes) {\n                sketches[i].notes = meta.notes;\n              }\n              // Memo-Elemente UND Pointer-Elemente: Text extrahieren (visuelle Notizen auf der Zeichenfläche)\n              if (!sketches[i].notes && meta.elements && Array.isArray(meta.elements)) {\n                const noteTexts = meta.elements.filter(el => (el