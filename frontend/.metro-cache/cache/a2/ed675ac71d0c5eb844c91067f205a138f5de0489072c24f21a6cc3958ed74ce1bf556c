n main array\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      sketches.push(lightSketch);\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = {\n            ...meta\n          };\n          delete metaWithoutBg.backgroundImage;\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          }\n        } catch (e) {\n          // If metadata isn't valid JSON, store as-is in separate key\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return {\n        ...lightSketch,\n        metadata: heavyMetadata\n      };\n    },\n    update: async (id, data) => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const index = sketches.findIndex(s => s.id === id);\n      if (index === -1) return null;\n\n      // Extract heavy data\n      const heavyMetadata = data.metadata;\n      const lightData = {\n        ...data\n      };\n      delete lightData.metadata; // Don't store metadata in main array\n\n      sketches[index] = {\n        ...sketches[index],\n        ...lightData,\n        updated_at: new Date().toISOString()\n      };\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = {\n            ...meta\n          };\n          delete metaWithoutBg.backgroundImage;\