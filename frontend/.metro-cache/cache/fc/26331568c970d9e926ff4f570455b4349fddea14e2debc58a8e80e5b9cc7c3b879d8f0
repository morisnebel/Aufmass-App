{"dependencies":[],"output":[{"data":{"code":"__d(function (global, require, _$$_IMPORT_DEFAULT, _$$_IMPORT_ALL, module, exports, _dependencyMap) {\n  \"use strict\";\n\n  Object.defineProperty(exports, '__esModule', {\n    value: true\n  });\n  Object.defineProperty(exports, \"QUICK_START\", {\n    enumerable: true,\n    get: function () {\n      return QUICK_START;\n    }\n  });\n  Object.defineProperty(exports, \"MANUAL\", {\n    enumerable: true,\n    get: function () {\n      return MANUAL;\n    }\n  });\n  Object.defineProperty(exports, \"getManual\", {\n    enumerable: true,\n    get: function () {\n      return getManual;\n    }\n  });\n  Object.defineProperty(exports, \"manualHtml\", {\n    enumerable: true,\n    get: function () {\n      return manualHtml;\n    }\n  });\n  // Bedienungsanleitung Aufmaßprofi – gemeinsame Inhalte für Hilfe-Seite und PDF\n\n  const QUICK_START = [{\n    title: 'Hinweise bestätigen',\n    text: 'Beim ersten Start die Hinweise lesen, Häkchen setzen und „App starten“ tippen.'\n  }, {\n    title: 'Firmendaten & Logo',\n    text: 'Einstellungen → Logo, Name und PDF-Einstellungen eintragen. Erscheinen später auf allen PDFs.'\n  }, {\n    title: 'Neues Projekt starten',\n    text: 'Auf der Startseite den großen blauen Button „Neues Projekt starten“ tippen, Namen eingeben, Kunde wählen oder neu anlegen, speichern.'\n  }, {\n    title: 'Aufmaß erfassen',\n    text: 'Im Projekt Skizzen zeichnen, Fotos aufnehmen und Checklisten ausfüllen'\n  }, {\n    title: 'Termin planen',\n    text: 'Startseite „+ Termin“ oder im Projekt „Termin planen“ – mit Erinnerung und Navi-Adresse.'\n  }, {\n    title: 'PDF erstellen & teilen',\n    text: 'Im Projekt „Projekt-PDF“ wählen und per Mail, WhatsApp oder in Dateien weitergeben.'\n  }, {\n    title: 'Daten sichern',\n    text: 'Regelmäßig unter Backup „Backup erstellen & teilen“ – alle Daten liegen nur auf deinem Gerät.'\n  }];\n  const MANUAL = [{\n    id: 'versionen',\n    icon: 'ribbon-outline',\n    color: '#d97706',\n    title: 'Basic und Pro – was ist enthalten?',\n    pro: true,\n    intro: 'Aufmaßprofi gibt es als Basic und als Pro. Mit „PRO“ markierte Kapitel und Schritte gibt es nur in der Pro-Version.',\n    steps: [{\n      text: 'Basic: Projekte, Kunden, Termine mit Erinnerungen, Skizzen mit Flächenberechnung, Fotos mit Beschriftung, Checklisten, Projekt-PDF und Backup.'\n    }, {\n      text: 'Checklisten in Basic: bis zu 3 Vorlagen, 10 Hauptpunkte und 5 Unterpunkte je Checkliste.',\n      info: 'In Pro sind Vorlagen und Punkte unbegrenzt. Dazu kommen verschachtelte Unterpunkte, Logos, Druckbild, Vorschau, Verknüpfungen, Berechnungen und Import/Export von Vorlagen.'\n    }, {\n      text: 'Pro zusätzlich: Dach-Aufmaß, Flächen-Kalkulator, Fotomessung, Dokumente, Rapporte mit Mitarbeitern, Material und Maschinen, Referenzen sowie Projekte exportieren, importieren und verschieben.',\n      pro: true\n    }, {\n      text: 'In dieser Anleitung sind Pro-Funktionen mit „PRO“ gekennzeichnet.',\n      info: 'Deine bisherigen Daten bleiben beim Wechsel von Basic auf Pro vollständig erhalten.'\n    }]\n  }, {\n    id: 'start',\n    icon: 'home-outline',\n    color: '#1565c0',\n    title: 'Die Startseite',\n    intro: 'Dein Überblick über Projekte, Termine und schnelle Aktionen.',\n    steps: [{\n      text: 'Oben: Suche (Lupe), Backup (Wolke) und Profil/Einstellungen.'\n    }, {\n      text: '„Neues Projekt starten“ ist der wichtigste Einstieg – hier beginnt jedes Aufmaß.'\n    }, {\n      text: 'Darunter: „Kunde anlegen“ und „Checklisten“ als Schnellaktionen.'\n    }, {\n      text: '„Heute“ zeigt die Termine des Tages, „Nächste 7 Tage“ die kommende Woche. „Kalender“ öffnet die Monatsansicht.',\n      info: 'Tippe einen Termin an, um ihn zu bearbeiten. Das Navi-Symbol neben der Adresse startet die Navigation.'\n    }, {\n      text: 'Zahlen-Kacheln zeigen, wie viele Projekte in Anfrage, Angebot, Ausführung oder fertig sind.'\n    }, {\n      text: 'Ordner und „Letzte Projekte“ führen direkt in deine Arbeit.'\n    }, {\n      text: 'Nach unten ziehen aktualisiert die Startseite.'\n    }],\n    tips: ['Ein gelber Hinweis erinnert dich an ein fälliges Backup – mit „Sichern“ geht es sofort, mit X wird er 24 Std. ausgeblendet.']\n  }, {\n    id: 'kunden',\n    icon: 'people-outline',\n    color: '#0284c7',\n    title: 'Kunden anlegen',\n    intro: 'Kunden einmal anlegen und in Projekten und Terminen wiederverwenden.',\n    steps: [{\n      text: 'Startseite → „Kunde anlegen“ oder Kunden → „+“.'\n    }, {\n      text: 'Kundentyp, Anrede, Vor- und Nachname (Pflicht), Adresse, Telefon und E-Mail eintragen.',\n      info: 'Die Kundennummer (z. B. KD-26001) wird automatisch vergeben, wenn du das Feld leer lässt.'\n    }, {\n      text: 'Alternativ „Aus Kontakten importieren“ – übernimmt Name, Telefon und Adresse aus deinem Telefonbuch.',\n      info: 'Die App fragt einmalig nach Zugriff auf deine Kontakte. Ohne Erlaubnis kannst du alles manuell eintragen.'\n    }, {\n      text: '„Kunde erstellen“ speichert.'\n    }]\n  }, {\n    id: 'projekte',\n    icon: 'folder-open-outline',\n    color: '#2e7d32',\n    title: 'Projekte',\n    intro: 'Ein Projekt bündelt alles zu einer Baustelle: Skizzen, Fotos, Dachflächen, Checklisten, Rapporte und Dokumente.',\n    steps: [{\n      text: '„Neues Projekt starten“ tippen und einen Projektnamen eingeben (z. B. „Dachsanierung Hauptstraße“).'\n    }, {\n      text: 'Kunde auswählen oder direkt neu anlegen.'\n    }, {\n      text: 'Objektadresse eintragen, wenn die Baustelle nicht an der Kundenadresse liegt.',\n      info: 'Die Objektadresse kannst du beim Kunden speichern und später wieder auswählen (z. B. „Garage“, „Ferienhaus“).'\n    }, {\n      text: 'Speichern – das Projekt öffnet sich in den Projektdetails.'\n    }, {\n      text: 'Status setzen (Anfrage, Angebot, Ausführung, Fertig), damit die Startseite den Überblick behält.'\n    }, {\n      text: 'Projekte in Ordner sortieren: in der Projektliste ein Projekt gedrückt halten und auf einen Ordner ziehen.',\n      info: 'Ordner legst du in der Projektliste an. „Ohne Ordner“ zeigt alle noch nicht sortierten Projekte.'\n    }, {\n      text: 'Dokumente (z. B. Pläne, Angebote als PDF) im Projekt unter „Dokumente“ ablegen.',\n      pro: true\n    }],\n    tips: ['Fertige Projekte archivieren hält die Liste übersichtlich – Archiv findest du in den Einstellungen.', 'Gelöschtes landet zuerst im Papierkorb und kann wiederhergestellt werden.']\n  }, {\n    id: 'skizzen',\n    icon: 'create-outline',\n    color: '#7b1fa2',\n    title: 'Skizzen zeichnen',\n    intro: 'Grundrisse, Ansichten und Dachskizzen mit echten Maßen direkt auf dem Handy oder Tablet zeichnen.',\n    steps: [{\n      text: 'Im Projekt „Skizze“ → neue Skizze anlegen und oben einen Titel vergeben (z. B. „EG Grundriss“).'\n    }, {\n      text: 'Werkzeugleiste: Stift (frei), Linie, Rechteck, Kreis, Polygon (Fläche aus Punkten), Maßlinie, Text und Foto. Auf dem Handy die Leiste seitlich wischen.',\n      info: 'Das aktive Werkzeug ist farbig hervorgehoben. Unter Einstellungen → „Skizzen-Werkzeuge benennen“ kannst du die Namen an deine Begriffe anpassen.'\n    }, {\n      text: 'Linie zeichnen: Werkzeug „Linie“ wählen, Finger am Startpunkt aufsetzen und zum Endpunkt ziehen.',\n      info: 'Mit „Winkel“ rasten Linien in festen Winkelschritten ein (z. B. 90°, 45°). Das Raster hilft zusätzlich, sauber gerade zu zeichnen.'\n    }, {\n      text: 'Maße eintragen: Linie oder Grundriss-Seite antippen → „Maß eingeben“ und die echte Länge eintragen (z. B. 4,50 m). Das Maß wird an der Linie angezeigt – die gezeichnete Länge ändert sich dabei nicht.',\n      info: 'Du kannst m, cm oder mm eingeben. Über „Winkel anpassen“ lässt sich der Winkel einer Linie exakt setzen.'\n    }, {\n      text: 'Maßlinie: zeigt einen Abstand mit Pfeilspitzen an, ohne die Zeichnung zu verändern – ideal für Fenster, Türen oder Abstände.'\n    }, {\n      text: 'Flächen (m²): Raum mit dem Grundriss-Werkzeug Ecke für Ecke zeichnen und mit „Schließen“ abschließen. Dann jede Seite antippen und ihr Maß eintragen.',\n      info: 'Die m² werden erst berechnet, wenn der Grundriss geschlossen ist und ALLE Seiten ein Maß haben – aus deinen Maßen, nicht aus der gezeichneten Größe. Rechtecke, Kreise und freie Linien bekommen keine m²-Berechnung. Mit „+Pkt“ / „-Pkt“ fügst du Ecken hinzu oder entfernst sie.'\n    }, {\n      text: 'Raumname: Fläche antippen und umbenennen, z. B. „Wohnzimmer“. Name und m² erscheinen direkt im Grundriss.',\n      info: 'Die m² werden automatisch angezeigt (über das Auge im Maß-Fenster ausblendbar). Unter der Skizze steht im PDF eine Flächenliste mit Umfang und Fläche plus Gesamtsumme (mit Wandhöhen heißt sie Raumliste).'\n    }, {\n      text: 'Text & Notizen: Mit „Text“ Beschriftungen setzen (Schriftart, Größe, Farbe wählbar). „Notizen zur Skizze“ speichert Hinweise, die nicht in der Zeichnung stehen sollen.'\n    }, {\n      text: 'Bearbeiten: Element antippen → verschieben, „Stil ändern“ (Farbe, Strichstärke) oder „Element löschen“. „Alles löschen“ leert die Seite nach Rückfrage.'\n    }, {\n      text: 'Fotos einfügen: „Foto“ → Kamera, Galerie, Dateien oder Projektfoto. Das Foto wird auf Seitenbreite skaliert und kann zugeschnitten werden.'\n    }, {\n      text: 'Raster: Größe (klein/groß) und Sichtbarkeit (schwach/stark) einstellen.'\n    }, {\n      text: 'Zoom an/aus: Grün = Zoom aktiv, dann mit zwei Fingern vergrößern und verschieben. Rot = Zoom aus, damit beim Zeichnen nichts verrutscht.'\n    }, {\n      text: 'Vor-Zurück: Rückgängig und Wiederholen für die letzten Schritte.'\n    }, {\n      text: 'Speichern mit dem Haken oben rechts – die Skizze erscheint im Projekt und im Projekt-PDF.'\n    }],\n    tips: ['Erst grob zeichnen, dann Maße eintragen – das geht schneller als exakt zu zeichnen.', 'Für große Grundrisse lieber mehrere Skizzen (z. B. pro Etage) anlegen – das bleibt übersichtlich und schnell.']\n  }, {\n    id: 'fotos',\n    icon: 'camera-outline',\n    color: '#f57c00',\n    title: 'Fotos & Fotomessung',\n    intro: 'Baustellenfotos aufnehmen, beschriften und Maße direkt im Foto messen.',\n    steps: [{\n      text: 'Im Projekt „Fotos“ → Kamera oder Galerie wählen.',\n      info: 'Kamera- und Fotozugriff wird erst beim ersten Tippen erfragt. Bei Ablehnung kannst du die Erlaubnis über „Einstellungen öffnen“ nachträglich erteilen.'\n    }, {\n      text: 'Foto antippen → bearbeiten: Pfeile, Texte, Linien und Flächen einzeichnen.'\n    }, {\n      text: 'Fotomessung: Referenz setzen (bekannte Länge, z. B. Ziegel oder Zollstock), dann weitere Strecken messen.',\n      pro: true,\n      info: 'Je genauer die Referenz, desto genauer die Messung. Fotomessung ersetzt kein exaktes Aufmaß.'\n    }, {\n      text: 'Das erste Projektfoto dient als Vorschaubild in der Projektliste.'\n    }]\n  }, {\n    id: 'dach',\n    icon: 'triangle-outline',\n    color: '#dc2626',\n    title: 'Dachflächen & Flächen-Kalkulator',\n    pro: true,\n    intro: 'Dachflächen aus Gebäudemaßen und Neigung berechnen.',\n    steps: [{\n      text: 'Im Projekt „Dach-Aufmaß“ → Dachtyp wählen (z. B. Satteldach, Walmdach, Pultdach).'\n    }, {\n      text: 'Gebäudebreite, -länge und Dachneigung in Grad eintragen, optional Dachüberstände.'\n    }, {\n      text: 'Die App zeigt Dachfläche und Firsthöhe sofort an.'\n    }, {\n      text: 'Flächen-Kalkulator: beliebige Flächen mit Abzügen (z. B. Fenster, Gauben) berechnen – Ergebnis ist die Netto-Fläche.'\n    }],\n    tips: ['Alle Berechnungen dienen als Unterstützung – bitte vor der Verwendung selbst prüfen.']\n  }, {\n    id: 'checklisten',\n    icon: 'checkbox-outline',\n    color: '#7c3aed',\n    title: 'Checklisten',\n    intro: 'Wiederkehrende Prüfungen und Abnahmen mit Vorlagen erledigen.',\n    steps: [{\n      text: 'Startseite → „Checklisten“ zeigt deine Vorlagen.'\n    }, {\n      text: 'Vorlage bearbeiten oder neu anlegen: Punkte und Kategorien festlegen.',\n      info: 'In der Basic-Version: bis zu 3 Vorlagen, 10 Hauptpunkte und 5 Unterpunkte je Checkliste.'\n    }, {\n      text: 'Logo, Druckbild, Vorschau, Berechnungen und Verknüpfungen in Vorlagen nutzen sowie Vorlagen importieren/exportieren.',\n      pro: true\n    }, {\n      text: 'Im Projekt „Checkliste“ → Vorlage wählen und Punkt für Punkt abhaken, Fotos und Notizen ergänzen.'\n    }, {\n      text: 'Fertige Checklisten erscheinen im Projekt-PDF oder lassen sich einzeln exportieren.'\n    }]\n  }, {\n    id: 'termine',\n    icon: 'calendar-outline',\n    color: '#dc2626',\n    title: 'Termine & Erinnerungen',\n    intro: 'Baustellentermine planen und rechtzeitig erinnert werden.',\n    steps: [{\n      text: 'Startseite „+ Termin“ oder im Projekt „Termin planen“.'\n    }, {\n      text: 'Optional ein Projekt wählen, Titel eingeben, Datum (Heute/Morgen/Übermorgen oder Kalender) und Uhrzeit setzen.'\n    }, {\n      text: 'Notiz eintragen, z. B. „Kunde vorher anrufen“.'\n    }, {\n      text: '„Mitnehmen“: Checkliste, was du zum Termin brauchst – eigene Einträge tippen oder Vorschläge wie Leiter, Zollstock antippen. Abhaken, sobald eingepackt.',\n      info: 'Deine eigenen Einträge merkt sich die App als Vorschlag. Was noch nicht abgehakt ist, steht auch in der Erinnerung. Auf der Startseite zeigt ein Taschen-Symbol, wie viel schon eingepackt ist (z. B. 2/5) – antippen klappt die Liste zum direkten Abhaken auf.'\n    }, {\n      text: 'Mitnehmen-Vorlagen: Lila Knöpfe wie „Dach-Aufmaß“ oder „Abnahme“ übernehmen eine ganze Liste mit einem Tipp. „Liste als Vorlage speichern“ legt eigene Vorlagen an.',\n      info: 'Gleicher Name überschreibt eine Vorlage. Lange auf eine Vorlage drücken löscht sie.'\n    }, {\n      text: 'Adresse fürs Navi eintragen, über „Kunden“ übernehmen oder über „Telefonbuch“ einen Kontakt wählen – wahlweise als Kunde speichern oder nur im Termin merken.'\n    }, {\n      text: '„Erinnerung vor dem Termin“: 15 Min bis 1 Tag vorher oder „Eigene Zeit“ mit Kalender und Uhrzeit.',\n      info: 'Erinnerungen kommen als Mitteilung aufs Handy – auch wenn die App geschlossen ist. Die App fragt dafür einmalig um Erlaubnis.'\n    }, {\n      text: '„Fahrzeit“: Die App erinnert dich rechtzeitig zum Losfahren (Fahrzeit + 10 Min Puffer) – oder du wählst mit „Abfahrt wählen“ eine feste Zeit.'\n    }, {\n      text: 'Adresse antippen → Apple Karten, Google Maps oder Waze wählen.'\n    }, {\n      text: 'Aus einem Termin ohne Projekt kannst du mit „Projekt erstellen“ direkt ein Projekt machen – Kunde und Adresse werden übernommen.'\n    }],\n    tips: ['Die Monatsansicht findest du über „Kalender“ auf der Startseite.']\n  }, {\n    id: 'rapporte',\n    icon: 'document-text-outline',\n    color: '#0891b2',\n    title: 'Rapporte, Material & Mitarbeiter',\n    pro: true,\n    intro: 'Arbeitszeiten, Fahrten und Material zu einem Projekt erfassen.',\n    steps: [{\n      text: 'Im Projekt „Rapport“ anlegen: Datum, Mitarbeiter, Stunden und Fahrzeiten eintragen.'\n    }, {\n      text: 'Material aus der Materialliste oder aus Checklisten übernehmen.'\n    }, {\n      text: 'Briefkopf-Felder am Ende des Editors festlegen – „Als Standard speichern“ merkt die Auswahl.'\n    }, {\n      text: 'Mitarbeiter, Material und Maschinen pflegst du über die Kacheln der Startseite.',\n      info: 'Bei Maschinen kannst du TÜV-Termine hinterlegen – die Startseite erinnert dich rechtzeitig.'\n    }]\n  }, {\n    id: 'pdf',\n    icon: 'share-outline',\n    color: '#1d4ed8',\n    title: 'PDF & Weitergeben',\n    intro: 'Aus jedem Projekt ein sauberes PDF mit deinem Logo erstellen.',\n    steps: [{\n      text: 'Im Projekt „Projekt-PDF“ tippen und Inhalte auswählen (Skizzen, Fotos, Flächen, Checklisten …).'\n    }, {\n      text: 'Teilen per Mail, WhatsApp, AirDrop oder in „Dateien“ speichern.'\n    }, {\n      text: 'Logo, Firmendaten und Layout stellst du unter Einstellungen → PDF-Einstellungen ein.'\n    }, {\n      text: '„Projekt exportieren“ erstellt eine Datei, die ein Kollege mit Aufmaßprofi Pro importieren kann.',\n      pro: true\n    }, {\n      text: 'Referenzen: abgeschlossene Projekte mit Beispielfotos sammeln und Kunden zeigen.',\n      pro: true\n    }]\n  }, {\n    id: 'backup',\n    icon: 'cloud-upload-outline',\n    color: '#0891b2',\n    title: 'Datensicherung',\n    intro: 'Alle Daten liegen ausschließlich auf deinem Gerät – sichere sie regelmäßig.',\n    steps: [{\n      text: 'Backup → „Backup erstellen & teilen“ und die Datei z. B. in iCloud Drive, Google Drive oder per Mail sichern.'\n    }, {\n      text: 'Automatisches Backup und Erinnerung an neue Backups lassen sich dort einschalten.'\n    }, {\n      text: 'Wiederherstellen: „Aus Datei wiederherstellen“ und die Backup-Datei auswählen.',\n      info: 'Beim Wiederherstellen werden die aktuellen Daten durch den Stand der Sicherung ersetzt.'\n    }, {\n      text: 'Speicher-Bereinigung (Einstellungen) entfernt nicht mehr benötigte Daten und schafft Platz.'\n    }],\n    tips: ['Vor einem Handywechsel immer ein Backup erstellen und auf dem neuen Gerät wiederherstellen.']\n  }, {\n    id: 'einstellungen',\n    icon: 'settings-outline',\n    color: '#546e7a',\n    title: 'Einstellungen',\n    intro: 'App an deinen Betrieb anpassen.',\n    steps: [{\n      text: 'Sprache, Logo, PDF-Layout, Projekttypen und Werkzeugnamen anpassen.'\n    }, {\n      text: 'Archiv und Papierkorb verwalten.'\n    }, {\n      text: 'Pro-Version: Dach-Aufmaß, Fotomessung, Rapporte, Mitarbeiter, Material und weitere Funktionen.',\n      pro: true\n    }, {\n      text: 'Rechtliches: Datenschutz, Haftungsausschluss und Impressum.'\n    }]\n  }];\n\n  // Basic: Pro-Kapitel und -Schritte ausblenden\n  const getManual = isPro => isPro ? MANUAL : MANUAL.filter(sec => !sec.pro).map(sec => ({\n    ...sec,\n    steps: sec.steps.filter(st => !st.pro)\n  }));\n  const esc = t => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const PRO = '<span class=\"pro\">PRO</span>';\n\n  // HTML für das PDF (Kurzanleitung + ausführliche Anleitung inkl. aller Erklärungen)\n  const manualHtml = (isPro = false) => `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n  .pro { display: inline-block; background: #d97706; color: #fff; font-size: 9px; font-weight: 800; border-radius: 4px; padding: 1px 5px; margin-left: 6px; vertical-align: middle; }\n  body { font-family: -apple-system, Helvetica, Arial, sans-serif; color: #0f172a; font-size: 12px; line-height: 1.45; }\n  h1 { color: #1565c0; font-size: 26px; margin: 0 0 4px; } .sub { color: #475569; margin-bottom: 18px; }\n  h2 { font-size: 17px; margin: 22px 0 6px; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; page-break-after: avoid; }\n  .quick { background: #eff6ff; border-radius: 10px; padding: 12px 16px; page-break-inside: avoid; }\n  .quick ol { margin: 6px 0 0 18px; padding: 0; } .quick li { margin-bottom: 5px; }\n  .intro { color: #475569; margin-bottom: 6px; } ol.steps { margin: 0 0 0 18px; padding: 0; } ol.steps li { margin-bottom: 6px; }\n  .info { background: #f1f5f9; border-left: 3px solid #1976d2; padding: 5px 8px; margin-top: 4px; color: #334155; font-size: 11px; }\n  .tip { background: #fff7e6; border-left: 3px solid #d97706; padding: 5px 8px; margin-top: 6px; font-size: 11px; }\n  section { page-break-inside: avoid; } .foot { margin-top: 24px; color: #64748b; font-size: 10px; }\n</style></head><body>\n<h1>Aufmaßprofi – Bedienungsanleitung</h1>\n<div class=\"sub\">Die App für digitales Aufmaß · Schritt für Schritt erklärt · ${isPro ? `Deine Version: Pro. Mit ${PRO} markierte Funktionen gibt es nur in der Pro-Version.` : ''}</div>\n<div class=\"quick\"><b>Kurzanleitung – in 7 Schritten startklar</b><ol>\n${QUICK_START.map(q => `<li><b>${esc(q.title)}:</b> ${esc(q.text)}</li>`).join('')}\n</ol></div>\n${getManual(isPro).map(sec => `<section><h2>${esc(sec.title)}${sec.pro ? PRO : ''}</h2><div class=\"intro\">${esc(sec.i