  // Überschrift aus dem Item entfernen\n            const cleanHtml = itemHtml.replace(/<h2 class=\"sketch-inline-heading\">[^<]*<\\/h2>/g, '');\n\n            // small wird zu medium gemappt (falls alte Daten vorhanden)\n            if (size === 'small' || size === 'medium') sketchesBySize.medium.push(cleanHtml);else sketchesBySize.large.push(cleanHtml);\n          });\n\n          // Überschrift wird mit der ersten Skizze zusammen in einen Container gepackt\n          // um Seitenumbrüche zwischen Überschrift und erster Skizze zu verhindern\n          let sketchListHtml = '';\n          let isFirstSketchRendered = false;\n\n          // 66% Skizzen: 2 nebeneinander, je ca. 48% Breite (mit Abstand = 100%)\n          if (sketchesBySize.medium.length > 0) {\n            // Wenn medium-Skizzen zuerst kommen, Überschrift + erste Skizzen zusammen wrappen\n            if (!isFirstSketchRendered) {\n              sketchListHtml += `<div style=\"page-break-inside:avoid!important;break-inside:avoid!important;\">`;\n              sketchListHtml += headingHtml;\n              isFirstSketchRendered = true;\n            }\n            sketchListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            sketchesBySize.medium.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html\n              // Entferne alle style-Attribute von img\n              .replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>')\n              // Setze neue styles für img - volle Breite erzwingen, max-height begrenzt\n              .replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:300px!important;object-fit:contain!important;\"')\n              // Auch das sketch-item div anpassen\n              .replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item\" style=\"width:100%!important;\"');\n              sketchListHtml += `\n              <div style=\"display:inline-block;width:48%;vertical-align:top;padding:4px;box-sizing:border-box;font-size:12px;\">\n                <div style=\"width:100%;border:1px solid #ddd;padding:5px;box-sizing:border-box;overflow:hidden;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n            sketchListHtml += `</div>`;\n            // Schließe den page-break-avoid Container nach den medium Skizzen\n            sketchListHtml += `</div>`;\n          }\n\n          // 100% Skizzen: Volle Breite - ZWEI übereinander pro Seite\n          if (sketchesBySize.large.length > 0) {\n            sketchesBySize.large.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html.replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>').replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:440px!important;object-fit:contain!important;image-rendering:crisp-edges!important;\"').replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item sketch-large\" style=\"width:100%!important;\"');\n\n              // Wenn dies die erste Skizze überhaupt ist (keine medium Skizzen vorhanden)\n              // dann Überschrift + erste große Skizze zusammen wrappen\n              if (!isFirstSketchRendered && idx === 0) {\n                sketchListHtml += `\n                <div style=\"page-break-inside:avoid!important;break-inside:avoid!important;\">\n                  ${headingHtml}\n                  <div style=\"display:block;width:100%;padding:0;box-sizing:border-box;margin-bottom:0;\">\n                    <div style=\"width:100%;border:1px solid #ddd;padding:2px;box-sizing:border-box;overflow:hidden;margin-bottom:0;\">\n                      ${modifiedHtml}\n                    </div>\n                  </div>\n                </div>\n              `;\n                isFirstSketchRendered = true;\n              } else {\n                sketchListHtml += `\n                <div style=\"display:block;width:100%;padding:0;box-sizing:border-box;margin-bottom:0;page-break-inside:avoid!important;break-inside:avoid!important;\">\n                  <div style=\"width:100%;border:1px solid #ddd;padding:2px;box-sizing:border-box;overflow:hidden;margin-bottom:0;page-break-inside:avoid!important;break-inside:avoid!important;\">\n                    ${modifiedHtml}\n                  </div>\n                </div>\n              `;\n              }\n            });\n          }\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchListHtml}</div>`;\n        } else {\n          // iOS/Web: Standard-Layout\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchItems.join('')}</div>`;\n        }\n      }\n\n      // Helper function to calculate polygon area\n      const calculatePolygonArea = (points, scale = 100) => {\n        if (points.length < 3) return 0;\n        let area = 0;\n        for (let i = 0; i < points.length; i++) {\n          const j = (i + 1) % points.length;\n          area += points[i].x * points[j].y;\n          area -= points[j].x * points[i].y;\n        }\n        return Math.abs(area / 2) / (scale * scale);\n      };\n\n      // Helper function to calculate line length\n      const calculateLineLength = (p1, p2, scale = 100) => {\n        return Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2)) / scale;\n      };\n\n      // Category colors\n      const getCategoryColor = category => {\n        // First try to find color from loaded line categories\n        const loadedCat = pdfLineCategories.find(c => c.name === category);\n        if (loadedCat) {\n          return loadedCat.color;\n        }\n        // Fallback to hardcoded colors\n        const colors = {\n          'Ortgang': '#4CAF50',\n          'Traufe': '#2196F3',\n          'First': '#9C27B0',\n          'Kehle': '#673AB7',\n          'Grat': '#FF9800',\n          'Fensterbank': '#795548',\n          'Sturz': '#607D8B',\n          'Laibung': '#E91E63',\n          'Rinne': '#00BCD4',\n          'Fensterumfang': '#FF5722',\n          'Sockelleiste': '#795548',\n          'Ortgang rechts': '#4CAF50',\n          'Ortgang links': '#4CAF50'\n        };\n        return colors[category] || '#607D8B';\n      };\n\n      // Generate FULL SVG drawing for a calculation (large, with all details)\n      const generateFullCalcSvg = calc => {\n        const polygons = calc.polygons || [];\n        const calcLines = calc.lines || [];\n        const calcScale = calc.scale || 100;\n        const calcBackgroundImage = calc.backgroundImage || null;\n        if (polygons.length === 0) return '';\n\n        // Find bounding box\n        let minX = Infinity,\n          minY = Infinity,\n          maxX = -Infinity,\n          maxY = -Infinity;\n        polygons.forEach(p => {\n          p.points.forEach(pt => {\n            minX = Math.min(minX, pt.x);\n            minY = Math.min(minY, pt.y);\n            maxX = Math.max(maxX, pt.x);\n            maxY = Math.max(maxY, pt.y);\n          });\n        });\n        const padding = 50;\n        const width = maxX - minX + padding * 2;\n        const height = maxY - minY + padding * 2;\n\n        // Scale to fit on page - FULL WIDTH for printing (A4 minus margins ~700px)\n        const maxWidth = 700;\n        const scaleRatio = Math.min(maxWidth / width, 550 / height);\n        const svgWidth = width * scaleRatio;\n        const svgHeight = height * scaleRatio;\n        const transformPoint = pt => ({\n          x: (pt.x - minX + padding) * scaleRatio,\n          y: (pt.y - minY + padding) * scaleRatio\n        });\n\n        // Calculate areas for overlay\n        const mainAreas = polygons.filter(p => p.type === 'main');\n        const deductionAreas =