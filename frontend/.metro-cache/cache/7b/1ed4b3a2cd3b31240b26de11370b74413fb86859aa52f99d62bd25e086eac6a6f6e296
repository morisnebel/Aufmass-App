ects) {\n      if (proj.id === currentProjectId) continue;\n      if (proj.customer_id === customerId) continue; // Same customer is OK\n      if (proj.objekt_number === number) {\n        return true; // Different customer uses this number\n      }\n    }\n    return false;\n  };\n\n  // Get next available customer number (avoiding duplicates)\n  const getNextAvailableCustomerNumber = async () => {\n    return generateCustomerNumber();\n  };\n\n  // Get next available project number (avoiding duplicates)\n  const getNextAvailableProjectNumber = async () => {\n    return generateProjectNumber();\n  };\n\n  // Get next available object number for customer (avoiding duplicates)\n  const getNextAvailableObjectNumber = async customerId => {\n    if (customerId) {\n      return generateObjectNumberForCustomer(customerId);\n    }\n    return generateObjectNumber();\n  };\n\n  // ============ LAST USED PROJECT TYPE ============\n  const LAST_PROJECT_TYPE_KEY = 'aufmass_last_project_type';\n  const setLastUsedProjectType = async projectType => {\n    try {\n      await AsyncStorage.default.setItem(LAST_PROJECT_TYPE_KEY, projectType);\n    } catch (error) {\n      console.error('Error saving last project type:', error);\n    }\n  };\n  const getLastUsedProjectType = async () => {\n    try {\n      return await AsyncStorage.default.getItem(LAST_PROJECT_TYPE_KEY);\n    } catch (error) {\n      console.error('Error loading last project type:', error);\n      return null;\n    }\n  };\n  const CustomerService = {\n    getAll: async () => {\n      return getItems(KEYS.CUSTOMERS);\n    },\n    getById: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      return customers.find(c => c.id === id) || null;\n    },\n    create: async data => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      // Auto-generate customer number if not provided\n      const customerNumber = data.customer_number || (await generateCustomerNumber());\n      const newCustomer = {\n        ...data,\n        id: generateId(),\n        customer_number: customerNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      customers.push(newCustomer);\n      await setItems(KEYS.CUSTOMERS, customers);\n      return newCustomer;\n    },\n    update: async (id, data) => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const index = customers.findIndex(c => c.id === id);\n      if (index === -1) return null;\n      customers[index] = {\n        ...customers[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.CUSTOMERS, customers);\n      return customers[index];\n    },\n    delete: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const filtered = customers.filter(c => c.id !== id);\n      await setItems(KEYS.CUSTOMERS, filtered);\n      return true;\n    }\n  };\n\n  // ============ PROJECTS ============\n\n  const ProjectService = {\n    getAll: async () => {\n      return getItems(KEYS.PROJECTS);\n    },\n    getById: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.find(p => p.id === id) || null;\n    },\n    getByCustomerId: async customerId => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => p.customer_id === customerId);\n    },\n    create: async data => {\n      const projects = await getItems(KEYS.PROJECTS);\n      // Auto-generate project number if not provided\n      const projectNumber = data.project_number || (await generateProjectNumber());\n      const newProject = {\n        ...data,\n        id: generateId(),\n        project_number: projectNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      projects.push(newProject);\n      await setItems(KEYS.PROJECTS, projects);\n      return newProject;\n    },\n    update: async (id, data) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const index = projects.findIndex(p => p.id === id);\n      if (index === -1) return null;\n      projects[index] = {\n        ...projects[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.PROJECTS, projects);\n      return projects[index];\n    },\n    delete: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const filtered = projects.filter(p => p.id !== id);\n      await setItems(KEYS.PROJECTS, filtered);\n      // Also delete related data\n      const sketches = await getItems(KEYS.SKETCHES);\n      const sketchesToDelete = sketches.filter(s => s.project_id === id);\n      await setItems(KEYS.SKETCHES, sketches.filter(s => s.project_id !== id));\n      // Clean up separate sketch data keys\n      const cleanupOps = [];\n      for (const sketch of sketchesToDelete) {\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_meta_${sketch.id}`));\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_bg_${sketch.id}`));\n        // Clean up separately stored image elements\n        try {\n          const metaStr = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (metaStr) {\n            const meta = JSON.parse(metaStr);\n            if (meta?.elements) {\n              for (const el of meta.elements) {\n                if (el.data?.imageStorageKey) {\n                  cleanupOps.push(AsyncStorage.default.removeItem(el.data.imageStorageKey));\n                }\n              }\n            }\n          }\n        } catch (e) {\n          // Ignore parse errors during cleanup\n        }\n      }\n      if (cleanupOps.length > 0) {\n        await Promise.all(cleanupOps);\n      }\n      const photos = await getItems(KEYS.PHOTOS);\n      // Separat gespeicherte Bilddaten der Projekt-Fotos mitlöschen (sonst bleibt\n      // der Speicher mit verwaisten photo_img_-Blobs gefüllt -> SQLITE_FULL)\n      const photosToDelete = photos.filter(p => p.project_id === id);\n      if (photosToDelete.length > 0) {\n        await AsyncStorage.default.multiRemove(photosToDelete.map(p => `photo_img_${p.id}`)).catch(() => {});\n      }\n      await setItems(KEYS.PHOTOS, photos.filter(p => p.project_id !== id));\n      const roofs = await getItems(KEYS.ROOFS);\n      await setItems(KEYS.ROOFS, roofs.filter(r => r.project_id !== id));\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      await setItems(KEYS.CHECKLISTS, checklists.filter(c => c.project_id !== id));\n      return true;\n    }\n  };\n\n  // ============ SKETCHES ============\n\n  // Lagert große eingebettete Bilder (base64-URIs) aus Skizzen-Elementen in eigene\n  // sketch_img_-Keys aus, BEVOR die Metadaten per JSON.stringify serialisiert werden.\n  // Verhindert riesige String-Allokationen (std::bad_alloc-Crash auf iOS beim Import).\n  const externalizeSketchImages = (meta, sketchId, saveOps) => {\n    const out = {\n      ...meta\n    };\n    delete out.backgroundImage;\n    if (Array.isArray(out.elements)) {\n      out.elements = out.elements.map(el => {\n        const uri = el?.data?.uri;\n        if (el?.type === 'image' && typeof uri === 'string' && uri.length > 50000) {\n          const imageKey = `sketch_img_${sketchId}_${el.id}`;\n          saveOps.push(AsyncStorage.default.setItem(imageKey, uri).catch(() => {}));\n          return {\n            ...el,\n            data: {\n              ...el.data,\n              uri: '__stored__',\n              imageStorageKey: imageKey\n            }\n          };\n        }\n        return el;\n      });\n    }\n    return out;\n  };\n  const SketchService = {\n    getAll: async () => {\n      return getItems(KEYS.SKETCHES);\n    },\n    getById: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      return sketches.find(s => s.id === id) || null;\n    },\n    getByProjectId: async projectId => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      return sketches.filter(s => s.project_id === projectId);\n    },\n    // Für Projekt-Export: Skizzen inkl. eingebetteter Bearbeitungsdaten\n    // (metadata + backgroundImage aus den optimierten Keys). Beim Import\n    // splittet create() die Daten automatisch wieder auf.\n    getByProjectIdWithData: async projectId => {\n      const sketches = await SketchService.getByProjectId(projectId);\n      return Promise.all(sketches.map(async s => {\n        try {\n          const {\n            metadata,\n            backgroundImage\n          } = await SketchService.loadSketchData(s.id);\n          if (metadata) {\n            const full = {\n              ...metadata\n            };\n            if (backgroundImage) full.backgroundImage = backgroundImage;\n            return {\n              ...s,\n              metadata: JSON.stringify(full)\n            };\n          }\n        } catch (e) {\n          console.warn('[SketchService] Export: Skizzen-Daten fehlen für', s.id, e);\n        }\n        return s;\n      }));\n    },\n    // ---- OPTIMIZED: Load heavy sketch data from separate storage keys ----\n    // This avoids parsing all sketches just to load one sketch's elements/background\n    loadSketchData: async id => {\n      try {\n        // Try loading from separate optimized keys first\n        const [metaStr, bgImage] = await Promise.all([AsyncStorage.default.getItem(`sketch_meta_${id}`), AsyncStorage.default.getItem(`sketch_bg_${id}`)]);\n        if (metaStr) {\n          // Found in optimized storage - parse with error handling\n          let metadata;\n          try {\n            metadata = JSON.parse(metaStr);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: bgImage\n            };\n          }\n\n          // Restore image URIs from separate storage if they were extracted\n          if (metadata.elements && Array.isArray(metadata.elements)) {\n            const imageElements = metadata.elements.filter(el => el.type === 'image' && el.data?.imageStorageKey);\n            if (imageElements.length > 0) {\n              const imageKeys = imageElements.map(el => el.data.imageStorageKey);\n              const imagePromises = imageKeys.map(key => AsyncStorage.default.getItem(key).catch(() => null));\n              const imageData = await Promise.all(imagePromises);\n              metadata.elements = metadata.elements.map(el => {\n                if (el.type === 'image' && el.data?.imageStorageKey) {\n                  const idx = imageKeys.indexOf(el.data.imageStorageKey);\n                  if (idx !== -1 && imageData[idx]) {\n                    return {\n                      ...el,\n                      data: {\n                        ...el.data,\n                        uri: imageData[idx]\n                      }\n                    };\n                  }\n                }\n                return el;\n              });\n            }\n          }\n          return {\n            metadata,\n            backgroundImage: bgImage\n          };\n        }\n\n        // Fallback: migrate from old format (metadata embedded in main array)\n        console.log(`[SketchService] Migrating sketch ${id} to optimized storage...`);\n        const sketch = await SketchService.getById(id);\n        if (sketch?.metadata) {\n          let metadata;\n          try {\n            metadata = JSON.parse(sketch.metadata);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse legacy metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: null\n            };\n          }\n          const bg = metadata.backgroundImage || null;\n\n          // Save to optimized keys (migration)\n          const metaWithoutBg = {\n            ...metadata\n          };\n          delete metaWithoutBg.backgroundImage;\n          await AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg));\n          if (bg) {\n            await AsyncStorage.default.setItem(`sketch_bg_${id}`, bg);\n          }\n\n          // Clean heavy data from main array to speed up future loads\n          const sketches = await getItems(KEYS.SKETCHES);\n          const index = sketches.findIndex(s => s.id === id);\n          if (index !== -1) {\n            // Keep only lightweight data + sketch_data (small preview) in the main array\n            delete sketches[index].metadata;\n            await setItems(KEYS.SKETCHES, sketches);\n          }\n          return {\n            metadata: metaWithoutBg,\n            backgroundImage: bg\n          };\n        }\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      } catch (error) {\n        console.error(`[SketchService] Error loading sketch data for ${id}:`, error);\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      }\n    },\n    // ---- OPTIMIZED: Save heavy data to separate keys ----\n    saveSketchData: async (id, metadata, backgroundImage) => {\n      try {\n        // Save metadata (without background image) to separate key\n        const metaWithoutBg = {\n          ...metadata\n        };\n        delete metaWithoutBg.backgroundImage;\n        const saveOps = [AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg))];\n\n        // Save background image to its own key\n        if (backgroundImage) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, backgroundImage));\n        } else {\n          // Remove old background if cleared\n          saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n        }\n        await Promise.all(saveOps);\n      } catch (error) {\n        console.error(`[SketchService] Error saving sketch data for ${id}:`, error);\n      }\n    },\n    create: async data => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const id = generateId();\n\n      // Extract heavy data before storing in main array\n      const heavyMetadata = data.metadata;\n      const lightSketch = {\n        ...data,\n        id,\n        metadata: undefined,\n        // Don't store metadata in main array\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      sketches.push(lightSketch);\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = externalizeSketchImages(meta, id, saveOps);\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          }\n        } catch (e) {\n          // If metadata isn't valid JSON, store as-is in separate key\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return {\n        ...lightSketch,\n        metadata: heavyMetadata\n      };\n    },\n    update: async (id, data) => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const index = sketches.findIndex(s => s.id === id);\n      if (index === -1) return null;\n\n      // Extract heavy data\n      const heavyMetadata = data.metadata;\n      const lightData = {\n        ...data\n      };\n      delete lightData.metadata; // Don't store metadata in main array\n\n      sketches[index] = {\n        ...sketches[index],\n        ...lightData,\n        updated_at: new Date().toISOString()\n      };\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = externalizeSketchImages(meta, id, saveOps);\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          } else {\n            saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n          }\n        } catch (e) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, heavyMetadata));\n        }\n      }\n      await Promise.all(saveOps);\n      return sketches[index];\n    },\n    delete: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const filtered = sketches.filter(s => s.id !== id);\n\n      // Delete main array entry + separate heavy data keys in parallel\n      await Promise.all([setItems(KEYS.SKETCHES, filtered), AsyncStorage.default.removeItem(`sketch_meta_${id}`), AsyncStorage.default.removeItem(`sketch_bg_${id}`)]);\n      return true;\n    },\n    // ---- BATCH MIGRATION: Move all embedded metadata to separate keys ----\n    // This should be called once on app startup to ensure the main sketches array is lightweight.\n    // After migration, loading the sketch list is fast because the heavy data is stored separately.\n    migrateAllSketches: async () => {\n      const MIGRATION_KEY = 'aufmassprofi_sketch_migration_done';\n      try {\n        // Check if migration already completed\n        const migrationDone = await AsyncStorage.default.getItem(MIGRATION_KEY);\n        if (migrationDone === 'true') {\n          console.log('[SketchService] Migration already completed, skipping.');\n          return;\n        }\n        console.log('[SketchService] Starting batch migration of sketches...');\n        const startTime = Date.now();\n        const sketches = await getItems(KEYS.SKETCHES);\n        let migratedCount = 0;\n        let needsSave = false;\n        for (const sketch of sketches) {\n          if (sketch.metadata) {\n            try {\n              const meta = JSON.parse(sketch.metadata);\n              const bg = meta.backgroundImage || null;\n              const metaWithoutBg = {\n                ...meta\n              };\n              delete metaWithoutBg.backgroundImage;\n\n              // Save heavy data to separate keys\n              await AsyncStorage.default.setItem(`sketch_meta_${sketch.id}`, JSON.stringify(metaWithoutBg));\n              if (bg) {\n                await AsyncStorage.default.setItem(`sketch_bg_${sketch.id}`, bg);\n              }\n\n              // Strip metadata from main array entry\n              delete sketch.metadata;\n              needsSave = true;\n              migratedCount++;\n            } catch (e) {\n              console.error(`[SketchService] Error migrating sketch ${sketch.id}:`, e);\n            }\n          }\n        }\n        if (needsSave) {\n          await setItems(KEYS.SKETCHES, sketches);\n        }\n\n        // Mark migration as done\n        await AsyncStorage.default.setItem(MIGRATION_KEY, 'true');\n        console.log(`[SketchService] Batch migration completed in ${Date.now() - startTime}ms. Migrated ${migratedCount} sketches.`);\n      } catch (error) {\n        console.error('[SketchService] Batch migration error:', error);\n      }\n    }\n  };\n\n  // ============ PHOTOS ============\n\n  // Migration: Foto-Bilddaten aus dem Array in separate Schlüssel verschieben\n  // Verhindert Hermes OOM bei JSON.stringify des gesamten Foto-Arrays\n  const migratePhotoStorage = async () => {\n    try {\n      const migrationKey = 'aufmassprofi_photo_migration_done';\n      const done = await AsyncStorage.default.getItem(migrationKey);\n      if (done =