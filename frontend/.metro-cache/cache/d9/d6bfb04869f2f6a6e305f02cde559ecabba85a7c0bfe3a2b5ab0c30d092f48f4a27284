id-template-columns: repeat(2, 1fr);\n            gap: 12px;\n          }\n          .photos-section-medium .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-medium .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          .photo-grid-medium {\n            width: 100%;\n          }\n          /* Groß: 1 Spalte (übereinander) */\n          .photos-section-large {\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n          }\n          .photos-section-large .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-large .photo-item img {\n            max-height: 340px;\n            object-fit: contain;\n          }\n          .photo-grid-large {\n            width: 100%;\n          }\n          /* iPhone-spezifischer Skizzen-Container: Grid mit 2 Spalten */\n          .sketches-container-iphone {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n          }\n          .sketch-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .sketch-iphone img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* iPhone-spezifischer Fotos-Container: Grid mit 2 Spalten */\n          .photos-container-iphone {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n            margin-bottom: 20px;\n            align-items: start;\n          }\n          .photos-container-iphone.photos-new-page {\n            page-break-before: always !important;\n            break-before: page !important;\n          }\n          .photo-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .photo-iphone .photo-wrapper {\n            display: flex;\n            align-items: center;\n 