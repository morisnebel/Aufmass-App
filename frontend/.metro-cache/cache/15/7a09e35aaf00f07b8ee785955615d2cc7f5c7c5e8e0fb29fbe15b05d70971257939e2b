r)\n          const headingHtml = `<h2 class=\"sketch-inline-heading\">${t('sketches.title')}</h2>`;\n          const sketchesBySize = {\n            medium: [],\n            large: []\n          };\n          sketchItems.forEach((itemHtml, index) => {\n            const sketch = sketches[index];\n            const meta = sketch.metadata || {};\n            const size = typeof meta === 'object' && meta.pdf_size || sketch.pdf_size || 'large';\n\n            // Überschrift aus dem Item entfernen\n            const cleanHtml = itemHtml.replace(/<h2 class=\"sketch-inline-heading\">[^<]*<\\/h2>/g, '');\n\n            // small wird zu medium gemappt (falls alte Daten vorhanden)\n            if (size === 'small' || size === 'medium') sketchesBySize.medium.push(cleanHtml);else sketchesBySize.large.push(cleanHtml);\n          });\n\n          // LÖSUNG: Überschrift + erste Skizze starten auf neuer Seite\n          // Android Print Spooler ignoriert oft page-break-inside:avoid bei großen Inhalten\n          // Daher: page-break-before:always für den Skizzen-Container\n          let sketchListHtml = '';\n          let isFirstSketchRendered = false;\n\n          // 66% Skizzen: 2 nebeneinander, je ca. 48% Breite (mit Abstand = 100%)\n          if (sketchesBySize.medium.length > 0) {\n            // Wenn medium-Skizzen zuerst kommen, Überschrift + erste Skizzen zusammen wrappen\n            // page-break-before: always erzwingt neue Seite VOR dem Container\n            if (!isFirstSketchRendered) {\n              sketchListHtml += `<div style=\"page-break-before:always!important;page-break-inside:avoid!important;break-inside:avoid!important;\">`;\n              sketchListHtml += headingHtml;\n              isFirstSketchRendered = true;\n            }\n            sketchListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            sketchesBySize.medium.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html\n              // Entferne alle style-Attribute von img\n              .replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>')\n              // Setze neue styles für img - volle Breite erzwingen, max-height begrenzt\n              .replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:300px!important;object-fit:contain!important;\"')\n              // Auch das sketch-item div anpassen\n              .replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item\" style=\"width:100%!important;\"');\n              sketchListHtml += `\n              <div style=\"display:inline-block;width:48%;vertical-align:top;padding:4px;box-sizing:border-box;font-size:12px;\">\n                <div style=\"width:100%;border:1px solid #ddd;padding:5px;box-sizing:border-box;overflow:hidden;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n            sketchListHtml += `</div>`;\n            // Schließe den page-break-avoid Container nach den medium Skizzen\n            sketchListHtml += `</div>`;\n          }\n\n          // 100% Skizzen: Volle Breite - ZWEI übereinander pro Seite\n          if (sketchesBySize.large.length > 0) {\n            sketchesBySize.large.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html.replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>').replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:440px!important;object-fit:contain!important;image-rendering:crisp-edges!important;\"').replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item sketch-large\" style=\"width:100%!important;\"');\n\n              // Wenn dies die erste Skizze überhaupt ist (