      ${roofs.length > 0 ? `\n        <div class=\"roofs-section\">\n          <h2>${t('projects.roofMeasurement')}</h2>\n          ${roofsHtml}\n        </div>\n        ` : ''}\n        \n        ${checklists.length > 0 ? `\n        <div class=\"checklists-section\" style=\"page-break-before: auto !important; page-break-inside: auto !important; break-inside: auto !important;\">\n          <h2>${t('checklists.title')}</h2>\n          ${checklistsHtml}\n        </div>\n        ` : ''}\n        \n        ${photos.length > 0 ? `\n          <div class=\"photos-section\" style=\"page-break-before: auto !important; break-before: auto !important; page-break-inside: auto !important; break-inside: auto !important; margin-top: 10px !important;\">\n            ${photosHtml}\n          </div>\n        ` : ''}\n        \n        ${sketches.length > 0 ? `\n          <div class=\"sketches-section\" style=\"page-break-before: auto !important; break-before: auto !important;\">\n            ${sketchesHtml}\n          </div>\n        ` : ''}\n        \n        ${areaCalculations.length === 0 && (photos.length > 0 || sketches.length > 0) ? `\n          <div class=\"footer-container\">\n            ${remarks || project?.remarks ? `\n              <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                <h2>Bemerkungen</h2>\n                <div class=\"remarks-box\">\n                  ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                </div>\n              </div>\n            ` : ''}\n            <div class=\"footer\">\n              ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n            </div>\n          </div>\n        ` : ''}\n        </div><!-- end .page -->\n        \n        ${areaCalculations.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"area-calcs-section\">\n              <h2>Flächenberechnungen</h2>\n              ${generateCombinedAreaCalcs()}\n            </div>\n            <div class=\"footer-container\">\n              ${remarks || project?.remarks ? `\n                <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                  <h2>Bemerkungen</h2>\n                  <div class=\"remarks-box\">\n                    ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                  </div>\n                </div>\n              ` : ''}\n              <div class=\"footer\">\n                ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n              </div>\n            </div>\n          </div>\n        ` : ''}\n        \n        ${photos.length === 0 && sketches.length === 0 && areaCalculations.length === 0 ? `\n          <div class=\"footer-container\">\n            ${remarks || project?.remarks ? `\n              <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                <h2>Bemerkungen</h2>\n                <div class=\"remarks-box\">\n                  ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                </div>\n              </div>\n            ` : ''}\n            <div class=\"footer\">\n              ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n            </div>\n          </div>\n        ` : ''}\n      </body>\n      </html>\n    `;\n      return html;\n    };\n\n    // Show PDF options dialog\n    const exportToPDF = async () => {\n      Alert.default.alert('PDF Export', t('projects.whatToDo'), [{\n        text: t('projects.showPreview'),\n        onPress: async () => {\n          try {\n            setIsGeneratingPdf(true);\n            const html = await generatePdfHtml();\n            setPdfHtmlContent(html);\n            setShowPdfPreviewModal(true);\n          } catch (error) {\n            console.error('Error generating preview:', error);\n            Alert.default.alert(t('common.error'), t('pdf.previewError'));\n          } finally {\n      