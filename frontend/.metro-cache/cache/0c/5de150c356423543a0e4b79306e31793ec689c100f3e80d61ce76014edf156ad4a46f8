 const gridColumns = checklistColumns === 1 ? '1fr' : checklistColumns === 2 ? '1fr 1fr' : '1fr 1fr 1fr';\n\n      // PDF Farb-Einstellungen\n      const pdfColorId = settings.pdf_header_color || 'blue';\n      const colorOptions = {\n        blue: {\n          color: '#1976d2',\n          textColor: '#ffffff'\n        },\n        light_blue: {\n          color: '#bbdefb',\n          textColor: '#1565c0'\n        },\n        gray: {\n          color: '#9e9e9e',\n          textColor: '#ffffff'\n        },\n        light_gray: {\n          color: '#e0e0e0',\n          textColor: '#424242'\n        },\n        green: {\n          color: '#388e3c',\n          textColor: '#ffffff'\n        },\n        light_green: {\n          color: '#c8e6c9',\n          textColor: '#2e7d32'\n        },\n        black: {\n          color: '#212121',\n          textColor: '#ffffff'\n        },\n        white: {\n          color: '#ffffff',\n          textColor: '#333333'\n        }\n      };\n      const pdfColor = colorOptions[pdfColorId] || colorOptions.blue;\n      const headerBgColor = pdfColor.color;\n      const headerTextColor = pdfColor.textColor;\n      // Dunklere Version für Gradient (oder gleich bei hellen Farben)\n      const headerBgColorDark = pdfColorId === 'white' ? '#f5f5f5' : pdfColorId.includes('light') ? pdfColor.color : pdfColor.color;\n\n      // Format date\n      const formatDate = dateStr => {\n        try {\n          const date = new Date(dateStr);\n          return date.toLocaleDateString('de-DE', {\n            day: '2-digit',\n            month: '2-digit',\n            year: 'numeric'\n          });\n        } catch {\n          return dateStr;\n        }\n      };\n\n      // Generate roofs HTML with more details\n      const roofsHtml = roofs.length > 0 ? roofs.map((roof, idx) => {\n        let measurementsHtml = '';\n        if (roof.measurements && typeof roof.measurements === 'object') {\n          const m = roof.measurements;\n          measurementsHt