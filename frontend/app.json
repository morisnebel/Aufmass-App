{
  "expo": {
    "name": "Dach-Aufmaß",
    "slug": "dach-aufmass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dachaufmass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nebelbedachung.dachaufmass",
      "infoPlist": {
        "NSContactsUsageDescription": "Kunden als Kontakte speichern",
        "NSPhotoLibraryUsageDescription": "Fotos in der Galerie speichern",
        "NSPhotoLibraryAddUsageDescription": "Aufmaß-Fotos in der Galerie speichern"
      }
    },
    "android": {
      "package": "com.nebelbedachung.dachaufmass",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1976d2"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1976d2"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Erlauben Sie den Zugriff auf Ihre Kontakte, um Kunden zu importieren und zu speichern."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Erlauben Sie den Zugriff auf Ihre Fotos, um Aufmaß-Fotos zu speichern.",
          "savePhotosPermission": "Erlauben Sie das Speichern von Fotos in Ihrer Galerie."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
