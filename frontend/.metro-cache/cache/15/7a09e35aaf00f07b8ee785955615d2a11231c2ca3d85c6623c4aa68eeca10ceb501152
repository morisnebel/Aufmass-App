nnotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 400px;\n            object-fit: contain;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes - mit Flexbox */\n          .sketch-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 0;\n          }\n          .sketch-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-item img {\n            max-height: 440px;\n            object-fit: contain;\n            image-rendering: crisp-edges;\n            image-rendering: high-quality;\n          }\n          .photo-item, .sketch-item {\n            border: 1px solid #e0e0e0;\n            border-radius: 6px;\n            overflow: hidden;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            display: block;\n            max-height: 450px;\n          }\n          /* Photo/Sketch im Grid nicht umbrechen */\n          .photo-iphone, .sketch-iphone {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n