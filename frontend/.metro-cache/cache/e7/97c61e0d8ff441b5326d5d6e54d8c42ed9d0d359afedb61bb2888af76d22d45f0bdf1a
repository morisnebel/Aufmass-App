n-items:flex-start;\">${projectHtml}${companyHtml}</div>`;\n      }\n      return projectHtml || companyHtml;\n    })()}\n\n      <div class=\"section\">\n        <div class=\"section-title\">👷 Mitarbeiter & Arbeitszeiten</div>\n        ${employeesTable}\n        ${roleSummaryHtml}\n      </div>\n\n      ${travelHtml}\n\n      <div class=\"section\">\n        <div class=\"section-title\">🛠️ Ausgeführte Arbeiten</div>\n        ${workItemsHtml}\n        ${report.work_description ? `<div class=\"work-desc\">${escapeHtml(report.work_description)}</div>` : ''}\n        ${!workItemsHtml && !report.work_description ? '<span style=\"color:#999;font-style:italic;\">Keine Angaben</span>' : ''}\n      </div>\n\n      ${machinesHtml ? `\n        <div class=\"section\">\n          <div class=\"section-title\">🚜 Maschinen / Geräte</div>\n          ${machinesHtml}\n        </div>\n      ` : ''}\n\n      ${materialsRows ? `\n        <div class=\"section\">\n          <div class=\"section-title\">🧱 Verwendetes Material</div>\n          <table class=\"material-table\">\n            <thead><tr><th>Material</th><th style=\"text-align:right;\">Menge</th><th>Einheit</th><th>Bemerkung</th></tr></thead>\n            <tbody>${materialsRows}</tbody>\n          </table>\n        </div>\n      ` : ''}\n\n      ${(() => {\n      // ====== Kosten-Übersicht (optional) ======\n      const showEmp = !!report.show_employee_costs;\n      const showMat = !!report.show_material_costs;\n      const showMac = !!report.show_machine_costs;\n      const showTravel = !!report.show_travel_costs;\n      const showSum = !!report.show_total_sum;\n      if (!showEmp && !showMat && !showMac && !showTravel && !showSum) return '';\n      const empMaster = options.employeesMaster || [];\n      const matMaster = options.materialsMaster || [];\n      const macMaster = options.machinesMaster || [];\n      const eurFmt = n => `${n.toFixed(2).replace('.', ',')} €`;\n      const escape = s => escapeHtml(s || '');\n\n      // Fließt Fahrzeit in die Lohnkosten-Berechnung ein?\n      const costIsPerEmp = !!report.travel_per_employee_enabled;\n      const costPerEmpTravel = costIsPerEmp && (report.employees || []).some(e => (e.travel_to_hours || 0) > 0 || (e.travel_back_hours || 0) > 0);\n      const costTeamTravel = !costIsPerEmp && ((report.travel_to_hours || 0) > 0 || (report.travel_back_hours || 0) > 0);\n      const travelIncludedInCosts = costPerEmpTravel || costTeamTravel && !!report.travel_in_total_hours;\n\n      // === Mitarbeiter-Kosten ===\n      let empTotal = 0;\n      let empRowsHtml = '';\n      if (showEmp || showSum) {\n        (report.employees || []).forEach(e => {\n          const ea = e;\n          const calcHours = (() => {\n            if (e.hours != null) return e.hours;\n            if (!ea.time_from || !ea.time_to) return 0;\n            const [fh, fm] = ea.time_from.split(':').map(Number);\n            const [th, tm] = ea.time_to.split(':').map(Number);\n            let mins = th * 60 + tm - (fh * 60 + fm);\n            if (mins < 0) mins += 24 * 60;\n            mins -= ea.pause_minutes || 0;\n            return Math.max(0, Math.round(mins / 60 * 100) / 100);\n          })();\n          const travelExtra = (ea.travel_to_hours || 0) + (ea.travel_back_hours || 0);\n          // Team-Fahrzeit pro Zeile: Gesamt-Fahrzeit der Person (Runde × Tage) auf ihre Einträge verteilt\n          const pKey = (ea.name || e.id || '').trim().toLowerCase();\n          const rowsOfPerson = Math.max(1, (report.employees || []).filter(x => (x.name || x.id || '').trim().toLowerCase() === pKey).length);\n          const teamTravelTeam = report.travel_per_employee_enabled ? 0 : ((report.travel_to_hours || 0) + (report.travel_back_hours || 0)) * Math.max(1, report.travel_days || 1) / rowsOfPerson;\n          const teamTravelShare = teamTravelTeam && report.travel_in_total_hours ? teamTravelTeam : 0; // pro MA der Team-Anteil zur Lohnberechnung\n          const totalHrs = calcHours + (report.travel_per_employee_enabled ? travelExtra : teamTravelShare);\n          const master = empMaster.find(m => e.id && m.id === e.id || m.name?.toLowerCase() === (e.name || '').toLowerCase());\n          const rate = ea.hourly_rate != null ? ea.hourly_rate : master?.hourly_rate || 0;\n          const cost = totalHrs * rate;\n          empTotal += cost;\n          if (showEmp) {\n            const entryDateStr = (() => {\n              const d = ea.entry_date || report.date;\n              try {\n                return new Date(d).toLocaleDateString('de-DE', {\n                  day: '2-digit',\n                  month: '2-digit',\n                  year: '2-digit'\n                });\n              } catch {\n                return '';\n              }\n            })();\n            empRowsHtml += `<tr>\n                <td>${escape(e.name)}</td>\n                <td style=\"color:#64748b;font-size:9px;\">${escape(ea.role || '')}</td>\n                <td style=\"color:#64748b;font-size:9px;\">${entryDateStr}</td>\n                <td style=\"text-align:right;\">${formatHoursHM(totalHrs)}</td>\n                <td style=\"text-align:right;\">${rate > 0 ? eurFmt(rate) + '/h' : '<span style=\"color:#94a3b8\">–</span>'}</td>\n                <td style=\"text-align:right;font-weight:600;\">${rate > 0 ? eurFmt(cost) : '<span style=\"color:#94a3b8\">–</span>'}</td>\n              </tr>`;\n          }\n        });\n      }\n\n      // === Material-Kosten ===\n      let matTotal = 0;\n      let matRowsHtml = '';\n      if (showMat || showSum) {\n        (report.materials || []).forEach(m => {\n          const master = matMaster.find(mm => mm.name?.toLowerCase() === (m.name || '').toLowerCase());\n          const price = m.price_per_unit != null ? m.price_per_unit : master?.price_per_unit || 0;\n          const cost = (m.quantity || 0) * price;\n          matTotal += cost;\n          if (showMat) {\n            matRowsHtml += `<tr>\n                <td>${escape(m.name)}</td>\n                <td style=\"text-align:right;\">${m.quantity || 0} ${escape(m.unit)}</td>\n                <td style=\"text-align:right;\">${price > 0 ? eurFmt(price) + '/' + escape(m.unit) : '<span style=\"color:#94a3b8\">–</span>'}</td>\n                <td style=\"text-align:right;font-weight:600;\">${price > 0 ? eurFmt(cost) : '<span style=\"color:#94a3b8\">–</span>'}</td>\n              </tr>`;\n          }\n        });\n      }\n\n      // === Maschinen-Kosten ===\n      let macTotal = 0;\n      let macRowsHtml = '';\n      if (showMac || showSum) {\n        (report.machines || []).forEach(m => {\n          const master = macMaster.find(mm => m.master_id && mm.id === m.master_id || mm.name?.toLowerCase() === (m.name || '').toLowerCase());\n          const rate = m.hourly_rate != null ? m.hourly_rate : master?.hourly_rate || 0;\n          const hours = m.hours || 0;\n          const cost = hours * rate;\n          macTotal += cost;\n          if (showMac) {\n            macRowsHtml += `<tr>\n                <td>${escape(m.name)}</td>\n                <td style=\"text-align:right;\">${formatHoursHM(hours)}</td>\n                <td style=\"text-align:right;\">${rate > 0 ? eurFmt(rate) + '/h' : '<span style=\"color:#94a3b8\">–</span>'}</td>\n                <td style=\"text-align:right;font-weight:600;\">${rate > 0 ? eurFmt(cost) : '<span style=\"color:#94a3b8\">–</span>'}</td>\n              </tr>`;\n          }\n        });\n      }\n\n      // === Spesen / Fahrtkosten ===\n      const travelCostsTotal = report.travel_per_employee_enabled ? (report.employees || []).reduce((s, e) => s + (e.travel_costs || 0), 0) : (report.travel_costs || 0) * Math.max(1, report.travel_days || 1);\n      const grandTotal = empTotal + matTotal + macTotal + (showTravel ? travelCostsTotal : 0);\n      return `\n          <div class=\"section keep-together\">\n            <div class=\"section-title\" style=\"background:#dcfce7;color:#166534;\">💰 Kosten-Übersicht</div>\n        