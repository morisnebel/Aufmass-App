v>\n            ` : ''}\n            ${bauherrEmail ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">E-Mail:</span>\n                <span class=\"info-value\">${bauherrEmail}</span>\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <div class=\"stats-grid\">\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${roofs.length}</div>\n            <div class=\"stat-label\">Dachflächen</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${pdfTotalArea.toFixed(2)} m²</div>\n            <div class=\"stat-label\">Gesamtfläche</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${photos.length}</div>\n            <div class=\"stat-label\">Fotos</div>\n          </div>\n        </div>\n        \n        <div class=\"roofs-section\">\n          <h2>Dachflächen</h2>\n          ${roofsHtml}\n        </div>\n        \n        <div class=\"checklists-section\">\n          <h2>Checklisten</h2>\n          ${checklistsHtml}\n        </div>\n        </div><!-- end .page -->\n        \n        ${photos.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"photos-section\">\n              <h2>Fotos</h2>\n              ${photosHtml}\n            </div>\n          </div>\n        ` : ''}\n        \n        ${sketches.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"sketches-section\">\n              <h2>Skizzen</h2>\n              ${sketchesHtml}\n            </div>\n          </div>\n        ` : ''}\n        \n        <div class=\"new-page\">\n          ${remarks || project?.remarks ? `\n            <div class=\"remarks-section\">\n              <h2>Bemerkungen</h2>\n              <div class=\"remarks-box\">\n                ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n              </div>\n            </div>\n          ` : ''}\n          <div class=\"footer\" style=\"margin-top: 30px;\">\n            Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n          </div>\n        </div>\n      </body>\n      </html>\n    `;\n      return html;\n    };\n\n    // Show PDF options dialog\n    const exportToPDF = async () => {\n      Alert.default.alert('PDF Export', 'Was möchten Sie tun?', [{\n        text: 'Vorschau anzeigen',\n        onPress: async () => {\n          try {\n            setIsGeneratingPdf(true);\n            const html = await generatePdfHtml();\n            setPdfHtmlContent(html);\n            setShowPdfPreviewModal(true);\n          } catch (error) {\n            console.error('Error generating preview:', error);\n            Alert.default.alert('Fehler', 'Vorschau konnte nicht erstellt werden.');\n          } finally {\n            setIsGeneratingPdf(false);\n          }\n        }\n      }, {\n        text: 'PDF teilen',\n        onPress: () => generateAndSharePdf()\n      }, {\n        text: 'In Dateien speichern',\n        onPress: () => generateAndSavePdf()\n      }, {\n        text: 'Abbrechen',\n        style: 'cancel'\n      }]);\n    };\n\n    // Generate and share PDF\n    const generateAndSharePdf = async () => {\n      try {\n        setIsGeneratingPdf(true);\n        const html = await generatePdfHtml();\n        const {\n          uri\n        } = await Print.printToFileAsync({\n          html,\n          base64: false\n        });\n        const canShare = await Sharing.isAvailableAsync();\n        if (canShare) {\n          await Sharing.shareAsync(uri, {\n            mimeType: 'application/pdf',\n            dialogTitle: `Aufmaß ${project?.name} teilen`,\n            UTI: 'com.adobe.pdf'\n          });\n        } else {\n          Alert.default.alert('Fehler', 'Teilen ist auf diesem Gerät nicht verfügbar.');\n        }\n      } catch (error) {\n        console.error('Error sharing PDF:', error);\n        Alert.default.alert('Fehler', 'PDF konnte nicht erstellt werden.');\n      } finally {\n        setIsGeneratingPdf(false);\n      }\n    };\n\n    // Generate and save PDF to Files app\n    const generateAndSavePdf = async () => {\n      try {\n        setIsGeneratingPdf(true);\n        const html = await generatePdfHtml();\n        const {\n          uri\n        } = await Print.printToFileAsync({\n          html,\n          base64: false\n        });\n\n        // Share the file directly - iOS will show \"Save to Files\" option\n        const canShare = await Sharing.isAvailableAsync();\n        if (canShare) {\n          await Sharing.shareAsync(uri, {\n            mimeType: 'application/pdf',\n            dialogTitle: 'PDF speichern',\n            UTI: 'com.adobe.pdf'\n          });\n        } else {\n          Alert.default.alert('Fehler', 'Teilen ist auf diesem Gerät nicht verfügbar.');\n        }\n      } catch (error) {\n        console.error('Error saving PDF:', error);\n        Alert.default.alert('Fehler', 'PDF konnte nicht gespeichert werden.');\n      } finally {\n        setIsGeneratingPdf(false);\n      }\n    };\n\n    // Share PDF from preview - use native print/share\n    const sharePdfFromPreview = async () => {\n      try {\n        // Close modal first\n        setShowPdfPreviewModal(false);\n\n        // Small delay to let modal close\n        await new Promise(resolve => setTimeout(resolve, 100));\n\n        // Generate fresh HTML to ensure all data is current\n        const html = await generatePdfHtml();\n\n        // Generate PDF file first, then share\n        const {\n          uri\n        } = await Print.printToFileAsync({\n          html: html,\n          base64: false\n        });\n\n        // Share the PDF file\n        const canShare = await Sharing.isAvailableAsync();\n        if (canShare) {\n          await Sharing.shareAsync(uri, {\n            mimeType: 'application/pdf',\n            dialogTitle: `Aufmaß ${project?.name} teilen`,\n            UT