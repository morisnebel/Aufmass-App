rue;\n    },\n    // Alle Templates auf einmal speichern (für Sortierung)\n    saveAll: async templates => {\n      const ops = [];\n      const extracted = templates.map(t => chkExtractImages(t, ops));\n      await Promise.all([setItems(KEYS.CHECKLIST_TEMPLATES, extracted), ...ops]);\n    }\n  };\n\n  // ============ SETTINGS ============\n\n  const SettingsService = {\n    get: async () => {\n      try {\n        const data = await storage.getItem(KEYS.SETTINGS);\n        return data ? JSON.parse(data) : {};\n      } catch (error) {\n        console.error('Error getting settings:', error);\n        return {};\n      }\n    },\n    update: async data => {\n      try {\n        const current = await SettingsService.get();\n        const updated = {\n          ...current,\n          ...data\n        };\n        await storage.setItem(KEYS.SETTINGS, JSON.stringify(updated));\n        return updated;\n      } catch (error) {\n        console.error('Error updating settings:', error);\n        return data;\n      }\n    }\n  };\n\n  // ============ DOCUMENTS (PDF with annotations) ============\n\n  const DocumentService = {\n    getAll: async () => {\n      return getItems(KEYS.DOCUMENTS);\n    },\n    getByProjectId: async projectId => {\n      const documents = await getItems(KEYS.DOCUMENTS);\n      return documents.filter(doc => doc.project_id === projectId);\n    },\n    getById: async id => {\n      const documents = await getItems(KEYS.DOCUMENTS);\n      return documents.find(doc => doc.id === id) || null;\n    },\n    create: async data => {\n      const documents = await getItems(KEYS.DOCUMENTS);\n      const newDocument = {\n        ...data,\n        id: generateId(),\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      documents.push(newDocument);\n      await setItems(KEYS.DOCUMENTS, documents);\n      return newDocument;\n    },\n    update: async (id, data) => {\n      const documents = await getItems(K