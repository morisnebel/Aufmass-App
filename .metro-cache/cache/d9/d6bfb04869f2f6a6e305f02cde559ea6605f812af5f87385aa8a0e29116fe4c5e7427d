x;\n            margin-top: 10px;\n          }\n          .footer {\n            margin-top: 30px;\n            padding-top: 15px;\n            border-top: 1px solid #e0e0e0;\n            font-size: 9px;\n            color: #999;\n            text-align: center;\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 5px;\n            margin-top: 8px;\n          }\n          .measure-item {\n            font-size: 11px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 14px;\n            color: #1976d2;\n            margin-bottom: 5px;\n          }\n          .roof-notes {\n            margin-top: 8px;\n            padding-top: 8px;\n            border-top: 1px dashed #e0e0e0;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 15px;\n          }\n          .company-logo {\n            max-width: 120px;\n            max-height: 90px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n  