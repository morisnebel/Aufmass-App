tes)\n  const getNextAvailableProjectNumber = async () => {\n    return generateProjectNumber();\n  };\n\n  // Get next available object number for customer (avoiding duplicates)\n  const getNextAvailableObjectNumber = async customerId => {\n    if (customerId) {\n      return generateObjectNumberForCustomer(customerId);\n    }\n    return generateObjectNumber();\n  };\n\n  // ============ LAST USED PROJECT TYPE ============\n  const LAST_PROJECT_TYPE_KEY = 'aufmass_last_project_type';\n  const setLastUsedProjectType = async projectType => {\n    try {\n      await AsyncStorage.default.setItem(LAST_PROJECT_TYPE_KEY, projectType);\n    } catch (error) {\n      console.error('Error saving last project type:', error);\n    }\n  };\n  const getLastUsedProjectType = async () => {\n    try {\n      return await AsyncStorage.default.getItem(LAST_PROJECT_TYPE_KEY);\n    } catch (error) {\n      console.error('Error loading last project type:', error);\n      return null;\n    }\n  };\n  const CustomerService = {\n    getAll: async () => {\n      return getItems(KEYS.CUSTOMERS);\n    },\n    getById: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      return customers.find(c => c.id === id) || null;\n    },\n    create: async data => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      // Auto-generate customer number if not provided\n      const customerNumber = data.customer_number || (await generateCustomerNumber());\n      const newCustomer = {\n        ...data,\n        id: generateId(),\n        customer_number: customerNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      customers.push(newCustomer);\n      await setItems(KEYS.CUSTOMERS, customers);\n      return newCustomer;\n    },\n    update: async (id, data) => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const index = customers.findIndex(c => c.id === id);\n      if (index === -1) return null;\n      customers[index] = {\n        ...customers[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.CUSTOMERS, customers);\n      return customers[index];\n    },\n    delete: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const filtered = customers.filter(c => c.id !== id);\n      await setItems(KEYS.CUSTOMERS, filtered);\n      return true;\n    }\n  };\n\n  // ============ PROJECTS ============\n\n  const ProjectService = {\n    getAll: async () => {\n      return getItems(KEYS.PROJECTS);\n    },\n    getById: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.find(p => p.id === id) || null;\n    },\n    getByCustomerId: async customerId => {\n      const projects = await getItems(KEYS.PROJECTS);\n      return projects.filter(p => p.customer_id === customerId);\n    },\n    create: async data => {\n      const projects = await getItems(KEYS.PROJECTS);\n      // Auto-generate project number if not provided\n      const projectNumber = data.project_number || (await generateProjectNumber());\n      const newProject = {\n        ...data,\n        id: generateId(),\n        project_number: projectNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      projects.push(newProject);\n      await setItems(KEYS.PROJECTS, projects);\n      return newProject;\n    },\n    update: async (id, data) => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const index = projects.findIndex(p => p.id === id);\n      if (index === -1) return null;\n      projects[index] = {\n        ...projects[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.PROJECTS, projects);\n      return projects[index];\n    },\n    delete: async id => {\n      const projects = await getItems(KEYS.PROJECTS);\n      const filtered = projects.filter(