{"dependencies":[{"name":"./manualIcons","data":{"asyncType":null,"isESMImport":true,"locs":[{"start":{"line":1,"column":0,"index":0},"end":{"line":1,"column":67,"index":67}}],"key":"HMjYmNx/3OwtIpbEGZ6tP5/43QI=","exportNames":["*"],"imports":1}}],"output":[{"data":{"code":"__d(function (global, require, _$$_IMPORT_DEFAULT, _$$_IMPORT_ALL, module, exports, _dependencyMap) {\n  \"use strict\";\n\n  Object.defineProperty(exports, '__esModule', {\n    value: true\n  });\n  Object.defineProperty(exports, \"QUICK_START\", {\n    enumerable: true,\n    get: function () {\n      return QUICK_START;\n    }\n  });\n  Object.defineProperty(exports, \"MANUAL\", {\n    enumerable: true,\n    get: function () {\n      return MANUAL;\n    }\n  });\n  Object.defineProperty(exports, \"getManual\", {\n    enumerable: true,\n    get: function () {\n      return getManual;\n    }\n  });\n  Object.defineProperty(exports, \"manualHtml\", {\n    enumerable: true,\n    get: function () {\n      return manualHtml;\n    }\n  });\n  var _manualIcons = require(_dependencyMap[0], \"./manualIcons\");\n  // Bedienungsanleitung Aufmaßprofi – gemeinsame Inhalte für Hilfe-Seite und PDF\n\n  const QUICK_START = [{\n    title: 'Hinweise bestätigen',\n    text: 'Beim ersten Start die Hinweise lesen, Häkchen setzen und „App starten“ tippen.'\n  }, {\n    title: 'Firmendaten & Logo',\n    text: 'Einstellungen → Logo, Name und PDF-Einstellungen eintragen. Erscheinen später auf allen PDFs.'\n  }, {\n    title: 'Neues Projekt starten',\n    text: 'Auf der Startseite den großen blauen Button „Neues Projekt starten“ tippen, Namen eingeben, Kunde wählen oder neu anlegen, speichern.'\n  }, {\n    title: 'Aufmaß erfassen',\n    text: 'Im Projekt Skizzen zeichnen, Fotos aufnehmen und Checklisten ausfüllen'\n  }, {\n    title: 'Termin planen',\n    text: 'Startseite „+ Termin“ oder im Projekt „Termin planen“ – mit Erinnerung und Navi-Adresse.'\n  }, {\n    title: 'PDF erstellen & teilen',\n    text: 'Im Projekt „Projekt-PDF“ wählen und per Mail, WhatsApp oder in Dateien weitergeben.'\n  }, {\n    title: 'Daten sichern',\n    text: 'Regelmäßig unter Backup „Backup erstellen & teilen“ – alle Daten liegen nur auf deinem Gerät.'\n  }];\n  const MANUAL = [{\n    id: 'versionen',\n    icon: 'ribbon-outline',\n    color: '#d97706',\n    title: 'Basic und Pro – was ist enthalten?',\n    pro: true,\n    intro: 'Aufmaßprofi gibt es als Basic und als Pro. Mit „PRO“ markierte Kapitel und Schritte gibt es nur in der Pro-Version.',\n    steps: [{\n      text: 'Basic: Projekte, Kunden, Termine mit Erinnerungen, Skizzen mit Flächenberechnung, Fotos mit Beschriftung, Checklisten, Projekt-PDF und Backup.'\n    }, {\n      text: 'Checklisten in Basic: bis zu 3 Vorlagen, 10 Hauptpunkte und 5 Unterpunkte je Checkliste.',\n      info: 'In Pro sind Vorlagen und Punkte unbegrenzt. Dazu kommen verschachtelte Unterpunkte, Logos, Druckbild, Vorschau, Verknüpfungen, Berechnungen und Import/Export von Vorlagen.'\n    }, {\n      text: 'Pro zusätzlich: Dach-Aufmaß, Flächen-Kalkulator, Fotomessung, Dokumente, Rapporte mit Mitarbeitern, Material und Maschinen, Referenzen sowie Projekte exportieren, importieren und verschieben.',\n      pro: true\n    }, {\n      text: 'In dieser Anleitung sind Pro-Funktionen mit „PRO“ gekennzeichnet.',\n      info: 'Deine bisherigen Daten bleiben beim Wechsel von Basic auf Pro vollständig erhalten.'\n    }]\n  }, {\n    id: 'start',\n    icon: 'home-outline',\n    color: '#1565c0',\n    title: 'Die Startseite',\n    intro: 'Dein Überblick über Projekte, Termine und schnelle Aktionen.',\n    steps: [{\n      text: 'Oben: Suche (Lupe), Backup (Wolke) und Profil/Einstellungen.'\n    }, {\n      text: '„Neues Projekt starten“ ist der wichtigste Einstieg – hier beginnt jedes Aufmaß.'\n    }, {\n      text: 'Darunter: „Kunde anlegen“ und „Checklisten“ als Schnellaktionen.'\n    }, {\n      text: '„Heute“ zeigt die Termine des Tages, „Nächste 7 Tage“ die kommende Woche. „Kalender“ öffnet die Monatsansicht.',\n      info: 'Tippe einen Termin an, um ihn zu bearbeiten. Das Navi-Symbol neben der Adresse startet die Navigation.'\n    }, {\n      text: 'Zahlen-Kacheln zeigen, wie viele Projekte in Anfrage, Angebot, Ausführung oder fertig sind.'\n    }, {\n      text: 'Ordner und „Letzte Projekte“ führen direkt in deine Arbeit.'\n    }, {\n      text: 'Nach unten ziehen aktualisiert die Startseite.'\n    }],\n    tips: ['Ein gelber Hinweis erinnert dich an ein fälliges Backup – mit „Sichern“ geht es sofort, mit X wird er 24 Std. ausgeblendet.']\n  }, {\n    id: 'kunden',\n    icon: 'people-outline',\n    color: '#0284c7',\n    title: 'Kunden anlegen',\n    intro: 'Kunden einmal anlegen und in Projekten und Terminen wiederverwenden.',\n    steps: [{\n      text: 'Startseite → „Kunde anlegen“ oder Kunden → „+“.'\n    }, {\n      text: 'Kundentyp, Anrede, Vor- und Nachname (Pflicht), Adresse, Telefon und E-Mail eintragen.',\n      info: 'Die Kundennummer (z. B. KD-26001) wird automatisch vergeben, wenn du das Feld leer lässt.'\n    }, {\n      text: 'Alternativ „Aus Kontakten importieren“ – übernimmt Name, Telefon und Adresse aus deinem Telefonbuch.',\n      info: 'Die App fragt einmalig nach Zugriff auf deine Kontakte. Ohne Erlaubnis kannst du alles manuell eintragen.'\n    }, {\n      text: '„Kunde erstellen“ speichert.'\n    }]\n  }, {\n    id: 'projekte',\n    icon: 'folder-open-outline',\n    color: '#2e7d32',\n    title: 'Projekte',\n    intro: 'Ein Projekt bündelt alles zu einer Baustelle: Skizzen, Fotos, Dachflächen, Checklisten, Rapporte und Dokumente.',\n    steps: [{\n      text: '„Neues Projekt starten“ tippen und einen Projektnamen eingeben (z. B. „Dachsanierung Hauptstraße“).'\n    }, {\n      text: 'Kunde auswählen oder direkt neu anlegen.'\n    }, {\n      text: 'Objektadresse eintragen, wenn die Baustelle nicht an der Kundenadresse liegt.',\n      info: 'Die Objektadresse kannst du beim Kunden speichern und später wieder auswählen (z. B. „Garage“, „Ferienhaus“).'\n    }, {\n      text: 'Speichern – das Projekt öffnet sich in den Projektdetails.'\n    }, {\n      text: 'Status setzen (Anfrage, Angebot, Ausführung, Fertig), damit die Startseite den Überblick behält.'\n    }, {\n      text: 'Projekte in Ordner sortieren: in der Projektliste ein Projekt gedrückt halten und auf einen Ordner ziehen.',\n      info: 'Ordner legst du in der Projektliste an. „Ohne Ordner“ zeigt alle noch nicht sortierten Projekte.'\n    }, {\n      text: 'Dokumente (z. B. Pläne, Angebote als PDF) im Projekt unter „Dokumente“ ablegen.',\n      pro: true\n    }],\n    tips: ['Fertige Projekte archivieren hält die Liste übersichtlich – Archiv findest du in den Einstellungen.', 'Gelöschtes landet zuerst im Papierkorb und kann wiederhergestellt werden.']\n  }, {\n    id: 'skizzen',\n    icon: 'create-outline',\n    color: '#7b1fa2',\n    title: 'Skizzen zeichnen',\n    intro: 'Grundrisse, Ansichten und Dachskizzen mit echten Maßen direkt auf dem Handy oder Tablet zeichnen.',\n    steps: [{\n      text: 'Im Projekt „Skizze“ → neue Skizze anlegen und oben einen Titel vergeben (z. B. „EG Grundriss“).'\n    }, {\n      text: 'Werkzeugleiste: Stift (frei), Linie, Rechteck, Kreis, Polygon (Fläche aus Punkten), Maßlinie, Text und Foto. Auf dem Handy die Leiste seitlich wischen.',\n      info: 'Das aktive Werkzeug ist farbig hervorgehoben. Unter Einstellungen → „Skizzen-Werkzeuge benennen“ kannst du die Namen an deine Begriffe anpassen.'\n    }, {\n      text: 'Linie zeichnen: Werkzeug „Linie“ wählen, Finger am Startpunkt aufsetzen und zum Endpunkt ziehen.',\n      info: 'Mit „Winkel“ rasten Linien in festen Winkelschritten ein (z. B. 90°, 45°). Das Raster hilft zusätzlich, sauber gerade zu zeichnen.'\n    }, {\n      text: 'Maße eintragen: Linie oder Grundriss-Seite antippen → „Maß eingeben“ und die echte Länge eintragen (z. B. 4,50 m). Das Maß wird an der Linie angezeigt – die gezeichnete Länge ändert sich dabei nicht.',\n      info: 'Du kannst m, cm oder mm eingeben. Über „Winkel anpassen“ lässt sich der Winkel einer Linie exakt setzen.'\n    }, {\n      text: 'Maßlinie: zeigt einen Abstand mit Pfeilspitzen an, ohne die Zeichnung zu verändern – ideal für Fenster, Türen oder Abstände.'\n    }, {\n      text: 'Flächen (m²): Raum mit dem Grundriss-Werkzeug Ecke für Ecke zeichnen und mit „Schließen“ abschließen. Dann jede Seite antippen und ihr Maß eintragen.',\n      info: 'Die m² werden erst berechnet, wenn der Grundriss geschlossen ist und ALLE Seiten ein Maß haben – aus deinen Maßen, nicht aus der gezeichneten Größe. Rechtecke, Kreise und freie Linien bekommen keine m²-Berechnung. Mit „+Pkt“ / „-Pkt“ fügst du Ecken hinzu oder entfernst sie.'\n    }, {\n      text: 'Raumname: Fläche antippen und umbenennen, z. B. „Wohnzimmer“. Name und m² erscheinen direkt im Grundriss.',\n      info: 'Die m² werden automatisch angezeigt (über das Auge im Maß-Fenster ausblendbar). Unter der Skizze steht im PDF eine Flächenliste mit Umfang und Fläche plus Gesamtsumme (mit Wandhöhen heißt sie Raumliste).'\n    }, {\n      text: 'Text & Notizen: Mit „Text“ Beschriftungen setzen (Schriftart, Größe, Farbe wählbar). „Notizen zur Skizze“ speichert Hinweise, die nicht in der Zeichnung stehen sollen.'\n    }, {\n      text: 'Bearbeiten: Element antippen → verschieben, „Stil ändern“ (Farbe, Strichstärke) oder „Element löschen“. „Alles löschen“ leert die Seite nach Rückfrage.'\n    }, {\n      text: 'Fotos einfügen: „Foto“ → Kamera, Galerie, Dateien oder Projektfoto. Das Foto wird auf Seitenbreite skaliert und kann zugeschnitten werden.'\n    }, {\n      text: 'Raster: Größe (klein/groß) und Sichtbarkeit (schwach/stark) einstellen.'\n    }, {\n      text: 'Zoom an/aus: Grün = Zoom aktiv, dann mit zwei Fingern vergrößern und verschieben. Rot = Zoom aus, damit beim Zeichnen nichts verrutscht.'\n    }, {\n      text: 'Vor-Zurück: Rückgängig und Wiederholen für die letzten Schritte.'\n    }, {\n      text: 'Speichern mit dem Haken oben rechts – die Skizze erscheint im Projekt und im Projekt-PDF.'\n    }],\n    tips: ['Erst grob zeichnen, dann Maße eintragen – das geht schneller als exakt zu zeichnen.', 'Für große Grundrisse lieber mehrere Skizzen (z. B. pro Etage) anlegen – das bleibt übersichtlich und schnell.']\n  }, {\n    id: 'skizzen-knoepfe',\n    icon: 'apps-outline',\n    color: '#7b1fa2',\n    title: 'Skizze: Alle Knöpfe erklärt',\n    intro: 'Jeder Knopf im Skizzen-Editor mit seinem Symbol und wozu er gut ist – von oben nach unten und von links nach rechts.',\n    steps: [{\n      icon: 'arrow-back',\n      iconColor: '#1565c0',\n      text: 'Zurück (oben links): Verlässt die Skizze. Sind Änderungen offen, fragt die App vorher nach.'\n    }, {\n      icon: 'square-outline',\n      iconColor: '#1565c0',\n      text: 'PDF (oben): Wechselt die Größe der Skizze im PDF – klein (3 pro Zeile), mittel (2 pro Zeile) oder groß (1 pro Zeile).'\n    }, {\n      icon: 'play-circle-outline',\n      iconColor: '#1565c0',\n      text: 'Demo (oben): Spielt eine kurze Vorführung des Skizzen-Editors ab.'\n    }, {\n      icon: 'help',\n      iconColor: '#1565c0',\n      text: '? (oben): Öffnet diese Anleitung.'\n    }, {\n      icon: 'checkmark',\n      iconColor: '#1565c0',\n      text: 'Haken (oben rechts): Speichert die Skizze und schließt den Editor.'\n    }, {\n      icon: 'camera',\n      iconColor: '#4caf50',\n      text: 'Foto: Nimmt ein Foto auf und legt es in die Skizze, z. B. zum Bemaßen.'\n    }, {\n      icon: 'images',\n      iconColor: '#1976d2',\n      text: 'Foto aus Projekt: Holt ein bereits im Projekt gespeichertes Foto in die Skizze.'\n    }, {\n      icon: 'image',\n      iconColor: '#9C27B0',\n      text: 'Aus Galerie: Fügt ein Bild aus der Foto-Galerie des Geräts ein.'\n    }, {\n      icon: 'document',\n      iconColor: '#FF5722',\n      text: 'Aus Dateien: Fügt ein Bild aus der Dateien-App ein.'\n    }, {\n      icon: 'move',\n      iconColor: '#FF9800',\n      text: 'Position: Foto-Modus zum Verschieben des eingefügten Bildes. Nochmal antippen beendet den Modus.'\n    }, {\n      icon: 'crop-outline',\n      iconColor: '#9C27B0',\n      text: 'Zuschneiden: Schneidet das eingefügte Bild auf einen Ausschnitt zu.'\n    }, {\n      icon: 'search',\n      iconColor: '#e53935',\n      text: 'Zoom: Schaltet den Zoom an oder aus. Grün = aktiv, dann mit zwei Fingern vergrößern und verschieben. Rot = aus, damit beim Zeichnen nichts verrutscht.'\n    }, {\n      icon: 'hand-left',\n      iconColor: '#1976d2',\n      text: 'Bearbeiten (Hand): Auswählen statt zeichnen: Element antippen und verschieben, Linie eines Raums antippen öffnet das Maß-Fenster, Doppeltipp öffnet Text, Pfeil oder Notiz zum Ändern.'\n    }, {\n      icon: 'locate',\n      iconColor: '#1976d2',\n      text: 'Punkte: Nur Ecken verschieben: Im Bearbeiten-Modus zusätzlich einschalten, dann lassen sich Eckpunkte ziehen, ohne dass sich das Maß-Fenster öffnet.'\n    }, {\n      icon: 'swap-horizontal',\n      iconColor: '#333',\n      text: 'M (Maßpfeil): Zieht einen frei platzierten Maßpfeil und fragt danach das Maß ab – für Maße, die zu keinem Raum gehören.'\n    }, {\n      icon: 'git-network-outline',\n      iconColor: '#333',\n      text: 'Polygon: Zeichnet Linienzüge und Räume Ecke für Ecke. Abschluss im kleinen Fenster: „Linie“ (offen, Laufmeter) oder „Raum“ (geschlossen, m²).'\n    }, {\n      icon: 'add-circle-outline',\n      iconColor: '#4caf50',\n      text: '+Pt: Fügt auf einer Linie eines Polygons einen zusätzlichen Eckpunkt ein.'\n    }, {\n      icon: 'remove-circle-outline',\n      iconColor: '#f44336',\n      text: '-Pt: Entfernt einen Eckpunkt aus einem Polygon.'\n    }, {\n      icon: 'trash',\n      iconColor: '#f44336',\n      text: 'Element löschen: Löscht das gerade ausgewählte Element (mit Rückfrage). Grau, solange nichts ausgewählt ist.'\n    }, {\n      icon: 'color-palette',\n      iconColor: '#1976d2',\n      text: 'Stil: Ändert Farbe und Strichstärke des ausgewählten Elements.'\n    }, {\n      icon: 'create',\n      iconColor: '#333',\n      text: 'Stift: Freihand zeichnen.'\n    }, {\n      icon: 'remove',\n      iconColor: '#333',\n      text: 'Linie: Gerade Linie ziehen. Erneutes Antippen öffnet die Auswahl Linie, Pfeil oder Doppelpfeil.'\n    }, {\n      icon: 'ellipse-outline',\n      iconColor: '#333',\n      text: 'Kreis: Kreis aufziehen.'\n    }, {\n      icon: 'square-outline',\n      iconColor: '#333',\n      text: 'Rechteck: Rechteck aufziehen.'\n    }, {\n      icon: 'compass-outline',\n      iconColor: '#e65100',\n      text: 'Winkel: Blendet den Winkelmesser ein: Griffe an die Schenkel ziehen, Winkel ablesen und bei Bedarf in die Skizze übernehmen.'\n    }, {\n      icon: 'arrow-forward',\n      iconColor: '#e91e63',\n      text: 'Zeiger: Setzt einen Hinweispfeil mit Beschriftung auf eine Stelle.'\n    }, {\n      icon: 'text',\n      iconColor: '#333',\n      text: 'Text: Tippe auf die Skizze und schreibe einen Text dorthin.'\n    }, {\n      icon: 'chatbox-outline',\n      iconColor: '#E74C3C',\n      text: 'Memo: Setzt eine Notiz (Memo) an eine Stelle der Skizze.'\n    }, {\n      icon: 'document-text-outline',\n      iconColor: '#333',\n      text: 'Notizen: Freier Notiztext zur ganzen Skizze. Ein grüner Haken zeigt, dass Notizen vorhanden sind.'\n    }, {\n      icon: 'ellipse',\n      iconColor: '#e53935',\n      text: 'Farbe und Strichstärke: Der farbige Punkt öffnet die Farbauswahl, die Punkte daneben stellen die Strichstärke für neue Elemente ein.'\n    }, {\n      icon: 'grid',\n      iconColor: '#7b1fa2',\n      text: 'Raster: Blendet das Hilfsraster ein oder aus. Langes Drücken öffnet die Raster-Einstellungen. Mit Hintergrundbild ist das Raster nicht verfügbar.'\n    }, {\n      icon: 'arrow-undo',\n      iconColor: '#1976d2',\n      text: 'Rückgängig: Nimmt den letzten Schritt zurück.'\n    }, {\n      icon: 'arrow-redo',\n      iconColor: '#1976d2',\n      text: 'Wiederholen: Stellt einen zurückgenommenen Schritt wieder her.'\n    }, {\n      icon: 'trash-bin',\n      iconColor: '#f44336',\n      text: 'Alles löschen: Leert die ganze Skizze (mit Rückfrage).'\n    }, {\n      icon: 'git-branch-outline',\n      iconColor: '#1976d2',\n      text: 'Winkel (Polygon-Fenster): Winkel-Einrasten beim Zeichnen: neue Linien rasten auf den gewählten Winkel ein (30°, 45°, 60°, 90°, 120° oder eigener Wert).'\n    }, {\n      icon: 'grid-outline',\n      iconColor: '#4caf50',\n      text: 'Raster (Polygon-Fenster): Punkte rasten beim Zeichnen auf das Raster ein.'\n    }, {\n      icon: 'checkmark',\n      iconColor: '#4caf50',\n      text: 'Linie (Polygon-Fenster): Beendet den Linienzug offen. Die Übersicht zeigt die Einzelmaße und die Summe in Laufmetern.'\n    }, {\n      icon: 'link',\n      iconColor: '#2196f3',\n      text: 'Raum (Polygon-Fenster): Schließt den Linienzug zum Raum – mit Fläche in m², Wandhöhe, Türen und Fenstern.'\n    }, {\n      icon: 'options',\n      iconColor: '#1976d2',\n      text: 'Mehr (Maß-Fenster): Klappt die Zusatzfunktionen auf: Laser, Ton, Tutorial, Wandhöhe, Winkel und Diagonalen, Geraderücken, Laser-Protokoll, Maßlinien-Darstellung.'\n    }, {\n      icon: 'keypad',\n      iconColor: '#1976d2',\n      text: 'Tastatur (Maß-Fenster): Blendet den Ziffernblock im Maß-Fenster ein oder aus. S / M / L ändert seine Größe, ABC schaltet auf Buchstaben.'\n    }, {\n      icon: 'add-circle',\n      iconColor: '#1976d2',\n      text: 'Hinzufügen / Fertig (Maß-Fenster): Schreibt das eingetippte Maß an die gewählte Linie. Ist das Feld leer, schließt der Knopf das Fenster.'\n    }, {\n      icon: 'trash-outline',\n      iconColor: '#f44336',\n      text: 'Maß löschen (Maß-Fenster): Entfernt das Maß der gewählten Linie.'\n    }],\n    tips: ['Schnellhilfe: Einen Knopf der Werkzeugleiste lange gedrückt halten – eine Sprechblase erklärt, wozu er gut ist.', 'Die Werkzeugleiste lässt sich auf dem Handy seitlich wischen – dort liegen weitere Knöpfe.', 'Die Namen einiger Knöpfe (z. B. Zeiger- und Memo-Kürzel) kannst du in den Einstellungen anpassen; das Symbol bleibt gleich.']\n  }, {\n    id: 'raeume',\n    icon: 'grid-outline',\n    color: '#5d4037',\n    title: 'Räume: Linien, Punkte, Winkel, Wände, Türen & Fenster',\n    intro: 'Alles rund um geschlossene Räume (Polygone): Linien anwählen, Ecken verschieben, genaue Flächen bei schiefen Räumen, Wandflächen mit Abzügen für Türen und Fenster.',\n    steps: [{\n      text: 'Linie anwählen: Auf „Bearbeiten“ (Hand) wechseln und eine Linie des Raums antippen. Das Maß-Fenster öffnet sich, die gewählte Linie ist orange und oben steht „Linie x von n“.',\n      info: 'Das Maß-Fenster lässt sich an der Kopfzeile verschieben. „Mehr“ klappt die Zusatzfunktionen auf, „Tastatur“ blendet den Ziffernblock ein oder aus.'\n    }, {\n      text: 'Punkte verschieben: „Punkte“ in der Werkzeugleiste einschalten und eine Ecke ziehen. In diesem Modus öffnet sich kein Maß-Fenster, so verrutscht nichts versehentlich.',\n      info: 'Die Fläche ändert sich beim Verschieben nicht – sie wird nur aus deinen Maßen, Winkeln und Diagonalen gerechnet, nicht aus der Zeichnung.'\n    }, {\n      text: 'Genaue Fläche bei schiefen Räumen: Im Maß-Fenster unter „Mehr“ gibt es drei Wege – „Alle Ecken rechtwinklig“, „Winkel angeben“ oder „Diagonalen angeben“.',\n      info: 'Ein Raum mit n Seiten braucht neben den Seitenlängen nur n − 3 Zusatzangaben (Viereck: 1 Winkel oder 1 Diagonale). Alles Weitere ergibt sich rechnerisch.'\n    }, {\n      text: 'Berechnete Werte: Unter jedem Winkel- und Diagonalen-Feld steht der rechnerische Wert – „=“ wenn der Raum eindeutig bestimmt ist, „≈“ solange es eine Näherung aus der Zeichnung ist.',\n      info: 'Passt eine Angabe nicht zu den Seiten und den früheren Angaben (mehr als 2 cm bzw. 1° daneben), wird sie rot markiert und nicht verwendet. Die frühere Eingabe hat Vorrang.'\n    }, {\n      text: 'Diagonale wählen: „Diagonale: zwei Ecken antippen“ drücken und dann zwei Ecken in der Skizze tippen. Die Diagonale wird gestrichelt gezeichnet, bis zum Messen mit „?“.',\n      info: 'Nach dem Verschieben einer Ecke legt die App die passende Diagonale automatisch an und springt direkt in ihr Eingabefeld.'\n    }, {\n      text: 'Ecke antippen: Ist das Maß-Fenster offen und „Winkel angeben“ eingeschaltet, wählt ein Tipp auf eine Ecke das passende Winkel-Feld.',\n      info: 'Das gewählte Winkel- oder Diagonalen-Feld wird in der Skizze orange hervorgehoben. Zum Verschieben der Ecke in dieser Situation den „Punkte“-Modus einschalten.'\n    }, {\n      text: 'Skizze geraderücken: Zieht die Zeichnung auf die berechnete Form, damit Bild und Maße zusammenpassen. Die gerade gewählte Linie bleibt an ihrem Platz.',\n      info: '„Alle Räume geraderücken“ erledigt das für alle eindeutig bestimmten Räume der Skizze. Ragt ein Raum danach über den Rand, rutscht er zurück in die Zeichenfläche. Mit Rückgängig nimmst du es zurück. Funktioniert auch für Dreiecke.'\n    }, {\n      text: 'Wandhöhe: Im Maß-Fenster „Mehr“ → „Wandhöhe“ aufklappen. „Höhe alle Linien“ gilt für den ganzen Raum, „Höhe diese Linie“ nur für die gewählte Wand.',\n      info: 'Mit Wandhöhe bekommen die Linien Nummern in der Skizze. Ein Tipp auf eine Nummer öffnet direkt den Wand-Bereich dieser Linie. Die Nummern lassen sich über „Linien-Nummern“ ausblenden.'\n    }, {\n      text: 'Tür oder Fenster einfügen: Eine Linie etwa eine halbe Sekunde gedrückt halten und Tür, Fenster oder Sonstiges wählen – die Öffnung sitzt an der gedrückten Stelle. Alternativ im Wand-Bereich „+ Tür“, „+ Fenster“ oder „Eigenes Maß“.',\n      info: 'Breite × Höhe wird als Abzug von der Wandfläche gerechnet. Zusätzlich gibt es „Weiterer Abzug diese Linie (m²)“ für freie Flächen.'\n    }, {\n      text: 'Öffnung in der Skizze: Jede Öffnung erscheint als Markierung auf ihrer Linie – T = Tür (braun gestrichelt), F = Fenster (blau), S = Sonstiges (grau), dazu Breite × Höhe und der Abstand zur Ecke.',\n      info: 'Die Art stellst du im Wand-Bereich über die Schalter Tür / Fenster / Sonst. ein.'\n    }, {\n      text: 'Öffnung ändern: Markierung kurz antippen – das Maß-Fenster springt zur Öffnung und das Breite-Feld ist gewählt. Die erste getippte Ziffer ersetzt den alten Wert.'\n    }, {\n      text: 'Öffnung verschieben: Markierung auf der Linie ziehen. Sie stößt an Ecken und Nachbaröffnungen an, eine Maßkette zeigt die Abstände zu beiden Ecken.',\n      info: 'Der Abstand ab Linienanfang wird gespeichert und lässt sich im Feld „Abstand ab Linienanfang“ auch direkt eintippen. Dafür braucht die Linie ein Maß und die Öffnung eine Breite.'\n    }, {\n      text: 'Warnung: Ragt eine Öffnung mit dem eingetippten Abstand über die Linie hinaus oder überlappt sie eine andere, wird das Feld rot und die Beschriftung in der Skizze bekommt ein ⚠.',\n      info: 'Die Warnung ist nur ein Hinweis – der Abzug wird trotzdem gerechnet.'\n    }, {\n      text: 'Öffnung kopieren: Im Wand-Bereich „Auf andere Linie kopieren“ tippen und danach die Ziel-Linie in der Skizze antippen. Die Kopie hat gleiche Art, Breite und Höhe.'\n    }, {\n      text: 'Linie statt Raum: Beim Zeichnen mit „Polygon“ erscheint ein kleines Fenster mit zwei Abschlüssen – grün „Linie“ beendet den Linienzug offen, blau „Raum“ schließt ihn zur Fläche.',\n      info: 'Ein offener Linienzug wird in Laufmetern gerechnet: In der Übersicht stehen die Einzelmaße und die Summe, z. B. „4,00 + 3,00 + 2,50 = 9,50 lfm“. Ein Raum zeigt Umfang und m².'\n    }, {\n      text: 'Im PDF: Unter der Skizze steht die Wandliste – je Wand Länge, Höhe, Abzüge (mit Art und Abstand zur Ecke) und Netto-Fläche, dazu die Summe. Gemessene Diagonalen und die Öffnungen sind auch im Skizzenbild zu sehen.'\n    }],\n    tips: ['Reihenfolge, die sich bewährt: Raum zeichnen → alle Seiten bemaßen → eine Diagonale messen → geraderücken → Wandhöhe → Türen und Fenster.', 'Im Maß-Fenster unter „Mehr“ und hier im Kapitel gibt es ein Bild-Tutorial zu genau diesen Schritten. Es erscheint einmalig automatisch nach dem ersten geschlossenen Raum.', 'Zum Mitmachen: Im Tutorial (hier in der Hilfe oder in der Skizze) auf „Selbst ausprobieren (Übungsskizze)“ tippen. Die App führt dich Schritt für Schritt durch eine leere Übungsskizze – deine eigene Skizze kommt danach unverändert zurück, gespeichert wird in der Übung nichts.']\n  }, {\n    id: 'laser',\n    icon: 'bluetooth-outline',\n    color: '#0277bd',\n    title: 'Laser-Entfernungsmesser (Bluetooth)',\n    intro: 'Maße direkt vom Laser-Entfernungsmesser (z. B. Leica DISTO im Tastatur-Modus) in die Skizze übernehmen.',\n    steps: [{\n      text: 'Laser in den iOS- bzw. Android-Bluetooth-Einstellungen als Tastatur koppeln. In der Skizze eine Linie antippen, damit das Maß-Fenster offen ist.'\n    }, {\n      text: 'Messen: Der Wert erscheint im Maß-Feld. Mit „Laser sofort übernehmen“ wird er ohne weiteres Tippen an die Linie geschrieben.',\n      info: 'Ein grüner Haken, ein Ton und (auf dem Handy) eine kurze Vibration bestätigen die Übernahme. Ton und Lautstärke stellst du über „Ton“ ein.'\n    }, {\n      text: '„Nächste Linie“: springt nach jeder Messung automatisch zur nächsten Seite – so misst du einen Raum reihum, ohne das Gerät zu berühren.',\n      info: 'Mit „Zurück“ nimmst du die letzte Messung zurück und landest wieder auf der vorherigen Linie.'\n    }, {\n      text: 'Auch Wandhöhe, Öffnungen, Winkel und Diagonalen lassen sich per Laser füllen: Feld antippen, messen.'\n    }, {\n      text: 'Laser-Protokoll: Unter „Mehr“ zeigt das Protokoll, welche Tasten der Laser gesendet hat und was die App daraus gemacht hat.',\n      info: 'Verschluckt das Betriebssystem das Komma, erkennt die App das an der Tastenfolge und korrigiert den Wert selbst. Bleibt doch einmal ein Wert ohne Komma stehen, hilft das Protokoll bei der Fehlersuche.'\n    }],\n    tips: ['Die Bildschirmtastatur bleibt bei verbundenem Laser ausgeblendet – getippt wird über den Ziffernblock im Maß-Fenster.', 'Laser und Töne lassen sich nur auf dem echten Gerät nutzen, nicht in der Web-Vorschau.']\n  }, {\n    id: 'fotos',\n    icon: 'camera-outline',\n    color: '#f57c00',\n    title: 'Fotos & Fotomessung',\n    intro: 'Baustellenfotos aufnehmen, beschriften und Maße direkt im Foto messen.',\n    steps: [{\n      text: 'Im Projekt „Fotos“ → Kamera oder Galerie wählen.',\n      info: 'Kamera- und Fotozugriff wird erst beim ersten Tippen erfragt. Bei Ablehnung kannst du die Erlaubnis über „Einstellungen öffnen“ nachträglich erteilen.'\n    }, {\n      text: 'Foto antippen → bearbeiten: Pfeile, Texte, Linien und Flächen einzeichnen.'\n    }, {\n      text: 'Fotomessung: Referenz setzen (bekannte Länge, z. B. Ziegel oder Zollstock), dann weitere Strecken messen.',\n      pro: true,\n      info: 'Je genauer die Referenz, desto genauer die Messung. Fotomessung ersetzt kein exaktes Aufmaß.'\n    }, {\n      text: 'Das erste Projektfoto dient als Vorschaubild in der Projektliste.'\n    }]\n  }, {\n    id: 'dach',\n    icon: 'triangle-outline',\n    color: '#dc2626',\n    title: 'Dachflächen & Flächen-Kalkulator',\n    pro: true,\n    intro: 'Dachflächen aus Gebäudemaßen und Neigung berechnen.',\n    steps: [{\n      text: 'Im Projekt „Dach-Aufmaß“ → Dachtyp wählen (z. B. Satteldach, Walmdach, Pultdach).'\n    }, {\n      text: 'Gebäudebreite, -länge und Dachneigung in Grad eintragen, optional Dachüberstände.'\n    }, {\n      text: 'Die App zeigt Dachfläche und Firsthöhe sofort an.'\n    }, {\n      text: 'Flächen-Kalkulator: beliebige Flächen mit Abzügen (z. B. Fenster, Gauben) berechnen – Ergebnis ist die Netto-Fläche.'\n    }],\n    tips: ['Alle Berechnungen dienen als Unterstützung – bitte vor der Verwendung selbst prüfen.']\n  }, {\n    id: 'checklisten',\n    icon: 'checkbox-outline',\n    color: '#7c3aed',\n    title: 'Checklisten',\n    intro: 'Wiederkehrende Prüfungen und Abnahmen mit Vorlagen erledigen.',\n    steps: [{\n      text: 'Startseite → „Checklisten“ zeigt deine Vorlagen.'\n    }, {\n      text: 'Vorlage bearbeiten oder neu anlegen: Punkte und Kategorien festlegen.',\n      info: 'In der Basic-Version: bis zu 3 Vorlagen, 10 Hauptpunkte und 5 Unterpunkte je Checkliste.'\n    }, {\n      text: 'Logo, Druckbild, Vorschau, Berechnungen und Verknüpfungen in Vorlagen nutzen sowie Vorlagen importieren/exportieren.',\n      pro: true\n    }, {\n      text: 'Im Projekt „Checkliste“ → Vorlage wählen und Punkt für Punkt abhaken, Fotos und Notizen ergänzen.'\n    }, {\n      text: 'Fertige Checklisten erscheinen im Projekt-PDF oder lassen sich einzeln exportieren.'\n    }]\n  }, {\n    id: 'termine',\n    icon: 'calendar-outline',\n    color: '#dc2626',\n    title: 'Termine & Erinnerungen',\n    intro: 'Baustellentermine planen und rechtzeitig erinnert werden.',\n    steps: [{\n      text: 'Startseite „+ Termin“ oder im Projekt „Termin planen“.'\n    }, {\n      text: 'Optional ein Projekt wählen, Titel eingeben, Datum (Heute/Morgen/Übermorgen oder Kalender) und Uhrzeit setzen.'\n    }, {\n      text: 'Notiz eintragen, z. B. „Kunde vorher anrufen“.'\n    }, {\n      text: '„Mitnehmen“: Checkliste, was du zum Termin brauchst – eigene Einträge tippen oder Vorschläge wie Leiter, Zollstock antippen. Abhaken, sobald eingepackt.',\n      info: 'Deine eigenen Einträge merkt sich die App als Vorschlag. Was noch nicht abgehakt ist, steht auch in der Erinnerung. Auf der Startseite zeigt ein Taschen-Symbol, wie viel schon eingepackt ist (z. B. 2/5) – antippen klappt die Liste zum direkten Abhaken auf.'\n    }, {\n      text: 'Mitnehmen-Vorlagen: Lila Knöpfe wie „Dach-Aufmaß“ oder „Abnahme“ übernehmen eine ganze Liste mit einem Tipp. „Liste als Vorlage speichern“ legt eigene Vorlagen an.',\n      info: 'Gleicher Name überschreibt eine Vorlage. Lange auf eine Vorlage drücken löscht sie.'\n    }, {\n      text: 'Adresse fürs Navi eintragen, über „Kunden“ übernehmen oder über „Telefonbuch“ einen Kontakt wählen – wahlweise als Kunde speichern oder nur im Termin merken.'\n    }, {\n      text: '„Erinnerung vor dem Termin“: 15 Min bis 1 Tag vorher oder „Eigene Zeit“ mit Kalender und Uhrzeit.',\n      info: 'Erinnerungen kommen als Mitteilung aufs Handy – auch wenn die App geschlossen ist. Die App fragt dafür einmalig um Erlaubnis.'\n    }, {\n      text: '„Fahrzeit“: Die App erinnert dich rechtzeitig zum Losfahren (Fahrzeit + 10 Min Puffer) – oder du wählst mit „Abfahrt wählen“ eine feste Zeit.'\n    }, {\n      text: 'Adresse antippen → Apple Karten, Google Maps oder Waze wählen.'\n    }, {\n      text: 'Aus einem Termin ohne Projekt kannst du mit „Projekt erstellen“ direkt ein Projekt machen – Kunde und Adresse werden übernommen.'\n    }],\n    tips: ['Die Monatsansicht findest du über „Kalender“ auf der Startseite.']\n  }, {\n    id: 'rapporte',\n    icon: 'document-text-outline',\n    color: '#0891b2',\n    title: 'Rapporte, Material & Mitarbeiter',\n    pro: true,\n    intro: 'Arbeitszeiten, Fahrten und Material zu einem Projekt erfassen.',\n    steps: [{\n      text: 'Im Projekt „Rapport“ anlegen: Datum, Mitarbeiter, Stunden und Fahrzeiten eintragen.'\n    }, {\n      text: 'Material aus der Materialliste oder aus Checklisten übernehmen.'\n    }, {\n      text: 'Briefkopf-Felder am Ende des Editors festlegen – „Als Standard speichern“ merkt die Auswahl.'\n    }, {\n      text: 'Mitarbeiter, Material und Maschinen pflegst du über die Kacheln der Startseite.',\n      info: 'Bei Maschinen kannst du TÜV-Termine hinterlegen – die Startseite erinnert dich rechtzeitig.'\n    }]\n  }, {\n    id: 'pdf',\n    icon: 'share-outline',\n    color: '#1d4ed8',\n    title: 'PDF & Weitergeben',\n    intro: 'Aus jedem Projekt ein sauberes PDF mit deinem Logo erstellen.',\n    steps: [{\n      text: 'Im Projekt „Projekt-PDF“ tippen und Inhalte auswählen (Skizzen, Fotos, Flächen, Checklisten …).'\n    }, {\n      text: 'Teilen per Mail, WhatsApp, AirDrop oder in „Dateien“ speichern.'\n    }, {\n      text: 'Logo, Firmendaten und Layout stellst du unter Einstellungen → PDF-Einstellungen ein.'\n    }, {\n      text: '„Projekt exportieren“ erstellt eine Datei, die ein Kollege mit Aufmaßprofi Pro importieren kann.',\n      pro: true\n    }, {\n      text: 'Referenzen: abgeschlossene Projekte mit Beispielfotos sammeln und Kunden zeigen.',\n      pro: true\n    }]\n  }, {\n    id: 'backup',\n    icon: 'cloud-upload-outline',\n    color: '#0891b2',\n    title: 'Datensicherung',\n    intro: 'Alle Daten liegen ausschließlich auf deinem Gerät – sichere sie regelmäßig.',\n    steps: [{\n      text: 'Backup → „Backup erstellen & teilen“ und die Datei z. B. in iCloud Drive, Google Drive oder per Mail sichern.'\n    }, {\n      text: 'Automatisches Backup und Erinnerung an neue Backups lassen sich dort einschalten.'\n    }, {\n      text: 'Wiederherstellen: „Aus Datei wiederherstellen“ und die Backup-Datei auswählen.',\n      info: 'Beim Wiederherstellen werden die aktuellen Daten durch den Stand der Sicherung ersetzt.'\n    }, {\n      text: 'Speicher-Bereinigung (Einstellungen) entfernt nicht mehr benötigte Daten und schafft Platz.'\n    }],\n    tips: ['Vor einem Handywechsel immer ein Backup erstellen und auf dem neuen Gerät wiederherstellen.']\n  }, {\n    id: 'einstellungen',\n    icon: 'settings-outline',\n    color: '#546e7a',\n    title: 'Einstellungen',\n    intro: 'App an deinen Betrieb anpassen.',\n    steps: [{\n      text: 'Sprache, Logo, PDF-Layout, Projekttypen und Werkzeugnamen anpassen.'\n    }, {\n      text: 'Archiv und Papierkorb verwalten.'\n    }, {\n      text: 'Pro-Version: Dach-Aufmaß, Fotomessung, Rapporte, Mitarbeiter, Material und weitere Funktionen.',\n      pro: true\n    }, {\n      text: 'Rechtliches: Datenschutz, Haftungsausschluss und Impressum.'\n    }]\n  }];\n\n  // Basic: Pro-Kapitel und -Schritte ausblenden\n  const getManual = isPro => isPro ? MANUAL : MANUAL.filter(sec => !sec.pro).map(sec => ({\n    ...sec,\n    steps: sec.steps.filter(s