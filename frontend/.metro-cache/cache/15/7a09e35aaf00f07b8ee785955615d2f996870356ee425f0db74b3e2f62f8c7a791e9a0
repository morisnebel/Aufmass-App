-note-icon {\n            margin-right: 1px;\n          }\n          .pdf-measurement {\n            background: #e3f2fd;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .photos-grid, .sketches-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n          }\n          /* Flexible photo/sketch containers */\n          .photos-container, .sketches-container {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 15px;\n            align-items: flex-start;\n          }\n          .photos-container::after, .sketches-container::after {\n            content: \"\";\n            display: table;\n            clear: both;\n          }\n          /* Photo page groups - jede Gruppe auf eigener Seite */\n          .photos-page-group {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .photos-page-group .photos-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n          }\n          .photos-page-group .photo-item {\n            max-height: 320px;\n            overflow: hidden;\n          }\n          .photos-page-group .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* Neue Foto-Seiten Layouts */\n          .photos-section {\n            margin-bottom: 15px;\n          }\n          /* Klein: 3 Spalten Grid */\n          .photos-section-small {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 8px;\n          }\n          .photos-section-small .photo-item {\n            page-break-inside: avoid;\n            break-inside