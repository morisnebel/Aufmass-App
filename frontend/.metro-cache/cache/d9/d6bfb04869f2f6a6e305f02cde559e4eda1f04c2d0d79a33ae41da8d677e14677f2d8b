        }\n          .pdf-category-count {\n            font-size: 9px;\n            color: #4caf50;\n            font-weight: 600;\n          }\n          .pdf-category-note {\n            background: #fff8e1;\n            padding: 4px 6px;\n            border-radius: 3px;\n            font-size: 9px;\n            color: #f57c00;\n            font-style: italic;\n            margin-bottom: 6px;\n          }\n          .pdf-category-measurements {\n            background: #e3f2fd;\n            padding: 4px 6px;\n            border-radius: 3px;\n            margin-bottom: 6px;\n          }\n          .pdf-measurement-line {\n            font-size: 9px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-bottom: 2px;\n          }\n          .pdf-measurement-sum {\n            margin-top: 4px;\n            padding-top: 4px;\n            border-top: 1px solid #90caf9;\n            font-size: 9px;\n            color: #1565c0;\n          }\n          .pdf-sum-badge {\n            background: #bbdefb;\n            padding: 2px 6px;\n            border-radius: 8px;\n            font-weight: 600;\n            margin-left: 4px;\n          }\n          .pdf-level1-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 6px;\n          }\n          .pdf-level1-container {\n            background: #fff;\n            border: 1px solid #e0e0e0;\n            border-left: 3px solid #1976d2;\n            border-radius: 4px;\n            padding: 6px;\n            box-sizing: border-box;\n          }\n          .pdf-level1-header {\n            display: flex;\n            align-items: center;\n            gap: 4px;\n            padding-bottom: 4px;\n            border-bottom: 1px solid #eee;\n            margin-bottom: 4px;\n          }\n          .pdf-level1-prefix {\n            background: #1976d2;\n            color: #fff;\n            font-size: 9px;\n            font-weight: 700;\n            padding: 1px 4px;\n  