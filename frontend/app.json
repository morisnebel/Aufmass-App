{
  "expo": {
    "name": "AUFMASSPROFI DACH",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aufmassprofi.dach",
      "infoPlist": {
        "NSContactsUsageDescription": "Kunden als Kontakte speichern",
        "NSPhotoLibraryUsageDescription": "Fotos in der Galerie speichern",
        "NSPhotoLibraryAddUsageDescription": "Aufmaß-Fotos in der Galerie speichern"
      }
    },
    "android": {
      "package": "com.aufmassprofi.dach",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
