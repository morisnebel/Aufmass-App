bjectNumber();\n  };\n\n  // ============ LAST USED PROJECT TYPE ============\n  const LAST_PROJECT_TYPE_KEY = 'aufmass_last_project_type';\n  const setLastUsedProjectType = async projectType => {\n    try {\n      await AsyncStorage.default.setItem(LAST_PROJECT_TYPE_KEY, projectType);\n    } catch (error) {\n      console.error('Error saving last project type:', error);\n    }\n  };\n  const getLastUsedProjectType = async () => {\n    try {\n      return await AsyncStorage.default.getItem(LAST_PROJECT_TYPE_KEY);\n    } catch (error) {\n      console.error('Error loading last project type:', error);\n      return null;\n    }\n  };\n  const CustomerService = {\n    getAll: async () => {\n      return getItems(KEYS.CUSTOMERS);\n    },\n    getById: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      return customers.find(c => c.id === id) || null;\n    },\n    create: async data => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      // Auto-generate customer number if not provided\n      const customerNumber = data.customer_number || (await generateCustomerNumber());\n      const newCustomer = {\n        ...data,\n        id: generateId(),\n        customer_number: customerNumber,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      customers.push(newCustomer);\n      await setItems(KEYS.CUSTOMERS, customers);\n      return newCustomer;\n    },\n    update: async (id, data) => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const index = customers.findIndex(c => c.id === id);\n      if (index === -1) return null;\n      customers[index] = {\n        ...customers[index],\n        ...data,\n        updated_at: new Date().toISOString()\n      };\n      await setItems(KEYS.CUSTOMERS, customers);\n      return customers[index];\n    },\n    delete: async id => {\n      const customers = await getItems(KEYS.CUSTOMERS);\n      const filtered = customers.filter(