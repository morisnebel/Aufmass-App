 align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            color: #999;\n          }\n          .empty {\n            color: #999;\n            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 4px;\n            padding: 6px 8px;\n            margin-top: 5px;\n            font-size: 8px;\n          }\n          .footer {\n            margin-top: 5px;\n            padding: 3px 0;\n            border-top: 1px solid ${accentColor};\n            font-size: 6px;\n            color: #999;\n            text-align: center;\n            font-weight: 400;\n            page-break-inside: avoid;\n            page-break-before: avoid;\n            break-before: avoid;\n            break-inside: avoid;\n          }\n          /* Wrapper um den letzten Inhalt und Footer, um sie zusammenzuhalten */\n          .footer-container {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          /* Footer im Druck nur anzeigen wenn genug Platz - sonst verstecken */\n          @media print {\n            .footer {\n              /* Footer wird nur gedruckt wenn er auf die Seite passt */\n              orphans: 3;\n              widows: 3;\n            }\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2px;\n            margin-top: 4px;\n          }\n          .measure-item {\n            font-size: 8px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 10px;\n            color: ${accentColor};\n            margin-bottom: 3px;\n          }\n          .roof-note