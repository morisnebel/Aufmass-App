n    }\n  };\n\n  // ============ DOCUMENTS (PDF with annotations) ============\n\n  // ============ Dokument-Bilder: separate Speicherung (OOM-Schutz) ============\n  // PDF-Seiten (imageData) und Original-PDFs (originalPdfData) werden unter\n  // eigenen Keys (doc_img_<id>) gespeichert – nicht mehr inline im Haupt-Array.\n  const DOC_IMG_PREFIX = '@docimg:';\n  const docStoreVal = (val, ops) => {\n    // Base64-Daten sind lang; Referenzen und kurze Strings unverändert lassen\n    if (val && typeof val === 'string' && val.length > 500 && !val.startsWith(DOC_IMG_PREFIX)) {\n      const key = `doc_img_${generateId()}`;\n      ops.push(AsyncStorage.default.setItem(key, val));\n      return DOC_IMG_PREFIX + key;\n    }\n    return val;\n  };\n  const docExtractImages = (doc, ops) => {\n    const out = {\n      ...doc\n    };\n    if ('originalPdfData' in out) out.originalPdfData = docStoreVal(out.originalPdfData, ops);\n    if (Array.isArray(out.pages)) {\n      out.pages = out.pages.map(p => ({\n        ...p,\n        imageData: docStoreVal(p.imageData, ops)\n      }));\n    }\n    return out;\n  };\n  const docCollectRefs = (doc, out) => {\n    const check = v => {\n      if (typeof v === 'string' && v.startsWith(DOC_IMG_PREFIX)) out.push(v.slice(DOC_IMG_PREFIX.length));\n    };\n    check(doc?.originalPdfData);\n    (Array.isArray(doc?.pages) ? doc.pages : []).forEach(p => check(p?.imageData));\n  };\n  const docRestoreImages = async doc => {\n    const refs = [];\n    docCollectRefs(doc, refs);\n    if (refs.length === 0) return doc;\n    const pairs = await AsyncStorage.default.multiGet(Array.from(new Set(refs)));\n    const map = new Map(pairs);\n    const resolve = v => typeof v === 'string' && v.startsWith(DOC_IMG_PREFIX) ? map.get(v.slice(DOC_IMG_PREFIX.length)) || '' : v;\n    return {\n      ...doc,\n      originalPdfData: resolve(doc.originalPdfData),\n      pages: (doc.pages || []).map(p => ({\n        ...p,\n        imageData: resolve(p.imageData)\n      