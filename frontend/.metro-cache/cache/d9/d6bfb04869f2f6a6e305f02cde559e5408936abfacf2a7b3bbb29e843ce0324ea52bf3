lex;\n            align-items: center;\n            gap: 10px;\n          }\n          .company-logo {\n            max-width: 120px;\n            max-height: 80px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>Tel: ${companyPhone}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <h2>Projektübersicht</h2>\n        <div class=\"info-grid\">\n          <div class=\"info-box\">\n            <h3>Projekt</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${project?.name || '-'}</span>\n            </div>\n            ${project?.description ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Beschreibung:</span>\n                <span class=\"info-value\">${project.description}</span>\n              </div>\n            ` : ''}\n            <div class=\"info-row\">\n              <span class=\"info-label\">Status:</span>\n              <span class=\"info-value\">${project?.status === 'aktiv' ? 'Aktiv' : project?.status === 'abgeschlossen' ? 'Abgeschlossen' : 'Abgebrochen'}</span>\n            </div>\n            ${objektStreet || objektPlz || objektCity || objektName || objektAddressName || objektContactPerson || objektPhone || objektEmail ? `\n              <div style=\"margin-top: 12px; padding-top: 12px; border-top: 1px solid #e0e0e0;\">\n                <strong style=\"color: #1976d2;\">Objektadresse${objektAddressName ? ` (${objektAddressName})` : ''}</strong>\n                ${objektName ? `<div style=\"margin-top: 4px;\"><strong>Name:</strong> ${objektName}</div>` : ''}\n                ${objektStreet ? `<div style=\"margin-top: 2px;\"><strong>Straße:</strong> ${objektStreet}</div>` : ''}\n                ${objektPlz || objektCity ? `<div><strong>PLZ/Ort:</strong> ${objektPlz || ''} ${objektCity || ''}</div>` : ''}\n                ${objektContactPerson ? `<div style=\"margin-top: 6px;\"><strong>Ansprechpartner:</strong> ${objektContactPerson}</div>` : ''}\n                ${objektPhone ? `<div><strong>Tel:</strong> ${objektPhone}</div>` : ''}\n                ${objektEmail ? `<div><strong>E-Mail:</strong> ${objektEmail}</div>` : ''}\n              </div>\n            ` : ''}\n          </div>\n          \n          <div class=\"info-box\">\n            <h3>Bauherr</h3>\n            ${bauherrName ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Name:</span>\n                <span class=\"info-value\">${bauherrName}</span>\n              </div>\n            ` : ''}\n            ${bauherrStreet ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Straße:</span>\n                <span class=\"info-value\">${bauherrStreet}</span>\n              </div>\n            ` : ''}\n            ${bauherrPlz || bauherrCity ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">PLZ/Ort:</span>\n                <span class=\"info-value\">${bauherrPlz || ''} ${bauherrCity || ''}</span>\n              </div>\n            ` : ''}\n            ${bauherrPhone ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Telefon:</span>\n                <span class=\"info-value\">${bauherrPhone}</span>\n              </div>\n            ` : ''}\n            ${bauherrMobile ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Mobil:</span>\n                <span class=\"info-value\">${bauherrMobile}</span>\n              </div>\n            ` : ''}\n            ${bauherrEmail ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">E-Mail:</span>\n                <span class=\"info-value\">${bauherrEmail}</span>\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <div class=\"stats-grid\">\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${roofs.length}</div>\n            <div class=\"stat-label\">Dachflächen</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${pdfTotalArea.toFixed(2)} m²</div>\n            <div class=\"stat-label\">Gesamtfläche</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${photos.length}</div>\n            <div class=\"stat-label\">Fotos</div>\n          </div>\n        </div>\n        \n        <div class=\"roofs-section\">\n          <h2>Dachflächen</h2>\n          ${roofsHtml}\n        </div>\n        \n        <div class=\"checklists-section checklists-page-break\">\n          <h2>Checklisten</h2>\n          ${checklistsHtml}\n        </div>\n        </div><!-- end .page -->\n        \n        ${photos.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"photos-section\">\n              <h2>Fotos</h2>\n              ${phot