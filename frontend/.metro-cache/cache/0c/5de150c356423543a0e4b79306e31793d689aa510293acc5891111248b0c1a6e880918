                  </div>\n                ` : ''}\n                ${objektStreet ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">Straße:</span>\n                    <span class=\"info-value\">${objektStreet}</span>\n                  </div>\n                ` : ''}\n                ${objektPlz || objektCity ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">PLZ/Ort:</span>\n                    <span class=\"info-value\">${objektPlz || ''} ${objektCity || ''}</span>\n                  </div>\n                ` : ''}\n                ${objektContactPerson ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">Ansprechpartner:</span>\n                    <span class=\"info-value\">${objektContactPerson}</span>\n                  </div>\n                ` : ''}\n                ${objektPhone ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">Tel:</span>\n                    <span class=\"info-value\">${objektPhone}</span>\n                  </div>\n                ` : ''}\n                ${objektEmail ? `\n                  <div class=\"info-row\">\n                    <span class=\"info-label\">E-Mail:</span>\n                    <span class=\"info-value\">${objektEmail}</span>\n                  </div>\n                ` : ''}\n              </div>\n            ` : ''}\n          </div>\n          \n          <div class=\"info-box\">\n            <h3>Bauherr</h3>\n            ${customer?.customer_number ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Kunden Nr.:</span>\n                <span class=\"info-value\" style=\"color: #1976d2; font-weight: 600;\">${customer.customer_number}</span>\n              </div>\n            ` : ''}\n            ${bauherrName ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Name:<