    };\n      }\n    },\n    // ---- OPTIMIZED: Save heavy data to separate keys ----\n    saveSketchData: async (id, metadata, backgroundImage) => {\n      try {\n        // Save metadata (without background image) to separate key\n        const metaWithoutBg = {\n          ...metadata\n        };\n        delete metaWithoutBg.backgroundImage;\n        const saveOps = [AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg))];\n\n        // Save background image to its own key\n        if (backgroundImage) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, backgroundImage));\n        } else {\n          // Remove old background if cleared\n          saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n        }\n        await Promise.all(saveOps);\n      } catch (error) {\n        console.error(`[SketchService] Error saving sketch data for ${id}:`, error);\n      }\n    },\n    create: async data => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const id = generateId();\n\n      // Extract heavy data before storing in main array\n      const heavyMetadata = data.metadata;\n      const lightSketch = {\n        ...data,\n        id,\n        metadata: undefined,\n        // Don't store metadata in main array\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      sketches.push(lightSketch);\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = {\n            ...meta\n          };\n          delete metaWithoutBg.backgroundImage;\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.defau