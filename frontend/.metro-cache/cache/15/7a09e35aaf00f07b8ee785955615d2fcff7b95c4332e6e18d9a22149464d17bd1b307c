iner';\n        const headingHtml = `<h2 class=\"photo-inline-heading\">${t('photos.title')}</h2>`;\n        if (isAndroidDevice) {\n          // ANDROID: Grid-Layout mit inline-block\n          // Klein: 3 nebeneinander, Mittel: 2 nebeneinander, Groß: 1 (volle Breite)\n          const photosBySize = {\n            small: [],\n            medium: [],\n            large: []\n          };\n          photos.forEach(photo => {\n            const size = photo.pdf_size || 'medium';\n            if (size === 'small') photosBySize.small.push(photo);else if (size === 'large' || size === 'full') photosBySize.large.push(photo);else photosBySize.medium.push(photo);\n          });\n          let photoListHtml = headingHtml;\n\n          // Kleine Fotos: 3 nebeneinander (33% Breite) - GRÖSSERE Bilder\n          if (photosBySize.small.length > 0) {\n            photoListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            photosBySize.small.forEach((photo, idx) => {\n              photoListHtml += `\n              <div style=\"display: inline-block; width: 32%; vertical-align: top; padding: 3px; box-sizing: border-box; font-size: 12px;\">\n                <div style=\"width: 100%;\">\n                  ${generatePhotoHtml(photo).replace(/max-height:\\s*\\d+px;?/g, 'max-height: 280px;').replace(/width:\\s*\\d+%;?/g, 'width: 100%;').replace(/<img/g, '<img style=\"width: 100%; height: auto; max-height: 280px; display: block;\"')}\n                </div>\n              </div>\n            `;\n            });\n            photoListHtml += `</div>`;\n          }\n\n          // Mittlere Fotos: 2 nebeneinander (50% Breite) - GRÖSSERE Bilder\n          if (photosBySize.medium.length > 0) {\n            photoListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            photosBySize.medium.forEach((photo, idx) => {\n              photoListHtml += `\n              <div style=\"display: inline-block; width: 49%; vertical-align: top; padding: 3px; box-sizing: border-box; font-size: 12px;\">\n                <div style=\"width: 100%;\">\n                  ${generatePhotoHtml(photo).replace(/max-height:\\s*\\d+px;?/g, 'max-height: 400px;').replace(/width:\\s*\\d+%;?/g, 'width: 100%;').replace(/<img/g, '<img style=\"width: 100%; height: auto; max-height: 400px; display: block;\"')}\n                </div>\n              </div>\n            `;\n            });\n            photoListHtml += `</div>`;\n          }\n\n          // Große Fotos: 1 pro Zeile (100% Breite), 2 untereinander pro Seite\n          if (photosBySize.large.length > 0) {\n            photoListHtml += `<div style=\"margin-bottom: 10px;\">`;\n            photosBySize.large.forEach((photo, idx) => {\n              photoListHtml += `\n              <div style=\"display: block; width: 100%; padding: 5px; box-sizing: border-box; margin-bottom: 10px;\">\n                <div style=\"width: 100%;\">\n                  ${generatePhotoHtml(photo).replace(/max-height:\\s*\\d+px;?/g, '').replace(/<img/g, '<img style=\"width: 100%; height: auto; max-height: 450px; display: block;\"')}\n                </div>\n              </div>\n            `;\n            });\n            photoListHtml += `</div>`;\n          }\n          photosHtml = `<div class=\"${photosContainerClass}\">${photoListHtml}</div>`;\n        } else {\n          // iOS/Web: Standard inline-block Layout\n          const firstPhotoHtml = generatePhotoHtml(photos[0]);\n          const restPhotoItems = photos.slice(1).map(photo => generatePhotoHtml(photo)).join('');\n          photosHtml = `<div class=\"${photosContainerClass}\" style=\"font-size: 0;\">${headingHtml}${firstPhotoHtml}${restPhotoItems}</div>`;\n        }\n      }\n\n      // Generate sketches HTML (embedded as base64/SVG) with size options\n      // iPhone: kleinere Skizzen (2 pro Seite) für bessere Kompatibilität\n      // iPad: normale Größe\n\n      const sketchItems = await Promise.all(sketches.map(async (sketch, index) => {\n        // Read pdf_size and notes from sketch object or metadata\n        let size = sketch.pdf_size || 'large';\n        let sketchNotes = sketch.notes || '';\n\n        // Metadata aus separatem Storage laden (zuverlässiger als sketch.metadata)\n        try {\n          let metadata = {};\n          const storedMeta = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (storedMeta) {\n            metadata = JSON.parse(storedMeta);\n          } else if (sketch.metadata) {\n            metadata = typeof sketch.metadata === 'string' ? JSON.parse(sketch.metadata) : sketch.metadata;\n          }\n          if (!size || size === 'large') {\n            if (metadata.pdf_size) {\n              size = metadata.pdf_size;\n            }\n          }\n          // Notes aus metadata als Fallback\n          if (!sketchNotes && metadata.notes) {\n            sketchNotes = metadata.notes;\n          }\n          // Memo-Elemente UND Pointer-Elemente: Text extrahieren (visuelle Notizen auf der Zeichenfläche)\n          if (!sketchNotes && metadata.elements && Array.isArray(metadata.elements)) {\n            const noteTexts = metadata.elements.filter(el => (el.type === 'memo' || el.type === 'pointer') && el.data?.text).map(el => el.data.text.trim()).filter(t => t.length > 0);\n            if (noteTexts.length > 0) {\n              sketchNotes = noteTexts.join(' | ');\n            }\n          }\n        } catch (e) {\n          console.log('Error parsing sketch metadata:', e);\n        }\n\n        // Größenklasse basierend auf pdf_size - für alle Geräte gleich\n        let sizeClass = 'sketch-large'; // Default\n        if (size === 'small') sizeClass = 'sketch-small';else if (size === 'medium') sizeClass = 'sketch-medium';else if (size === 'full') sizeClass = 'sketch-full';else sizeClass = 'sketch-large';\n\n        // Titel für Skizze\n        const sketchTitle = sketch.title || `Skizze ${index + 1}`;\n\n        // Notizen nur anzeigen wenn vorhanden - kompakt inline\n        const notesHtml = sketchNotes.trim() ? `<div class=\"sketch-notes sketch-notes-filled\">\n            <span class=\"sketch-notes-label\">Notizen: </span><span class=\"sketch-notes-text\">${sketchNotes.replace(/\\n/g, '<br>')}</span>\n          </div>` : '';\n        return `\n        <div class=\"sketch-item ${sizeClass}\">\n          ${index === 0 ? `<h2 class=\"sketch-inline-heading\">${t('sketches.title')}</h2>` : ''}\n          <p class=\"sketch-title\">${sketchTitle}</p>\n          ${sketch.sketch_data ? `<img src=\"${sketch.sketch_data}\" alt=\"Skizze\" />` : '<div class=\"sketch-placeholder\">Skizze</div>'}\n          ${notesHtml}\n        </div>\n      `;\n      }));\n\n      // Sketches-Container: iOS bekommt block/inline-block Layout für bessere Seitenumbrüche\n      // WebKit (iOS) ignoriert page-break-inside: avoid bei Flexbox-Containern\n      // Android: Tabellen-basiertes Grid-Layout\n      const sketchesContainerClass = isAndroidDevice ? 'sketches-container sketches-container-android' : isIphone ? 'sketches-container sketches-container-iphone' : isIpad ? 'sketches-container sketches-container-ipad' : 'sketches-container';\n\n      // Alle Sketches im Container zusammen - Überschrift ist im ersten Item eingebettet\n      let sketchesHtml = '';\n      if (sketches.length > 0) {\n        if (isAndroidDevice) {\n          // ANDROID: Grid-Layout mit inline-block\n          // Nur 2 Größen: 66% (2 nebeneinander) und 100% (volle Breite, untereinander)\n          const headingHtml = `<h2 class=\"sketch-inline-heading\">${t('sketches.title')}</h2>`;\n          const sketchesBySize = {\n            medium: [],\n            large: []\n          };\n          sketchItems.forEach((itemHtml, index) => {\n            const sketch = sketches[index];\n            const meta = sketch.metadata || {};\n            const size = typeof meta === 'object' && meta.pdf_size || sketch.pdf_size || 'large';\n\n            // Überschrift aus dem Item entfernen\n            const cleanHtml = itemHtml.replace(/<h2 class=\"sketch-inline-heading\">[^<]*<\\/h2>/g, '');\n\n            // small wird zu medium gemappt (falls alte Daten vorhanden)\n            if (size === 'small' || size === 'medium') sketchesBySize.medium.push(cleanHtml);else sketchesBySize.large.push(cleanHtml);\n          });\n          let sketchListHtml = headingHtml;\n\n          // 66% Skizzen: 2 nebeneinander, je ca. 48% Breite (mit Abstand = 100%)\n          if (sketchesBySize.medium.length > 0) {\n            sketchListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            sketchesBySize.medium.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html\n              // Entferne alle style-Attribute von img\n              .replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>')\n              // Setze neue styles für img - volle Breite erzwingen\n              .replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;\"')\n              // Auch das sketch-item div anpassen\n              .replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item\" style=\"width:100%!important;\"');\n              sketchListHtml += `\n              <div style=\"display:inline-block;width:48%;vertical-align:top;padding:4px;box-sizing:border-box;font-size:12px;\">\n                <div style=\"width:100%;border:1px solid #ddd;padding:5px;box-sizing:border-box;overflow:hidden;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n            sketchListHtml += `</div>`;\n          }\n\n          // 100% Skizzen: Volle Breite, größer\n          if (sketchesBySize.large.length > 0) {\n            sketchesBySize.large.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html.replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>').replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;\"').replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item\" style=\"width:100%!important;\"');\n              sketchListHtml += `\n              <div style=\"display:block;width:100%;padding:5px;box-sizing:border-box;margin-bottom:10px;\">\n                <div style=\"width:100%;border:1px solid #ddd;padding:8px;box-sizing:border-box;overflow:hidden;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n          }\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchListHtml}</div>`;\n        } else {\n          // iOS/Web: Standard-Layout\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchItems.join('')}</div>`;\n        }\n      }\n\n      // Helper function to calculate polygon area\n      const calculatePolygonArea = (points, scale = 100) => {\n        if (points.length < 3) return 0;\n        let area = 0;\n        for (let i = 0; i < points.length; i++) {\n          const j = (i + 1) % points.length;\n          area += points[i].x * points[j].y;\n          area -= points[j].x * points[i].y;\n        }\n        return Math.abs(area / 2) / (scale * scale);\n      };\n\n      // Helper function to calculate line length\n      const calculateLineLength = (p1, p2, scale = 100) => {\n        return Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2)) / scale;\n      };\n\n      // Category colors\n      const getCategoryColor = category => {\n        // First try to find color from loaded line categories\n        const loadedCat = pdfLineCategories.find(c => c.name === category);\n        if (loadedCat) {\n          return loadedCat.color;\n        }\n        // Fallback to hardcoded