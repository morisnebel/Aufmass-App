argin-bottom: 15px;\n          }\n          .photo-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 400px;\n            object-fit: contain;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes - mit Flexbox */\n          .sketch-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-item img {\n            max-height: 500px;\n            object-fit: contain;\n          }\n          .photo-item, .sketch-item {\n            border: 1px solid #e0e0e0;\n            border-radius: 6px;\n            overflow: hidden;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            display: block;\n            max-height: 350px;\n          }\n          /* Photo/Sketch im Grid nicht umbrechen */\n          .photo-iphone, .sketch-iphone {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            max-height: 280px;\n            overflow: hidden;\n          }\n          .photo-small, .photo-medium, .photo-large, .photo-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .sketch-small, .sketch-medium, .sketch-large, .sketch-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 300px;\n            object-fit: contain;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-title {\n            margin: 0;\n            padding: 8px 10px;\n            font-size: 11px;\n            font-weight: 600;\n            color: ${accentColor};\n            background: #f0f4f8;\n            border-bottom: 1px solid ${accentColor};\n          }\n          .sketch-notes {\n            padding: 8px 10px;\n            background: #fafafa;\n            border-top: 1px solid #e0e0e0;\n          }\n          .sketch-notes-filled {\n            background: #fff8e1;\n            border-top: 1px solid #ffe082;\n          }\n          .sketch-notes-label {\n            font-size: 9px;\n            font-weight: 600;\n            color: #666;\n          }\n          .sketch-notes-text {\n            font-size: 9px;\n            color: #333;\n            line-height: 1.4;\n          }\n          .sketch-notes-lines {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n          }\n          .sketch-note-line {\n            height: 1px;\n            background: #ccc;\n            width: 100%;\n          }\n          .sketch-placeholder {\n            height: 150px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            color: #999;\n          }\n          .empty {\n            color: #999;\n            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 4px;\n            padding: 6px 8px;\n            margin-top: 5px;\n            font-size: 8px;\n          }\n          .footer {\n            margin-top: 5px;\n            padding: 3px 0;\n            border-top: 1px solid ${accentColor};\n            font-size: 6px;\n            color: #999;\n            text-align: center;\n            font-weight: 400;\n            page-break-inside: avoid;\n            page-break-before: avoid;\n            break-before: avoid;\n            break-inside: avoid;\n          }\n          /* Wrapper um den letzten Inhalt und Footer, um sie zusammenzuhalten */\n          .footer-container {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          /* Footer im Druck nur anzeigen wenn genug Platz - sonst verstecken */\n          @media print {\n            .footer {\n              /* Footer wird nur gedruckt wenn er auf die Seite passt */\n              orphans: 3;\n              widows: 3;\n            }\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n   