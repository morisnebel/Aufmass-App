nfo-value\">${project?.status === 'active' ? 'Aktiv' : project?.status === 'completed' ? 'Abgeschlossen' : 'Abgebrochen'}</span>\n            </div>\n            ${objektStreet || objektPlz || objektCity || objektName ? `\n              <div style=\"margin-top: 12px; padding-top: 12px; border-top: 1px solid #e0e0e0;\">\n                <strong style=\"color: #1976d2;\">Objektadresse</strong>\n                ${objektName ? `<div style=\"margin-top: 4px;\">${objektName}</div>` : ''}\n                <div style=\"margin-top: 2px;\">${objektStreet || bauherrStreet}</div>\n                <div>${objektPlz || bauherrPlz} ${objektCity || bauherrCity}</div>\n              </div>\n            ` : ''}\n          </div>\n          \n          <div class=\"info-box\">\n            <h3>Bauherr</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${bauherrName}</span>\n            </div>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Adresse:</span>\n              <span class=\"info-value\">${bauherrStreet}<br/>${bauherrPlz} ${bauherrCity}</span>\n            </div>\n            ${bauherrPhone ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Telefon:</span>\n                <span class=\"info-value\">${bauherrPhone}</span>\n              </div>\n            ` : ''}\n            ${bauherrMobile ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Mobil:</span>\n                <span class=\"info-value\">${bauherrMobile}</span>\n              </div>\n            ` : ''}\n            ${bauherrEmail ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">E-Mail:</span>\n                <span class=\"info-value\">${bauherrEmail}</span>\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <div class=\"stats-grid\">\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${roofs.length}</div>\n            <div class=\"stat-label\">Dachflächen</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${pdfTotalArea.toFixed(2)} m²</div>\n            <div class=\"stat-label\">Gesamtfläche</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${photos.length}</div>\n            <div class=\"stat-label\">Fotos</div>\n          </div>\n        </div>\n        \n        <div class=\"roofs-section\">\n          <h2>Dachflächen</h2>\n          ${roofsHtml}\n        </div>\n        \n        <div class=\"checklists-section\">\n          <h2>Checklisten</h2>\n          ${checklistsHtml}\n        </div>\n        </div><!-- end .page -->\n        \n        ${photos.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"photos-section\">\n              <h2>Fotos</h2>\n              ${photosHtml}\n            </div>\n          </div>\n        ` : ''}\n        \n        ${sketches.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"sketches-section\">\n              <h2>Skizzen</h2>\n              ${sketchesHtml}\n            </div>\n          </div>\n        ` : ''}\n        \n        <div class=\"new-page\">\n          ${remarks || project?.remarks ? `\n            <div class=\"remarks-section\">\n              <h2>Bemerkungen</h2>\n              <div class=\"remarks-box\">\n                ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n              </div>\n            </div>\n          ` : ''}\n          <div class=\"footer\" style=\"margin-top: 30px;\">\n            Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n          </div>\n        </div>\n        \n        <!-- Contact/Closing page -->\n        <div class=\"new-page\">\n          <div style=\"text-align: center; padding-top: 40px;\">\n            ${companyLogo ? `<img src=\"${companyLogo}\" style=\"max-width: 150px; max-height: 80px; margin-bottom: 20px;\" />` : ''}\n            <h2 style=\"color: #1976d2; margin-bottom: 20px;\">Vielen Dank für Ihr Vertrauen!</h2>\n            ${companyName ? `<p style=\"font-size: 16px; font-weight: bold; margin-bottom: 5px;\">${companyName}</p>` : ''}\n            ${companySubtitle ? `<p style=\"font-size: 12px; color: #666; margin-bottom: 15px;\">${companySubtitle}</p>` : ''}\n            ${companyStreet || companyCity ? `\n              <p style=\"font-size: 11px; color: #333; margin-bottom: 3px;\">\n                ${companyStreet}${companyStreet && companyCity ? ', ' : ''}${companyZipCode} ${companyCity}\n              </p>\n            ` : ''}\n            ${companyPhone ? `<p style=\"font-size: 11px; color: #333; margin-bottom: 3px;\">Tel: ${companyPhone}</p>` : ''}\n            ${companyEmail ? `<p style=\"font-size: 11px; color: #333; margin-bottom: 20px;\">${companyEmail}</p>` : ''}\n            <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0;\">\n              <p style=\"font-size: 10px; color: #999;\">\n                Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n              </p>\n            </div>\n          </div>\n        </div>\n      </body>\n      </html>\n    `;\n      return html;\n    };\n\n    // Show PDF options dialog\n    const exportToPDF = async () => {\n      Alert.default.alert('PDF Export', 'Was möchten Sie tun?', [{\n        text: 'Vorschau anzeigen',\n        onPress: async () => {\n          try {\n            setIsGeneratingPdf(true);\n            const html = await generatePdfHtml();\n            setPdfHtmlContent(html);\n            setShowPdfPreviewModal(true);\n          } catch (error) {\n            console.error('Error generating preview:', error);\n            Alert.default.alert('Fehler', 'Vorschau konnte nicht erstellt werden.');\n          } finally {\n            setIsGeneratingPdf(false);\n          }\n        }\n      }, {\n        text: 'PDF teilen',\n        onPress: () => generateAndSharePdf()\n      }, {\n        text: 'In Dateien speichern',\n        onPress: () => generateAndSavePdf()\n      }, {\n        text: 'Abbrechen',\n        style: 'cancel'\n      }]);\n    };\n\n    // Generate and share PDF\n    const generateAndSharePdf = async () => {\n      try {\n        setIsGeneratingPdf(true);\n        const html = await generatePdfHtml();\n        const {\n          uri\n        } = await Print.printToFileAsync({\n          html,\n          base64: false\n        });\n        const canShare = await Sharing.isAvailableAsync();\n        if (canShare) {\n          await Sharing.shareAsync(uri, {\n            mimeType: 'application/pdf',\n            dialogTitle: `Aufmaß ${project?.name} teilen`,\n            UTI: 'com.adobe.pdf'\n          });\n        } else {\n          Alert.default.alert('Fehler', 'Teilen ist auf diesem Gerät nicht verfügbar.');\n        }\n      } catch (error) {\n        console.error('Error sharing PDF:', error);\n        Alert.default.alert('Fehler', 'PDF konnte nicht erstellt werden.');\n      } finally {\n        setIsGeneratingPdf(false);\n      }\n    };\n\n    // Generate and save PDF to Files app\n    const generateAndSavePdf = async () => {\n      try {\n        setIsGeneratingPdf(true);\n        const html = await generatePdfHtml();\n        const {\n          uri\n        } = await Print.printToFileAsync({\n          html,\n          base64: false\n        });\n\n        // Share the file directly - iOS will show \"Save to Files\" option\n        const canShare = await Sharing.isAvailableAsync();\n        if (canShare) {\n          await Sharing.shareAsync(uri, {\n            mimeType: 'application/pdf',\n            dialogTitle: 'PDF speichern',\n            UTI: 'com.adobe.pdf'\n          });\n        } else {\n          Alert.default.alert('Fehler', 'Teilen ist auf diesem Gerät ni