rder: 1px solid #e0e0e0;\n            border-radius: 6px;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            display: block;\n          }\n          .photo-item {\n            overflow: hidden;\n            max-height: 350px;\n          }\n          /* Photo/Sketch im Grid nicht umbrechen */\n          .photo-iphone, .sketch-iphone {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            max-height: 280px;\n            overflow: hidden;\n          }\n          .photo-small, .photo-medium, .photo-large, .photo-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .sketch-small, .sketch-medium, .sketch-large, .sketch-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 300px;\n            object-fit: contain;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-title {\n            margin: 0;\n            padding: 8px 10px;\n            font-size: 11px;\n            font-weight: 600;\n            color: ${accentColor};\n            background: #f0f4f8;\n            border-bottom: 1px solid