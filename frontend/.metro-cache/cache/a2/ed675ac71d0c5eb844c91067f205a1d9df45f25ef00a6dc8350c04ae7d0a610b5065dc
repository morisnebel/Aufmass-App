tItem(KEYS.CHECKLIST_TEMPLATES);\n      // Nur wenn noch nie Vorlagen existiert haben (key ist null, nicht leeres Array)\n      if (existingKey === null) {\n        const defaultTemplates = [{\n          id: 'default-1',\n          name: 'Dachinspektion',\n          items: [{\n            text: 'Dachziegel prüfen',\n            subItems: []\n          }, {\n            text: 'Dachrinne prüfen',\n            subItems: []\n          }, {\n            text: 'Schornstein prüfen',\n            subItems: []\n          }, {\n            text: 'Dachfenster prüfen',\n            subItems: []\n          }],\n          created_at: new Date().toISOString(),\n          updated_at: new Date().toISOString()\n        }, {\n          id: 'default-2',\n          name: 'Aufmaß Standard',\n          items: [{\n            text: 'Dachfläche vermessen',\n            subItems: []\n          }, {\n            text: 'Traufhöhe messen',\n            subItems: []\n          }, {\n            text: 'Firsthöhe messen',\n            subItems: []\n          }, {\n            text: 'Dachneigung bestimmen',\n            subItems: []\n          }],\n          created_at: new Date().toISOString(),\n          updated_at: new Date().toISOString()\n        }];\n        await setItems(KEYS.CHECKLIST_TEMPLATES, defaultTemplates);\n      }\n    },\n    getById: async id => {\n      const templates = await ChecklistTemplateService.getAll();\n      return templates.find(t => t.id === id) || null;\n    },\n    create: async data => {\n      const templates = await getItems(KEYS.CHECKLIST_TEMPLATES);\n      const newTemplate = {\n        ...data,\n        id: generateId(),\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      templates.push(newTemplate);\n      await setItems(KEYS.CHECKLIST_TEMPLATES, templates);\n      return newTemplate;\n    },\n    update: async (id, data) => {\n      const templates = await getItems(KEYS.CHECKLIST_TEMPLATES);\n      