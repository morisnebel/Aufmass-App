  display: flex;\n            flex-wrap: wrap;\n            gap: 15px;\n            align-items: flex-start;\n          }\n          .photos-container::after, .sketches-container::after {\n            content: \"\";\n            display: table;\n            clear: both;\n          }\n          /* Photo page groups - jede Gruppe auf eigener Seite */\n          .photos-page-group {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .photos-page-group .photos-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n          }\n          .photos-page-group .photo-item {\n            max-height: 320px;\n            overflow: hidden;\n          }\n          .photos-page-group .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* Neue Foto-Seiten Layouts */\n          .photos-section {\n            margin-bottom: 15px;\n          }\n          /* Klein: 3 Spalten Grid */\n          .photos-section-small {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 8px;\n          }\n          .photos-section-small .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-small .photo-item img {\n            max-height: 180px;\n            object-fit: contain;\n          }\n          .photo-grid-small {\n            width: 100%;\n          }\n          /* Mittel: 2 Spalten Grid */\n          .photos-section-medium {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 12px;\n          }\n          .photos-section-medium .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-medium .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          .photo-grid-medium {\n            width: 100%;\n          }\n          /* Groß: 1 Spalte (übereinander) */\n          .photos-section-large {\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n          }\n          .photos-section-large .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-large .photo-item img {\n            max-height: 340px;\n            object-fit: contain;\n          }\n          .photo-grid-large {\n            width: 100%;\n          }\n          /* iPhone-spezifischer Skizzen-Container: Grid mit 2 Spalten */\n          .sketches-container-iphone {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n          }\n          .sketch-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .sketch-iphone img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* iPhone-spezifischer Fotos-Container: Grid mit 2 Spalten */\n          .photos-container-iphone {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n            margin-bottom: 20px;\n            align-items: start;\n          }\n          .photos-container-iphone.photos-new-page {\n            page-break-before: always !important;\n            break-before: page !important;\n          }\n          .photo-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .photo-iphone .photo-wrapper {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            border-radius: 4px;\n            overflow: hidden;\n          }\n          .photo-iphone img {\n            width: 100%;\n            height: auto;\n            max-height: 200px;\n            object-fit: contain;\n          }\n          /* Photo sizes - iPad mit Flexbox */\n          .photo-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 400px;\n            object-fit: contain;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes - mit Flexbox */\n          .sketch-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-item img {\n            max-height: 500px;\n            object-fit: contain;\n          }\n          .photo-