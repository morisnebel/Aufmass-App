;\n            overflow: hidden;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-placeholder {\n            height: 150px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            color: #999;\n          }\n          .empty {\n            color: #999;\n            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 6px;\n            padding: 12px;\n            margin-top: 10px;\n          }\n          .footer {\n            margin-top: 30px;\n            padding-top: 15px;\n            border-top: 2px solid #1976d2;\n            font-size: 11px;\n            color: #666;\n            text-align: center;\n            font-weight: 500;\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 5px;\n            margin-top: 8px;\n          }\n          .measure-item {\n            font-size: 11px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 14px;\n            color: #1976d2;\n            margin-bottom: 5px;\n          }\n          .roof-notes {\n            margin-top: 8px;\n            padding-top: 8px;\n            border-top: 1px dashed #e0e0e0;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 15px;\n          }\n          .company-logo {\n            max-width: 180px;\n            max-height: 130px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>Tel: ${companyPhone}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <h2>Projektübersicht</h2>\n        <div class=\"info-grid\">\n          <div class=\"info-box\">\n            <h3>Projekt</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${project?.name || '-'}</span>\n            </div>\n            ${project?.description ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Beschreibung:</span>\n                <span class=\"info-value\">${project.description}</span>\n              </div>\n            ` : ''}\n            <div class=\"info-row\">\n              <span class=\"info-label\">Status:</span>\n              <span class=\"info-value\">${project?.status === 'active' ? 'Aktiv' : project?.status === 'completed' ? 'Abgeschlossen' : 'Abgebrochen'}</span>\n            </div>\n            ${objektStreet || objektPlz || objektCity || objektName ? `\n              <div style=\"margin-top: 12px; padding-top: 12px; border-top: 1px solid #e0e0e0;\">\n                <strong style=\"color: #1976d2;\">Objektadresse</strong>\n                ${objektName ? `<div style=\"margin-top: 4px;\">${objektName}</div>` : ''}\n                <div style=\"margin-top: 2px;\">${objektStreet || bauherrStreet}</div>\n                <div>${objektPlz || bauherrPlz} ${objektCity || bauherrCity}</div>\n              </div>\n            ` : ''}\n          </div>\n          \n          <div class=\"info-box\">\n            <h3>Bauherr</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${bauherrName}</span>\n            </div>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Adresse:</span>\n              <span class=\"info-value\">${bauherrStreet}<br/>${bauherrPlz} ${bauherrCity}</span>\n            </div>\n            ${bauherrPhone ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Telefon:</span>\n                <span class=\"info-value\">${bauherrPhone}</span>\n              </div>\n            ` : ''}\n            ${bauherrMobile ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Mobil:</span>\n                <span class=\"info-value\">${bauherrMobile}</span>\n              </div>\n            ` : ''}\n            ${bauherrEmail ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">E-Mail:</span>\n                <span class=\"info-value\">${bauherrEmail}</span>\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <div class=\"stats-grid\">\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${roofs.length}</div>\n            <div class=\"stat-label\">Dachflächen</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${pdfTotalArea.toFixed(2)} m²</div>\n            <div class=\"stat-label\">Gesamtfläche</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${photos.length}</div>\n            <div class=\"stat-label\">Fotos</div>\n          </div>\n        </div>\n        \n        <div class=\"roofs-section\">\n          <h2>Dachflächen</h2>\n          ${roofsHtml}\n        </div>\n        \n        <div class=\"checklists-section\">\n          <h2>Checklisten</h2>\n          ${checklistsHtml}\n        </div>\n        </div><!-- end .page -->\n        \n        ${photos.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"photos-section\">\n              <h2>Fotos</h2>\n              ${photosHtml}\n            </div>\n          </div>\n        ` : ''}\n        \n        ${sketches.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"sketches-section\">\n              <h2>Skizzen</h2>\n              ${sketchesHtml}\n            </div>\n          </div>\n        ` : ''}\n        \n        <div class=\"new-page\">\n          ${remarks || project?.remarks ? `\n            <div class=\"remarks-section\">\n              <h2>Bemerkungen</h2>\n              <div class=\"remarks-box\">\n                ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n              </div>\n            </div>\n          ` : ''}\n          <div class=\"footer\" style=\"margin-top: 30px;\">\n            Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n          </div>\n        </div>\n        \n        <!-- Contact/Closing page -->\n        <div class=\"new-page\">\n          <div style=\"text-align: center; padding-top: 40px;\">\n            ${companyLogo ? `<img src=\"${companyLogo}\" style=\"max-width: 150px; max-height: 80px; margin-bottom: 20px;\" />` : ''}\n            <h2 style=\"color: #1976d2; margin-bottom: 20px;\">Vielen Dank für Ihr Vertrauen!</h2>\n            ${companyName ? `<p style=\"font-size: 16px; font-weight: bold; margin-bottom: 5px;\">${companyName}</p>` : ''}\n            ${companySubtitle ? `<p style=\"font-size: 12px; color: #666; margin-bottom: 15px;\">${companySubtitle}</p>` : ''}\n            ${companyStreet || companyCity ? `\n              <p style=\"font-size: 11px; color: #333; margin-bottom: 3px;\">\n                ${companyStreet}${companyStreet && companyCity ? ', ' : ''}${companyZipCode} ${companyCity}\n              </p>\n            ` : ''}\n            ${companyPhone ? `<p style=\"font-size: 11px; color: #333; margin-bottom: 3px;\">Tel: ${companyPhone}</p>` : ''}\n            ${companyEmail ? `<p style=\"font-size: 11px; color: #333; margin-bottom: 20px;\">${companyEmail}</p>` : ''}\n            <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0;\">\n              <p style=\"font-size: 10px; color: #999;\">\n                Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n              </p>\n            </div>\n          </div>\n        </div>\n      </body>\n      </html>\n    `;\n      return html;\n    };\n\n    // Show PDF options dialog\n    const exportToPDF = async () => {\n      Alert.default.alert('PDF Export', 'Was möchten Sie tun?', [{\n        text: 'Vorschau anzeigen',\n        onPress: async () => {\n          try