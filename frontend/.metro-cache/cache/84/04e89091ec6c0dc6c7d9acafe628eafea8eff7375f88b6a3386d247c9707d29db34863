      const img = await AsyncStorage.default.getItem(oldKey).catch(() => null);\n                if (img) await AsyncStorage.default.setItem(newKey, img);\n                meta.elements[i] = {\n                  ...el,\n                  data: {\n                    ...el.data,\n                    imageStorageKey: newKey\n                  }\n                };\n              }\n            }\n          }\n          newMetaStr = JSON.stringify(meta);\n        } catch {/* Nicht parsebar: 1:1 übernehmen */}\n        await AsyncStorage.default.setItem(`sketch_meta_${newId}`, newMetaStr);\n      }\n      sketches.push(copy);\n      await setItems(KEYS.SKETCHES, sketches);\n      return copy;\n    },\n    delete: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const filtered = sketches.filter(s => s.id !== id);\n\n      // Delete main array entry + separate heavy data keys in parallel\n      await Promise.all([setItems(KEYS.SKETCHES, filtered), AsyncStorage.default.removeItem(`sketch_meta_${id}`), AsyncStorage.default.removeItem(`sketch_bg_${id}`), AsyncStorage.default.removeItem(`sketch_prev_${id}`)]);\n      return true;\n    },\n    // ---- BATCH MIGRATION: Move all embedded metadata to separate keys ----\n    // This should be called once on app startup to ensure the main sketches array is lightweight.\n    // After migration, loading the sketch list is fast because the heavy data is stored separately.\n    migrateAllSketches: async () => {\n      const MIGRATION_KEY = 'aufmassprofi_sketch_migration_done';\n      try {\n        // Check if migration already completed\n        const migrationDone = await AsyncStorage.default.getItem(MIGRATION_KEY);\n        if (migrationDone === 'true') {\n          console.log('[SketchService] Migration already completed, skipping.');\n          return;\n        }\n        console.log('[SketchService] Starting batch migration of sketches...');\n        const startTime = Date.now();\n        const sketches