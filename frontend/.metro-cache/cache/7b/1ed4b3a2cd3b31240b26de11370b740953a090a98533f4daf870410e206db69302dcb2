Foto-Bilddaten aus dem Array in separate Schlüssel verschieben\n  // Verhindert Hermes OOM bei JSON.stringify des gesamten Foto-Arrays\n  const migratePhotoStorage = async () => {\n    try {\n      const migrationKey = 'aufmassprofi_photo_migration_done';\n      const done = await AsyncStorage.default.getItem(migrationKey);\n      if (done === 'true') return; // Bereits migriert\n\n      const photos = await getItems(KEYS.PHOTOS);\n      let migrated = 0;\n      let needsSave = false;\n      for (const photo of photos) {\n        const inlineData = photo.image_data || photo.uri || '';\n        if (inlineData.length > 200) {\n          // Bilddaten separat speichern\n          try {\n            await AsyncStorage.default.setItem(`photo_img_${photo.id}`, inlineData);\n            photo.image_data = '';\n            photo.uri = '';\n            migrated++;\n            needsSave = true;\n          } catch (e) {\n            console.error(`Migration error for photo ${photo.id}:`, e);\n          }\n        }\n      }\n      if (needsSave) {\n        await setItems(KEYS.PHOTOS, photos);\n        console.log(`[migratePhotoStorage] ${migrated} photos migrated to separate storage`);\n      }\n      await AsyncStorage.default.setItem(migrationKey, 'true');\n    } catch (e) {\n      console.error('[migratePhotoStorage] Error:', e);\n    }\n  };\n\n  // Entfernt \"Geister-Fotos\": Einträge ohne Bilddaten. Diese entstehen, wenn beim\n  // Import/Speichern das Bild wegen vollem Speicher (SQLITE_FULL) nicht mehr\n  // gespeichert werden konnte, der Metadaten-Eintrag aber angelegt wurde.\n  const cleanupGhostPhotos = async () => {\n    try {\n      const photos = await getItems(KEYS.PHOTOS);\n      const keep = [];\n      let removed = 0;\n      for (const photo of photos) {\n        const inline = photo.image_data || photo.uri || '';\n        if (inline.length > 100) {\n          keep.push(photo);\n          continue;\n        }\n        const stored = await storage.getItem(`photo_img_${photo.id}`);\n        if (stored && stored.length > 100) {\n          keep.push(photo);\n        } else {\n          removed++;\n        }\n      }\n      if (removed > 0) {\n        await setItems(KEYS.PHOTOS, keep);\n        console.log(`[cleanupGhostPhotos] ${removed} Foto-Einträge ohne Bilddaten entfernt`);\n      }\n      return removed;\n    } catch (e) {\n      console.error('[cleanupGhostPhotos] Error:', e);\n      return 0;\n    }\n  };\n\n  // Entfernt verwaiste Speicher-Blobs (photo_img_/sketch_meta_/sketch_bg_/sketch_img_),\n  // deren Foto/Skizze nicht mehr existiert. Wichtig: Gelöschte Projekte haben früher\n  // ihre Bilddaten zurückgelassen -> Speicher blieb voll (SQLITE_FULL bei 6-MB-Limit).\n  const cleanupOrphanedStorage = async () => {\n    try {\n      const [photos, sketches] = await Promise.all([getItems(KEYS.PHOTOS), getItems(KEYS.SKETCHES)]);\n      const validPhotoIds = new Set(photos.map(p => p.id));\n      const validSketchIds = new Set(sketches.map(s => s.id));\n      const allKeys = await AsyncStorage.default.getAllKeys();\n      const toRemove = [];\n      for (const key of allKeys) {\n        if (key.startsWith('photo_img_')) {\n          if (!validPhotoIds.has(key.slice(10))) toRemove.push(key);\n        } else if (key.startsWith('sketch_meta_')) {\n          if (!validSketchIds.has(key.slice(12))) toRemove.push(key);\n        } else if (key.startsWith('sketch_bg_')) {\n          if (!validSketchIds.has(key.slice(10))) toRemove.push(key);\n        } else if (key.startsWith('sketch_prev_')) {\n          if (!validSketchIds.has(key.slice(12))) toRemove.push(key);\n        } else if (key.startsWith('sketch_img_')) {\n          // Format: sketch_img_<sketchId>_<elementId>; \"new\"-Keys nicht anfassen\n          const sketchId = key.slice(11).split('_')[0];\n          if (sketchId !== 'new' && !validSketchIds.has(sketchId)) toRemove.push(key);\n        }\n      }\n      if (toRemove.length > 0) {\n        await AsyncStorage.default.multiRemove(toRemove);\n        console.log(`[cleanupOrphanedStorage] ${toRemove.length} verwaiste Speicher-Einträge entfernt`);\n      }\n      return toRemove.length;\n    } catch (e) {\n      console.error('[cleanupOrphanedStorage] Error:', e);\n      return 0;\n    }\n  };\n  const PhotoService = {\n    getAll: async () => {\n      return getItems(KEYS.PHOTOS);\n    },\n    getById: async id => {\n      const photos = await getItems(KEYS.PHOTOS);\n      const photo = photos.find(p => p.id === id) || null;\n      if (photo) {\n        // Bilddaten separat laden (OOM-Schutz)\n        const imageData = await storage.getItem(`photo_img_${id}`);\n        if (imageData) {\n          photo.image_data = imageData;\n          photo.uri = imageData;\n        } else if (!photo.image_data && !photo.uri) {\n          // Kein separates Bild und kein Inline-Bild → kein Bild verfügbar\n        }\n        // Migration: Wenn Bild noch im Array steckt, separat speichern und Array bereinigen\n        if ((photo.image_data || photo.uri) && !imageData) {\n          const inlineImg = photo.image_data || photo.uri || '';\n          if (inlineImg.length > 100) {\n            // Nur echte base64-Daten migrieren\n            await storage.setItem(`photo_img_${id}`, inlineImg);\n          }\n        }\n      }\n      return photo;\n    },\n    getByProjectId: async projectId => {\n      const photos = await getItems(KEYS.PHOTOS);\n      const projectPhotos = photos.filter(p => p.project_id === projectId);\n      // Bilddaten separat laden für jedes Foto (einzeln, nicht alle auf einmal!)\n      for (const photo of projectPhotos) {\n        try {\n          const imageData = await storage.getItem(`photo_img_${photo.id}`);\n          if (imageData) {\n            photo.image_data = imageData;\n            photo.uri = imageData;\n          } else if (photo.image_data && photo.image_data.length > 100) {\n            // Migration: Altes Foto hat Bilddaten noch im Array\n            // Separat 