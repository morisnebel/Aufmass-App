ches-container-iphone .sketch-small {\n            width: 32% !important;\n            max-width: 32% !important;\n          }\n          .sketches-container-iphone .sketch-medium {\n            width: 48% !important;\n            max-width: 48% !important;\n          }\n          .sketches-container-iphone .sketch-large {\n            width: 100% !important;\n            max-width: 100% !important;\n          }\n          .sketches-container-iphone .sketch-full {\n            width: 100% !important;\n            max-width: 100% !important;\n          }\n          .sketches-container-iphone .sketch-item img {\n            max-height: 420px !important;\n            max-width: 100% !important;\n            width: 100% !important;\n            height: auto !important;\n            object-fit: contain !important;\n          }\n          .sketch-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .sketch-iphone img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* iPhone-spezifischer Fotos-Container: Grid mit 2 Spalten */\n          .photos-container-iphone {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n            margin-bottom: 20px;\n            align-items: start;\n          }\n          .photos-container-iphone.photos-new-page {\n            page-break-before: always !important;\n            break-before: page !important;\n          }\n          .photo-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .photo-iphone .photo-wrapper {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            border-radius: 4px;\n            overflow: hidden;\n          }\n          .photo-iphone img {\n            width: 100%;\n            height: auto;\n            max-height: 200px;\n            object-fit: contain;\n          }\n       