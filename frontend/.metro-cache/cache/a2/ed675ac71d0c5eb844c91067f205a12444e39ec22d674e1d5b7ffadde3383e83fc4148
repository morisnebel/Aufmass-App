a keys\n      const cleanupOps = [];\n      for (const sketch of sketchesToDelete) {\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_meta_${sketch.id}`));\n        cleanupOps.push(AsyncStorage.default.removeItem(`sketch_bg_${sketch.id}`));\n        // Clean up separately stored image elements\n        try {\n          const metaStr = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (metaStr) {\n            const meta = JSON.parse(metaStr);\n            if (meta?.elements) {\n              for (const el of meta.elements) {\n                if (el.data?.imageStorageKey) {\n                  cleanupOps.push(AsyncStorage.default.removeItem(el.data.imageStorageKey));\n                }\n              }\n            }\n          }\n        } catch (e) {\n          // Ignore parse errors during cleanup\n        }\n      }\n      if (cleanupOps.length > 0) {\n        await Promise.all(cleanupOps);\n      }\n      const photos = await getItems(KEYS.PHOTOS);\n      await setItems(KEYS.PHOTOS, photos.filter(p => p.project_id !== id));\n      const roofs = await getItems(KEYS.ROOFS);\n      await setItems(KEYS.ROOFS, roofs.filter(r => r.project_id !== id));\n      const checklists = await getItems(KEYS.CHECKLISTS);\n      await setItems(KEYS.CHECKLISTS, checklists.filter(c => c.project_id !== id));\n      return true;\n    }\n  };\n\n  // ============ SKETCHES ============\n\n  const SketchService = {\n    getAll: async () => {\n      return getItems(KEYS.SKETCHES);\n    },\n    getById: async id => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      return sketches.find(s => s.id === id) || null;\n    },\n    getByProjectId: async projectId => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      return sketches.filter(s => s.project_id === projectId);\n    },\n    // ---- OPTIMIZED: Load heavy sketch data from separate storage keys ----\n    // This avoids parsing all sketches just to load one sketch's elements/background\n    loadSketchData: async id => {\n      try {\n        // Try loading from separate optimized keys first\n        const [metaStr, bgImage] = await Promise.all([AsyncStorage.default.getItem(`sketch_meta_${id}`), AsyncStorage.default.getItem(`sketch_bg_${id}`)]);\n        if (metaStr) {\n          // Found in optimized storage - parse with error handling\n          let metadata;\n          try {\n            metadata = JSON.parse(metaStr);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: bgImage\n            };\n          }\n\n          // Restore image URIs from separate storage if they were extracted\n          if (metadata.elements && Array.isArray(metadata.elements)) {\n            const imageElements = metadata.elements.filter(el => el.type === 'image' && el.data?.imageStorageKey);\n            if (imageElements.length > 0) {\n              const imageKeys = imageElements.map(el => el.data.imageStorageKey);\n              const imagePromises = imageKeys.map(key => AsyncStorage.default.getItem(key).catch(() => null));\n              const imageData = await Promise.all(imagePromises);\n              metadata.elements = metadata.elements.map(el => {\n                if (el.type === 'image' && el.data?.imageStorageKey) {\n                  const idx = imageKeys.indexOf(el.data.imageStorageKey);\n                  if (idx !== -1 && imageData[idx]) {\n                    return {\n                      ...el,\n                      data: {\n                        ...el.data,\n                        uri: imageData[idx]\n                      }\n                    };\n                  }\n                }\n                return el;\n              });\n            }\n          }\n          return {\n            metadata,\n            backgroundImage: bgImage\n          };\n        }\n\n        // Fallback: migrate from old format (metadata embedded in main array)\n        console.log(`[SketchService] Migrating sketch ${id} to optimized storage...`);\n        const sketch = await SketchService.getById(id);\n        if (sketch?.metadata) {\n          let metadata;\n          try {\n            metadata = JSON.parse(sketch.metadata);\n          } catch (parseErr) {\n            console.error(`[SketchService] Failed to parse legacy metadata for sketch ${id}:`, parseErr);\n            return {\n              metadata: null,\n              backgroundImage: null\n            };\n          }\n          const bg = metadata.backgroundImage || null;\n\n          // Save to optimized keys (migration)\n          const metaWithoutBg = {\n            ...metadata\n          };\n          delete metaWithoutBg.backgroundImage;\n          await AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg));\n          if (bg) {\n            await AsyncStorage.default.setItem(`sketch_bg_${id}`, bg);\n          }\n\n          // Clean heavy data from main array to speed up future loads\n          const sketches = await getItems(KEYS.SKETCHES);\n          const index = sketches.findIndex(s => s.id === id);\n          if (index !== -1) {\n            // Keep only lightweight data + sketch_data (small preview) in the main array\n            delete sketches[index].metadata;\n            await setItems(KEYS.SKETCHES, sketches);\n          }\n          return {\n            metadata: metaWithoutBg,\n            backgroundImage: bg\n          };\n        }\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      } catch (error) {\n        console.error(`[SketchService] Error loading sketch data for ${id}:`, error);\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      }\n    },\n    // ---- OPTIMIZED: Save heavy data to separate keys ----\n    saveSketchData: async (id, metadata, backgroundImage) => {\n      try {\n        // Save metadata (without background image) to separate key\n        const metaWithoutBg = {\n          ...metadata\n        };\n        delete metaWithoutBg.backgroundImage;\n        const saveOps = [AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg))];\n\n        // Save background image to its own key\n        if (backgroundImage) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, backgroundImage));\n        } else {\n          // Remove old background if cleared\n          saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n        }\n        await Promise.all(saveOps);\n      } catch (error) {\n        console.error(`[SketchService] Error saving sketch data for ${id}:`, error);\n      }\n    },\n    create: async data => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const id = generateId();\n\n      // Extract heavy data before storing in main array\n      const heavyMetadata = data.metadata;\n      const lightSketch = {\n        ...data,\n        id,\n        metadata: undefined,\n        // Don't store metadata in main array\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      };\n      sketches.push(lightSketch);\n\n      // Save lightweight array + heavy data in parallel\n      const saveOps = [setItems(KEYS.SKETCHES, sketches)];\n      if (heavyMetadata) {\n        try {\n          const meta = JSON.parse(heavyMetadata);\n          const bg = meta.backgroundImage || null;\n          const metaWithoutBg = {\n            ...meta\n          };\n          delete metaWithoutBg.backgroundImage;\n          saveOps.push(AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg)));\n          if (bg) {\n            saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, bg));\n          }\n        } catch (e) {\n          // If metadata isn't valid JSON, store a