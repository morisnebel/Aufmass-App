onst isIpad = Platform.default.OS === 'ios' && Platform.default.isPad;\n      const isIphone = Platform.default.OS === 'ios' && !Platform.default.isPad;\n\n      // Hilfsfunktion um Fotos-HTML zu generieren - mit inline styles für zuverlässiges Drucken\n      const generatePhotoHtml = photo => {\n        const size = photo.pdf_size || 'medium';\n        let annotationSvg = '';\n        if (photo.annotations) {\n          try {\n            const annotationData = JSON.parse(photo.annotations);\n            const canvasWidth = annotationData.canvasWidth || 400;\n            const canvasHeight = annotationData.canvasHeight || 300;\n            let svgContent = '';\n\n            // Render paths (drawing annotations)\n            if (annotationData.paths && annotationData.paths.length > 0) {\n              svgContent += annotationData.paths.map(p => `<path d=\"${p.path}\" stroke=\"${p.color || '#FF0000'}\" stroke-width=\"${p.strokeWidth || 3}\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>`).join('');\n            }\n\n            // Render text elements (including date/time stamps)\n            if (annotationData.textElements && annotationData.textElements.length > 0) {\n              svgContent += annotationData.textElements.map(t => {\n                const escapedText = (t.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n                const fontFamily = t.fontFamily === 'System' ? 'Arial, sans-serif' : t.fontFamily || 'Arial, sans-serif';\n                return `<text x=\"${t.x}\" y=\"${t.y}\" font-size=\"${t.fontSize || 20}\" fill=\"${t.color || '#FFFFFF'}\" font-family=\"${fontFamily}\" font-weight=\"bold\" stroke=\"#000000\" stroke-width=\"0.5\" paint-order=\"stroke\">${escapedText}</text>`;\n              }).join('');\n            }\n            if (svgContent) {\n              annotationSvg = `<svg class=\"photo-annotations\" viewBox=\"0 0 ${canvasWidth} ${canvasHeight}\" preserveAspectRatio=\"xMidYMid sli