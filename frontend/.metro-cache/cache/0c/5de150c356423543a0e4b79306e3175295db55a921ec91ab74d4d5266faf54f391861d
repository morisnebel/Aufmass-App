der-radius: 2px;\n          }\n          .pdf-checkmark-circle {\n            color: #4caf50;\n            font-size: 8px;\n          }\n          .pdf-level1-title {\n            font-size: 8px;\n            font-weight: 600;\n            color: #333;\n            flex: 1;\n          }\n          .pdf-level1-content {\n            padding-left: 1px;\n          }\n          .pdf-deep-sub {\n            display: flex;\n            align-items: center;\n            gap: 2px;\n            padding: 0;\n          }\n          .pdf-deep-prefix {\n            font-size: 7px;\n            color: #666;\n            font-weight: 600;\n            min-width: 18px;\n          }\n          .pdf-checkmark {\n            color: #4caf50;\n            font-size: 7px;\n          }\n          .pdf-deep-text {\n            font-size: 7px;\n            color: #444;\n            flex: 1;\n          }\n          .pdf-note {\n            background: #fff8e1;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #f57c00;\n            font-style: italic;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .pdf-note-icon {\n            margin-right: 1px;\n          }\n          .pdf-measurement {\n            background: #e3f2fd;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .photos-grid, .sketches-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n          }\n          /* Flexible photo/sketch containers */\n          .photos-container, .sketches-container {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 15px;\n            align-items: flex-start;\n          }\n          .photos-container::after, .sketches-container::af