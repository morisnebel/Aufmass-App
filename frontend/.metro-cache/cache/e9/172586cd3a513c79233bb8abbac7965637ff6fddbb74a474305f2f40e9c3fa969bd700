  return false;\n    };\n\n    // Save calculation\n    const saveCalculation = async () => {\n      if (!projectId) {\n        Alert.default.alert('Fehler', 'Kein Projekt zugeordnet');\n        return;\n      }\n      setSaving(true);\n      try {\n        const results = calculateResults();\n        const data = {\n          project_id: projectId,\n          name,\n          scale,\n          scaleReference: scaleReference.startPoint && scaleReference.endPoint ? {\n            startPoint: scaleReference.startPoint,\n            endPoint: scaleReference.endPoint,\n            realLength: scaleReference.realLength\n          } : undefined,\n          polygons,\n          lines,\n          gridEnabled,\n          gridSize,\n          results\n        };\n        if (calculationId) {\n          await _servicesLocalStorage.AreaCalculationService.update(calculationId, data);\n        } else {\n          await _servicesLocalStorage.AreaCalculationService.create(data);\n        }\n        if (Platform.default.OS === 'web') {\n          alert('Berechnung gespeichert');\n        } else {\n          Alert.default.alert('Erfolg', 'Berechnung wurde gespeichert');\n        }\n        router.back();\n      } catch (error) {\n        console.error('Error saving calculation:', error);\n        if (Platform.default.OS === 'web') {\n          alert('Fehler beim Speichern');\n        } else {\n          Alert.default.alert('Fehler', 'Berechnung konnte nicht gespeichert werden');\n        }\n      } finally {\n        setSaving(false);\n      }\n    };\n\n    // Calculate intersections of guide lines\n    const calculateGuideLineIntersections = () => {\n      const intersections = [];\n      for (let i = 0; i < guideLines.length; i++) {\n        for (let j = i + 1; j < guideLines.length; j++) {\n          const intersection = getLineIntersection(guideLines[i].start, guideLines[i].end, guideLines[j].start, guideLines[j].end);\n          if (intersection) {\n            // Check if inte