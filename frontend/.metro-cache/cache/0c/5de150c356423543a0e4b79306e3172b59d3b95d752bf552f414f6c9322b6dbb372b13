;\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .photo-large {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-full {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes */\n          .sketch-small {\n            width: calc(33.33% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            width: calc(50% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-full {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-item, .sketch-item {\n            border: 1px solid #e0e0e0;\n            border-radius: 6px;\n            overflow: hidden;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-title {\n            margin: 0;\n            padding: 8px 10px;\n            font-size: 11px;\n            font-weight: 600;\n            color: ${accentColor};\n            background: #f0f4f8;\n            border-bottom: 1px solid ${accentColor};\n          }\n          .sketch-notes {\n            padding: 8px 10px;\n            background: #fafafa;\n            border-top: 1px solid #e0e0e0;\n          }\n          .sketch-notes-filled {\n            background: #fff8e1;\n            border-top: 1px solid #ffe082;\n          }\n          .sketch-notes-label {\n            font-size: 9px;\n            font-weight: 600;\n            color: #666;\n          }\n          .sketch-notes-text {\n            font-size: 9px;\n            color: #333;\n            line-height: 1.4;\n          }\n          .sketch-notes-lines {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n          }\n          .sketch-note-line {\n            height: 1px;\n            background: #ccc;\n            width: 100%;\n          }\n          .sketch-placeholder {\n            height: 150px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            color: #999;\n          }\n          .empty {\n            color: #999;\n            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 4px;\n            padding: 6px 8px;\n            margin-top: 5px;\n            font-size: 8px;\n          }\n          .footer {\n            margin-top: 15px;\n            padding-top: 8px;\n            border-top: 1px solid ${accentColor};\n            font-size: 8px;\n            color: #666;\n            text-align: center;\n            font-weight: 500;\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2px;\n            margin-top: 4px;\n          }\n          .measure-item {\n            font-size: 8px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 10px;\n            color: ${accentColor};\n            margin-bottom: 3px;\n          }\n          .roof-notes {\n            margin-top: 4px;\n            padding-top: 4px;\n            border-top: 1px dashed #e0e0e0;\n            font-size: 8px;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n          }\n          .company-logo {\n            max-width: 120px;\n            max-height: 80px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>Tel: ${companyPhone}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <h2>Projektübersicht</h2>\n        <div class=\"info-grid\">\n          <div class=\"info-box\">\n            <h3>Projekt</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${project?.name || '-'}</span>\n            </div>\n            ${project?.description ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Beschreibung:</span>\n                <span class=\"info-value\">${project.description}</span>\n              </div>\n            ` : ''}\n            <div class=\"info-row\">\n              <span class=\"info-label\">Status:</span>\n              <span class=\"info-value\">${project?.status === 'aktiv' ? 'Aktiv' : project?.status === 'abgeschlossen' ? 'Abgeschlossen' : 'Abgebrochen'}</span>\n            </div>\n            ${objektStreet || objektPlz || objektCity || objektName || objektAddressName ? `\n              <div style=\"margin-top: 12px; padding-top: 12px; border-top: 1px solid #e0e0e0;\">\n                <strong style=\"color: #1976d2;\">Objektadresse${objektAddressName ? ` (${objektAddressName})` : ''}</strong>\n                ${objektName ? `<div style=\"margin-top: 4px;\">${objektName}</div>` : ''}\n                <div style=\"margin-top: 2px;\">${objektStreet || bauherrStreet}</div>\n                <div>${objektPlz || bauherrPlz} ${objektCity || bauherrCity}</div>\n              </div>\n            ` : ''}\n          </div>\n          \n          <div class=\"info-box\">\n            <h3>Bauherr</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${bauherrName}</span>\n            </div>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Adresse:</span>\n              <span class=\"info-value\">${bauherrStreet}<br/>${bauherrPlz} ${bauherrCity}</span>\n            </div>\n            ${bauherrPhone ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Telefon:</span>\n                <span class=\"info-value\">${bauherrPhone}</span>\n              </div>\n            ` : ''}\n            ${bauherrMobile ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">Mobil:</span>\n                <span class=\"info-value\">${bauherrMobile}</span>\n              </div>\n            ` : ''}\n            ${bauherrEmail ? `\n              <div class=\"info-row\">\n                <span class=\"info-label\">E-Mail:</span>\n                <span class=\"info-value\">${bauherrEmail}</span>\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <div class=\"stats-grid\">\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${roofs.length}</div>\n            <div class=\"stat-label\">Dachflächen</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${pdfTotalArea.toFixed(2)} m²</div>\n            <div class=\"stat-label\">Gesamtfläche</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-value\">${photos.length}</div>\n            <div class=\"stat-label\">Fotos</div>\n          </div>\n        </div>\n        \n        <div class=\"roofs-section\">\n          <h2>Dachflächen</h2>\n          ${roofsHtml}\n        </div>\n        \n        <div class=\"checklists-section checklists-page-break\">\n          <h2>Checklisten</h2>\n          ${checklistsHtml}\n        </div>\n        </div><!-- end .page -->\n        \n        ${photos.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"photos-section\">\n              <h2>Fotos</h2>\n              ${photosHtml}\n            </div>\n            ${sketches.length === 0 ? `\n              ${remarks || project?.remarks ? `\n                <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                  <h2>Bemerkungen</h2>\n                  <div class=\"remarks-box\">\n                    ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                  </div>\n                </div>\n              ` : ''}\n              <div class=\"footer\">\n                Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n              </div>\n            ` : ''}\n          </div>\n        ` : ''}\n        \n        ${sketches.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"sketches-section\">\n              <h2>Skizzen</h2>\n              ${sketchesHtml}\n            </div>\n            ${areaCalculations.length === 0 ? `\n              ${remarks || project?.remarks ? `\n                <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                  <h2>Bemerkungen</h2>\n                  <div class=\"remarks-box\">\n                    ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                  </div>\n                </div>\n              ` : ''}\n              <div class=\"footer\">\n                Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n              </div>\n            ` : ''}\n          </div>\n        ` : ''}\n        \n        ${areaCalculations.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"area-calcs-section\">\n              <h2>Flächenberechnungen</h2>\n              ${areaCalcsHtml}\n            </div>\n            ${remarks || project?.remarks ? `\n              <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                <h2>Bemerkungen</h2>\n                <div class=\"remarks-box\">\n                  ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                </div>\n              </div>\n            ` : ''}\n            <div class=\"footer\">\n              Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n            </div>\n          </div>\n        ` : ''}\n        \n        ${photos.length === 0 && sketches.length === 0 && areaCalculations.length === 0 ? `\n          ${remarks || project?.remarks ? `\n            <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n              <h2>Bemerkungen</h2>\n              <div class=\"remarks-box\">\n                ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n              </div>\n            </div>\n          ` : ''}\n          <div class=\"footer\">\n            Erstellt mit AUFMASSPROFI DACH • ${formatDate(new Date().toISOString())}\n          </div>\n        ` : ''}\n      </body>\n      </html>\n    `;\n      return html;\n    };\n\n    // Show PDF options dialog\n    const exportToPDF = async () => {\n      Alert.default.alert('PDF Export', 'Was möchten Sie tun?', [{\n        text: 'Vorschau anzeigen',\n        onPress: async () => {\n          try {\n            setIsGeneratingPdf(true);\n            const html = await generatePdfHtml();\n            setPdfHtmlContent(html);\n            setShowPdfPreviewModal(true);\n          } catch (error) {\n            console.error('Error generating preview:', error);\n            Alert.default.alert('Fehler', 'Vorschau konnte nicht erstellt werden.');\n          } finally {\n            setIsGeneratingPdf(false);\n          }\n        }\n      }, {\n        text: 'PDF teilen',\n        onPress: () => generateAndSharePdf()\n      }, {\n        text: 'In Dateien speichern',\n        onPress: () => generateAndSavePdf()\n      }, {\n        text: 'Abbrechen',\n        style: 'cancel'\n      }]);\n    };\n\n    // Gene