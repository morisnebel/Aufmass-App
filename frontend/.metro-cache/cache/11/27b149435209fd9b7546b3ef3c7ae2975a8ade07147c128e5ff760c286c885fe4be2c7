ck {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .photo-inline-heading, .sketch-inline-heading {\n            color: ${accentColor};\n            border-bottom: 1px solid ${accentColor};\n            padding-bottom: 3px;\n            margin-top: 8px;\n            margin-bottom: 8px;\n            font-size: ${toolsSize.h2Size}px;\n            font-weight: bold;\n            display: block !important;\n            width: 100% !important;\n          }\n          .sketch-inline-title {\n            color: ${accentColor};\n            margin: 8px 0 5px 0;\n            font-size: 9px;\n          }\n          /* New checklist PDF styles */\n          .checklist-main-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding-bottom: 4px;\n            border-bottom: 1px solid ${accentColor};\n            margin-bottom: 6px;\n          }\n          .checklist-main-title {\n            font-size: 11px;\n            font-weight: 700;\n            color: ${accentColor};\n            flex: 1;\n          }\n          .checklist-main-count {\n            font-size: 9px;\n            color: #4caf50;\n            font-weight: 600;\n          }\n          /* PDF Checklist Image Styles */\n          .pdf-template-logo {\n            max-width: 50px;\n            max-height: 20px;\n            margin-right: 6px;\n            object-fit: contain;\n            border-radius: 2px;\n          }\n          .pdf-category-logo {\n            max-width: 35px;\n            max-height: 14px;\n            margin-right: 3px;\n            object-fit: contain;\n            border-radius: 2px;\n          }\n          .pdf-print-thumbnail {\n            width: 40px;\n            height: 30px;\n            object-fit: contain;\n            border-radius: 2px;\n            border: 1px solid #4ca