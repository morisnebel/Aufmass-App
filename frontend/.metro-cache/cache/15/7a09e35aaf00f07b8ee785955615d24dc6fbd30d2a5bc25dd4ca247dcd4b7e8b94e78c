S SECTION SETTINGS (Info, Fotos, Skizzen, etc.) =====\n      const toolsColorId = settings.pdf_tools_color || headerColorId;\n      const toolsStyleSetting = settings.pdf_tools_style || 'filled';\n      const toolsSizeSetting = settings.pdf_tools_size || 'medium';\n      const toolsColor = colorOptions[toolsColorId] || colorOptions.blue;\n      const toolsSize = sizeMapping[toolsSizeSetting] || sizeMapping.medium;\n\n      // Tools-Farben (für Section Headers)\n      const toolsAccentColor = toolsColor.color;\n      const toolsBgColor = toolsStyleSetting === 'outline' ? '#ffffff' : toolsColor.color;\n      const toolsTextColor = toolsStyleSetting === 'outline' ? toolsColor.color : toolsColor.textColor;\n\n      // Legacy: Akzentfarbe für Überschriften im Dokument (verwendet jetzt Tools-Farbe)\n      const accentColor = toolsAccentColor;\n      // Legacy: Altes pdfColor für Abwärtskompatibilität\n      const pdfColor = headerColor;\n      const pdfHeaderStyle = headerStyleSetting;\n\n      // Format date\n      const formatDate = dateStr => {\n        try {\n          const date = new Date(dateStr);\n          return date.toLocaleDateString('de-DE', {\n            day: '2-digit',\n            month: '2-digit',\n            year: 'numeric'\n          });\n        } catch {\n          return dateStr;\n        }\n      };\n\n      // Generate roofs HTML with more details\n      const roofsHtml = roofs.length > 0 ? roofs.map((roof, idx) => {\n        let measurementsHtml = '';\n        if (roof.measurements && typeof roof.measurements === 'object') {\n          const m = roof.measurements;\n          measurementsHtml = `\n          <div class=\"measurements-grid\">\n            ${m.gebaeudelaenge ? `<div class=\"measure-item\"><span class=\"measure-label\">Gebäudelänge:</span> ${m.gebaeudelaenge} m</div>` : ''}\n            ${m.gebaeudebreite ? `<div class=\"measure-item\"><span class=\"measure-label\">Gebäudebreite:</span> ${m.gebaeudebreite} m</div>` : ''}\n            ${m.traufhoehe ? `<div class=\"measure-item\"><span class=\"measure-label\">Traufhöhe:</span> ${m.traufhoehe} m</div>` : ''}\n            ${m.firsthoehe ? `<div class=\"measure-item\"><span class=\"measure-label\">Firsthöhe:</span> ${m.firsthoehe} m</div>` : ''}\n            ${m.dachneigung1 ? `<div class=\"measure-item\"><span class=\"measure-label\">Dachneigung:</span> ${m.dachneigung1}°</div>` : ''}\n            ${m.dachueberstand ? `<div class=\"measure-item\"><span class=\"measure-label\">Dachüberstand:</span> ${m.dachueberstand} m</div>` : ''}\n            ${m.sparrenlaenge ? `<div class=\"measure-item\"><span class=\"measure-label\">Sparrenlänge:</span> ${m.sparrenlaenge} m</div>` : ''}\n            ${m.ortganglaenge ? `<div class=\"measure-item\"><span class=\"measure-label\">Ortganglänge:</span> ${m.ortganglaenge} m</div>` : ''}\n            ${m.firstlaenge ? `<div class=\"measure-item\"><span class=\"measure-label\">Firstlänge:</span> ${m.firstlaenge} m</div>` : ''}\n            ${m.trauflaenge ? `<div class=\"measure-item\"><span class=\"measure-label\">Trauflänge:</span> ${m.trauflaenge} m</div>` : ''}\n          </div>\n        `;\n        }\n        return `\n        <div class=\"roof-card\">\n          <h4>Dachfläche ${idx + 1}: ${roof.roof_type || 'Unbenannt'}</h4>\n          <div class=\"roof-area\"><strong>Gesamtfläche:</strong> ${roof.area?.toFixed(2) || 0} m²</div>\n          ${measurementsHtml}\n          ${roof.notes ? `<div class=\"roof-notes\"><strong>Notizen:</strong> ${roof.notes}</div>` : ''}\n        </div>\n      `;\n      }).join('') : '<p class=\"empty\">Keine Dachflächen erfasst</p>';\n\n      // Generate checklists HTML with new hierarchical layout\n      // Helper: Flatten deep sub-items for PDF\n      const flattenDeepSubItemsForPdf = (items, basePrefix) => {\n        const result = [];\n        items.forEach((item, index) => {\n          const currentPrefix = `${basePrefix}.${index + 1}`;\n          const currentLevel = currentPrefix.split('.').length - 2;\n          if (item.checked) {\n            result.push({\n              text: item.text,\n              level: currentLevel,\n              prefix: currentPrefix,\n              note: item.note,\n              measurements: item.measurements\n            });\n          }\n          if (item.subItems && item.subItems.length > 0) {\n            result.push(...flattenDeepSubItemsForPdf(item.subItems, currentPrefix));\n          }\n        });\n        return result;\n      };\n\n      // Helper: Format measurement for display\n      const formatMeasurementForPdf = m => {\n        const expr = m.expression || m.value?.toString() || '0';\n        const result = m.result ?? m.value ?? 0;\n        return `${expr.replace(/\\./g, ',').replace(/\\*/g, '×')} = ${result.toString().replace('.', ',')} ${m.unit}`;\n      };\n\n      // Helper: Count checked items recursively\n      const countCheckedForPdf = items => {\n        let total = 0;\n        items.forEach(item => {\n          if (item.checked) total++;\n          if (item.subItems && item.subItems.length > 0) {\n            total += countCheckedForPdf(item.subItems);\n          }\n        });\n        return total;\n      };\n\n      // Helper: Count total items recursively\n      const countTotalForPdf = items => {\n        let total = items.length;\n        items.forEach(item => {\n          if (item.subItems && item.subItems.length > 0) {\n            total += countTotalForPdf(item.subItems);\n          }\n        });\n        return total;\n      };\n      const checklistItems = checklists.length > 0 ? checklists.map((checklist, checklistIndex) => {\n        // Filter checked main categories\n        const checkedCategories = checklist.items.filter(item => item.checked);\n        if (checkedCategories.length === 0) {\n          return `\n          <div class=\"checklist-card\">\n            <div class=\"checklist-main-header\">${checklist.template_name}</div>\n            <p class=\"empty\">Keine Positionen abgehakt</p>\n          </div>\n        `;\n        }\n\n        // Build categories HTML\n        const categoriesHtml = checkedCategories.map((category, catIndex) => {\n          const level1Items = category.subItems || [];\n          const checkedLevel1 = level1Items.filter(item => item.checked);\n          const checkedSubCount = category.subItems ? countCheckedForPdf(category.subItems) : 0;\n          const totalSubCount = category.subItems ? countTotalForPdf(category.subItems) : 0;\n\n          // Build level 1 containers\n          const containersHtml = checkedLevel1.map(l1Item => {\n            const originalIndex = level1Items.indexOf(l1Item);\n            const containerPrefix = `${catIndex + 1}.${originalIndex + 1}`;\n            const deepSubs = l1Item.subItems ? flattenDeepSubItemsForPdf(l1Item.subItems, containerPrefix) : [];\n            const deepSubsHtml = deepSubs.map(sub => `\n            <div class=\"pdf-deep-sub\" style=\"padding-left: ${sub.level * 10}px;\">\n              <span class=\"pdf-deep-prefix\">${sub.prefix}</span>\n              <span class=\"pdf-checkmark\">✓</span>\n              <span class=\"pdf-deep-text\">${sub.text}</span>\n            </div>\n            ${sub.note ? `<div class=\"pdf-note\" style=\"margin-left: ${sub.level * 10 + 36}px;\"><span class=\"pdf-note-icon\">📝</span> ${sub.note}</div>` : ''}\n            ${sub.measurements && sub.measurements.length > 0 ? `<div class=\"pdf-measurement\" style=\"margin-left: ${sub.level * 10 + 36}px;\">${sub.measurements.map(m => `📐 ${formatMeasurementForPdf(m)}`).join('<br>')}</div>` : ''}\n          `).join('');\n            return `\n            <div class=\"pdf-level1-container\">\n              <div class=\"pdf-level1-header\">\n                <span class=\"pdf-level1-prefix\">${containerPrefix}</span>\n                <span class=\"pdf-checkmark-circle\">✓</span>\n                <span class=\"pdf-level1-title\">${l1Item.text}</span>\n                ${l1Item.printImage ? `<img src=\"${l1Item.printImage}\" class=\"pdf-print-thumbnail-small\" alt=\"Bild\" />` : ''}\n              </div>\n              ${l1Item.note ? `<div class=\"pdf-note\"><span class=\"pdf-note-icon\">📝</span> ${l1Item.note}</div>` : ''}\n              ${l1Item.measurements && l1Item.measurements.length > 0 ? `<div class=\"pdf-measurement\">${l1Item.measurements.map(m => `📐 ${formatMeasurementForPdf(m)}`).join('<br>')}</div>` : ''}\n              ${deepSubs.length > 0 ? `<div class=\"pdf-level1-content\">${deepSubsHtml}</div>` : ''}\n            </div>\n          `;\n          }).join('');\n          return `<!--CATEGORY_SPLIT-->\n          <div class=\"pdf-category-section cols-${checklistColumns}\" style=\"page-break-inside: avoid; break-inside: avoid; margin-bottom: 8px;\">\n            <div class=\"pdf-category-header\">\n              ${category.categoryLogo ? `<img src=\"${category.categoryLogo}\" class=\"pdf-category-logo\" alt=\"Logo\" />` : ''}\n              <span class=\"pdf-cat-check\">✓</span>\n              <span class=\"pdf-category-title\">${category.text}</span>\n              ${category.printImage ? `<img src=\"${category.printImage}\" class=\"pdf-print-thumbnail\" alt=\"Bild\" />` : ''}\n              ${totalSubCount > 0 ? `<span class=\"pdf-category-count\">${checkedSubCount}/${totalSubCount}</span>` : ''}\n            </div>\n            ${category.note ? `<div class=\"pdf-category-note\"><span class=\"pdf-note-icon\">📝</span> ${category.note}</div>` : ''}\n            ${category.measurements && category.measurements.length > 0 ? `\n              <div class=\"pdf-category-measurements\">\n                ${category.measurements.map(m => `<div class=\"pdf-measurement-line\">📐 ${formatMeasurementForPdf(m)}</div>`).join('')}\n                ${(() => {\n            const sumsByUnit = {};\n            category.measurements.forEach(m => {\n              const result = m.result ?? m.value ?? 0;\n              sumsByUnit[m.unit] = (sumsByUnit[m.unit] || 0) + result;\n            });\n            const units = Object.keys(sumsByUnit);\n            if (units.length > 0) {\n              return `<div class=\"pdf-measurement-sum\">Summen: ${units.map(u => `<span class=\"pdf-sum-badge\">${sumsByUnit[u].toFixed(2).replace('.', ',')} ${u}</span>`).join(' ')}</div>`;\n            }\n            return '';\n          })()}\n              </div>\n            ` : ''}\n            <div class=\"pdf-level1-grid\" style=\"display: grid; grid-template-columns: repeat(${checklistColumns}, 1fr); gap: 3px; width: 100%;\">${containersHtml}</div>\n          </div>\n        `;\n        }).join('');\n        const totalChecked = countCheckedForPdf(checklist.items);\n        const totalItems = countTotalForPdf(checklist.items);\n\n        // Template Logo für PDF\n        const templateLogoHtml = checklist.templateLogo ? `<img src=\"${checklist.templateLogo}\" class=\"pdf-template-logo\" alt=\"Logo\" />` : '';\n        return {\n          categoriesHtml,\n          totalChecked,\n          totalItems,\n          templateLogoHtml\n        };\n      }) : [];\n\n      // Alle Checklisten als einfache divs generieren\n      const checklistsHtml = checklistItems.length > 0 ? checklistItems.map((item, idx) => {\n        if (!item) return '';\n        const categoryHtmls = item.categoriesHtml.split('<!--CATEGORY_SPLIT-->').filter(Boolean);\n\n        // Hauptüberschrift kommt jetzt direkt aus dem Section-div als <h2>\n        const sectionHeader = '';\n\n        // Checklist-Header + erste Kategorie zusammen (nicht trennen)\n        const cardHeader = `\n        <div style=\"page-break-inside: avoid; break-inside: avoid;\">\n          ${sectionHeader}\n          <div class=\"checklist-main-header\" style=\"margin-top: ${idx > 0 ? '8px' : '0'};\">\n            ${item.templateLogoHtml}\n            <span class=\"checklist-main-title\">${checklists[idx]?.template_name || ''}</span>\n            <span class=\"checklist-main-count\">${item.totalChecked} von ${item.totalItems}</span>\n          </div>\n          ${categoryHtmls.length > 0 ? categoryHtmls[0] : ''}\n        </div>\n      `;\n\n        // Restliche Kategorien — sauber ohne Wiederholung\n        const restCategories = categoryHtmls.slice(1).map(catHtml => `\n        <div style=\"page-break-inside: avoid; break-inside: avoid;\">\n          ${catHtml}\n        </div>\n      `).join('');\n        return cardHeader + restCategories;\n      }).join('') : '<p class=\"empty\">Keine Checklisten erfasst</p>';\n\n      // Generate photos HTML (embedded as base64) with individual sizes\n      // Neue Logik: Fotos bleiben in der ursprünglichen Reihenfolge\n      // Jedes Foto bekommt page-break-inside: avoid\n      // Die Größe bestimmt nur wie viel Platz das Foto einnimmt\n\n      // iOS (iPhone UND iPad): Block-Layout für saubere Seitenumbrüche\n      // WebKit ignoriert page-break-inside: avoid bei Flexbox-Containern\n      // iPhone: Alles untereinander (display: block, width: 100%)\n      // iPad: inline-block Layout (mehrere nebeneinander, aber Seitenumbrüche werden respektiert)\n      // Android: Radikal vereinfacht - nur block-Elemente für zuverlässiges Drucken\n      const isIOSDevice = Platform.default.OS === 'ios';\n      const isAndroidDevice = Platform.default.OS === 'android';\n      const isIpad = Platform.default.OS === 'ios' && Platform.default.isPad;\n      const isIphone = Platform.default.OS === 'ios' && !Platform.default.isPad;\n      const isAndroidPhone = Platform.default.OS === 'android' && screenWidth < 768;\n      const isAndroidTablet = Platform.default.OS === 'android' && screenWidth >= 768;\n\n      // Hilfsfunktion um Fotos-HTML zu generieren - mit inline styles für zuverlässiges Drucken\n      const generatePhotoHtml = photo => {\n        const size = photo.pdf_size || 'medium';\n        let svgContent = '';\n        let canvasWidth = 0;\n        let canvasHeight = 0;\n        if (photo.annotations) {\n          try {\n            const annotationData = JSON.parse(photo.annotations);\n            canvasWidth = annotationData.canvasWidth || 400;\n            canvasHeight = annotationData.canvasHeight || 300;\n\n            // Render paths (drawing annotations)\n            if (annotationData.paths && annotationData.paths.length > 0) {\n              svgContent += annotationData.paths.map(p => `<path d=\"${p.path}\" stroke=\"${p.color || '#FF0000'}\" stroke-width=\"${p.strokeWidth || 3}\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>`).join('');\n            }\n\n            // Render text elements (including date/time stamps)\n            if (annotationData.textElements && annotationData.textElements.length > 0) {\n              svgContent += annotationData.textElements.map(t => {\n                const escapedText = (t.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n                const fontFamily = t.fontFamily === 'System' ? 'Arial, sans-serif' : t.fontFamily || 'Arial, sans-serif';\n                return `<text x=\"${t.x}\" y=\"${t.y}\" font-size=\"${t.fontSize || 20}\" fill=\"${t.color || '#FFFFFF'}\" font-family=\"${fontFamily}\" font-weight=\"bold\" stroke=\"#000000\" stroke-width=\"0.5\" paint-order=\"stroke\">${escapedText}</text>`;\n              }).join('');\n            }\n          } catch (e) {\n            console.error('Error parsing photo annotations:', e);\n          }\n        }\n\n        // Bestimme Breite und max-height basierend auf Größe\n        // ANDROID: Tabellen-basiertes Grid-Layout für zuverlässiges Drucken\n        // iOS/Web: Standard inline-block Layout\n        let width = '48%'; // medium default\n        let maxImgHeight = '280px';\n        let display = 'inline-block';\n        if (size === 'small') {\n          width = '31%';\n          maxImgHeight = '180px';\n        } else if (size === 'medium') {\n          width = '48%';\n          maxImgHeight = '280px';\n        } else if (size === 'large' || size === 'full') {\n          width = '100%';\n          maxImgHeight = '400px';\n          display = 'block';\n        }\n\n        // Bild und Annotationen in einem einzigen SVG für korrekte Koordinaten\n        const hasAnnotations = svgContent.length > 0;\n        let imageHtml = '';\n        if (hasAnnotations && canvasWidth > 0 && canvasHeight > 0) {\n          // Bild INNERHALB des SVG rendern damit Bild und Annotationen\n          // denselben Koordinatenraum teilen\n          imageHtml = `\n          <svg viewBox=\"0 0 ${canvasWidth} ${canvasHeight}\" preserveAspectRatio=\"xMidYMid meet\" style=\"display: block; width: 100%; max-height: ${maxImgHeight}; background: #f5f5f5;\">\n            <image href=\"${photo.image_data}\" x=\"0\" y=\"0\" width=\"${canvasWidth}\" height=\"${canvasHeight}\" preserveAspectRatio=\"xMidYMid meet\" />\n            ${svgContent}\n          </svg>\n        `;\n        } else {\n          imageHtml = `<img src=\"${photo.image_data}\" alt=\"Foto\" style=\"display: block; width: 100%; height: auto; max-height: ${maxImgHeight}; object-fit: contain; background: #f5f5f5;\" />`;\n        }\n        return `\n        <div style=\"display: ${display}; width: ${width}; vertical-align: top; margin: 0 1% 10px 0; page-break-inside: avoid; break-inside: avoid;\">\n          <div style=\"border: 1px solid #e0e0e0; border-radius: 6px; overflow: hidden; background: #fff;\">\n            <div style=\"display: block; width: 100%;\">\n              ${imageHtml}\n            </div>\n            ${photo.description ? `<p style=\"margin: 0; padding: 8px; font-size: 10px; color: #666; background: #f8f9fa;\">${photo.description}</p>` : ''}\n          </div>\n        </div>\n      `;\n      };\n\n      // Erzeuge Fotos - Überschrift wird ins erste Foto-Item eingebettet\n      let photosHtml = '';\n      if (photos.length > 0) {\n        // iOS: Saubere Seitenumbrüche\n        // Android: Tabellen-basiertes Grid-Layout\n        // Android-Handy: Spezielle Klasse für kompaktes Layout (Fotos auf erste Seite)\n        const photosContainerClass = isAndroidPhone ? 'photos-print-container photos-print-android photos-print-android-phone' : isAndroidTablet ? 'photos-print-container photos-print-android photos-print-android-tablet' : isAndroidDevice ? 'photos-print-container photos-print-android' : isIphone ? 'photos-print-container photos-print-iphone' : isIpad ? 'photos-print-container photos-print-ipad' : 'photos-print-container';\n        const headingHtml = `<h2 class=\"photo-inline-heading\">${t('photos.title')}</h2>`;\n        if (isAndroidDevice) {\n          // ANDROID: Grid-Layout mit inline-block\n          // Klein: 3 nebeneinander, Mittel: 2 nebeneinander, Groß: 1 (volle Breite)\n          const photosBySize = {\n            small: [],\n            medium: [],\n            large: []\n          };\n          photos.forEach(photo => {\n            const size = photo.pdf_size || 'medium';\n            if (size === 'small') photosBySize.small.push(photo);else if (size === 'large' || size === 'full') photosBySize.large.push(photo);else photosBySize.medium.push(photo);\n          });\n          let photoListHtml = headingHtml;\n\n          // Kleine Fotos: 3 nebeneinander (33% Breite) - GRÖSSERE Bilder\n          if (photosBySize.small.length > 0) {\n            photoListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            photosBySize.small.forEach((photo, idx) => {\n              photoListHtml += `\n              <div style=\"display: inline-block; width: 32%; vertical-align: top; padding: 3px; box-sizing: border-box; font-size: 12px;\">\n                <div style=\"width: 100%;\">\n                  ${generatePhotoHtml(photo).replace(/max-height:\\s*\\d+px;?/g, 'max-height: 280px;').replace(/width:\\s*\\d+%;?/g, 'width: 100%;').replace(/<img/g, '<img style=\"width: 100%; height: auto; max-height: 280px; display: block;\"')}\n                </div>\n              </div>\n            `;\n            });\n            photoListHtml += `</div>`;\n          }\n\n          // Mittlere Fotos: 2 nebeneinander (50% Breite) - GRÖSSERE Bilder\n          if (photosBySize.medium.length > 0) {\n            photoListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            photosBySize.medium.forEach((photo, idx) => {\n              photoListHtml += `\n              <div style=\"display: inline-block; width: 49%; vertical-align: top; padding: 3px; box-sizing: border-box; font-size: 12px;\">\n                <div style=\"width: 100%;\">\n                  ${generatePhotoHtml(photo).replace(/max-height:\\s*\\d+px;?/g, 'max-height: 400px;').replace(/width:\\s*\\d+%;?/g, 'width: 100%;').replace(/<img/g, '<img style=\"width: 100%; height: auto; max-height: 400px; display: block;\"')}\n                </div>\n              </div>\n            `;\n            });\n            photoListHtml += `</div>`;\n          }\n\n          // Große Fotos: 1 pro Zeile (100% Breite), 2 untereinander pro Seite\n          if (photosBySize.large.length > 0) {\n            photoListHtml += `<div style=\"margin-bottom: 10px;\">`;\n            photosBySize.large.forEach((photo, idx) => {\n              photoListHtml += `\n              <div style=\"display: block; width: 100%; padding: 5px; box-sizing: border-box; margin-bottom: 10px;\">\n                <div style=\"width: 100%;\">\n                  ${generatePhotoHtml(photo).replace(/max-height:\\s*\\d+px;?/g, '').replace(/<img/g, '<img style=\"width: 100%; height: auto; max-height: 450px; display: block;\"')}\n                </div>\n              </div>\n            `;\n            });\n            photoListHtml += `</div>`;\n          }\n          photosHtml = `<div class=\"${photosContainerClass}\">${photoListHtml}</div>`;\n        } else {\n          // iOS/Web: Standard inline-block Layout\n          const firstPhotoHtml = generatePhotoHtml(photos[0]);\n          const restPhotoItems = photos.slice(1).map(photo => generatePhotoHtml(photo)).join('');\n          photosHtml = `<div class=\"${photosContainerClass}\" style=\"font-size: 0;\">${headingHtml}${firstPhotoHtml}${restPhotoItems}</div>`;\n        }\n      }\n\n      // Generate sketches HTML (embedded as base64/SVG) with size options\n      // iPhone: kleinere Skizzen (2 pro Seite) für bessere Kompatibilität\n      // iPad: normale Größe\n\n      const sketchItems = await Promise.all(sketches.map(async (sketch, index) => {\n        // Read pdf_size and notes from sketch object or metadata\n        let size = sketch.pdf_size || 'large';\n        let sketchNotes = sketch.notes || '';\n        let sketchMemos = sketch.memos || '';\n        let sketchGeneralNotes = sketch.generalNotes || '';\n\n        // Metadata aus separatem Storage laden (zuverlässiger als sketch.metadata)\n        try {\n          let metadata = {};\n          const storedMeta = await AsyncStorage.default.getItem(`sketch_meta_${sketch.id}`);\n          if (storedMeta) {\n            metadata = JSON.parse(storedMeta);\n          } else if (sketch.metadata) {\n            metadata = typeof sketch.metadata === 'string' ? JSON.parse(sketch.metadata) : sketch.metadata;\n          }\n          if (!size || size === 'large') {\n            if (metadata.pdf_size) {\n              size = metadata.pdf_size;\n            }\n          }\n          // Allgemeine Notizen aus metadata (vom Notizen-Button)\n          if (!sketchGeneralNotes && metadata.notes) {\n            sketchGeneralNotes = metadata.notes;\n          }\n          // Memos und Notizen separat extrahieren aus elements\n          if (metadata.elements && Array.isArray(metadata.elements)) {\n            // Memos/Pointer = Zusatzleistungen (rote Pfeile mit Text)\n            if (!sketchMemos) {\n              const memoTexts = metadata.elements.filter(el => el.type === 'pointer' && el.data?.text).map(el => el.data.text.trim()).filter(t => t.length > 0);\n              if (memoTexts.length > 0) {\n                sketchMemos = memoTexts.join(' | ');\n              }\n            }\n            // Notizen = memo type (Sprechblasen)\n            if (!sketchNotes) {\n              const noteTexts = metadata.elements.filter(el => el.type === 'memo' && el.data?.text).map(el => el.data.text.trim()).filter(t => t.length > 0);\n              if (noteTexts.length > 0) {\n                sketchNotes = noteTexts.join(' | ');\n              }\n            }\n          }\n        } catch (e) {\n          console.log('Error parsing sketch metadata:', e);\n        }\n\n        // Größenklasse basierend auf pdf_size - für alle Geräte gleich\n        let sizeClass = 'sketch-large'; // Default\n        if (size === 'small') sizeClass = 'sketch-small';else if (size === 'medium') sizeClass = 'sketch-medium';else if (size === 'full') sizeClass = 'sketch-full';else sizeClass = 'sketch-large';\n\n        // Titel für Skizze\n        const sketchTitle = sketch.title || `Skizze ${index + 1}`;\n\n        // Allgemeine Notizen (vom Notizen-Button) - blauer Hintergrund\n        const generalNotesHtml = sketchGeneralNotes.trim() ? `<div class=\"sketch-notes sketch-general-notes-filled\">\n            <span class=\"sketch-general-notes-label\">Allgemeine Notizen: </span><span class=\"sketch-general-notes-text\">${sketchGeneralNotes.replace(/\\n/g, '<br>')}</span>\n          </div>` : '';\n\n        // Notizen (Sprechblasen) - gelber Hintergrund\n        const notesHtml = sketchNotes.trim() ? `<div class=\"sketch-notes sketch-notes-filled\">\n            <span class=\"sketch-notes-label\">${noteToolLabel}: </span><span class=\"sketch-notes-text\">${sketchNotes.replace(/\\n/g, '<br>')}</span>\n          </div>` : '';\n\n        // Memos (Pfeile) - roter Hintergrund\n        const memosHtml = sketchMemos.trim() ? `<div class=\"sketch-notes sketch-memos-filled\">\n            <span class=\"sketch-memos-label\">${memoToolLabel}: </span><span class=\"sketch-memos-text\">${sketchMemos.replace(/\\n/g, '<br>')}</span>\n          </div>` : '';\n        return `\n        <div class=\"sketch-item ${sizeClass}\">\n          ${index === 0 ? `<h2 class=\"sketch-inline-heading\">${t('sketches.title')}</h2>` : ''}\n          <p class=\"sketch-title\">${sketchTitle}</p>\n          ${sketch.sketch_data ? `<img src=\"${sketch.sketch_data}\" alt=\"Skizze\" />` : '<div class=\"sketch-placeholder\">Skizze</div>'}\n          ${generalNotesHtml}\n          ${notesHtml}\n          ${memosHtml}\n        </div>\n      `;\n      }));\n\n      // Sketches-Container: iOS bekommt block/inline-block Layout für bessere Seitenumbrüche\n      // WebKit (iOS) ignoriert page-break-inside: avoid bei Flexbox-Containern\n      // Android: Tabellen-basiertes Grid-Layout\n      const sketchesContainerClass = isAndroidDevice ? 'sketches-container sketches-container-android' : isIphone ? 'sketches-container sketches-container-iphone' : isIpad ? 'sketches-container sketches-container-ipad' : 'sketches-container';\n\n      // Alle Sketches im Container zusammen - Überschrift ist im ersten Item eingebettet\n      let sketchesHtml = '';\n      if (sketches.length > 0) {\n        if (isAndroidDevice) {\n          // ANDROID: Grid-Layout mit inline-block\n          // Nur 2 Größen: 66% (2 nebeneinander) und 100% (volle Breite, untereinander)\n          const headingHtml = `<h2 class=\"sketch-inline-heading\">${t('sketches.title')}</h2>`;\n          const sketchesBySize = {\n            medium: [],\n            large: []\n          };\n          sketchItems.forEach((itemHtml, index) => {\n            const sketch = sketches[index];\n            const meta = sketch.metadata || {};\n            const size = typeof meta === 'object' && meta.pdf_size || sketch.pdf_size || 'large';\n\n            // Überschrift aus dem Item entfernen\n            const cleanHtml = itemHtml.replace(/<h2 class=\"sketch-inline-heading\">[^<]*<\\/h2>/g, '');\n\n            // small wird zu medium gemappt (falls alte Daten vorhanden)\n            if (size === 'small' || size === 'medium') sketchesBySize.medium.push(cleanHtml);else sketchesBySize.large.push(cleanHtml);\n          });\n\n          // LÖSUNG: Überschrift + erste Skizze starten auf neuer Seite\n          // Android Print Spooler ignoriert oft page-break-inside:avoid bei großen Inhalten\n          // Daher: page-break-before:always für den Skizzen-Container\n          let sketchListHtml = '';\n          let isFirstSketchRendered = false;\n\n          // 66% Skizzen: 2 nebeneinander, je ca. 48% Breite (mit Abstand = 100%)\n          if (sketchesBySize.medium.length > 0) {\n            // Wenn medium-Skizzen zuerst kommen, Überschrift + erste Skizzen zusammen wrappen\n            // page-break-before: always erzwingt neue Seite VOR dem Container\n            if (!isFirstSketchRendered) {\n              sketchListHtml += `<div style=\"page-break-before:always!important;page-break-inside:avoid!important;break-inside:avoid!important;\">`;\n              sketchListHtml += headingHtml;\n              isFirstSketchRendered = true;\n            }\n            sketchListHtml += `<div style=\"margin-bottom: 10px; font-size: 0;\">`;\n            sketchesBySize.medium.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html\n              // Entferne alle style-Attribute von img\n              .replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>')\n              // Setze neue styles für img - volle Breite erzwingen, max-height begrenzt\n              .replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:300px!important;object-fit:contain!important;\"')\n              // Auch das sketch-item div anpassen\n              .replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item\" style=\"width:100%!important;\"');\n              sketchListHtml += `\n              <div style=\"display:inline-block;width:48%;vertical-align:top;padding:4px;box-sizing:border-box;font-size:12px;\">\n                <div style=\"width:100%;border:1px solid #ddd;padding:5px;box-sizing:border-box;overflow:hidden;\">\n                  ${modifiedHtml}\n                </div>\n              </div>\n            `;\n            });\n            sketchListHtml += `</div>`;\n            // Schließe den page-break-avoid Container nach den medium Skizzen\n            sketchListHtml += `</div>`;\n          }\n\n          // 100% Skizzen: Volle Breite - ZWEI übereinander pro Seite\n          if (sketchesBySize.large.length > 0) {\n            sketchesBySize.large.forEach((html, idx) => {\n              // Alle style-Attribute komplett entfernen und neu setzen\n              let modifiedHtml = html.replace(/<img([^>]*)\\s+style=\"[^\"]*\"([^>]*)>/gi, '<img$1$2>').replace(/<img/gi, '<img style=\"width:100%!important;height:auto!important;display:block!important;max-width:none!important;min-width:100%!important;max-height:440px!important;object-fit:contain!important;image-rendering:crisp-edges!important;\"').replace(/class=\"sketch-item[^\"]*\"/gi, 'class=\"sketch-item sketch-large\" style=\"width:100%!important;\"');\n\n              // Wenn dies die erste Skizze überhaupt ist (keine medium Skizzen vorhanden)\n              // dann Überschrift + erste große Skizze auf neuer Seite starten\n              if (!isFirstSketchRendered && idx === 0) {\n                sketchListHtml += `\n                <div style=\"page-break-before:always!important;page-break-inside:avoid!important;break-inside:avoid!important;\">\n                  ${headingHtml}\n                  <div style=\"display:block;width:100%;padding:0;box-sizing:border-box;margin-bottom:0;\">\n                    <div style=\"width:100%;border:1px solid #ddd;padding:2px;box-sizing:border-box;overflow:hidden;margin-bottom:0;\">\n                      ${modifiedHtml}\n                    </div>\n                  </div>\n                </div>\n              `;\n                isFirstSketchRendered = true;\n              } else {\n                sketchListHtml += `\n                <div style=\"display:block;width:100%;padding:0;box-sizing:border-box;margin-bottom:0;page-break-inside:avoid!important;break-inside:avoid!important;\">\n                  <div style=\"width:100%;border:1px solid #ddd;padding:2px;box-sizing:border-box;overflow:hidden;margin-bottom:0;page-break-inside:avoid!important;break-inside:avoid!important;\">\n                    ${modifiedHtml}\n                  </div>\n                </div>\n              `;\n              }\n            });\n          }\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchListHtml}</div>`;\n        } else {\n          // iOS/Web: Standard-Layout\n          sketchesHtml = `<div class=\"${sketchesContainerClass}\">${sketchItems.join('')}</div>`;\n        }\n      }\n\n      // Helper function to calculate polygon area\n      const calculatePolygonArea = (points, scale = 100) => {\n        if (points.length < 3) return 0;\n        let area = 0;\n        for (let i = 0; i < points.length; i++) {\n          const j = (i + 1) % points.length;\n          area += points[i].x * points[j].y;\n          area -= points[j].x * points[i].y;\n        }\n        return Math.abs(area / 2) / (scale * scale);\n      };\n\n      // Helper function to calculate line length\n      const calculateLineLength = (p1, p2, scale = 100) => {\n        return Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2)) / scale;\n      };\n\n      // Category colors\n      const getCategoryColor = category => {\n        // First try to find color from loaded line categories\n        const loadedCat = pdfLineCategories.find(c => c.name === category);\n        if (loadedCat) {\n          return loadedCat.color;\n        }\n        // Fallback to hardcoded colors\n        const colors = {\n          'Ortgang': '#4CAF50',\n          'Traufe': '#2196F3',\n          'First': '#9C27B0',\n          'Kehle': '#673AB7',\n          'Grat': '#FF9800',\n          'Fensterbank': '#795548',\n          'Sturz': '#607D8B',\n          'Laibung': '#E91E63',\n          'Rinne': '#00BCD4',\n          'Fensterumfang': '#FF5722',\n          'Sockelleiste': '#795548',\n          'Ortgang rechts': '#4CAF50',\n          'Ortgang links': '#4CAF50'\n        };\n        return colors[category] || '#607D8B';\n      };\n\n      // Generate FULL SVG drawing for a calculation (large, with all details)\n      const generateFullCalcSvg = calc => {\n        const polygons = calc.polygons || [];\n        const calcLines = calc.lines || [];\n        const calcScale = calc.scale || 100;\n        const calcBackgroundImage = calc.backgroundImage || null;\n        if (polygons.length === 0) return '';\n\n        // Find bounding box\n        let minX = Infinity,\n          minY = Infinity,\n          maxX = -Infinity,\n          maxY = -Infinity;\n        polygons.forEach(p => {\n          p.points.forEach(pt => {\n            minX = Math.min(minX, pt.x);\n            minY = Math.min(minY, pt.y);\n            maxX = Math.max(maxX, pt.x);\n            maxY = Math.max(maxY, pt.y);\n          });\n        });\n        const padding = 50;\n        const width = maxX - minX + padding * 2;\n        const height = maxY - minY + padding * 2;\n\n        // Scale to fit on page - FULL WIDTH for printing (A4 minus margins ~700px)\n        const maxWidth = 700;\n        const scaleRatio = Math.min(maxWidth / width, 550 / height);\n        const svgWidth = width * scaleRatio;\n        const svgHeight = height * scaleRatio;\n        const transformPoint = pt => ({\n          x: (pt.x - minX + padding) * scaleRatio,\n          y: (pt.y - minY + padding) * scaleRatio\n        });\n\n        // Calculate areas for overlay\n        const mainAreas = polygons.filter(p => p.type === 'main');\n        const deductionAreas = polygons.filter(p => p.type === 'deduction');\n        const grossArea = mainAreas.reduce((sum, p) => sum + calculatePolygonArea(p.points, calcScale), 0);\n        const deductionsTotal = deductionAreas.reduce((sum, p) => sum + calculatePolygonArea(p.points, calcScale), 0);\n        const netArea = grossArea - deductionsTotal;\n        let svgContent = `<svg width=\"${svgWidth}\" height=\"${svgHeight}\" viewBox=\"0 0 ${svgWidth} ${svgHeight}\" style=\"background: #fff; border: 1px solid #ddd; border-radius: 6px;\">`;\n\n        // Draw light grid\n        const gridSize = 25 * scaleRatio;\n        svgContent += `<defs><pattern id=\"grid-${calc.id || 'default'}\" width=\"${gridSize}\" height=\"${gridSize}\" patternUnits=\"userSpaceOnUse\">\n        <path d=\"M ${gridSize} 0 L 0 0 0 ${gridSize}\" fill=\"none\" stroke=\"#f5f5f5\" stroke-width=\"0.5\"/>\n      </pattern></defs>`;\n        svgContent += `<rect width=\"100%\" height=\"100%\" fill=\"url(#grid-${calc.id || 'default'})\"/>`;\n\n        // Draw polygons - NO FILL for printing (save ink)\n        polygons.forEach(polygon => {\n          const points = polygon.points.map(p => {\n            const tp = transformPoint(p);\n            return `${tp.x},${tp.y}`;\n          }).join(' ');\n          const defaultStrokeColor = polygon.type === 'main' ? '#4CAF50' : '#f44336';\n\n          // First draw the default polygon outline\n          svgContent += `<polygon points=\"${points}\" fill=\"none\" stroke=\"${defaultStrokeColor}\" stroke-width=\"2\"/>`;\n\n          // Now overdraw edges that have categories with their category color\n          polygon.points.forEach((point, index) => {\n            const nextPoint = polygon.points[(index + 1) % polygon.points.length];\n            const lineCategory = calcLines.find(l => l.polygonId === polygon.id && l.pointIndex === index);\n            if (lineCategory) {\n              const tp1 = transformPoint(point);\n              const tp2 = transformPoint(nextPoint);\n              const catColor = getCategoryColor(lineCategory.category);\n              // Draw colored line over the default\n              svgContent += `<line x1=\"${tp1.x}\" y1=\"${tp1.y}\" x2=\"${tp2.x}\" y2=\"${tp2.y}\" stroke=\"${catColor}\" stroke-width=\"3\"/>`;\n            }\n          });\n\n          // Draw edge lengths\n          polygon.points.forEach((point, index) => {\n            const nextPoint = polygon.points[(index + 1) % polygon.points.length];\n            const tp1 = transformPoint(point);\n            const tp2 = transformPoint(nextPoint);\n            const midX = (tp1.x + tp2.x) / 2;\n            const midY = (tp1.y + tp2.y) / 2;\n            const length = calculateLineLength(point, nextPoint, calcScale);\n            if (length < 0.1) return;\n\n            // Check if this edge has a category\n            const lineCategory = calcLines.find(l => l.polygonId === polygon.id && l.pointIndex === index);\n            const bgColor = lineCategory ? getCategoryColor(lineCategory.category) : polygon.type === 'main' ? '#4CAF50' : '#f44336';\n\n            // Get shortcut for category\n            let labelText = `${length.toFixed(2)}m`;\n            let labelWidth = 44;\n            if (lineCategory) {\n              const catInfo = pdfLineCategories.find(c => c.name === lineCategory.category);\n              if (catInfo?.shortcut) {\n                labelText = `${catInfo.shortcut} ${length.toFixed(2)}m`;\n                labelWidth = 62;\n              }\n            }\n\n            // Draw label background\n            const labelHeight = 14;\n            svgContent += `<rect x=\"${midX - labelWidth / 2}\" y=\"${midY - labelHeight / 2}\" width=\"${labelWidth}\" height=\"${labelHeight}\" rx=\"7\" fill=\"${bgColor}\"/>`;\n            svgContent += `<text x=\"${midX}\" y=\"${midY + 4}\" text-anchor=\"middle\" font-size=\"9\" font-weight=\"bold\" fill=\"white\">${labelText}</text>`;\n          });\n\n          // Draw corner point