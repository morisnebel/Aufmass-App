            border-radius: 2px;\n          }\n          .pdf-checkmark-circle {\n            color: #4caf50;\n            font-size: 8px;\n          }\n          .pdf-level1-title {\n            font-size: 8px;\n            font-weight: 600;\n            color: #333;\n            flex: 1;\n          }\n          .pdf-level1-content {\n            padding-left: 1px;\n          }\n          .pdf-deep-sub {\n            display: flex;\n            align-items: center;\n            gap: 2px;\n            padding: 0;\n          }\n          .pdf-deep-prefix {\n            font-size: 7px;\n            color: #666;\n            font-weight: 600;\n            min-width: 18px;\n          }\n          .pdf-checkmark {\n            color: #4caf50;\n            font-size: 7px;\n          }\n          .pdf-deep-text {\n            font-size: 7px;\n            color: #444;\n            flex: 1;\n          }\n          .pdf-note {\n            background: #fff8e1;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #f57c00;\n            font-style: italic;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .pdf-note-icon {\n            margin-right: 1px;\n          }\n          .pdf-measurement {\n            background: #e3f2fd;\n            padding: 2px 3px;\n            border-radius: 2px;\n            font-size: 6px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-top: 1px;\n            margin-bottom: 1px;\n          }\n          .photos-grid, .sketches-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n          }\n          /* Flexible photo/sketch containers */\n          .photos-container, .sketches-container {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 15px;\n            align-items: flex-start;\n          }\n          .photos-container::after, .sketches-container::after {\n            content: \"\";\n            display: table;\n            clear: both;\n          }\n          /* Photo page groups - jede Gruppe auf eigener Seite */\n          .photos-page-group {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .photos-page-group .photos-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n          }\n          .photos-page-group .photo-item {\n            max-height: 320px;\n            overflow: hidden;\n          }\n          .photos-page-group .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* Neue Foto-Seiten Layouts */\n          .photos-section {\n            margin-bottom: 15px;\n          }\n          /* Klein: 3 Spalten Grid */\n          .photos-section-small {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 8px;\n          }\n          .photos-section-small .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-small .photo-item img {\n            max-height: 180px;\n            object-fit: contain;\n          }\n          .photo-grid-small {\n            width: 100%;\n          }\n          /* Mittel: 2 Spalten Grid */\n          .photos-section-medium {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 12px;\n          }\n          .photos-section-medium .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-medium .photo-item img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          .photo-grid-medium {\n            width: 100%;\n          }\n          /* Groß: 1 Spalte (übereinander) */\n          .photos-section-large {\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n          }\n          .photos-section-large .photo-item {\n            page-break-inside: avoid;\n            break-inside: avoid;\n          }\n          .photos-section-large .photo-item img {\n            max-height: 340px;\n            object-fit: contain;\n          }\n          .photo-grid-large {\n            width: 100%;\n          }\n          /* iPhone-spezifischer Skizzen-Container */\n          .sketches-container-iphone {\n            display: block !important;\n            font-size: 0 !important;\n          }\n          .sketches-container-iphone .sketch-item {\n            display: inline-block !important;\n            vertical-align: top !important;\n            font-size: 14px !important;\n            margin-bottom: 10px !important;\n            margin-right: 1% !important;\n            max-height: 500px !important;\n            overflow: hidden !important;\n          }\n          .sketches-container-iphone .sketch-small {\n            width: 32% !important;\n            max-width: 32% !important;\n          }\n          .sketches-container-iphone .sketch-medium {\n            width: 48% !important;\n            max-width: 48% !important;\n          }\n          .sketches-container-iphone .sketch-large {\n            width: 100% !important;\n            max-width: 100% !important;\n          }\n          .sketches-container-iphone .sketch-full {\n            width: 100% !important;\n            max-width: 100% !important;\n          }\n          .sketches-container-iphone .sketch-item img {\n            max-height: 420px !important;\n            max-width: 100% !important;\n            width: 100% !important;\n            height: auto !important;\n            object-fit: contain !important;\n          }\n          .sketch-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .sketch-iphone img {\n            max-height: 280px;\n            object-fit: contain;\n          }\n          /* iPhone-spezifischer Fotos-Container: Grid mit 2 Spalten */\n          .photos-container-iphone {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n            margin-bottom: 20px;\n            align-items: start;\n          }\n          .photos-container-iphone.photos-new-page {\n            page-break-before: always !important;\n            break-before: page !important;\n          }\n          .photo-iphone {\n            width: 100%;\n            margin: 0;\n          }\n          .photo-iphone .photo-wrapper {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            border-radius: 4px;\n            overflow: hidden;\n          }\n          .photo-iphone img {\n            width: 100%;\n            height: auto;\n            max-height: 200px;\n            object-fit: contain;\n          }\n          /* Photo sizes - iPad mit Flexbox */\n          .photo-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .photo-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 400px;\n            object-fit: contain;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes - mit Flexbox */\n          .sketch-small {\n            flex: 0 0 calc(33.33% - 10px);\n            max-width: calc(33.33% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            flex: 0 0 calc(50% - 10px);\n            max-width: calc(50% - 10px);\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-full {\n            flex: 0 0 100%;\n            max-width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-item img {\n            max-height: 500px;\n            object-fit: contain;\n          }\n          .photo-item, .sketch-item {\n            border: 1px solid #e0e0e0;\n            border-radius: 6px;\n            overflow: hidden;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            display: block;\n            max-height: 350px;\n          }\n          /* Photo/Sketch im Grid nicht umbrechen */\n          .photo-iphone, .sketch-iphone {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n            max-height: 280px;\n            overflow: hidden;\n          }\n          .photo-small, .photo-medium, .photo-large, .photo-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          .sketch-small, .sketch-medium, .sketch-large, .sketch-full {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-height: 300px;\n            object-fit: contain;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-title {\n            margin: 0;\n            padding: 8px 10px;\n            font-size: 11px;\n            font-weight: 600;\n            color: ${accentColor};\n            background: #f0f4f8;\n            border-bottom: 1px solid ${accentColor};\n          }\n          .sketch-notes {\n            padding: 8px 10px;\n            background: #fafafa;\n            border-top: 1px solid #e0e0e0;\n          }\n          .sketch-notes-filled {\n            background: #fff8e1;\n            border-top: 1px solid #ffe082;\n          }\n          .sketch-notes-label {\n            font-size: 9px;\n            font-weight: 600;\n            color: #666;\n          }\n          .sketch-notes-text {\n            font-size: 9px;\n            color: #333;\n            line-height: 1.4;\n          }\n          .sketch-notes-lines {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n          }\n          .sketch-note-line {\n            height: 1px;\n            background: #ccc;\n            width: 100%;\n          }\n          .sketch-placeholder {\n            height: 150px;\n            display: flex;\n            align-items: center;\n            justify-content: cent