t index = sketches.findIndex(s => s.id === id);\n          if (index !== -1) {\n            // Keep only lightweight data + sketch_data (small preview) in the main array\n            delete sketches[index].metadata;\n            await setItems(KEYS.SKETCHES, sketches);\n          }\n          return {\n            metadata: metaWithoutBg,\n            backgroundImage: bg\n          };\n        }\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      } catch (error) {\n        console.error(`[SketchService] Error loading sketch data for ${id}:`, error);\n        return {\n          metadata: null,\n          backgroundImage: null\n        };\n      }\n    },\n    // ---- OPTIMIZED: Save heavy data to separate keys ----\n    saveSketchData: async (id, metadata, backgroundImage) => {\n      try {\n        // Save metadata (without background image) to separate key\n        const metaWithoutBg = Object.assign({}, metadata);\n        delete metaWithoutBg.backgroundImage;\n        const saveOps = [AsyncStorage.default.setItem(`sketch_meta_${id}`, JSON.stringify(metaWithoutBg))];\n\n        // Save background image to its own key\n        if (backgroundImage) {\n          saveOps.push(AsyncStorage.default.setItem(`sketch_bg_${id}`, backgroundImage));\n        } else {\n          // Remove old background if cleared\n          saveOps.push(AsyncStorage.default.removeItem(`sketch_bg_${id}`));\n        }\n        await Promise.all(saveOps);\n      } catch (error) {\n        console.error(`[SketchService] Error saving sketch data for ${id}:`, error);\n      }\n    },\n    create: async data => {\n      const sketches = await getItems(KEYS.SKETCHES);\n      const id = generateId();\n\n      // Extract heavy data before storing in main array\n      const heavyMetadata = data.metadata;\n      const lightSketch = Object.assign({}, data, {\n        id,\n        metadata: undefined,\n        // Don't store metadata in main array\n        crea