ix {\n            background: #1976d2;\n            color: #fff;\n            font-size: 9px;\n            font-weight: 700;\n            padding: 1px 4px;\n            border-radius: 3px;\n          }\n          .pdf-checkmark-circle {\n            color: #4caf50;\n            font-size: 10px;\n          }\n          .pdf-level1-title {\n            font-size: 10px;\n            font-weight: 600;\n            color: #333;\n            flex: 1;\n          }\n          .pdf-level1-content {\n            padding-left: 2px;\n          }\n          .pdf-deep-sub {\n            display: flex;\n            align-items: center;\n            gap: 3px;\n            padding: 1px 0;\n          }\n          .pdf-deep-prefix {\n            font-size: 9px;\n            color: #666;\n            font-weight: 600;\n            min-width: 24px;\n          }\n          .pdf-checkmark {\n            color: #4caf50;\n            font-size: 9px;\n          }\n          .pdf-deep-text {\n            font-size: 9px;\n            color: #444;\n            flex: 1;\n          }\n          .pdf-note {\n            background: #fff8e1;\n            padding: 3px 5px;\n            border-radius: 3px;\n            font-size: 8px;\n            color: #f57c00;\n            font-style: italic;\n            margin-top: 2px;\n            margin-bottom: 2px;\n          }\n          .pdf-note-icon {\n            margin-right: 2px;\n          }\n          .pdf-measurement {\n            background: #e3f2fd;\n            padding: 3px 5px;\n            border-radius: 3px;\n            font-size: 8px;\n            color: #1565c0;\n            font-weight: 500;\n            margin-top: 2px;\n            margin-bottom: 2px;\n          }\n          .photos-grid, .sketches-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n          }\n          /* Flexible photo/sketch containers */\n          .photos-container, .sketches-container {\n            display: block;\n          }\n          .photos-container::after, .sketches-container::after {\n            content: \"\";\n            display: table;\n            clear: both;\n          }\n          /* Photo sizes */\n          .photo-small {\n            width: calc(33.33% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .photo-medium {\n            width: calc(50% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .photo-large {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-full {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          /* Photo wrapper for annotation overlay */\n          .photo-wrapper {\n            position: relative;\n            display: block;\n            width: 100%;\n          }\n          .photo-wrapper img {\n            display: block;\n            width: 100%;\n            height: auto;\n          }\n          .photo-annotations {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n          }\n          /* Sketch sizes */\n          .sketch-small {\n            width: calc(33.33% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .sketch-medium {\n            width: calc(50% - 10px);\n            float: left;\n            margin-right: 15px;\n            margin-bottom: 15px;\n          }\n          .sketch-large {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          .sketch-full {\n            width: 100%;\n            margin-bottom: 15px;\n          }\n          .photo-item, .sketch-item {\n            border: 1px solid #e0e0e0;\n            border-radius: 6px;\n            overflow: hidden;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n            -webkit-column-break-inside: avoid !important;\n          }\n          /* All images fill their container width */\n          .photo-item img, .sketch-item img {\n            display: block;\n            width: 100%;\n            height: auto;\n            background: #f5f5f5;\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n          }\n          .photo-item p, .sketch-item p {\n            margin: 0;\n            padding: 8px;\n            font-size: 10px;\n            color: #666;\n            background: #f8f9fa;\n          }\n          .sketch-placeholder {\n            height: 150px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: #f5f5f5;\n            color: #999;\n          }\n          .empty {\n            color: #999;\n            font-style: italic;\n            padding: 10px;\n            background: #f8f9fa;\n            border-radius: 4px;\n          }\n          .remarks-box {\n            background: #fff8e1;\n            border: 1px solid #ffe082;\n            border-radius: 6px;\n            padding: 12px;\n            margin-top: 10px;\n          }\n          .footer {\n            margin-top: 30px;\n            padding-top: 15px;\n            border-top: 2px solid #1976d2;\n            font-size: 11px;\n            color: #666;\n            text-align: center;\n            font-weight: 500;\n          }\n          .page-break {\n            page-break-before: always;\n          }\n          .measurements-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 5px;\n            margin-top: 8px;\n          }\n          .measure-item {\n            font-size: 11px;\n          }\n          .measure-label {\n            color: #666;\n          }\n          .roof-area {\n            font-size: 14px;\n            color: #1976d2;\n            margin-bottom: 5px;\n          }\n          .roof-notes {\n            margin-top: 8px;\n            padding-top: 8px;\n            border-top: 1px dashed #e0e0e0;\n          }\n          .company-header {\n            display: flex;\n            align-items: center;\n            gap: 15px;\n          }\n          .company-logo {\n            max-width: 180px;\n            max-height: 130px;\n            object-fit: contain;\n          }\n        </style>\n      </head>\n      <body>\n        <div class=\"page\">\n        <div class=\"header\">\n          <div class=\"header-top\">\n            <div class=\"company-header\">\n              ${companyLogo ? `<img src=\"${companyLogo}\" class=\"company-logo\" alt=\"Logo\" />` : ''}\n              <div>\n                <h1>AUFMASS-DOKUMENTATION</h1>\n                <div class=\"date\">Erstellt am: ${formatDate(new Date().toISOString())}${authorName ? ` | Verfasser: ${authorName}` : ''}</div>\n              </div>\n            </div>\n            ${companyName ? `\n              <div class=\"company-info\">\n                <strong>${companyName}</strong>\n                ${companySubtitle ? `<br/><em>${companySubtitle}</em>` : ''}\n                ${companyStreet ? `<br/>${companyStreet}` : ''}\n                ${companyZipCode || companyCity ? `<br/>${companyZipCode} ${companyCity}` : ''}\n                ${companyPhone ? `<br/>Tel: ${companyPhone}` : ''}\n                ${companyEmail ? `<br/>${companyEmail}` : ''}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n        \n        <h2>Projektübersicht</h2>\n        <div class=\"info-grid\">\n          <div class=\"info-box\">\n            <h3>Projekt</h3>\n            <div class=\"info-row\">\n              <span class=\"info-label\">Name:</span>\n              <span class=\"info-value\">${project?.name || '-'}</span>\n            </div>\n            ${project?.description ?