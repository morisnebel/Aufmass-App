nipResult.height || 200;\n          const maxWidth = 400;\n          const maxHeight = 300;\n          const aspectRatio = imgWidth / imgHeight;\n          let finalWidth, finalHeight;\n          if (aspectRatio > maxWidth / maxHeight) {\n            // Bild ist breiter - begrenzen durch Breite\n            finalWidth = maxWidth;\n            finalHeight = maxWidth / aspectRatio;\n          } else {\n            // Bild ist höher - begrenzen durch Höhe\n            finalHeight = maxHeight;\n            finalWidth = maxHeight * aspectRatio;\n          }\n          const newElement = {\n            id: generateId(),\n            type: 'image',\n            data: {\n              uri: base64Image\n            },\n            color: '#000000',\n            strokeWidth: 0,\n            x: 100,\n            y: 100,\n            width: finalWidth,\n            height: finalHeight,\n            rotation: 0\n          };\n          const newElements = [...elements, newElement];\n          addToHistory(newElements);\n          // Automatisch Foto-Bearbeiten Modus aktivieren\n          setSelectedElementId(newElement.id);\n          setPhotoEditMode(true);\n          selectDrawMode('select');\n        }\n      } catch (error) {\n        console.error('Error inserting image:', error);\n        showAlert(t('common.error'), t('sketches.imageInsertError'));\n      }\n    };\n\n    // Import document/image from Files app\n    const importFromFiles = async () => {\n      try {\n        const result = await DocumentPicker.getDocumentAsync({\n          type: ['image/*', 'application/pdf'],\n          copyToCacheDirectory: true\n        });\n        if (result.canceled || !result.assets || result.assets.length === 0) {\n          return;\n        }\n        const file = result.assets[0];\n        const fileUri = file.uri;\n        const mimeType = file.mimeType || '';\n        console.log('[importFromFiles] Selected file:', file.name, mimeType);\n\n        // Wenn es ein PDF ist, konvertiere es zu einem Bild\n        if (mimeType === 'application/pdf' || file.name?.toLowerCase().endsWith('.pdf')) {\n          try {\n            console.log('[importFromFiles] Converting PDF to image...');\n            // Prüfe ob PdfThumbnail verfügbar ist (natives Modul - nur in Development Build)\n            if (!PdfThumbnail.default || !PdfThumbnail.default.generate) {\n              throw new Error('PDF Thumbnail module not available');\n            }\n            // Generiere Thumbnail der ersten Seite\n            const {\n              uri,\n              width,\n              height\n            } = await PdfThumbnail.default.generate(fileUri, 0);\n            console.log('[importFromFiles] PDF converted successfully:', uri, width, height);\n            await insertImageFromUri(uri);\n            return;\n          } catch (pdfError) {\n            console.error('[importFromFiles] PDF conversion error:', pdfError);\n            // Bessere Fehlermeldung wenn natives Modul nicht verfügbar\n            Alert.default.alert('PDF Import', 'PDF-Import ist nur im TestFlight/Production-Build verfügbar.\\n\\nBitte wähle stattdessen ein Bild (JPG, PNG) aus.', [{\n              text: t('common.ok'),\n              style: 'default'\n            }]);\n            return;\n          }\n        }\n\n        // Wenn es ein Bild ist, füge es direkt ein\n        if (mimeType.startsWith('image/')) {\n          await insertImageFromUri(fileUri);\n        } else {\n          showAlert(t('common.error'), t('sketches.fileTypeNotSupported'));\n        }\n      } catch (error) {\n        console.error('Error importing from files:', error);\n        showAlert(t('common.error'), t('sketches.fileImportError'));\n      }\n    };\n\n    // Import only images from Files\n    const importImageFromFiles = async () => {\n      try {\n        const result = await DocumentPicker.getDocumentAsync({\n          type: ['image/*'],\n          copyToCacheDirectory: true\n        });\n        if (result.canceled || !result.assets || result.assets.length === 0) {\n          return;\n        }\n        const file = result.assets[0];\n        await insertImageFromUri(file.uri);\n      } catch (error) {\n        console.error('Error importing image from files:', error);\n        showAlert(t('common.error'), t('sketches.imageImportError'));\n      }\n    };\n\n    // Helper function to insert image from URI\n    const insertImageFromUri = async uri => {\n      try {\n        // Manipulate image to get base64\n        const manipResult = await ImageManipulator.manipulateAsync(uri, [{\n          resize: {\n            width: 800\n          }\n        }], {\n          compress: 0.7,\n          format: ImageManipulator.SaveFormat.JPEG,\n          base64: true\n        });\n        if (!manipResult.base64) {\n          throw new Error('Konnte kein Base64 generieren');\n        }\n        const base64Image = `data:image/jpeg;base64,${manipResult.base64}`;\n\n        // Berechne Seitenverhältnis\n        const imgWidth = manipResult.width || 200;\n        const imgHeight = manipResult.height || 200;\n        const maxWidth = 400;\n        const maxHeight = 300;\n        const aspectRatio = imgWidth / imgHeight;\n        let finalWidth, finalHeight;\n        if (aspectRatio > maxWidth / maxHeight) {\n          finalWidth = maxWidth;\n          finalHeight = maxWidth / aspectRatio;\n        } else {\n          finalHeight = maxHeight;\n          finalWidth = maxHeight * aspectRatio;\n        }\n        const newElement = {\n          id: generateId(),\n          type: 'image',\n          data: {\n            uri: base64Image\n          },\n          color: '#000000',\n          strokeWidth: 0,\n          x: 100,\n          y: 100,\n          width: finalWidth,\n          height: finalHeight,\n          rotation: 0\n        };\n        const newElements = [...elements, newElement];\n        addToHistory(newElements);\n        setSelectedElementId(newElement.id);\n        setPhotoEditMode(true);\n        selectDrawMode('select');\n        showAlert(t('common.success'), t('sketches.imageInserted'));\n      } catch (error) {\n        console.error('Error inserting image from URI:', error);\n        showAlert(t('common.error'), t('sketches.imageInsertError'));\n      }\n    };\n\n    // Take photo and insert on canvas\n    const takePhotoAndInsert = async () => {\n      try {\n        if (Platform.default.OS !== 'web') {\n          const {\n            status\n          } = await ImagePicker.requestCameraPermissionsAsync();\n          if (status !== 'granted') {\n            showAlert(t('sketches.cameraPermission'), t('sketches.cameraPermissionMessage'));\n            return;\n          }\n        }\n        const result = await ImagePicker.launchCameraAsync({\n          allowsEditing: false,\n          quality: 0.7\n        });\n        if (!result.canceled && result.assets[0]) {\n          const asset = result.assets[0];\n\n          // Bild auf max. 1200px Breite reduzieren (verhindert OOM auf iPad)\n          const manipResult = await ImageManipulator.manipulateAsync(asset.uri, [{\n            resize: {\n              width: Math.min(asset.width || 1200, 1200)\n            }\n          }], {\n            compress: 0.7,\n            format: ImageManipulator.SaveFormat.JPEG,\n            base64: true\n          });\n          if (!manipResult.base64) {\n            throw new Error('Could not generate base64');\n          }\n          const base64Image = `data:image/jpeg;base64,${manipResult.base64}`;\n\n          // Berechne korrektes Seitenverhältnis des Bildes\n          const imgWidth = manipResult.width || 250;\n          const imgHeight = manipResult.height || 250;\n          const maxWidth = 400;\n          const maxHeight = 300;\n          const aspectRatio = imgWidth / imgHeight;\n          let finalWidth, finalHeight;\n          if (aspectRatio > maxWidth / maxHeight) {\n            // Bild ist breiter - begrenzen durch Breite\n            finalWidth = maxWidth;\n            finalHeight = maxWidth / aspectRatio;\n          } else {\n            // Bild ist höher - begrenzen durch Höhe\n            finalHeight = maxHeight;\n            finalWidth = maxHeight * aspectRatio;\n          }\n          const newElement = {\n            id: generateId(),\n            type: 'image',\n            data: {\n              uri: base64Image\n            },\n            color: '#000000',\n            strokeWidth: 0,\n            x: 100,\n            y: 100,\n            width: finalWidth,\n            height: finalHeight,\n            rotation: 0\n          };\n          const newElements = [...elements, newElement];\n          addToHistory(newElements);\n          // Automatisch Foto-Bearbeiten Modus aktivieren\n          setSelectedElementId(newElement.id);\n          setPhotoEditMode(true);\n          selectDrawMode('select');\n        }\n      } catch (error) {\n        console.error('Error taking photo:', error);\n        showAlert(t('common.error'), t('sketches.photoTakeError'));\n      }\n    };\n\n    // Touch handlers\n    // Hilfsfunktion: Berechnet die Canvas-Koordinaten aus Touch-Event\n    // locationX/Y sind relativ zum inneren View (dem Canvas-Container)\n    // Bei einem gezoomten ScrollView sind diese Koordinaten bereits in Canvas-Koordinaten!\n    // Der scrollOffset wird benötigt, um die Position des sichtbaren Ausschnitts zu berücksichtigen\n    const onTouchStart = event => {\n      // === Android Zoom-Modus ===\n      if (Platform.default.OS === 'android' && zoomMode) {\n        const touches = event.nativeEvent.touches;\n        if (!touches) return;\n        if (touches.length >= 2) {\n          // Pinch-Start: Abstand zwischen zwei Fingern berechnen\n          const dx = touches[0].pageX - touches[1].pageX;\n          const dy = touches[0].pageY - touches[1].pageY;\n          androidPinchRef.current.initialDistance = Math.sqrt(dx * dx + dy * dy);\n          androidPinchRef.current.initialScale = androidPinchRef.current.currentScale;\n          androidPinchRef.current.isPinching = true;\n          androidPinchRef.current.numTouches = touches.length;\n        } else if (touches.length === 1) {\n          // Pan-Start: Startpunkt merken\n          androidPinchRef.current.lastPanX = touches[0].pageX;\n          androidPinchRef.current.lastPanY = touches[0].pageY;\n          androidPinchRef.current.isPinching = false;\n          androidPinchRef.current.numTouches = 1;\n        }\n        return;\n      }\n      // Im Zoom-Modus keine Zeichnung (iOS → ScrollView handelt)\n      if (zoomMode) return;\n      const touch = event.nativeEvent.touches ? event.nativeEvent.touches[0] : event.nativeEvent;\n      // Die locationX/Y sind relativ zum inneren View (Canvas-Container)\n      // Bei gezoomter ScrollView (iOS): locationX ist bereits in Canvas-Koordinaten!\n      // Bei Android viewBox-Zoom: locationX ist in Screen-Koordinaten und muss konvertiert werden\n      let locationX = touch.locationX || touch.pageX;\n      let locationY = touch.locationY || touch.pageY;\n\n      // Android: Konvertiere Screen-Koordinaten → Canvas-Koordinaten via viewBox\n      if (Platform.default.OS === 'android' && androidViewBox.w > 0 && androidViewBox.w !== screenWidth) {\n        locationX = androidViewBox.x + locationX / screenWidth * androidViewBox.w;\n        locationY = androidViewBox.y + locationY / canvasHeight * androidViewBox.h;\n      }\n      if (drawMode === 'select') {\n        handleSelectTouchStart(locationX, locationY);\n      } else if (drawMode === 'crop') {\n        // Im Crop-Modus: Suche nach einem Bild an dieser Position\n        handleCropModeTouch(locationX, locationY);\n      } else if (drawMode === 'text') {\n        // Show text input modal\n        setPendingPosition({\n          x: locationX,\n          y: locationY\n        });\n        setShowTextModal(true);\n      } else if (drawMode === 'pen') {\n        // Initialisiere sowohl Ref (für Performance) als auch State (für Rendering)\n        const pathStart = `M ${locationX} ${locationY}`;\n        currentPathRef.current = pathStart;\n        drawPointCountRef.current = 0;\n        setCurrentPath(pathStart);\n      } else if (drawMode === 'polygon') {\n        // Start polygon drawing\n        setCurrentPath(`M ${locationX} ${locationY}`);\n      } else if (drawMode === 'polyline') {\n        // Polyline: Füge Punkt hinzu\n        const snappedPoint = snapPointToAngle(locationX, locationY);\n        const newPoint = {\n          x: snappedPoint.x,\n          y: snappedPoint.y\n        };\n\n        // Prüfe ob wir nahe am ersten Punkt sind (schließen)\n        if (polylinePoints.length >= 3) {\n          const firstPoint = polylinePoints[0];\n          const distance = Math.sqrt(Math.pow(snappedPoint.x - firstPoint.x, 2) + Math.pow(snappedPoint.y - firstPoint.y, 2));\n          if (distance < 30) {\n            // Schließe die Polyline als geschlossenen Grundriss\n            finishPolyline(true);\n            return;\n          }\n        }\n        setPolylinePoints([...polylinePoints, newPoint]);\n      } else if (drawMode === 'addPoint') {\n        // addPoint Modus: Punkt zu bestehender Polyline hinzufügen\n        handleAddPointTouch(locationX, locationY);\n      } else if (drawMode === 'removePoint') {\n        // removePoint Modus: Punkt aus bestehender Polyline entfernen\n        handleRemovePointTouch(locationX, locationY);\n      } else {\n        // Other drawing modes\n        setStartPoint({\n          x: locationX,\n          y: locationY\n        });\n      }\n    };\n\n    // Handler für addPoint Modus - fügt Punkt zu bestehender Polyline hinzu\n    const handleAddPointTouch = (x, y) => {\n      // Zuerst: Prüfe ob eine Polyline ausgewählt ist\n      if (!selectedElementId) {\n        showAlert(t('common.note'), t('sketches.selectPolylineFirst'));\n        return;\n      }\n      const selectedEl = elements.find(el => el.id === selectedElementId);\n      if (!selectedEl || selectedEl.type !== 'polyline') {\n        showAlert(t('common.note'), t('sketches.selectPolyline'));\n        return;\n      }\n      const points = selectedEl.data?.points;\n      if (!points || points.length < 2) {\n        showAlert(t('common.note'), t('sketches.invalidPolyline'));\n        return;\n      }\n\n      // Prüfe ob Klick nahe einem Endpunkt ist (zum Anhängen)\n      const endpointRadius = 40;\n      const firstPoint = points[0];\n      const lastPoint = points[points.length - 1];\n      const distToFirst = Math.sqrt(Math.pow(x - firstPoint.x, 2) + Math.pow(y - firstPoint.y, 2));\n      const distToLast = Math.sqrt(Math.pow(x - lastPoint.x, 2) + Math.pow(y - lastPoint.y, 2));\n\n      // Wenn nahe am ersten Punkt - Punkt am Anfang einfügen\n      if (distToFirst < endpointRadius && !selectedEl.data.closed) {\n        const newPoints = [{\n          x,\n          y\n        }, ...points];\n        const newElements = elements.map(el => {\n          if (el.id === selectedElementId) {\n            return {\n              ...el,\n              data: {\n                ...el.data,\n                points: newPoints\n              }\n            };\n          }\n          return el;\n        });\n        addToHistory(newElements);\n        return;\n      }\n\n      // Wenn nahe am letzten Punkt - Punkt am Ende anhängen\n      if (distToLast < endpointRadius && !selectedEl.data.closed) {\n        const newPoints = [...points, {\n          x,\n          y\n        }];\n        const newElements = elements.map(el => {\n          if (el.id === selectedElementId) {\n            return {\n              ...el,\n              data: {\n                ...el.data,\n                points: newPoints\n              }\n            };\n          }\n          return el;\n        });\n        addToHistory(newElements);\n        return;\n      }\n\n      // Sonst: Prüfe ob Klick auf einer Kante ist (zum Einfügen)\n      let closestSegment = -1;\n      let minDist = Infinity;\n      let insertPoint = {\n        x,\n        y\n      };\n      for (let i = 0; i < points.length - 1; i++) {\n        const p1 = points[i];\n        const p2 = points[i + 1];\n        const dist = distanceToLineSegment(x, y, p1.x, p1.y, p2.x, p2.y);\n        if (dist < minDist && dist < 30) {\n          minDist = dist;\n          closestSegment = i;\n          // Berechne den nächsten Punkt auf dem Segment\n          insertPoint = getClosestPointOnSegment(x, y, p1.x, p1.y, p2.x, p2.y);\n        }\n      }\n\n      // Prüfe auch die schließende Kante bei geschlossenen Polylines\n      if (selectedEl.data.closed && points.length >= 3) {\n        const p1 = points[points.length - 1];\n        const p2 = points[0];\n        const dist = distanceToLineSegment(x, y, p1.x, p1.y, p2.x, p2.y);\n        if (dist < minDist && dist < 30) {\n          minDist = dist;\n          closestSegment = points.length - 1; // Spezialindex für schließende Kante\n          insertPoint = getClosestPointOnSegment(x, y, p1.x, p1.y, p2.x, p2.y);\n        }\n      }\n      if (closestSegment >= 0) {\n        // Punkt auf der Kante einfügen\n        let newPoints;\n        if (closestSegment === points.length - 1 && selectedEl.data.closed) {\n          // Schließende Kante - füge am Ende ein\n          newPoints = [...points, insertPoint];\n        } else {\n          // Normale Kante - füge nach dem Segment ein\n          newPoints = [...points.slice(0, closestSegment + 1), insertPoint, ...points.slice(closestSegment + 1)];\n        }\n        const newElements = elements.map(el => {\n          if (el.id === selectedElementId) {\n            return {\n              ...el,\n              data: {\n                ...el.data,\n                points: newPoints\n              }\n            };\n          }\n          return el;\n        });\n        addToHistory(newElements);\n\n        // Bemaßungs-Indizes aktualisieren: Segment wird geteilt → Indizes nach dem Split verschieben\n        setLineSegmentMeasurements(prev => {\n          const elementMeasurements = prev[selectedElementId];\n          if (!elementMeasurements) return prev;\n          const isClosingSegment = closestSegment === points.length - 1 && selectedEl.data.closed;\n          const newMeasurements = {};\n          for (const [key, value] of Object.entries(elementMeasurements)) {\n            const oldIdx = parseInt(key);\n            if (isClosingSegment) {\n              // Schließende Kante geteilt: altes Schließsegment-Maß löschen, Rest bleibt gleich\n              if (oldIdx === closestSegment) continue; // Altes Schließsegment-Maß entfernen\n              newMeasurements[oldIdx] = value;\n            } else if (oldIdx === closestSegment) {\n              // Geteiltes Segment: altes Maß löschen (Benutzer muss neue Maße für die 2 neuen Segmente eingeben)\n              continue;\n            } else if (oldIdx > closestSegment) {\n              // Segmente nach dem Split: Index um 1 erhöhen\n              newMeasurements[oldIdx + 1] = value;\n            } else {\n              // Segmente vor dem Split: Index bleibt gleich\n              newMeasurements[oldIdx] = value;\n            }\n          }\n          if (Object.keys(newMeasurements).length === 0) {\n            const newAll = {\n              ...prev\n            };\n            delete newAll[selectedElementId];\n            return newAll;\n          }\n          return {\n            ...prev,\n            [selectedElementId]: newMeasurements\n          };\n        });\n      }\n    };\n\n    // Hilfsfunktion: Berechnet den nächsten Punkt auf einem Liniensegment\n    const getClosestPointOnSegment = (px, py, x1, y1, x2, y2) => {\n      const dx = x2 - x1;\n      const dy = y2 - y1;\n      const lenSq = dx * dx + dy * dy;\n      if (lenSq === 0) return {\n        x: x1,\n        y: y1\n      };\n      let t = ((px - x1) * dx + (py - y1) * dy) / lenSq;\n      t = Math.max(0, Math.min