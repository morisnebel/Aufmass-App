  } catch (error) {\n      // Wenn es ein Fehler war, den wir selbst geworfen haben, weiterwerfen\n      if (error.message?.includes('beschädigt') || error.message?.includes('Parse-Fehler') || error.message?.includes('existieren')) {\n        throw error;\n      }\n      // Bei Storage-Fehlern auch Fehler werfen\n      console.error(`[getItemsStrict] KRITISCHER STORAGE-FEHLER für ${key}:`, error);\n      throw new Error(`Storage-Fehler für ${key}: ${error.message || 'Speicher möglicherweise voll'}`);\n    }\n  };\n\n  // ALIAS: Standardmäßig die sichere Version verwenden für Abwärtskompatibilität\n  const getItems = getItemsSafe;\n\n  // Batch-read multiple keys in ONE native call (much faster than individual reads)\n  // SAFE VERSION: Für Lesevorgänge - gibt leeres Array bei Fehlern zurück\n  const getMultipleItems = async keys => {\n    try {\n      const startTime = Date.now();\n      const pairs = await AsyncStorage.default.multiGet(keys);\n      const result = new Map();\n      for (const [key, value] of pairs) {\n        try {\n          if (!value) {\n            result.set(key, key === KEYS.SETTINGS ? null : []);\n          } else {\n            const parsed = JSON.parse(value);\n            // Settings ist ein Objekt, alles andere sind Arrays\n            if (key === KEYS.SETTINGS) {\n              result.set(key, parsed);\n            } else if (!Array.isArray(parsed)) {\n              console.warn(`[multiGet] ${key} ist kein Array, gebe leeres Array zurück`);\n              result.set(key, []);\n            } else {\n              result.set(key, parsed);\n            }\n          }\n        } catch (parseError) {\n          // Bei Lesevorgängen: Leeres Array für diesen Key, damit App weiter funktioniert\n          console.error(`[multiGet] JSON parse für ${key} fehlgeschlagen, überspringe:`, parseError);\n          result.set(key, key === KEYS.SETTINGS ? null : []);\n        }\n      }\n      console.log('[multiGet] Read', keys.length, 'keys in', Date.now() - startTime, 'ms');\n      return result;\n    } catch (error) {\n      console.error('[multiGet] Fehler:', error);\n\n      // Fallback to individual reads\n      const result = new Map();\n      for (const key of keys) {\n        if (key === KEYS.SETTINGS) {\n          try {\n            const data = await storage.getItem(key);\n            result.set(key, data ? JSON.parse(data) : null);\n          } catch (e) {\n            result.set(key, null);\n          }\n        } else {\n          result.set(key, await getItemsSafe(key));\n        }\n      }\n      return result;\n    }\n  };\n\n  // Fast project data loader - reads ALL needed data in one native call\n  const loadAllProjectDataFast = async projectId => {\n    const startTime = Date.now();\n\n    // Read ALL keys in ONE native call\n    const allData = await getMultipleItems([KEYS.PROJECTS, KEYS.CUSTOMERS, KEYS.ROOFS, KEYS.PHOTOS, KEYS.SKETCHES, KEYS.CHECKLISTS, KEYS.DOCUMENTS, KEYS.AREA_CALCULATIONS, KEYS.SETTINGS, 'aufmassprofi_imagemeter_photos']);\n    const t1 = Date.now();\n\n    // Filter data for this project\n    const projects = allData.get(KEYS.PROJECTS) || [];\n    const project = projects.find(p => p.id === projectId) || null;\n    let customer = null;\n    if (project?.customer_id) {\n      const customers = allData.get(KEYS.CUSTOMERS) || [];\n      customer = customers.find(c => c.id === project.customer_id) || null;\n    }\n    const roofs = (allData.get(KEYS.ROOFS) || []).filter(r => r.project_id === projectId);\n    const photos = (allData.get(KEYS.PHOTOS) || []).filter(p => p.project_id === projectId);\n\n    // Bilddaten separat laden (neue Speicherstruktur: Datei statt AsyncStorage)\n    // FIX: Lade Fotos einzeln aus Datei (umgeht AsyncStorage-Limits auf Samsung/Android)\n    if (photos.length > 0) {\n      const migrationOps = [];\n      for (let i = 0; i < photos.length; i++) {\n        const photoId = photos[i].id;\n        try {\n          // Primär: Aus Datei laden\n          const imageData = await loadImageFromFile(`photo_img_${photoId}`);\n          if (imageData && imageData.length > 100) {\n            photos[i].image_data = imageData;\n            photos[i].uri = imageData;\n          } else {\n            // Fallback: Prüfe ob Inline-Daten vorhanden sind (alte Fotos)\n            const inlineData = photos[i].image_data || photos[i].uri;\n            if (inlineData && inlineData.length > 100) {\n              console.log(`[loadAllProjectDataFast] Using inline data for photo ${photoId}`);\n              photos[i].image_data = inlineData;\n              photos[i].uri = inlineData;\n              // Queue migration to file storage\n              migrationOps.push(saveImageToFile(`photo_img_${photoId}`, inlineData).catch(err => console.error(`[loadAllProjectDataFast] Migration error for photo ${photoId}:`, err)));\n            } else {\n              console.warn(`[loadAllProjectDataFast] No image data for photo ${photoId}`);\n            }\n          }\n        } catch (e) {\n          console.error(`[loadAllProjectDataFast] Error loading photo ${photoId}:`, e);\n          // Try inline fallback even on error\n          const inlineData = photos[i].image_data || photos[i].uri;\n          if (inlineData && inlineData.length > 100) {\n            photos[i].image_data = inlineData;\n            photos[i].uri = inlineData;\n          }\n        }\n      }\n\n      // Run migrations in background\n      if (migrationOps.length > 0) {\n        Promise.all(migrationOps).then(() => {\n          console.log(`[loadAllProjectDataFast] Migrated ${migrationOps.length} photos to file storage`);\n        });\n      }\n    }\n    const sketches = (allData.get(KEYS.SKETCHES) || []).filter(s => s.project_id === projectId);\n\n    // Skizzen-Notizen und pdf_size aus separatem Storage laden (sketch_meta_${id})\n    // Notizen werden dort gespeichert und sind möglicherweise nicht im Hauptobjekt vorhanden\n    if (sketches.length > 0) {\n      const sketc