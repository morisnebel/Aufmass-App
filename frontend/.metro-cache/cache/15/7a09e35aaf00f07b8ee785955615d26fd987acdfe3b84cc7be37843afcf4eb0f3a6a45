       ${sketches.length > 0 ? `\n          <div class=\"sketches-section\" style=\"page-break-before: auto !important; break-before: auto !important;\">\n            ${sketchesHtml}\n          </div>\n        ` : ''}\n        \n        ${areaCalculations.length === 0 && (photos.length > 0 || sketches.length > 0) ? `\n          <div class=\"footer-container\">\n            ${remarks || project?.remarks ? `\n              <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                <h2>Bemerkungen</h2>\n                <div class=\"remarks-box\">\n                  ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                </div>\n              </div>\n            ` : ''}\n            <div class=\"footer\">\n              ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n            </div>\n          </div>\n        ` : ''}\n        </div><!-- end .page -->\n        \n        ${areaCalculations.length > 0 ? `\n          <div class=\"new-page\">\n            <div class=\"area-calcs-section\">\n              <h2>Flächenberechnungen</h2>\n              ${generateCombinedAreaCalcs()}\n            </div>\n            <div class=\"footer-container\">\n              ${remarks || project?.remarks ? `\n                <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                  <h2>Bemerkungen</h2>\n                  <div class=\"remarks-box\">\n                    ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                  </div>\n                </div>\n              ` : ''}\n              <div class=\"footer\">\n                ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n              </div>\n            </div>\n          </div>\n        ` : ''}\n        \n        ${photos.length === 0 && sketches.length === 0 && areaCalculations.length === 0 ? `\n          <div class=\"footer-container\">\n            ${remarks || project?.remarks ? `\n              <div class=\"remarks-section\" style=\"margin-top: 30px;\">\n                <h2>Bemerkungen</h2>\n                <div class=\"remarks-box\">\n                  ${(remarks || project?.remarks || '').replace(/\\n/g, '<br/>')}\n                </div>\n              </div>\n            ` : ''}\n            <div class=\"footer\">\n              ${t('pdf.createdWith')} - Aufmassprofi - • ${formatDate(new Date().toISOString())}\n            </div>\n          </div>\n        ` : ''}\n      </body>\n      </html>\n    `;\n      return html;\n    };\n\n    // Show PDF options dialog\n    const exportToPDF = async () => {\n      Alert.default.alert('PDF Export', t('projects.whatToDo'), [{\n        text: t('projects.showPreview'),\n        onPress: async () => {\n          try {\n            setIsGeneratingPdf(true);\n            const html = await generatePdfHtml();\n            setPdfHtmlContent(html);\n            setShowPdfPreviewModal(true);\n          } catch (error) {\n            console.error('Error generating preview:', error);\n            Alert.default.alert(t('common.error'), t('pdf.previewError'));\n          } finally {\n            setIsGeneratingPdf(false);\n          }\n        }\n      }, {\n        text: 'PDF teilen',\n        onPress: () => generateAndSharePdf()\n      }, {\n        text: t('projects.saveToFiles'),\n        onPress: () => generateAndSavePdf()\n      }, {\n        text: t('common.cancel'),\n        style: 'cancel'\n      }]);\n    };\n\n    // Generate and share PDF\n    const generateAndSharePdf = async () => {\n      try {\n        setIsGeneratingPdf(true);\n        const html = await generatePdfHtml();\n        const {\n          uri\n        } = await Print.printToFileAsync({\n          html,\n          base64: false\n        });\n\n        // Hide loader BEFORE opening share dialog to prevent stuck overlay\n        // Share dialog may not always resolve properly when user interacts with sub-dialogs (like P